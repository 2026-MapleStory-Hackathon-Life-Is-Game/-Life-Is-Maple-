--[[
    DiceManager
    ----------------------------------------------------------------------------
    주사위 굴리기를 전담하는 매니저(Logic). 싱글/멀티 턴 매니저가 공용으로 사용한다.

    주사위 값 생성은 반드시 '서버'가 전담한다.
    (멀티에서 클라가 굴리면 치팅이 가능하므로, 진실은 서버에서만 만든다.)

    주사위는 1~6짜리 두 개를 각각 굴려 합산한다(2~12, 7 중심의 종 분포).
    개별 눈(_dice1, _dice2)도 @Sync로 보관해 두어 연출에서 활용할 수 있다.
--]]
@Logic
script DiceManager extends Logic

    @Sync
    property integer _dice1 = 0

    @Sync
    property integer _dice2 = 0

    @Sync
    property integer _total = 0

    -- 주사위 두 개를 굴려 합계를 반환한다. (RandomIntegerRange는 양 끝값 포함)
    @ExecSpace("Server")
    method integer Roll()
        local d1 = _UtilLogic:RandomIntegerRange(1, 6)
        local d2 = _UtilLogic:RandomIntegerRange(1, 6)
        local total = d1 + d2

        self._dice1 = d1
        self._dice2 = d2
        self._total = total

        log("[DiceManager] 주사위: " .. tostring(d1) .. " + " .. tostring(d2) .. " = " .. tostring(total))
        return total
    end

end
