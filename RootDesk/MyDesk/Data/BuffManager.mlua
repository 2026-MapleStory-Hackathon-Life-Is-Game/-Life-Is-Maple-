@Logic
script BuffManager extends Logic

	property table ActiveBuffs = {} -- 각 버프 = { id=, statFlat=, statPct=, attackFlat=, attackPct=, damagePct=, bossDamagePct= }

	method void AddBuff(table buff)
		-- 버프 추가 (받은 순서대로 뒤에 쌓임)
		table.insert(self.ActiveBuffs, buff)
	end

	method void RemoveBuff(string id)
		-- 버프 제거 (id로 찾아서 삭제)
		for i = #self.ActiveBuffs, 1, -1 do
			
			if self.ActiveBuffs[i].id == id then
				table.remove(self.ActiveBuffs, i)
			end
			
		end
	end

	method table GetModifiers()
		-- 적용 중인 모든 버프를 합산해 modifier 1개로 반환
		local total = {
			statFlat = 0, statPct = 0,
			attackFlat = 0, attackPct = 0,
			damagePct = 0, bossDamagePct = 0,
		}
		
		for i = 1, #self.ActiveBuffs do
		
			local b = self.ActiveBuffs[i]
			
			total.statFlat      = total.statFlat      + (b.statFlat or 0)
			total.statPct       = total.statPct       + (b.statPct or 0)
			total.attackFlat    = total.attackFlat    + (b.attackFlat or 0)
			total.attackPct     = total.attackPct     + (b.attackPct or 0)
			total.damagePct     = total.damagePct     + (b.damagePct or 0)
			total.bossDamagePct = total.bossDamagePct + (b.bossDamagePct or 0)
		end
		
		return total
		
	end

end