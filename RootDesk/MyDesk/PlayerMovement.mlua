@Component
script PlayerMovement extends Component

	@Sync
	property string currentTile = "Tile_1"

	@Sync
	property number remainingSteps = 0

	method void OnBeginPlay()
		        self.currentTile = "Tile_1"
		        self:ApplyPhysicsForMap()
		        self:UpdateMapUI()
	end

	method void OnMapEnter(Entity enteredMap)
		
		        self:ApplyPhysicsForMap()
		        self:UpdateMapUI()
				self:UpdateDiceBuffUI(0)
	end

	@ExecSpace("ClientOnly")
	method void UpdateMapUI()
		        -- 내 플레이어가 이동한 경우만 내 화면 UI를 바꾼다(다른 플레이어 진입은 무시).
		        if self.Entity ~= _UserService.LocalPlayer then return end
		
				-- Map_01(진영 선택)은 레벨업이 없어 여기서 바로 표시한다.
				-- Map_02(직업)/Map_03(인생분기) 선택창은 레벨업 배너가 닫힌 뒤 열려야 하므로
				-- GameModeManager.MoveToNextMap의 레벨업 게이트(→ ShowMapSelectionFor)로 이관했다.
				-- (게임은 항상 Map_01에서 시작해 MoveToNextMap으로만 Map_02/03에 진입하므로 여기서 빠져도 누락되지 않는다.)
				if self.Entity.CurrentMapName == "Map_01" then
					-- [룸 분리] 인스턴스 룸 싱글 플로우에서는 진영 선택을 BeginSingleRoomGame의 Lv.10 게이트가 연다.
					-- 여기서 열면 '인트로 도중 조기 오픈' + '게이트 후 재오픈'(이중)이 된다.
					-- (MarkOpeningCampPending는 FirstMapManagement의 클라 타이머로 늦게 켜져 UpdateMapUI가 먼저 실행되는 레이스가 있다.)
					-- 인스턴스 룸이면 항상 게이트가 담당하므로 여기선 건너뛴다(타이밍 비의존).
					if _RoomService ~= nil and _RoomService:IsInstanceRoom() then return end
					-- 싱글 오프닝: Lv.10 인트로 배너가 먼저 나와야 하므로, 배너 게이트가 진영 선택을 열 예정이면 여기선 건너뛴다.
					-- (멀티 등 게이트가 없으면 플래그가 꺼져 있어 기존대로 즉시 표시.)
					if _LevelUpCelebration:IsOpeningCampPending() == false then
						_CampSelectUI:ShowSelectPanel()
					end
				end
	end

	method void ApplyPhysicsForMap()
		        local inGame = (self.Entity.CurrentMapName ~= "Lobby")
		        self:SetPhysicsEnabled(inGame == false)
		        if inGame then
		            -- 게임 맵 진입: 이때서야 게임 맵 타일이 로드되므로 보드 타일을 재수집한다.
		            _TileManager:EnsureTilesCollected()
			            -- 클라: 내 진영에 맞춰 변형 타일 겉모습을 로컬 교체(서버에선 ClientOnly라 no-op).
			            _TileManager:RequestCampVisuals()
			            -- 씬 로드 시 이 맵의 사용 예정 에셋(보스 로스터/NPC/배경 등)을 백그라운드로 캐시 워밍(논블로킹).
			            -- 로컬 플레이어 진입에만 실행(다른 플레이어 OnMapEnter로 중복 워밍 방지). 도착 시 top-up(PrefetchForTile)은 유지.
			            if self.Entity == _UserService.LocalPlayer then
			                _TileManager:WarmupMapAssets(self.Entity.CurrentMapName)
			            end
		        end
		        log("[PlayerMovement] 맵=" .. tostring(self.Entity.CurrentMapName) .. " 물리/입력 enable=" .. tostring(inGame == false))
	end

	method void SetPhysicsEnabled(boolean on)
		        if isvalid(self.Entity.RigidbodyComponent) then self.Entity.RigidbodyComponent.Enable = on end
		        if isvalid(self.Entity.KinematicbodyComponent) then self.Entity.KinematicbodyComponent.Enable = on end
		        if isvalid(self.Entity.MovementComponent) then self.Entity.MovementComponent.Enable = on end
		        if isvalid(self.Entity.PlayerControllerComponent) then self.Entity.PlayerControllerComponent.Enable = on end
		        if isvalid(self.Entity.StateComponent) then self.Entity.StateComponent.Enable = on end
	end

	@ExecSpace("Server")
	method void MoveSteps(number steps)
		        self.remainingSteps = steps
				
				-- 남은 주사위 이동 횟수를 표시
				self:UpdateDiceBuffUI(steps)
		
				-- 목적지가 (분기 없이) 확정되면 도착 전에 미리 배경/RUID 프리로드(pop-in 방지).
				self:TryPrefetchDestination()
		
				-- 실제 행동 로직
		        self:MoveNextStep()
	end

	@ExecSpace("Server")
	method void MoveNextStep()
		-- 이동을 다 썼으면 종료 + 턴 매니저에 완료 알림
				        if self.remainingSteps <= 0 then
				            self:ChangePlayerState("IDLE")
				            self:UpdateDiceBuffUI(0)   -- 이동 종료 → 남은 횟수 표시를 0으로 리셋
					            -- 활성인 턴 매니저만 반응한다(비활성 쪽은 내부에서 무시).
				            _SingleTurnManager:OnMoveComplete()
				            _MultiTurnManager:OnMoveComplete()
				            return
				        end
				
				        -- [수정 1] 현재 맵 이름을 같이 넘겨줍니다!
				        local nextList = _TileManager:GetNextTiles(self.Entity.CurrentMapName, self.currentTile)
				
				        -- End 타일: 더 갈 곳이 없으면 멈춘다.
				        if #nextList == 0 then
				            self.remainingSteps = 0
				            self:ChangePlayerState("IDLE")
				
							self:UpdateDiceBuffUI(0)   -- 막다른 길 → 남은 횟수 표시를 0으로 리셋
							-- 매니저 알림: 턴이 멈추지 않고 타일 이벤트로 넘어가게 함
				    		_SingleTurnManager:OnMoveComplete()
				    		_MultiTurnManager:OnMoveComplete()
				            return
				        end
				
				        -- 분기 타일: 갈래들의 표시 이름을 모아 선택 UI를 띄우고 대기.
				        if #nextList >= 2 then
				            -- 선택지 도착 Region이 다르면 한글 마을 이름, 같으면 BranchText("N번 분기점") 라벨.
				            local branchTexts = _TileManager:GetBranchLabels(self.Entity.CurrentMapName, nextList)
				            self:ShowBranchUI(nextList, branchTexts, self.remainingSteps, self.Entity.PlayerComponent.UserId)   -- actor에게만 타깃(userId 없으면 전원 브로드캐스트 → 남의 턴 분기 이동 버그)
		            _BranchSelectUI:SpectatorNotice(nextList, branchTexts, self.remainingSteps, self.Entity.PlayerComponent.UserId)   -- 관전자에 분기 선택지 읽기전용 표시("어느 쪽으로 갈까?", 피드백 3)
		            self:StartBranchWatch(nextList[1])   -- 멀티: 30초 내 미선택 시 자동으로 첫 분기 선택(피드백 6)
				            return   -- 선택이 올 때까지 멈춤 (OnBranchSelected에서 재개)
				        end
				
				        -- 직선: 다음 타일로 한 칸 진행.
				        local nextTileName = nextList[1]
				        local prevTileName = self.currentTile   -- Region 비교용(갱신 전 이전 칸)
			self.currentTile = nextTileName
				        self.remainingSteps = self.remainingSteps - 1
				
						-- UI는 '이번 칸 이동을 포함한' 남은 횟수를 표시한다(감소 전 값 = remainingSteps+1).
						-- 감소 후 값을 쓰면 이동 애니메이션 동안 한 칸 적게 보여 실제 이동 수와 어긋난다.
						self:UpdateDiceBuffUI(self.remainingSteps + 1)
				
						-- 다음 타일로 이동
						-- 직선 이동이라도 마을(Region)이 바뀌면 분기점과 동일하게 점프 연출.
			local mapNameStraight = self.Entity.CurrentMapName
			local prevRegion = _TileManager:GetTileRegion(mapNameStraight, prevTileName)
			local nextRegion = _TileManager:GetTileRegion(mapNameStraight, nextTileName)
			if prevRegion ~= "" and nextRegion ~= "" and prevRegion ~= nextRegion then
				log("[PlayerMovement] 직선 이동 마을 경계: " .. tostring(prevRegion) .. " -> " .. tostring(nextRegion) .. " (점프)")
				self:MoveToTileJump(nextTileName)   -- 마을 경계 → 점프
			else
				self:MoveToTile(nextTileName)       -- 같은 마을 → 걷기
			end
	end

	@ExecSpace("Server")
	method void OnBranchSelected(string tileName)
		-- 분기 선택. 도착 칸의 마을(Region)이 현재 칸과 다르면 점프(착지 IDLE)로, 같으면 일반 걷기로 이동.
		-- 서버 방어: 요청자가 이 말(piece)의 소유자여야 하고, 멀티면 현재 턴 플레이어여야 한다.
		-- (분기창을 actor에게만 띄우지만, 서버에서도 남의 턴 이동을 이중으로 막는다.)
		if self.Entity.PlayerComponent == nil or senderUserId ~= self.Entity.PlayerComponent.UserId then
			log_warning("[PlayerMovement] 분기 선택 거부 — 요청자가 말 소유자가 아님: " .. tostring(senderUserId))
			return
		end
		if _MultiTurnManager ~= nil and _MultiTurnManager._isActive and _MultiTurnManager._currentPlayerUserId ~= senderUserId then
			log_warning("[PlayerMovement] 분기 선택 거부 — 현재 턴 플레이어가 아님: " .. tostring(senderUserId))
			return
		end
		self:ClearBranchWatch()   -- actor가 직접 선택 → 자동선택 감시 해제(피드백 6)
		self:ApplyBranch(tileName)
	end

	method void ApplyBranch(string tileName)
		-- 분기 확정 후 이동 실행(검증 없는 내부 경로: 수동 선택/자동 선택 공통).
		_BranchSelectUI:CloseForAll()   -- 분기 확정 → 전 클라 분기창 강제 닫기(actor 외 잔재 방어)
		local mapName = self.Entity.CurrentMapName
		local prevRegion = _TileManager:GetTileRegion(mapName, self.currentTile)
		local nextRegion = _TileManager:GetTileRegion(mapName, tileName)
		self.currentTile = tileName
		self.remainingSteps = self.remainingSteps - 1
		self:UpdateDiceBuffUI(self.remainingSteps + 1)
		self:TryPrefetchDestination()
		if prevRegion ~= "" and nextRegion ~= "" and prevRegion ~= nextRegion then
			self:MoveToTileJump(tileName)
		else
			self:MoveToTile(tileName)
		end
	end

	property integer _branchTimerId = 0

	method void StartBranchWatch(string firstTile)
		-- 멀티에서 분기창을 띄운 뒤, 30초 내 미선택 시 자동으로 첫 분기를 선택한다(AFK 방지, 피드백 6).
		-- 싱글은 대기해도 게임이 멈추지 않으므로(1인) 감시하지 않는다.
		self:ClearBranchWatch()
		if _MultiTurnManager == nil or _MultiTurnManager._isActive == false then return end
		self._branchTimerId = _TimerService:SetTimerOnce(function()
			self:OnBranchTimeout(firstTile)
		end, 30.0)
	end

	method void ClearBranchWatch()
		-- 분기 자동선택 감시 해제.
		if self._branchTimerId ~= 0 then
			_TimerService:ClearTimer(self._branchTimerId)
			self._branchTimerId = 0
		end
	end

	@ExecSpace("Server")
	method void OnBranchTimeout(string tileName)
		-- 분기 미선택 30초 초과 → 자동으로 첫 분기 선택 + 턴 매니저에 AFK 자동이동 스트라이크 통지.
		self._branchTimerId = 0
		local uid = ""
		if self.Entity.PlayerComponent ~= nil then uid = self.Entity.PlayerComponent.UserId end
		-- 그새 턴이 바뀌었거나(다른 유저가 현재 턴) 순서가 리셋돼 이동(MOVE) 단계가 아니면 자동 선택하지 않는다(잔재 방지).
		if _MultiTurnManager ~= nil and _MultiTurnManager._isActive then
			if _MultiTurnManager._currentPlayerUserId ~= uid then return end
			if _MultiTurnManager._currentState ~= "MOVE" then return end
		end
		log("[PlayerMovement] 분기 시간 초과 — 자동 선택: " .. tostring(tileName))
		if uid ~= "" and _MultiTurnManager ~= nil then _MultiTurnManager:NotifyAutoBranch(uid) end
		self:ApplyBranch(tileName)
	end

	@ExecSpace("Client")
	method void MoveToTile(string tileName)
		local target = _TileManager:GetTileEntity(self.Entity.CurrentMapName, tileName)
				
				if target == nil then
					log_warning("[PlayerMovement] 타일 엔티티 미발견(이동 중단): " .. tostring(tileName))
					return
				end
		
				-- 목적지 좌표 (평면이므로 z는 버리고 x,y만 사용)
				local destPos = target.TransformComponent.WorldPosition
				local dest2D  = Vector2(destPos.x, destPos.y)
		
				-- 진행 방향에 따라 바라보는 방향 전환
				local curX = self.Entity.TransformComponent.WorldPosition.x
				if dest2D.x > curX then
					self.Entity.PlayerControllerComponent.LookDirectionX = 1     -- 오른쪽
				elseif dest2D.x < curX then
					self.Entity.PlayerControllerComponent.LookDirectionX = -1    -- 왼쪽
				end
		
				-- 걷는 애니메이션으로 전환 후 Tween 이동
				self:ChangePlayerState("MOVE")
				local tween = _TweenLogic:MoveTo(self.Entity, dest2D, 0.4, EaseType.Linear)
				tween:SetOnEndCallback(function()
					self:MoveNextStep()   -- 한 칸 도착 → 다음 칸 시도(서버에서 실행)
				end)
	end

	@ExecSpace("Client")
	method void MoveToTileJump(string tileName)
		-- 다른 마을로 가는 분기 선택 시: 공중(낙하) 포즈로 포물선 점프 → 해당 칸 착지 시 IDLE → 이후 MoveNextStep은 다시 MOVE 걷기.
		local target = _TileManager:GetTileEntity(self.Entity.CurrentMapName, tileName)
		if target == nil then
			log_warning("[PlayerMovement] 타일 엔티티 미발견(점프 이동 중단): " .. tostring(tileName))
			return
		end
		
		local destPos = target.TransformComponent.WorldPosition
		local dest2D  = Vector2(destPos.x, destPos.y)
		local curPos  = self.Entity.TransformComponent.WorldPosition
		
		if dest2D.x > curPos.x then
			self.Entity.PlayerControllerComponent.LookDirectionX = 1
		elseif dest2D.x < curPos.x then
			self.Entity.PlayerControllerComponent.LookDirectionX = -1
		end
		
		-- 공중(낙하) 포즈
		local fall = BodyActionStateChangeEvent()
		fall.ActionState = MapleAvatarBodyActionState.Fall
		fall.needResetAction = true
		self.Entity:SendEvent(fall)
		_SFXManager:PlayJump()   -- 점프 효과음
		
		-- 포물선: 중간 지점에서 정점(QuadEaseOut 상승) → 도착 칸으로(QuadEaseIn 하강) → 착지 시 Stand(IDLE).
		local peakY = math.max(curPos.y, dest2D.y) + 1.2
		local apex  = Vector2((curPos.x + dest2D.x) * 0.5, peakY)
		
		local up = _TweenLogic:MoveTo(self.Entity, apex, 0.25, EaseType.QuadEaseOut)
		up:SetOnEndCallback(function()
			local down = _TweenLogic:MoveTo(self.Entity, dest2D, 0.25, EaseType.QuadEaseIn)
			down:SetOnEndCallback(function()
				local land = BodyActionStateChangeEvent()
				land.ActionState = MapleAvatarBodyActionState.Stand
				land.needResetAction = true
				self.Entity:SendEvent(land)
				self:MoveNextStep()   -- 착지 → 다음 칸 시도(서버에서 실행)
			end)
		end)
	end

	@ExecSpace("Client")
	method void ChangePlayerState(string state)
		        local actionState = MapleAvatarBodyActionState.Stand
		        if state == "MOVE" then actionState = MapleAvatarBodyActionState.Walk end
		
		        local ev = BodyActionStateChangeEvent()
		        ev.ActionState = actionState
		        ev.needResetAction = true
		        self.Entity:SendEvent(ev)
	end

	@ExecSpace("Client")
	method void ShowBranchUI(table tileNames, table branchTexts, integer remaining)
		        -- remaining: 분기 시점의 남은 주사위 수. 각 분기의 도착 칸 예측에 사용된다.
		        _BranchSelectUI:Show(tileNames, branchTexts, remaining)
	end

	@ExecSpace("Client")
	method void UpdateDiceBuffUI(integer remaining)
		 _RollDiceAnimationUI:ChangeDiceBuff(remaining)
	end

	method string PredictDestination()
		-- 현재 위치 + 남은 걸음 수로 목적지 타일을 예측한다. 도중에 분기를 만나면 "" (아직 미확정).
		local map = self.Entity.CurrentMapName
		local tile = self.currentTile
		local steps = self.remainingSteps
		while steps > 0 do
			local nexts = _TileManager:GetNextTiles(map, tile)
			if #nexts == 0 then break end       -- 막다른 길 → 현재 tile이 최종 도착지
			if #nexts >= 2 then return "" end    -- 분기 → 아직 확정 불가(선택 후 재예측)
			tile = nexts[1]
			steps = steps - 1
		end
		return tile
	end

	method void TryPrefetchDestination()
		-- 목적지가 분기 없이 확정되면 도착 플레이어 클라에 프리로드를 지시한다(서버에서 호출).
		local dest = self:PredictDestination()
		if dest == nil or dest == "" then return end
		self:PrefetchArrivalAssets(dest)
	end

	@ExecSpace("Client")
	method void PrefetchArrivalAssets(string tileName)
		-- 도착 예정 타일의 배경/후보 RUID를 미리 적용·프리로드(도착 시 pop-in 방지). 도착 플레이어 클라에서 실행.
		_EventTileUI:PrefetchForTile(self.Entity.CurrentMapName, tileName)
	end

end