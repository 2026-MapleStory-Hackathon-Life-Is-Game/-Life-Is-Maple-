@Component
script TileEntity extends Component

	property string tileType = "NORMAL"

	@ExecSpace("ServerOnly")
	method void OnPieceEnter(Entity playerEntity)
		-- Called by TurnManager when a player piece lands on this tile.
		if isvalid(playerEntity) == false then
-- 			log_error("TileEntity.OnPieceEnter: invalid playerEntity")
			return
		end
		
-- 		log("TileEntity: player landed on " .. self.tileType .. " tile")
		
		if self.tileType == "NORMAL" then
			-- No effect; TurnManager advances phase automatically.
		
		elseif self.tileType == "HEAL" then
			-- TODO: restore HP (TurnManager advances after this returns)
		
		elseif self.tileType == "DAMAGE" then
			-- TODO: deal damage (TurnManager advances after this returns)
		
		elseif self.tileType == "EVENT" then
			-- TODO: trigger random event (TurnManager advances after this returns)
		
		elseif self.tileType == "JOB" then
			-- Show job selection UI on the landing player's client.
			-- Phase does NOT advance here; JobManager.OnJobSelected calls AdvancePhase.
			local pc = playerEntity.PlayerComponent
			if isvalid(pc) == false then
-- 				log_error("TileEntity.OnPieceEnter: PlayerComponent missing on playerEntity")
				return
			end
			local userId = pc.UserId
			_JobManager:ShowJobSelect(userId)
			return
		
		else
-- 			log_warning("TileEntity.OnPieceEnter: unknown tileType=" .. self.tileType)
		end
	end

end