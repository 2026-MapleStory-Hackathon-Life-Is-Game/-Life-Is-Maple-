@Logic
script JobManager extends Logic

	@Sync
	property string currentJob = "Beginner"

	@Sync
	property integer currentJobAdvancement = 0

	property any keyHandler = nil

	property any userEnterHandler = nil

	method void OnBeginPlay()
		if self:IsServer() then
			-- Auto-apply beginner costume when a player enters the world
			self.userEnterHandler = self:ConnectEvent(UserEnterEvent, self.OnUserEnter)
		else
			
			-- 클라이언트일 때, 직업 선택창을 열어줍니다.
			self:ShowJobSelect()
			
			self.keyHandler = _InputService:ConnectEvent(KeyDownEvent, self.OnDebugKey)
		end
		
	end

	method void OnEndPlay()
		if self:IsServer() then
			if self.userEnterHandler ~= nil then
				_InputService:DisconnectEvent(UserEnterEvent, self.userEnterHandler)
				self.userEnterHandler = nil
			end
		else
			if self.keyHandler ~= nil then
				_InputService:DisconnectEvent(KeyDownEvent, self.keyHandler)
				self.keyHandler = nil
			end
		end
	end

	method void OnUserEnter(UserEnterEvent event)
		-- Apply beginner costume when player enters the world
		local playerPiece = _EntityService:GetEntityByPath("/maps/map01/PlayerPiece")
		
		if isvalid(playerPiece) then
			self:ChangeJob("Beginner", 0, playerPiece)
		end
	end

	@ExecSpace("ClientOnly")
	method void OnDebugKey(KeyDownEvent event)
		-- Debug: press 1-6 to switch job class for testing.
		local k = event.key
		
		if k == KeyboardKey.Alpha0 then
			self:ShowJobSelect()
		elseif k == KeyboardKey.Alpha1 then
			self:OnJobSelected("Beginner", 0)
		elseif k == KeyboardKey.Alpha2 then
			self:OnJobSelected("Warrior", 1)
		elseif k == KeyboardKey.Alpha3 then
			self:OnJobSelected("Archer", 1)
		elseif k == KeyboardKey.Alpha4 then
			self:OnJobSelected("Mage", 1)
		elseif k == KeyboardKey.Alpha5 then
			self:OnJobSelected("Thief", 1)
		elseif k == KeyboardKey.Alpha6 then
			self:OnJobSelected("Pirate", 1)
		end
	end

	@ExecSpace("Client")
	method void ShowJobSelect()
		-- Show the job selection UI on the client.
		log("직업 선택창을 엽니다.")
		_JobSelectUI:Show()
	end

	@ExecSpace("Server")
	method void OnJobSelected(string jobName, integer advancement)
		
		local playerPiece = _EntityService:GetEntityByPath("/maps/map01/PlayerPiece")
		
		if isvalid(playerPiece) == false then
			log_error("[플레이어 말]이 발견되지 않았습니다. 할당이 돼있는지 확인해주세요.")
			return
		end
		
		self:ChangeJob(jobName, advancement, playerPiece)
		self:HideJobSelectUI()
	end

	@ExecSpace("Client")
	method void HideJobSelectUI()
		-- Hide the job selection UI on the client.
		_JobSelectUI:Hide()
	end

	@ExecSpace("Server")
	method void ChangeJob(string jobName, integer advancement, Entity playerEntity)
		-- Look up the matching row in JobCostume dataset and apply all costume slots.
		local ds = _DataService:GetTable("JobCostume")
		if isvalid(ds) == false then
			log_error("JobManager.ChangeJob: dataset 'JobCostume' not found")
			return
		end
		
		local targetIdx = -1
		for i = 1, ds:GetRowCount() do
			if ds:GetCell(i, "Job") == jobName
			and tonumber(ds:GetCell(i, "Job_Advancement")) == advancement then
				targetIdx = i
				break
			end
		end
		
		if targetIdx == -1 then
			log_warning("JobManager.ChangeJob: no row for job=" .. jobName .. " adv=" .. tostring(advancement))
			return
		end
		
		if isvalid(playerEntity) == false then
			log_error("JobManager.ChangeJob: playerEntity is not valid")
			return
		end
		
		local costume = playerEntity.CostumeManagerComponent
		if isvalid(costume) == false then
			log_error("JobManager.ChangeJob: CostumeManagerComponent not found on playerEntity")
			return
		end
		
		local longcoat  = ds:GetCell(targetIdx, "LongCoat")
		local coat      = ds:GetCell(targetIdx, "Coat")
		local pants     = ds:GetCell(targetIdx, "Pants")
		local weapon2h  = ds:GetCell(targetIdx, "TwoHandedWeapon")
		local weapon1h  = ds:GetCell(targetIdx, "OneHandedWeapon")
		local subweapon = ds:GetCell(targetIdx, "SubWeapon")
		
		if longcoat ~= "" then
			coat  = ""
			pants = ""
		end
		if weapon2h ~= "" then
			weapon1h  = ""
			subweapon = ""
		elseif weapon1h ~= "" then
			weapon2h = ""
		end
		
		costume.CustomBodyEquip            = ds:GetCell(targetIdx, "Body")
		costume.CustomCapEquip             = ds:GetCell(targetIdx, "Cap")
		costume.CustomCapeEquip            = ds:GetCell(targetIdx, "Cape")
		costume.CustomCoatEquip            = coat
		costume.CustomEarAccessoryEquip    = ds:GetCell(targetIdx, "Ear_Accessory")
		costume.CustomEarEquip             = ds:GetCell(targetIdx, "Ear")
		costume.CustomEyeAccessoryEquip    = ds:GetCell(targetIdx, "Eye_Accessory")
		costume.CustomFaceAccessoryEquip   = ds:GetCell(targetIdx, "Face_Accessory")
		costume.CustomFaceEquip            = ds:GetCell(targetIdx, "Face")
		costume.CustomGloveEquip           = ds:GetCell(targetIdx, "Glove")
		costume.CustomHairEquip            = ds:GetCell(targetIdx, "Hair")
		costume.CustomLongcoatEquip        = longcoat
		costume.CustomOneHandedWeaponEquip = weapon1h
		costume.CustomPantsEquip           = pants
		costume.CustomShoesEquip           = ds:GetCell(targetIdx, "Shoes")
		costume.CustomSubWeaponEquip       = subweapon
		costume.CustomTwoHandedWeaponEquip = weapon2h
		
		costume.UseCustomEquipOnly         = true
		
		self.currentJob = jobName
		self.currentJobAdvancement = advancement
		log("JobManager: changed to " .. jobName .. " Job Advancement " .. tostring(advancement))
	end

end