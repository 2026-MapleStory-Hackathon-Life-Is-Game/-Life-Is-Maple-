@Logic
script JobSelectUI extends Logic

	property Entity panel = "e443565f-8fd0-4c78-9173-ceba78635bd5"

	property ButtonComponent btnWarrior = "1894c0b6-5e8b-40b4-a106-89b48d746379"

	property ButtonComponent btnArcher = "b0597270-1f81-45be-b1db-241d0bbd36fd"

	property ButtonComponent btnMage = "8e751a35-dd1a-4836-9079-945f5a7e909d"

	property ButtonComponent btnThief = "8d6f95a2-905b-4daf-9a65-5c896d1e3364"

	property ButtonComponent btnPirate = "f6fe7b29-dde2-4a1e-a396-86c8b958ff32"

	-- 팝업 뒤 반투명 검정 디머(패널과 함께 토글).
	property Entity dimBack = "e1f3aa40-5079-47ae-92d0-643835a45322"

	-- 선택 후 결과 패널(대사→장비 안내 순차 재사용, 각 2초). UUID는 UIBuilder bind로 주입.
	property Entity resultPanel = "96878c22-cd37-4ac4-8d54-e11c0fe88ad1"
	property SpriteGUIRendererComponent jobImage = "7522cc96-9ea7-4451-9d5c-a49db58f4c4e"
	property TextComponent resultText = "c208f966-ac2c-49b7-985b-a9af1416d954"

	property any handlerWarrior = nil

	property any handlerArcher = nil

	property any handlerMage = nil

	property any handlerThief = nil

	property any handlerPirate = nil

	@ExecSpace("ClientOnly")
	method void OnBeginPlay()
		-- Root UIGroup stays visible so this Logic fires; hide the visual Panel on start.
		if isvalid(self.panel) then
			self.panel.Enable = false
		end
		if isvalid(self.resultPanel) then
			self.resultPanel.Enable = false
		end
	end

	@ExecSpace("ClientOnly")
	method void OnEndPlay()
		-- Release all event handlers to prevent leaks.
		self:DisconnectAll()
	end

	@ExecSpace("ClientOnly")
	method void Show()
		-- Called via Server→Client RPC from JobManager.ShowJobSelect.
		if isvalid(self.panel) == false then return end
		if isvalid(self.dimBack) then self.dimBack.Enable = true end
		self.panel.Enable = true

		-- 재오픈 시 중복 구독 방지: 기존 핸들러를 먼저 끊고 다시 연결한다.
		self:DisconnectAll()
		self.handlerWarrior = self.btnWarrior.Entity:ConnectEvent(ButtonClickEvent, function()
			self:SelectJob("warrior")
		end)
		self.handlerArcher = self.btnArcher.Entity:ConnectEvent(ButtonClickEvent, function()
			self:SelectJob("archer")
		end)
		self.handlerMage = self.btnMage.Entity:ConnectEvent(ButtonClickEvent, function()
			self:SelectJob("mage")
		end)
		self.handlerThief = self.btnThief.Entity:ConnectEvent(ButtonClickEvent, function()
			self:SelectJob("thief")
		end)
		self.handlerPirate = self.btnPirate.Entity:ConnectEvent(ButtonClickEvent, function()
			self:SelectJob("pirate")
		end)
		log("JobSelectUI: shown")
		
	end

	@ExecSpace("ClientOnly")
	method void Hide()
		-- Called via Server→Client RPC from JobManager.HideJobSelectUI.
		self:DisconnectAll()
		if isvalid(self.panel) then
			self.panel.Enable = false
		end
		if isvalid(self.dimBack) then self.dimBack.Enable = false end
		log("JobSelectUI: hidden")
	end

	@ExecSpace("ClientOnly")
	method void SelectJob(string jobName)
		-- 선택 직업을 서버에 전달(무기/주스탯 적용) 후, 결과 패널을 대사(2초) → 장비 안내(2초) 순으로 보여준다.
		_SFXManager:PlayClick()
		_JobWeaponManager:OnJobSelected(jobName, 1)

		-- 선택 버튼 패널은 닫고, 디머는 유지한 채 결과 패널로 전환.
		self:DisconnectAll()
		if isvalid(self.panel) then self.panel.Enable = false end
		if isvalid(self.dimBack) then self.dimBack.Enable = true end

		-- 결과 이미지: 직업별 지정 스프라이트 RUID를 적용.
		if isvalid(self.jobImage) then
			self.jobImage.ImageRUID = self:JobImageRUID(jobName)
		end
		if isvalid(self.resultPanel) then self.resultPanel.Enable = true end

		-- 1) 주스탯 대사.
		if isvalid(self.resultText) then
			self.resultText.Text = "전투력이 " .. self:JobStat(jobName) .. " 수치를 중심으로 반영됩니다!"
		end

		-- 2) 2초 뒤 장비 안내.
		_TimerService:SetTimerOnce(function()
			if isvalid(self.resultText) then
				self.resultText.Text = "기본 " .. self:JobWeaponName(jobName) .. " 지급!"
			end
			-- 3) 다시 2초 뒤 결과 패널/디머 종료.
			_TimerService:SetTimerOnce(function()
				if isvalid(self.resultPanel) then self.resultPanel.Enable = false end
				if isvalid(self.dimBack) then self.dimBack.Enable = false end
			end, 2.0)
		end, 2.0)
	end

	method string JobStat(string jobName)
		-- 직업 → 주스탯(대사 표시용). 해적은 STR.
		local j = string.lower(jobName)
		if j == "warrior" then return "STR"
		elseif j == "mage" then return "INT"
		elseif j == "archer" then return "DEX"
		elseif j == "thief" then return "LUK"
		elseif j == "pirate" then return "STR"
		end
		return "STR"
	end

	method string JobWeaponName(string jobName)
		-- 직업 → 기본 무기 이름(안내 표시용).
		local j = string.lower(jobName)
		if j == "warrior" then return "검"
		elseif j == "mage" then return "완드"
		elseif j == "archer" then return "활"
		elseif j == "thief" then return "단검"
		elseif j == "pirate" then return "너클"
		end
		return "무기"
	end

	method string JobImageRUID(string jobName)
		-- 직업 → 결과 이미지 스프라이트 RUID(지정 아트).
		local j = string.lower(jobName)
		if j == "warrior" then return "87ba231c2b6d47b2b3e265df1fbf8649"
		elseif j == "archer" then return "3d52302e8013408283910384439d34b4"
		elseif j == "mage" then return "7a3f8f82748046cbb0d872020ba2553d"
		elseif j == "thief" then return "13ce31ee4c1d4f149114e75b61788ed0"
		elseif j == "pirate" then return "6bbadb800f6149fca1d22e5a6781ddfa"
		end
		return ""
	end

	method table GetJobImageRUIDs()
		-- 프리로드용: 5개 직업 결과 이미지 RUID 목록(JobImageRUID 단일 소스를 재사용).
		local jobs = { "warrior", "archer", "mage", "thief", "pirate" }
		local out = {}
		for i = 1, #jobs do
			table.insert(out, self:JobImageRUID(jobs[i]))
		end
		return out
	end

	method void DisconnectAll()
		-- Disconnect all button handlers. Safe to call when handlers are nil.
		if self.handlerWarrior ~= nil then
			self.btnWarrior.Entity:DisconnectEvent(ButtonClickEvent, self.handlerWarrior)
			self.handlerWarrior = nil
		end
		if self.handlerArcher ~= nil then
			self.btnArcher.Entity:DisconnectEvent(ButtonClickEvent, self.handlerArcher)
			self.handlerArcher = nil
		end
		if self.handlerMage ~= nil then
			self.btnMage.Entity:DisconnectEvent(ButtonClickEvent, self.handlerMage)
			self.handlerMage = nil
		end
		if self.handlerThief ~= nil then
			self.btnThief.Entity:DisconnectEvent(ButtonClickEvent, self.handlerThief)
			self.handlerThief = nil
		end
		if self.handlerPirate ~= nil then
			self.btnPirate.Entity:DisconnectEvent(ButtonClickEvent, self.handlerPirate)
			self.handlerPirate = nil
		end
	end

end