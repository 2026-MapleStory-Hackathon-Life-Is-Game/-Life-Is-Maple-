@Logic
script RollDiceAnimationUI extends Logic

	property Entity panel = "7fe00e77-22a6-4d0f-b5df-1106f0279438"

	-- 눈금별 주사위 얼굴 엔티티(각 1~6). 결과 눈금만 Enable=true. 컨테이너(panel) 하위에서 이름으로 수집한다.
	property string leftBaseName = "UI_LeftDice_"
	property string rightBaseName = "UI_RightDice_"
	property table leftFaces = {}
	property table rightFaces = {}
	property table thrownFaces = {}

	property TextGUIRendererComponent resultText = "0746379f-0e16-4898-93ff-a8363188d3d0"

	property SpriteGUIRendererComponent resultPanel = "0746379f-0e16-4898-93ff-a8363188d3d0"

	property Entity DiceBuffPanel = "14dc1c11-16ef-43d8-a888-d767279dd4a0"

	property TextGUIRendererComponent diceBuffText = "5050589f-ca63-47e5-8201-ab05bdb14c1e"

	property Entity diceParticle = "81437709-abea-4122-a8fb-4a3311a5c881"

	property Entity hudPlayerInfo = "d22ebf6b-d4f8-44fa-a804-2dd726ed608e"

	property Entity hudUnderButton = "907c4883-c6af-4ab6-bd5d-b4601633e5f2"

	property number throwHeight = 350

	property number throwUpDur = 0.45

	property number throwDownDur = 0.55

	@ExecSpace("ClientOnly")
	method void OnBeginPlay()
		-- 눈금별 얼굴 엔티티(UI_LeftDice_1~6 / UI_RightDice_1~6)를 컨테이너(panel=UI_RollDice) 하위에서 이름으로 수집.
		self:CollectFaces(self.panel)
		if isvalid(self.panel) then
			self.panel.Enable = false   -- 평소엔 숨김
		end
		
		if isvalid(self.DiceBuffPanel) then
			self.DiceBuffPanel.Enable = false   -- 평소엔 숨김
		end
		
		-- 결과 텍스트/패널은 굴리기 전까지 숨김(초기 방어).
		if isvalid(self.resultText) then
			self.resultText.Enable = false
		end
		if isvalid(self.resultPanel) then
			self.resultPanel.Enable = false
		end
		
		-- 주사위 눈금 표시를 기본 상태(일반 주사위 활성 / 전용 '1' 주사위 비활성)로 초기화.
		self:ResetDiceFaces()
	end

	@ExecSpace("ClientOnly")
	method void CollectFaces(Entity container)
		-- 컨테이너 하위에서 눈금별 얼굴 엔티티(1~6)를 이름으로 수집해 배열에 담는다.
		self.leftFaces = {}
		self.rightFaces = {}
		if isvalid(container) == false then return end
		for i = 1, 6 do
			self.leftFaces[i] = container:GetChildByName(self.leftBaseName .. tostring(i), true)
			self.rightFaces[i] = container:GetChildByName(self.rightBaseName .. tostring(i), true)
		end
	end

	@ExecSpace("ClientOnly")
	method void HideAllFaces()
		-- 모든 눈금 얼굴을 숨긴다(다음 판 잔상 방지 / 초기화).
		for i = 1, 6 do
			local lf = self.leftFaces[i]
			if isvalid(lf) then lf.Enable = false end
			local rf = self.rightFaces[i]
			if isvalid(rf) then rf.Enable = false end
		end
	end

	@ExecSpace("ClientOnly")
	method void ShowFaces(integer d1, integer d2)
		-- 결과 눈금(d1/d2)에 해당하는 얼굴만 켜고 나머지는 끈다.
		for i = 1, 6 do
			local lf = self.leftFaces[i]
			if isvalid(lf) then lf.Enable = (i == d1) end
			local rf = self.rightFaces[i]
			if isvalid(rf) then rf.Enable = (i == d2) end
		end
	end

	@ExecSpace("ClientOnly")
	method void ResetDiceFaces()
		-- 다음 판을 위해 주사위를 기본 상태로 되돌린다(던진 위치 원복 + 모든 얼굴 숨김).
		self:RestoreDicePositions()
		self:HideAllFaces()
	end

	@ExecSpace("ClientOnly")
	method void ThrowOne(Entity die)
		-- die를 현재 위치 기준으로 y축 위로 쐈다가(감속) 다시 제자리로 떨어뜨린다(가속). UI는 anchoredPosition으로만 이동.
		if isvalid(die) == false then return end
		local ut = die.UITransformComponent
		if isvalid(ut) == false then return end
		local baseX = ut.anchoredPosition.x
		local baseY = ut.anchoredPosition.y
		-- 연출 도중 닫힘/재사용 대비 원복 기준으로 기억.
		table.insert(self.thrownFaces, { ut = ut, x = baseX, y = baseY })
		local apex = baseY + self.throwHeight
		-- 올라감: 기준 → 정점(QuadEaseOut = 정점에서 감속).
		local up = _TweenLogic:PlayTween(baseY, apex, self.throwUpDur, EaseType.QuadEaseOut, function(v)
			if isvalid(ut) then ut.anchoredPosition = Vector2(baseX, v) end
		end)
		-- 떨어짐: 정점 → 기준(QuadEaseIn = 낙하 가속).
		up:SetOnEndCallback(function()
			_TweenLogic:PlayTween(apex, baseY, self.throwDownDur, EaseType.QuadEaseIn, function(v)
				if isvalid(ut) then ut.anchoredPosition = Vector2(baseX, v) end
			end)
		end)
	end

	@ExecSpace("ClientOnly")
	method void ThrowDice(integer d1, integer d2)
		-- 결과 눈금 얼굴 두 개를 위로 던졌다가 떨어뜨리는 연출.
		self.thrownFaces = {}
		self:ThrowOne(self.leftFaces[d1])
		self:ThrowOne(self.rightFaces[d2])
	end

	@ExecSpace("ClientOnly")
	method void RestoreDicePositions()
		-- 이번 판에 던진 얼굴들을 기준(정지) 위치로 즉시 되돌린다(연출 도중 닫힘/재사용 대비).
		if self.thrownFaces == nil then return end
		for _, r in ipairs(self.thrownFaces) do
			if isvalid(r.ut) then r.ut.anchoredPosition = Vector2(r.x, r.y) end
		end
		self.thrownFaces = {}
	end

	@ExecSpace("ClientOnly")
	method void SetHudDimmed(boolean dim)
		-- 주사위 굴리는 동안 나머지 HUD를 투명도 50% + 입력 차단(누를 수 없음을 강조).
		local a = 1.0
		if dim then a = 0.5 end
		local panels = { self.hudPlayerInfo, self.hudUnderButton }
		for i = 1, #panels do
			local p = panels[i]
			if isvalid(p) and isvalid(p.CanvasGroupComponent) then
				p.CanvasGroupComponent.GroupAlpha = a
				p.CanvasGroupComponent.Interactable = (dim == false)
			end
		end
	end

	@ExecSpace("ClientOnly")
	method void Show(integer d1, integer d2, integer total, any onComplete)
		-- 주사위 연출: 굴러가는 동안엔 결과 텍스트/패널을 숨겼다가, 다 굴러간 뒤(2초) 결과를 노출한다.
		if isvalid(self.panel) == false then return end
		_SFXManager:PlayDice()   -- 주사위 굴림 효과음
		
		-- 나머지 HUD를 흐리게(50%) + 입력 차단
		self:SetHudDimmed(true)
		
		-- 패널 켜고, 주사위 눈 스프라이트 교체
		self.panel.Enable = true
		if isvalid(self.diceParticle) then self.diceParticle.Enable = true end   -- 반짝임 시작(play_on_enable)
		-- 결과 눈금 얼굴만 켜고 나머지는 끈다(RUID 교체 대신 눈금별 엔티티 활성).
		self:ShowFaces(d1, d2)
		-- 결과 눈금 얼굴을 위로 던졌다가 떨어뜨리는 트윈 연출(스프라이트 애니메이션 대체).
		self:ThrowDice(d1, d2)
		
		-- 방어: 이번에 패널이 다시 켜졌을 때, 굴리기 전에는 결과 텍스트/패널을 숨긴다(지난 결과 잔상 방지).
		if isvalid(self.resultText) then
			self.resultText.Enable = false
		end
		if isvalid(self.resultPanel) then
			self.resultPanel.Enable = false
		end
		
		-- 타이머 중첩: (주사위 굴러가는 연출 2초) 뒤 결과 노출 → 1초 더 대기 → 패널 끄고 onComplete.
		_TimerService:SetTimerOnce(function()
			-- 주사위가 다 굴러간 뒤 결과 텍스트/패널을 활성화하고 값을 채운다.
			if isvalid(self.resultPanel) then
				self.resultPanel.Enable = true
			end
			if isvalid(self.resultText) then
				self.resultText.Enable = true
				self.resultText.FontSize = 48
				self.resultText.FontStyle = FontStyleType.Bold
				self.resultText.Text = tostring(total) .. "칸"
			end
		
			_TimerService:SetTimerOnce(function()
				self.panel.Enable = false
				if isvalid(self.diceParticle) then self.diceParticle.Enable = false end   -- 반짝임 종료
				self:ResetDiceFaces()   -- 던진 얼굴 위치 원복 + 모든 눈금 얼굴 숨김(다음 판 잔상 방지)
				self:SetHudDimmed(false)   -- HUD 투명도/입력 원복
				-- 다음 판을 위해 결과 텍스트/패널도 다시 숨김.
				if isvalid(self.resultText) then
					self.resultText.Enable = false
				end
				if isvalid(self.resultPanel) then
					self.resultPanel.Enable = false
				end
				if onComplete ~= nil then
					onComplete()
				end
			end, 1.0)   -- 결과 본 뒤 1초 대기
		end, 2.0)       -- 주사위 굴러가는 연출 2초
	end

	@ExecSpace("ClientOnly")
	method void ChangeDiceBuff(integer remaining)
		if isvalid(self.DiceBuffPanel) == false then return end
		
		if remaining > 0 then
			-- 이동 중: 패널 켜고 숫자 갱신
			self.DiceBuffPanel.Enable = true
			self.diceBuffText.Text = tostring(remaining)
		else
			-- 다 썼으면 숨김
			self.DiceBuffPanel.Enable = false
		end
	end

end