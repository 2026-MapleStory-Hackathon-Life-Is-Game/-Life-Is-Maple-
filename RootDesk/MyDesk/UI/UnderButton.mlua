@Component
script UnderButton extends Component

	property any openHandler = nil

	property any rollHandler = nil

	property any closeHandler = nil

	property any mapHandler = nil

	property any charInfoHandler = nil

	property any bagHandler = nil

	property ButtonComponent OpenDicePanelButton = "64eadf42-ab0c-4d9c-99f4-9da65935f7d1"

	property ButtonComponent RollDiceButton = "859b1f3d-8c48-4216-b425-18e45ef436bd"

	property ButtonComponent CloseDicePanelButton = "fbabd9a0-bb4d-47be-bcf0-d8625ee61e1c"

	property ButtonComponent MapViewButton = "f4d5b8f1-b4f3-48f2-a9d4-e113e1204abe"

	property ButtonComponent CharInfoButton = "9cdcac8a-2a4d-4f0b-b128-5fa7e1c1246f"

	property ButtonComponent BagButton = "620689f7-d644-4347-94c3-9a74de27cc46"

	-- 주사위 버튼 자리에 겹쳐 놓는 상황별 버튼: 맵뷰=돌아가기 / 캐릭터정보=닫기.
	property ButtonComponent btnMapBack = "0533069c-9624-4b11-bb19-720ff7977b62"

	property ButtonComponent btnCharClose = "a1a14fd7-6fbf-442e-bdcd-e06f1e5f96f9"

	property any mapBackHandler = nil

	property any charCloseHandler = nil

	property string _hudCtx = ""

	property Entity WholePanel = "f6591a77-568d-41c8-b6f0-b4721629787f"

	property Entity DicePanel = "3cf2b530-e75e-4041-8925-4e4e2c4f96f1"

	property any charPanel = nil

	property any invPanel = nil

	property string openExclusive = ""

	-- 주사위(열기) 버튼의 마지막 적용 Enable 상태(변할 때만 기록, nil=최초 적용 강제).
	property any _lastDiceEnable = nil

	method void OnBeginPlay()
		if self:IsServer() then

		else
			-- 클라이언트: 버튼 이벤트 구독, 반환된 핸들을 저장
			self.openHandler = self.OpenDicePanelButton.Entity:ConnectEvent(ButtonClickEvent,self.OnDicePanelClickOpen)
			self.rollHandler = self.RollDiceButton.Entity:ConnectEvent(ButtonClickEvent,self.OnClickRoll)
			self.closeHandler = self.CloseDicePanelButton.Entity:ConnectEvent(ButtonClickEvent,self.OnDicePanelClickClose)
			if isvalid(self.MapViewButton.Entity) then
				self.mapHandler = self.MapViewButton.Entity:ConnectEvent(ButtonClickEvent, self.OnClickMap)
			end

			-- 캐릭터 정보 / 배낭 패널 컨트롤러 바인딩
			local charCtrlEntity = _EntityService:GetEntityByPath("/ui/InGameUIGroup/CharacterInfo_Panel/Ctrl")
			if isvalid(charCtrlEntity) then
				self.charPanel = charCtrlEntity:GetComponent("script.CharacterInfoPanel")
			end
			local invCtrlEntity = _EntityService:GetEntityByPath("/ui/InGameUIGroup/Inventory_Panel/Ctrl")
			if isvalid(invCtrlEntity) then
				self.invPanel = invCtrlEntity:GetComponent("script.InventoryPanel")
			end
			self.openExclusive = ""

			if isvalid(self.CharInfoButton) and isvalid(self.CharInfoButton.Entity) then
				self.charInfoHandler = self.CharInfoButton.Entity:ConnectEvent(ButtonClickEvent, self.OnClickCharInfo)
			end
			if isvalid(self.BagButton) and isvalid(self.BagButton.Entity) then
				self.bagHandler = self.BagButton.Entity:ConnectEvent(ButtonClickEvent, self.OnClickBag)
			end

			-- 상황별 버튼(돌아가기/닫기) 배선 + 시작 숨김.
			self._hudCtx = ""
			if isvalid(self.btnMapBack) and isvalid(self.btnMapBack.Entity) then
				self.btnMapBack.Entity.Enable = false
				self.mapBackHandler = self.btnMapBack.Entity:ConnectEvent(ButtonClickEvent, self.OnClickMapBack)
			end
			if isvalid(self.btnCharClose) and isvalid(self.btnCharClose.Entity) then
				self.btnCharClose.Entity.Enable = false
				self.charCloseHandler = self.btnCharClose.Entity:ConnectEvent(ButtonClickEvent, self.OnClickCharClose)
			end

			self.DicePanel.Visible = false
		end

	end

	method void OnEndPlay()
		if not self:IsServer() then
					if self.openHandler ~= nil then
						self.OpenDicePanelButton.Entity:DisconnectEvent(ButtonClickEvent, self.openHandler)
					end
					if self.rollHandler ~= nil then
						self.RollDiceButton.Entity:DisconnectEvent(ButtonClickEvent, self.rollHandler)
					end
					if self.closeHandler ~= nil then
						self.CloseDicePanelButton.Entity:DisconnectEvent(ButtonClickEvent, self.closeHandler)
					end
					if self.mapHandler ~= nil and isvalid(self.MapViewButton.Entity) then
						self.MapViewButton.Entity:DisconnectEvent(ButtonClickEvent, self.mapHandler)
					end
					if self.charInfoHandler ~= nil and isvalid(self.CharInfoButton.Entity) then
						self.CharInfoButton.Entity:DisconnectEvent(ButtonClickEvent, self.charInfoHandler)
					end
					if self.bagHandler ~= nil and isvalid(self.BagButton.Entity) then
						self.BagButton.Entity:DisconnectEvent(ButtonClickEvent, self.bagHandler)
					end
					if self.mapBackHandler ~= nil and isvalid(self.btnMapBack) and isvalid(self.btnMapBack.Entity) then
						self.btnMapBack.Entity:DisconnectEvent(ButtonClickEvent, self.mapBackHandler)
					end
					if self.charCloseHandler ~= nil and isvalid(self.btnCharClose) and isvalid(self.btnCharClose.Entity) then
						self.btnCharClose.Entity:DisconnectEvent(ButtonClickEvent, self.charCloseHandler)
					end
				end
	end

	method void OnUpdate(number delta)
		-- 패널이 자체 닫기 버튼/ESC 등 UnderButton을 거치지 않고 닫혔을 때,
		-- openExclusive가 "BAG"/"CHAR"로 남아 주사위 차단·토글 오작동을 일으킨다.
		-- 매 프레임 실제 패널 isOpen과 동기화해 desync를 제거한다.
		if self:IsClient() == false then return end
		if self.openExclusive == "BAG" then
			if isvalid(self.invPanel) and self.invPanel.isOpen == false then
				self.openExclusive = ""
			end
		elseif self.openExclusive == "CHAR" then
			if isvalid(self.charPanel) and self.charPanel.isOpen == false then
				self.openExclusive = ""
			end
		end

		-- 주사위 버튼 자리에 상황별 버튼을 보이고(맵뷰=돌아가기 / 캐릭터정보=닫기), 주사위 버튼은 숨긴다.
		-- 상태 변할 때만 적용(매 프레임 Enable 쓰기 방지).
		local ctx = "none"
		if _MapViewManager ~= nil and _MapViewManager._isOpen then
			ctx = "map"
		elseif self.openExclusive == "CHAR" then
			ctx = "char"
		end
		if ctx ~= self._hudCtx then
			self._hudCtx = ctx
			self:ApplyHudContext(ctx)
		end

		-- 주사위(열기) 버튼 활성/비활성: 굴릴 수 있는 상태(내 DICE 차례 · 굴리는 중 아님 · 맵/캐릭터뷰 아님)에서만 활성.
		-- 주사위를 굴리면 DICE 단계를 벗어나 자동으로 비활성 → 다음 DICE 차례에 다시 활성된다.
		local wantDice = (ctx == "none") and self:CanOpenDicePanel()
		if self._lastDiceEnable ~= wantDice then
			self._lastDiceEnable = wantDice
			if isvalid(self.OpenDicePanelButton) and isvalid(self.OpenDicePanelButton.Entity) then
				self.OpenDicePanelButton.Entity.Enable = wantDice
			end
		end
	end

	method void ApplyHudContext(string ctx)
		-- ctx: "map"=돌아가기만 / "char"=닫기만 / "none"=주사위 버튼 복원.
		if isvalid(self.btnMapBack) and isvalid(self.btnMapBack.Entity) then
			self.btnMapBack.Entity.Enable = (ctx == "map")
		end
		if isvalid(self.btnCharClose) and isvalid(self.btnCharClose.Entity) then
			self.btnCharClose.Entity.Enable = (ctx == "char")
		end
		-- 주사위(열기) 버튼은 상황별 버튼이 뜰 때 숨긴다. 맵뷰는 SetHudHidden도 끄지만 일관되게 여기서도 처리.
		-- (주사위 열기 버튼 Enable은 OnUpdate에서 CanOpenDicePanel 상태에 맞춰 관리 → 여기서 처리하지 않음)
	end

	method void OnClickMapBack(any event)
		-- 맵뷰 '돌아가기' → 맵뷰 닫기.
		_SFXManager:PlayClick()
		if _MapViewManager ~= nil then _MapViewManager:CloseMapView() end
	end

	method void OnClickCharClose(any event)
		-- 캐릭터 정보 '닫기' → 캐릭터 정보 패널 닫기(배타 상태 해제).
		_SFXManager:PlayClick()
		self:CloseExclusive()
	end

	method void OnDicePanelClickOpen(any event)
		_SFXManager:PlayClick()
		if self:CanOpenDicePanel() == false then
					return   -- 주사위 차례가 아니면 패널 안 열림
				end
				-- 주사위 패널 열기 전 맵 뷰 닫기
				_MapViewManager:CloseMapView()
				self.DicePanel.Visible = true
				self.WholePanel.Visible = false
	end

	method void OnClickRoll(any event)
		-- 주사위 로직 발동
		_SFXManager:PlayClick()
		_SingleTurnManager:RequestRollDice()
		_MultiTurnManager:RequestRollDice()

		self.DicePanel.Visible = false
		self.WholePanel.Visible = true
	end

	method void OnDicePanelClickClose(any event)
		_SFXManager:PlayClick()
		self.DicePanel.Visible = false
		self.WholePanel.Visible = true
	end

	method void OnClickMap(any event)
		_SFXManager:PlayClick()
		if not self:CanOpenDicePanel() then return end
		_MapViewManager:Toggle()
	end

	method void OnClickCharInfo(any event)
		-- 캐릭터 정보 토글(배낭과 상호배타).
		-- 주사위 결과 연출 중엔 새로 열지 않는다(주사위 그룹이 위에 떠 닫기 버튼을 가림).
		if self.openExclusive ~= "CHAR" and self:IsDiceResultShowing() then return end
		_SFXManager:PlayClick()
		if self.openExclusive == "CHAR" then
			self:CloseExclusive()
		else
			self:CloseExclusive()
			self.openExclusive = "CHAR"
			if isvalid(self.charPanel) then self.charPanel:Open() end
		end
	end

	method void OnClickBag(any event)
		-- 배낭 토글(캐릭터 정보와 상호배타).
		-- 주사위 결과 연출 중엔 새로 열지 않는다(주사위 그룹이 위에 떠 닫기 버튼을 가림).
		if self.openExclusive ~= "BAG" and self:IsDiceResultShowing() then return end
		_SFXManager:PlayClick()
		if self.openExclusive == "BAG" then
			self:CloseExclusive()
		else
			self:CloseExclusive()
			self.openExclusive = "BAG"
			if isvalid(self.invPanel) then self.invPanel:Open() end
		end
	end

	method void CloseExclusive()
		-- 열린 배타 패널을 닫는다.
		if isvalid(self.charPanel) then self.charPanel:Close() end
		if isvalid(self.invPanel) then self.invPanel:Close() end
		self.openExclusive = ""
	end

	method boolean IsExclusiveOpen()
		-- 캐릭터정보/배낭 중 하나라도 열려 있으면 true.
		return self.openExclusive ~= ""
	end

	method boolean CanOpenDicePanel()
		-- 캐릭터정보/배낭 패널이 열려 있으면 주사위 열기 차단.
		if self:IsExclusiveOpen() then return false end

		local mode = _GameModeManager._activeMode

				if mode == "SINGLE" then
					-- 싱글: DICE 단계 + 굴리는 중이 아니어야 OK (연출 중 재오픈 차단)
					return _SingleTurnManager._currentState == "DICE" and _SingleTurnManager._isRolling == false

				elseif mode == "MULTI" then
					-- 멀티: DICE 단계 + 굴리는 중 아님 + 내가 현재 턴 플레이어여야 함
					if _MultiTurnManager._currentState ~= "DICE" then
						return false
					end
					if _MultiTurnManager._isRolling then
						return false
					end
					local myUserId = _UserService.LocalPlayer.PlayerComponent.UserId
					return myUserId == _MultiTurnManager._currentPlayerUserId
				end

				-- 그 외(NONE 등): 못 엶
				return false
	end

	method boolean IsDiceResultShowing()
		-- 주사위 결과 연출 패널(ResultDicetUIGroup)이 현재 떠 있는지 라이브 상태로 판단(플래그 desync 없음).
		if _RollResultDiceAnimationUI == nil then return false end
		local p = _RollResultDiceAnimationUI.panel
		return isvalid(p) and p.Enable
	end

	@ExecSpace("ServerOnly")
	method void OnInitialize()
		-- 여기서 table을 매핑
	end

end