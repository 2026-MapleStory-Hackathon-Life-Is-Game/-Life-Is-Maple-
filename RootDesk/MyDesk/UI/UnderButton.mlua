@Component
script UnderButton extends Component

	property any openHandler = nil

	property any rollHandler = nil

	property any closeHandler = nil

	property any mapHandler = nil

	property any charInfoHandler = nil

	property any bagHandler = nil

	property ButtonComponent OpenDicePanelButton = "64eadf42-ab0c-4d9c-99f4-9da65935f7d1"

	property ButtonComponent RollDiceButton = "859b1f3d-8c48-4216-b425-18e45ef436bd"

	property ButtonComponent CloseDicePanelButton = "fbabd9a0-bb4d-47be-bcf0-d8625ee61e1c"

	property ButtonComponent MapViewButton = "f4d5b8f1-b4f3-48f2-a9d4-e113e1204abe"

	property ButtonComponent CharInfoButton = "9cdcac8a-2a4d-4f0b-b128-5fa7e1c1246f"

	property ButtonComponent BagButton = "620689f7-d644-4347-94c3-9a74de27cc46"

	-- 주사위 고정 카드 버튼(주사위 패널 위에 배치). 낮은=1~6, 높은=7~12 범위 랜덤 고정.
	property ButtonComponent BtnCardLow = "bfe4a390-132e-45c4-b2dc-1ae76a4c443d"

	property ButtonComponent BtnCardHigh = "79594592-eca1-4f1d-a583-8a49f5e92ab5"

	-- 중앙 '확정 숫자 카드'. 누르면 1~12 픽커를 열고, 숫자 적용 중이면 눌러서 해제한다.
	property ButtonComponent BtnCardNum = "455fe208-a473-44ea-840b-bd2e5d5fa99d"

	-- 픽커가 열린 동안 3장이 숨겨진 자리에 나타나는 '취소하기'. 아무것도 안 고르고 되돌아간다.
	property ButtonComponent BtnCardCancel = "45be9c05-65e5-4021-a865-490784fe7b55"

	property any cardLowHandler = nil

	property any cardHighHandler = nil

	property any cardNumHandler = nil

	property any cardCancelHandler = nil

	-- 1~12 픽커 버튼 구독 기록: { { entity=, eventHandler= }, ... }
	-- (12개라 UUID 프로퍼티 대신 DicePanel 자식 이름으로 찾는다. 'handler'는 예약어라 키로 못 씀)
	property any numHandlers = nil

	-- 1~12 픽커가 열려 있는지. 열리면 3장이 숨겨지고 픽커 + 취소하기가 보인다.
	property boolean _pickerOpen = false

	-- 현재 예약(장전)된 카드: ""=없음 / "low" / "high". 굴리면 해제.
	property string _armedCard = ""

	-- 카드 버튼 보유 수 라이브 갱신 폴링 타이머(주사위 패널 열린 동안).
	property number _cardPollTimer = 0

	-- 마지막 카드 조작(적용/취소) 시각. 이 뒤 CARD_SYNC_HOLD초 동안은 폴링이 서버 동기값 대신
	-- 로컬 낙관값(_armedCard)을 신뢰한다 — UseCard/ClearCard는 서버 왕복이 필요해, 그 사이
	-- 폴링이 옛 값으로 되돌리면 하이라이트가 깜빡이기 때문.
	-- 카운트다운이 아니라 '시각'으로 재는 이유: 이 컴포넌트의 OnUpdate는 InGameUIGroup이 숨겨져
	-- 있으면 tick되지 않아, delta 차감식 타이머는 영원히 만료되지 않는다.
	property number _cardActAt = -100

	-- 마지막 '적용' 시각. 이 뒤 CARD_ARM_HOLD초 내의 같은 카드 재클릭은 더블클릭으로 보고 무시한다.
	property number _cardArmAt = -100

	property ButtonComponent btnMapBack = "0533069c-9624-4b11-bb19-720ff7977b62"

	property ButtonComponent btnCharClose = "a1a14fd7-6fbf-442e-bdcd-e06f1e5f96f9"

	-- 최종 맵(검은 마법사 클리어) 완주자의 대기 턴에 주사위 버튼 자리에 뜨는 '턴 넘기기' 버튼.
	-- 멀티 FINISHED_PASS 상태 + 내 턴일 때만 노출한다. UUID는 UIBuilder 바인딩으로 주입.
	property ButtonComponent btnPassTurn = "be84e46c-df93-45ac-9cf1-8e717aba0056"

	property any mapBackHandler = nil

	property any charCloseHandler = nil

	property any passTurnHandler = nil

	property boolean _lastPassEnable = false

	property string _hudCtx = ""

	property Entity WholePanel = "f6591a77-568d-41c8-b6f0-b4721629787f"

	property Entity DicePanel = "3cf2b530-e75e-4041-8925-4e4e2c4f96f1"

	property any charPanel = nil

	property any invPanel = nil

	property string openExclusive = ""

	property any _lastDiceEnable = nil

	-- 중앙 상단 턴 안내 텍스트(내 턴 남은시간 / 배낭 차단 안내 겸용).
	property Entity turnTimerText = "fc311d4b-86d1-4956-8cd4-b801295aaf64"   -- /ui/RemainTimeTextGroup/RemainTimeText (기존 InGameUIGroup/TurnTimer에서 이동)

	property number _blockMsgLeft = 0           -- 안내 문구 표시 잔여 시간(초)

	property string _blockMsg = ""              -- 표시할 안내 문구(배낭 차단 / 카드 미보유 등)

	method void ShowHudMessage(string msg)
		-- 중앙 상단에 짧은 안내 문구를 띄운다(1.5초). 남은시간 표시보다 우선한다.
		self._blockMsg = msg
		self._blockMsgLeft = 1.5
	end

	method void OnBeginPlay()
		if self:IsServer() then
		
		else
			-- 클라이언트: 버튼 이벤트 구독, 반환된 핸들을 저장
			self.openHandler = self.OpenDicePanelButton.Entity:ConnectEvent(ButtonClickEvent,self.OnDicePanelClickOpen)
			self.rollHandler = self.RollDiceButton.Entity:ConnectEvent(ButtonClickEvent,self.OnClickRoll)
			self.closeHandler = self.CloseDicePanelButton.Entity:ConnectEvent(ButtonClickEvent,self.OnDicePanelClickClose)
			if isvalid(self.MapViewButton.Entity) then
				self.mapHandler = self.MapViewButton.Entity:ConnectEvent(ButtonClickEvent, self.OnClickMap)
			end
		
			-- 캐릭터 정보 / 배낭 패널 컨트롤러 바인딩
			local charCtrlEntity = _EntityService:GetEntityByPath("/ui/InGameUIGroup/CharacterInfo_Panel/Ctrl")
			if isvalid(charCtrlEntity) then
				self.charPanel = charCtrlEntity:GetComponent("script.CharacterInfoPanel")
			end
			local invCtrlEntity = _EntityService:GetEntityByPath("/ui/InGameUIGroup/Inventory_Panel/Ctrl")
			if isvalid(invCtrlEntity) then
				self.invPanel = invCtrlEntity:GetComponent("script.InventoryPanel")
			end
			self.openExclusive = ""
		
			if isvalid(self.CharInfoButton) and isvalid(self.CharInfoButton.Entity) then
				self.charInfoHandler = self.CharInfoButton.Entity:ConnectEvent(ButtonClickEvent, self.OnClickCharInfo)
			end
			if isvalid(self.BagButton) and isvalid(self.BagButton.Entity) then
				self.bagHandler = self.BagButton.Entity:ConnectEvent(ButtonClickEvent, self.OnClickBag)
			end

			-- 주사위 고정 카드 버튼 배선 + 장전 표시 초기화.
			if isvalid(self.BtnCardLow) and isvalid(self.BtnCardLow.Entity) then
				self.cardLowHandler = self.BtnCardLow.Entity:ConnectEvent(ButtonClickEvent, self.OnClickCardLow)
			end
			if isvalid(self.BtnCardHigh) and isvalid(self.BtnCardHigh.Entity) then
				self.cardHighHandler = self.BtnCardHigh.Entity:ConnectEvent(ButtonClickEvent, self.OnClickCardHigh)
			end
			if isvalid(self.BtnCardNum) and isvalid(self.BtnCardNum.Entity) then
				self.cardNumHandler = self.BtnCardNum.Entity:ConnectEvent(ButtonClickEvent, self.OnClickCardNum)
			end
			if isvalid(self.BtnCardCancel) and isvalid(self.BtnCardCancel.Entity) then
				self.cardCancelHandler = self.BtnCardCancel.Entity:ConnectEvent(ButtonClickEvent, self.OnClickCardCancel)
			end
			self:ConnectNumButtons()
			self._armedCard = ""
			self:SetPickerOpen(false)   -- 픽커 닫힌 3장 상태로 시작(라벨/알파 갱신 포함)
		
			-- 상황별 버튼(돌아가기/닫기) 배선 + 시작 숨김.
			self._hudCtx = ""
			if isvalid(self.btnMapBack) and isvalid(self.btnMapBack.Entity) then
				self.btnMapBack.Entity.Enable = false
				self.mapBackHandler = self.btnMapBack.Entity:ConnectEvent(ButtonClickEvent, self.OnClickMapBack)
			end
			if isvalid(self.btnCharClose) and isvalid(self.btnCharClose.Entity) then
				self.btnCharClose.Entity.Enable = false
				self.charCloseHandler = self.btnCharClose.Entity:ConnectEvent(ButtonClickEvent, self.OnClickCharClose)
			end
			-- 완주자 '턴 넘기기' 버튼: 시작 숨김. 멀티 FINISHED_PASS 내 턴에만 OnUpdate가 켠다.
			if isvalid(self.btnPassTurn) and isvalid(self.btnPassTurn.Entity) then
				self.btnPassTurn.Entity.Enable = false
				self.passTurnHandler = self.btnPassTurn.Entity:ConnectEvent(ButtonClickEvent, self.OnClickPassTurn)
			end
			self._lastPassEnable = false
		
			-- 주사위 패널은 Enable로 숨긴다. Visible=false만 쓰면 렌더만 꺼지고 클릭은 살아 있어(문서상 금지 패턴)
			-- 숨겨진 굴리기 버튼이 겹친 '돌아가기'의 클릭을 가로챈다.
			self.DicePanel.Enable = false
			if isvalid(self.turnTimerText) then self.turnTimerText.Enable = false end
		end

	end

	method boolean IsMyTurnNow()
		-- 지금이 로컬 플레이어의 턴인지. 싱글/비활성은 항상 내 턴 취급, 멀티 진행 중이면 현재 턴 유저만 true.
		local mode = _GameModeManager._activeMode
		if mode == "MULTI" then
			if _MultiTurnManager._isActive == false then return true end
			local lp = _UserService.LocalPlayer
			if isvalid(lp) == false or lp.PlayerComponent == nil then return false end
			return lp.PlayerComponent.UserId == _MultiTurnManager._currentPlayerUserId
		end
		return true
	end

	method void UpdateTurnTimerText(number delta)
		-- 중앙 상단 텍스트: (1) 배낭 차단 안내가 남아있으면 우선 표시, (2) 아니면 내 턴 남은시간(멀티) 표시, (3) 그 외 숨김.
		if isvalid(self.turnTimerText) == false then return end
		local tc = self.turnTimerText:GetComponent("MOD.Core.TextComponent")
		local show = false
		local msg = ""
		if self._blockMsgLeft > 0 and self._blockMsg ~= "" then
			self._blockMsgLeft -= delta
			show = true
			msg = self._blockMsg
		elseif _GameModeManager._activeMode == "MULTI"
			and _MultiTurnManager._isActive and _MultiTurnManager._turnTimerActive
			and _MultiTurnManager._turnSecondsLeft > 0 then
			-- 남은 시간은 모든 유저에게 표시(actor뿐 아니라 관전자도). 내 턴이면 "남은 시간", 남의 턴이면 상대 턴 남은 시간임을 구분.
			show = true
			if self:IsMyTurnNow() then
				msg = "남은 시간 " .. tostring(_MultiTurnManager._turnSecondsLeft) .. "초"
			else
				msg = "상대 턴 " .. tostring(_MultiTurnManager._turnSecondsLeft) .. "초"
			end
		end
		if show and tc ~= nil then tc.Text = msg end
		if self.turnTimerText.Enable ~= show then self.turnTimerText.Enable = show end
	end

	method void OnEndPlay()
		if not self:IsServer() then
					if self.openHandler ~= nil then
						self.OpenDicePanelButton.Entity:DisconnectEvent(ButtonClickEvent, self.openHandler)
					end
					if self.rollHandler ~= nil then
						self.RollDiceButton.Entity:DisconnectEvent(ButtonClickEvent, self.rollHandler)
					end
					if self.closeHandler ~= nil then
						self.CloseDicePanelButton.Entity:DisconnectEvent(ButtonClickEvent, self.closeHandler)
					end
					if self.mapHandler ~= nil and isvalid(self.MapViewButton.Entity) then
						self.MapViewButton.Entity:DisconnectEvent(ButtonClickEvent, self.mapHandler)
					end
					if self.charInfoHandler ~= nil and isvalid(self.CharInfoButton.Entity) then
						self.CharInfoButton.Entity:DisconnectEvent(ButtonClickEvent, self.charInfoHandler)
					end
					if self.bagHandler ~= nil and isvalid(self.BagButton.Entity) then
						self.BagButton.Entity:DisconnectEvent(ButtonClickEvent, self.bagHandler)
					end
					if self.cardLowHandler ~= nil and isvalid(self.BtnCardLow) and isvalid(self.BtnCardLow.Entity) then
						self.BtnCardLow.Entity:DisconnectEvent(ButtonClickEvent, self.cardLowHandler)
					end
					if self.cardHighHandler ~= nil and isvalid(self.BtnCardHigh) and isvalid(self.BtnCardHigh.Entity) then
						self.BtnCardHigh.Entity:DisconnectEvent(ButtonClickEvent, self.cardHighHandler)
					end
					if self.cardNumHandler ~= nil and isvalid(self.BtnCardNum) and isvalid(self.BtnCardNum.Entity) then
						self.BtnCardNum.Entity:DisconnectEvent(ButtonClickEvent, self.cardNumHandler)
					end
					if self.cardCancelHandler ~= nil and isvalid(self.BtnCardCancel) and isvalid(self.BtnCardCancel.Entity) then
						self.BtnCardCancel.Entity:DisconnectEvent(ButtonClickEvent, self.cardCancelHandler)
					end
					if self.numHandlers ~= nil then
						for _, rec in ipairs(self.numHandlers) do
							if isvalid(rec.entity) then
								rec.entity:DisconnectEvent(ButtonClickEvent, rec.eventHandler)
							end
						end
						self.numHandlers = nil
					end
					if self.mapBackHandler ~= nil and isvalid(self.btnMapBack) and isvalid(self.btnMapBack.Entity) then
						self.btnMapBack.Entity:DisconnectEvent(ButtonClickEvent, self.mapBackHandler)
					end
					if self.charCloseHandler ~= nil and isvalid(self.btnCharClose) and isvalid(self.btnCharClose.Entity) then
						self.btnCharClose.Entity:DisconnectEvent(ButtonClickEvent, self.charCloseHandler)
					end
					if self.passTurnHandler ~= nil and isvalid(self.btnPassTurn) and isvalid(self.btnPassTurn.Entity) then
						self.btnPassTurn.Entity:DisconnectEvent(ButtonClickEvent, self.passTurnHandler)
					end
				end
	end

	property boolean _lastMyDiceTurn = false

	method void OnUpdate(number delta)
		-- 패널이 자체 닫기 버튼/ESC 등 UnderButton을 거치지 않고 닫혔을 때,
		-- openExclusive가 "BAG"/"CHAR"로 남아 주사위 차단·토글 오작동을 일으킨다.
		-- 매 프레임 실제 패널 isOpen과 동기화해 desync를 제거한다.
		if self:IsClient() == false then return end

		-- 중앙 상단 턴 안내(남은시간 / 배낭 차단 안내) 갱신.
		self:UpdateTurnTimerText(delta)

		-- 카드 버튼: 주사위 패널이 열려 있는 동안 보유 수/장전 상태를 주기적으로 갱신(굴림 소비/지급 반영).
		if isvalid(self.DicePanel) and self.DicePanel.Enable then
			self._cardPollTimer = self._cardPollTimer + delta
			if self._cardPollTimer >= 0.25 then
				self._cardPollTimer = 0
				-- 서버 장전 상태로 재동기화(인벤에서 사용/굴림 소비 등 외부 변화 반영).
				-- 단 방금 클릭했다면 아직 서버 왕복 전이라 낙관값을 유지한다.
				if self:WithinCardSyncHold() == false then
					self._armedCard = self:ArmedCard()
				end
				self:UpdateCardButtons()
			end
		end

		-- 캐릭터 정보 패널(Ctrl)은 숨겨진 UIGroup 내부라 자체 OnUpdate가 tick되지 않는다.
		-- 항상 tick하는 이 HUD가 열린 동안의 라이브 갱신(스탯/장비 변경 폴링, 우클릭 메뉴 엣지)을 대신 구동한다.
		-- → 올스탯 +10 같은 이벤트가 패널이 열린 채로 발생해도 즉시 반영된다.
		if isvalid(self.charPanel) then self.charPanel:TickWhileOpen(delta) end
		if self.openExclusive == "BAG" then
			if isvalid(self.invPanel) and self.invPanel.isOpen == false then
				self.openExclusive = ""
			end
		elseif self.openExclusive == "CHAR" then
			if isvalid(self.charPanel) and self.charPanel.isOpen == false then
				self.openExclusive = ""
			end
		end
		
		-- 주사위 버튼 자리에 상황별 버튼을 보이고(맵뷰=돌아가기 / 캐릭터정보=닫기), 주사위 버튼은 숨긴다.
		-- 상태 변할 때만 적용(매 프레임 Enable 쓰기 방지).
		local ctx = "none"
		if _MapViewManager ~= nil and _MapViewManager._isOpen then
			ctx = "map"
		elseif self.openExclusive == "CHAR" then
			ctx = "char"
		end
		if ctx ~= self._hudCtx then
			self._hudCtx = ctx
			self:ApplyHudContext(ctx)
		end
		
		-- 내 주사위 차례가 '막 시작'했는데 배낭/캐릭터정보가 열려 있으면 자동으로 닫는다.
		-- (HUD가 인벤 위에 그려져 주사위 버튼이 인벤 닫기(빨간)버튼을 덮어 '못 닫는' 문제를 근본 차단.)
		local myDice = self:IsMyDiceTurn()
		if myDice and self._lastMyDiceTurn == false and self:IsExclusiveOpen() then
			self:CloseExclusive()
		end
		self._lastMyDiceTurn = myDice

		-- 주사위(열기) 버튼 활성/비활성: 굴릴 수 있는 상태(내 DICE 차례 · 굴리는 중 아님 · 맵/캐릭터뷰 아님)에서만 활성.
		-- 주사위를 굴리면 DICE 단계를 벗어나 자동으로 비활성 → 다음 DICE 차례에 다시 활성된다.
		local wantDice = (ctx == "none") and self:CanOpenDicePanel()
		if self._lastDiceEnable ~= wantDice then
			self._lastDiceEnable = wantDice
			if isvalid(self.OpenDicePanelButton) and isvalid(self.OpenDicePanelButton.Entity) then
				self.OpenDicePanelButton.Entity.Enable = wantDice
			end
		end

		-- 완주자 '턴 넘기기' 버튼: 최종 맵 완주자 내 턴(FINISHED_PASS)에서만, 맵/캐릭터뷰가 아닐 때 노출.
		-- (이 상태에선 주사위 열기 버튼은 CanOpenDicePanel=false라 자동으로 숨겨져 자리 충돌 없음.)
		local wantPass = (ctx == "none") and self:IsMyFinishedPassTurn()
		if self._lastPassEnable ~= wantPass then
			self._lastPassEnable = wantPass
			if isvalid(self.btnPassTurn) and isvalid(self.btnPassTurn.Entity) then
				self.btnPassTurn.Entity.Enable = wantPass
			end
		end
	end

	method void ApplyHudContext(string ctx)
		-- ctx: "map"=돌아가기만 / "char"=닫기만 / "none"=주사위 버튼 복원.
		if isvalid(self.btnMapBack) and isvalid(self.btnMapBack.Entity) then
			self.btnMapBack.Entity.Enable = (ctx == "map")
		end
		if isvalid(self.btnCharClose) and isvalid(self.btnCharClose.Entity) then
			self.btnCharClose.Entity.Enable = (ctx == "char")
		end
		-- 주사위(열기) 버튼은 상황별 버튼이 뜰 때 숨긴다. 맵뷰는 SetHudHidden도 끄지만 일관되게 여기서도 처리.
		-- (주사위 열기 버튼 Enable은 OnUpdate에서 CanOpenDicePanel 상태에 맞춰 관리 → 여기서 처리하지 않음)
	end

	method void OnClickMapBack(any event)
		-- 맵뷰 '돌아가기' → 맵뷰 닫기.
		_SFXManager:PlayClick()
		if _MapViewManager ~= nil then _MapViewManager:CloseMapView() end
	end

	method void OnClickCharClose(any event)
		-- 캐릭터 정보 '닫기' → 캐릭터 정보 패널 닫기(배타 상태 해제).
		_SFXManager:PlayClick()
		self:CloseExclusive()
	end

	method void OnClickPassTurn(any event)
		-- 최종 맵 완주자 '턴 넘기기' → 서버에 턴 종료 요청(다음 플레이어로 진행).
		if self:IsMyFinishedPassTurn() == false then return end
		_SFXManager:PlayClick()
		_MultiTurnManager:RequestFinishedPassTurn()
	end

	method boolean IsMyFinishedPassTurn()
		-- 지금이 '내가 최종 맵 완주자로서 턴 넘기기를 눌러야 하는' 상태인지.
		-- 멀티 진행 중 + 현재 상태 FINISHED_PASS + 현재 턴 유저가 나 일 때만 true.
		if _GameModeManager._activeMode ~= "MULTI" then return false end
		if _MultiTurnManager._isActive == false then return false end
		if _MultiTurnManager._currentState ~= "FINISHED_PASS" then return false end
		local lp = _UserService.LocalPlayer
		if isvalid(lp) == false or lp.PlayerComponent == nil then return false end
		return lp.PlayerComponent.UserId == _MultiTurnManager._currentPlayerUserId
	end

	method void OnDicePanelClickOpen(any event)
		_SFXManager:PlayClick()
		if self:CanOpenDicePanel() == false then
					return   -- 주사위 차례가 아니면 패널 안 열림
				end
				-- 주사위 패널 열기 전 맵 뷰 닫기
				_MapViewManager:CloseMapView()
				self.DicePanel.Enable = true
				self.WholePanel.Enable = false
				-- 카드 버튼 보유 수/장전 상태를 최신으로(서버 장전값 반영). 이전 클릭의 유예는 만료 처리.
				self._cardActAt = -100
				self._cardArmAt = -100
				self._armedCard = self:ArmedCard()
				self:SetPickerOpen(false)   -- 항상 3장 화면으로 열린다
	end

	method void OnClickRoll(any event)
		-- 주사위 로직 발동
		_SFXManager:PlayClick()
		_SingleTurnManager:RequestRollDice()
		_MultiTurnManager:RequestRollDice()

		-- 굴렸으니 카드 장전 표시 해제(서버 고정값은 이번 굴림에 소비됨).
		self._armedCard = ""
		self._cardActAt = -100
		self._cardArmAt = -100
		self:SetPickerOpen(false)

		self.DicePanel.Enable = false
		self.WholePanel.Enable = true
	end

	method void OnClickCardLow(any event)
		-- 낮은 숫자 카드 사용 → 다음 이동 주사위를 1~6 범위 랜덤으로 고정.
		self:UseDiceCard("low")
	end

	method void OnClickCardHigh(any event)
		-- 높은 숫자 카드 사용 → 다음 이동 주사위를 7~12 범위 랜덤으로 고정.
		self:UseDiceCard("high")
	end

	method void ConnectNumButtons()
		-- 1~12 픽커 버튼 구독. DicePanel(=UnderButton_Panel_Dice) 직속 자식 BtnNum1..BtnNum12를 이름으로 찾는다.
		-- 클로저로 숫자를 캡처해 핸들러 12개를 따로 만들지 않는다.
		self.numHandlers = {}
		if isvalid(self.DicePanel) == false then return end
		for i = 1, 12 do
			local e = self.DicePanel:GetChildByName("BtnNum" .. tostring(i))
			if isvalid(e) then
				local n = i
				local h = e:ConnectEvent(ButtonClickEvent, function() self:OnClickNum(n) end)
				table.insert(self.numHandlers, { entity = e, eventHandler = h })
			end
		end
	end

	method boolean IsNumKey(string key)
		-- "num1".."num12"(확정 숫자 카드)인지.
		if key == nil or key == "" then return false end
		return string.sub(key, 1, 3) == "num"
	end

	method integer NumCardTotal()
		-- 보유한 확정 숫자 카드(num1~num12) 총 장수. 0이면 픽커를 열어도 고를 게 없다.
		local total = 0
		for i = 1, 12 do
			total = total + self:CardCount("num" .. tostring(i))
		end
		return total
	end

	method void SetBtnEnable(ButtonComponent btn, boolean on)
		-- 버튼 엔티티 표시/숨김. 상태가 바뀔 때만 쓴다.
		if isvalid(btn) == false or isvalid(btn.Entity) == false then return end
		if btn.Entity.Enable ~= on then btn.Entity.Enable = on end
	end

	method void SetPickerOpen(boolean open)
		-- 1~12 픽커 열기/닫기. 열리면 3장(낮은/확정/높은)을 숨기고 픽커 + '취소하기'를 보인다.
		self._pickerOpen = open
		self:SetBtnEnable(self.BtnCardLow, open == false)
		self:SetBtnEnable(self.BtnCardHigh, open == false)
		self:SetBtnEnable(self.BtnCardNum, open == false)
		self:SetBtnEnable(self.BtnCardCancel, open)
		if isvalid(self.DicePanel) then
			for i = 1, 12 do
				local e = self.DicePanel:GetChildByName("BtnNum" .. tostring(i))
				if isvalid(e) and e.Enable ~= open then e.Enable = open end
			end
		end
		self:UpdateCardButtons()
	end

	method void OnClickCardNum(any event)
		-- 중앙 '확정 숫자 카드': 이미 숫자 카드가 적용중이면 해제, 아니면 1~12 픽커를 연다.
		-- (해제한 뒤 다시 누르면 미적용 상태라 픽커가 다시 열린다.)
		if self:IsMyDiceTurn() == false then return end
		local armed = self:EffectiveArmed()
		if self:IsNumKey(armed) then
			self:UseDiceCard(armed)   -- 같은 카드 재클릭 = 해제(더블클릭 유예 적용)
			return
		end
		if self:NumCardTotal() <= 0 then
			_SFXManager:PlayClick()
			self:ShowHudMessage("보유한 숫자 카드가 없어요")
			return
		end
		_SFXManager:PlayClick()
		self:SetPickerOpen(true)
	end

	method void OnClickCardCancel(any event)
		-- 픽커 '취소하기': 아무것도 고르지 않고 3장 화면으로 돌아간다(적용 상태는 그대로).
		_SFXManager:PlayClick()
		self:SetPickerOpen(false)
	end

	method void OnClickNum(integer n)
		-- 픽커에서 숫자 선택 → 그 숫자 카드 적용 후 3장 화면으로 복귀. 미보유 카드는 적용하지 않는다.
		if self:IsMyDiceTurn() == false then return end
		local key = "num" .. tostring(n)
		if self:CardCount(key) <= 0 then
			_SFXManager:PlayClick()
			self:ShowHudMessage(tostring(n) .. " 카드가 없어요")
			return
		end
		self:UseDiceCard(key)
		self:SetPickerOpen(false)
	end

	method void UpdateNumButtons()
		-- 픽커 버튼 1~12: 보유 중이면 원래 색, 없으면 반투명(사용 불가).
		if isvalid(self.DicePanel) == false then return end
		for i = 1, 12 do
			local e = self.DicePanel:GetChildByName("BtnNum" .. tostring(i))
			if isvalid(e) then
				local count = self:CardCount("num" .. tostring(i))
				local spr = e.SpriteGUIRendererComponent
				if spr ~= nil then
					local c = spr.Color
					local a = 1.0
					if count <= 0 then a = 0.25 end
					spr.Color = Color(c.r, c.g, c.b, a)
				end
			end
		end
	end

	method void UpdateNumCardButton()
		-- 중앙 '확정 숫자 카드' 갱신.
		--  적용중(numN) → 알파 1.0 + 라벨 "N 카드 / 적용중"
		--  숫자카드 0장 → 알파 0.25(픽커를 열어도 고를 게 없음)
		--  다른 카드(낮은/높은)가 적용중 → 알파 0.35(반투명)
		local btn = self.BtnCardNum
		if isvalid(btn) == false or isvalid(btn.Entity) == false then return end
		local armed = self._armedCard
		local isArmed = self:IsNumKey(armed)
		local tc = btn.Entity:GetComponent("MOD.Core.TextComponent")
		if tc ~= nil then
			if isArmed then
				local def = _ItemDiceCardManager:CardDef(armed)
				local nm = armed
				if def ~= nil then nm = def.name end   -- "N 카드"
				tc.Text = nm .. "\n적용중"
			else
				-- 낮은/높은 카드처럼 보유 수를 표기한다. 0장이면 반투명(아래)과 함께 '사용 불가'가 분명해진다.
				tc.Text = "확정 숫자\n" .. tostring(self:NumCardTotal()) .. "장"
			end
			tc.FontSize = 22
		end
		local spr = btn.Entity.SpriteGUIRendererComponent
		if spr ~= nil then
			local c = spr.Color
			local a = 1.0
			if isArmed then
				a = 1.0
			elseif self:NumCardTotal() <= 0 then
				a = 0.25
			elseif armed ~= "" then
				a = 0.35
			end
			spr.Color = Color(c.r, c.g, c.b, a)
		end
	end

	method integer CardCount(string cardKey)
		-- 로컬 플레이어의 카드 보유 수(없으면 0). DiceCardInventory @TargetUserSync 값을 읽는다.
		local p = _UserService.LocalPlayer
		if isvalid(p) == false then return 0 end
		local inv = p:GetComponent("script.DiceCardInventory")
		if isvalid(inv) == false then return 0 end
		return inv:GetCount(cardKey)
	end

	method string ArmedCard()
		-- 현재 장전된 카드(서버 권위, DiceCardInventory.ArmedCard 동기값). 없으면 "".
		-- 주사위 패널 버튼/인벤 어디서 장전했든 일관되게 반영된다.
		local p = _UserService.LocalPlayer
		if isvalid(p) == false then return "" end
		local inv = p:GetComponent("script.DiceCardInventory")
		if isvalid(inv) == false then return "" end
		return inv.ArmedCard
	end

	method boolean WithinCardSyncHold()
		-- 방금 카드를 조작해 아직 서버 왕복이 끝나지 않았을 구간인지.
		return (_UtilLogic.ElapsedSeconds - self._cardActAt) < 0.6
	end

	method boolean WithinCardArmHold()
		-- 방금 적용한 직후(=더블클릭의 두 번째 클릭이 들어올 만한) 구간인지.
		return (_UtilLogic.ElapsedSeconds - self._cardArmAt) < 0.5
	end

	method string EffectiveArmed()
		-- 적용 상태 판정값. 방금 클릭한 직후엔 서버 왕복 전이라 로컬 낙관값이 정답이고,
		-- 그 뒤엔 서버 권위값(DiceCardInventory.ArmedCard)을 따른다.
		if self:WithinCardSyncHold() then return self._armedCard end
		return self:ArmedCard()
	end

	method void UseDiceCard(string cardKey)
		-- 카드 사용 공통 처리: 내 DICE 차례에서만.
		-- 다른 카드 클릭=교체 적용 / 같은 카드 재클릭=적용 취소. 단 방금 적용한 직후의 재클릭은
		-- 무시한다 — 더블클릭이 '적용→취소'로 상쇄돼 아무것도 안 걸리는 것을 막는다.
		if self:IsMyDiceTurn() == false then return end
		if self:EffectiveArmed() == cardKey then
			if self:WithinCardArmHold() then return end   -- 더블클릭의 두 번째 클릭 → 적용 유지
			-- 의도적 재클릭 → 적용 취소. 아직 굴리지 않았으니 소비 없음.
			_SFXManager:PlayClick()
			self._armedCard = ""
			self._cardActAt = _UtilLogic.ElapsedSeconds
			_ItemDiceCardManager:ClearCard()
		else
			-- 새로 적용: 보유 0이면 사용 불가(적용 안 함) + 이유를 안내한다.
			if self:CardCount(cardKey) <= 0 then
				_SFXManager:PlayClick()
				self:ShowHudMessage("보유한 카드가 없어요")
				return
			end
			_SFXManager:PlayClick()
			self._armedCard = cardKey
			self._cardActAt = _UtilLogic.ElapsedSeconds
			self._cardArmAt = _UtilLogic.ElapsedSeconds
			_ItemDiceCardManager:UseCard(cardKey)
		end
		self:UpdateCardButtons()
	end

	method void UpdateCardButtons()
		-- 카드 UI 갱신. 픽커가 열린 동안엔 3장이 숨겨져 있으므로 픽커 쪽만 갱신한다.
		if self._pickerOpen then
			self:UpdateNumButtons()
			return
		end
		self:SetCardButton(self.BtnCardLow, "낮은 1-6", "low")
		self:SetCardButton(self.BtnCardHigh, "높은 7-12", "high")
		self:UpdateNumCardButton()
	end

	method void SetCardButton(ButtonComponent btn, string baseLabel, string cardKey)
		-- 카드 버튼 1개 갱신.
		-- 적용중  → 알파 1.0(선명) + 라벨 "적용중"   ← 어느 카드가 걸렸는지 한눈에
		-- 다른 카드가 적용중 → 알파 0.35(반투명)     ← 이 카드는 지금 안 걸림
		-- 보유 0장 → 알파 0.25(가장 흐림)            ← 클릭해도 사용 불가
		-- 그 외(아무것도 안 걸림) → 알파 1.0
		if isvalid(btn) == false or isvalid(btn.Entity) == false then return end
		local count = self:CardCount(cardKey)
		local armed = self._armedCard
		local isArmed = (armed == cardKey)
		local tc = btn.Entity:GetComponent("MOD.Core.TextComponent")
		if tc ~= nil then
			if isArmed then
				tc.Text = baseLabel .. "\n적용중"
			else
				tc.Text = baseLabel .. "\n" .. tostring(count) .. "장"
			end
			tc.FontSize = 22
		end
		local spr = btn.Entity.SpriteGUIRendererComponent
		if spr ~= nil then
			local c = spr.Color
			local a = 1.0
			if isArmed then
				a = 1.0
			elseif count <= 0 then
				a = 0.25
			elseif armed ~= "" then
				a = 0.35
			end
			spr.Color = Color(c.r, c.g, c.b, a)
		end
	end

	method void OnDicePanelClickClose(any event)
		_SFXManager:PlayClick()
		self:SetPickerOpen(false)   -- 다음에 열 때 3장 화면부터 시작
		self.DicePanel.Enable = false
		self.WholePanel.Enable = true
	end

	method void OnClickMap(any event)
		_SFXManager:PlayClick()
		if not self:CanOpenDicePanel() then return end
		_MapViewManager:Toggle()
	end

	method void OnClickCharInfo(any event)
		-- 캐릭터 정보 토글(배낭과 상호배타).
		-- 주사위 결과 연출 중엔 새로 열지 않는다(주사위 그룹이 위에 떠 닫기 버튼을 가림).
		if self.openExclusive ~= "CHAR" and self:IsDiceResultShowing() then return end
		_SFXManager:PlayClick()
		if self.openExclusive == "CHAR" then
			self:CloseExclusive()
		else
			self:CloseExclusive()
			self.openExclusive = "CHAR"
			if isvalid(self.charPanel) then self.charPanel:Open() end
		end
	end

	method void OnClickBag(any event)
		-- 배낭 토글(캐릭터 정보와 상호배타).
		-- 주사위 결과 연출 중엔 새로 열지 않는다(주사위 그룹이 위에 떠 닫기 버튼을 가림).
		if self.openExclusive ~= "BAG" and self:IsDiceResultShowing() then return end
		-- 자기 턴이 아니면 배낭을 아예 열 수 없다(이미 열려 있으면 닫기는 허용). 남은 큐브/장비 조작은 내 턴에만.
		if self.openExclusive ~= "BAG" and self:IsMyTurnNow() == false then
			_SFXManager:PlayClick()
			self:ShowHudMessage("내 턴에만 배낭을 열 수 있어요")
-- 			log("[UnderButton] 내 턴이 아니라 배낭 열기 차단")
			return
		end
		_SFXManager:PlayClick()
		if self.openExclusive == "BAG" then
			self:CloseExclusive()
		else
			self:CloseExclusive()
			self.openExclusive = "BAG"
			if isvalid(self.invPanel) then self.invPanel:Open() end
		end
	end

	method void CloseExclusive()
		-- 열린 배타 패널을 닫는다.
		if isvalid(self.charPanel) then self.charPanel:Close() end
		if isvalid(self.invPanel) then self.invPanel:Close() end
		self.openExclusive = ""
	end

	method boolean IsExclusiveOpen()
		-- 캐릭터정보/배낭 중 하나라도 열려 있으면 true.
		return self.openExclusive ~= ""
	end

	method boolean IsMyDiceTurn()
		-- 내 DICE 차례(굴리는 중 아님)인지. CanOpenDicePanel에서 '배타패널 열림' 가드만 뺀 버전.
		local mode = _GameModeManager._activeMode
		if mode == "SINGLE" then
			return _SingleTurnManager._currentState == "DICE" and _SingleTurnManager._isRolling == false
		elseif mode == "MULTI" then
			if _MultiTurnManager._currentState ~= "DICE" then return false end
			if _MultiTurnManager._isRolling then return false end
			local lp = _UserService.LocalPlayer
			if isvalid(lp) == false then return false end
			return lp.PlayerComponent.UserId == _MultiTurnManager._currentPlayerUserId
		end
		return false
	end

	method boolean CanOpenDicePanel()
		-- 캐릭터정보/배낭 패널이 열려 있으면 주사위 열기 차단.
		if self:IsExclusiveOpen() then return false end
		
		local mode = _GameModeManager._activeMode
		
				if mode == "SINGLE" then
					-- 싱글: DICE 단계 + 굴리는 중이 아니어야 OK (연출 중 재오픈 차단)
					return _SingleTurnManager._currentState == "DICE" and _SingleTurnManager._isRolling == false
		
				elseif mode == "MULTI" then
					-- 멀티: DICE 단계 + 굴리는 중 아님 + 내가 현재 턴 플레이어여야 함
					if _MultiTurnManager._currentState ~= "DICE" then
						return false
					end
					if _MultiTurnManager._isRolling then
						return false
					end
					local lp = _UserService.LocalPlayer
					if isvalid(lp) == false then return false end
					local myUserId = lp.PlayerComponent.UserId
					return myUserId == _MultiTurnManager._currentPlayerUserId
				end
		
				-- 그 외(NONE 등): 못 엶
				return false
	end

	method boolean IsDiceResultShowing()
		-- 주사위 결과 연출 패널(ResultDicetUIGroup)이 현재 떠 있는지 라이브 상태로 판단(플래그 desync 없음).
		if _RollResultDiceAnimationUI == nil then return false end
		local p = _RollResultDiceAnimationUI.panel
		return isvalid(p) and p.Enable
	end

	@ExecSpace("ServerOnly")
	method void OnInitialize()
		-- 여기서 table을 매핑
	end

end