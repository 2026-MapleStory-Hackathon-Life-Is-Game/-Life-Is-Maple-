@Component
script UnderButton extends Component

	property any openHandler = nil

	property any rollHandler = nil

	property any closeHandler = nil

	property any mapHandler = nil

	property ButtonComponent OpenDicePanelButton = "64eadf42-ab0c-4d9c-99f4-9da65935f7d1"

	property ButtonComponent RollDiceButton = "859b1f3d-8c48-4216-b425-18e45ef436bd"

	property ButtonComponent CloseDicePanelButton = "fbabd9a0-bb4d-47be-bcf0-d8625ee61e1c"

	property ButtonComponent MapViewButton = "f4d5b8f1-b4f3-48f2-a9d4-e113e1204abe"

	property Entity WholePanel = "f6591a77-568d-41c8-b6f0-b4721629787f"

	property Entity DicePanel = "3cf2b530-e75e-4041-8925-4e4e2c4f96f1"

	method void OnBeginPlay()
		if self:IsServer() then
		
		else
			-- 클라이언트: 버튼 이벤트 구독, 반환된 핸들을 저장
			self.openHandler = self.OpenDicePanelButton.Entity:ConnectEvent(ButtonClickEvent,self.OnDicePanelClickOpen)
			self.rollHandler = self.RollDiceButton.Entity:ConnectEvent(ButtonClickEvent,self.OnClickRoll)
			self.closeHandler = self.CloseDicePanelButton.Entity:ConnectEvent(ButtonClickEvent,self.OnDicePanelClickClose)
			if isvalid(self.MapViewButton.Entity) then
				self.mapHandler = self.MapViewButton.Entity:ConnectEvent(ButtonClickEvent, self.OnClickMap)
			end
		
			self.DicePanel.Visible = false
		end
		
	end

	method void OnEndPlay()
		if not self:IsServer() then
					if self.openHandler ~= nil then
						self.OpenDicePanelButton.Entity:DisconnectEvent(ButtonClickEvent, self.openHandler)
					end
					if self.rollHandler ~= nil then
						self.RollDiceButton.Entity:DisconnectEvent(ButtonClickEvent, self.rollHandler)
					end
					if self.closeHandler ~= nil then
						self.CloseDicePanelButton.Entity:DisconnectEvent(ButtonClickEvent, self.closeHandler)
					end
					if self.mapHandler ~= nil and isvalid(self.MapViewButton.Entity) then
						self.MapViewButton.Entity:DisconnectEvent(ButtonClickEvent, self.mapHandler)
					end
				end
	end

	method void OnDicePanelClickOpen(any event)
		_SFXManager:PlayClick()
		if self:CanOpenDicePanel() == false then
					return   -- 주사위 차례가 아니면 패널 안 열림
				end
				-- 주사위 패널 열기 전 맵 뷰 닫기
				_MapViewManager:CloseMapView()
				self.DicePanel.Visible = true
				self.WholePanel.Visible = false
	end

	method void OnClickRoll(any event)
		-- 주사위 로직 발동
		_SFXManager:PlayClick()
		_SingleTurnManager:RequestRollDice()
		_MultiTurnManager:RequestRollDice()
		
		self.DicePanel.Visible = false
		self.WholePanel.Visible = true
	end

	method void OnDicePanelClickClose(any event)
		_SFXManager:PlayClick()
		self.DicePanel.Visible = false
		self.WholePanel.Visible = true
	end

	method void OnClickMap(any event)
		_SFXManager:PlayClick()
		if not self:CanOpenDicePanel() then return end
		_MapViewManager:Toggle()
	end

	method boolean CanOpenDicePanel()
		local mode = _GameModeManager._activeMode
		
				if mode == "SINGLE" then
					-- 싱글: DICE 단계 + 굴리는 중이 아니어야 OK (연출 중 재오픈 차단)
					return _SingleTurnManager._currentState == "DICE" and _SingleTurnManager._isRolling == false
		
				elseif mode == "MULTI" then
					-- 멀티: DICE 단계 + 굴리는 중 아님 + 내가 현재 턴 플레이어여야 함
					if _MultiTurnManager._currentState ~= "DICE" then
						return false
					end
					if _MultiTurnManager._isRolling then
						return false
					end
					local myUserId = _UserService.LocalPlayer.PlayerComponent.UserId
					return myUserId == _MultiTurnManager._currentPlayerUserId
				end
		
				-- 그 외(NONE 등): 못 엶
				return false
	end

	@ExecSpace("ServerOnly")
	method void OnInitialize()
		-- 여기서 table을 매핑
	end

end