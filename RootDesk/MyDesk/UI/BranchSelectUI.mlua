@Logic
script BranchSelectUI extends Logic

	property Entity panel = "13367a9a-0361-4ca5-8c7e-f472404b1edf"

	property ButtonComponent Btn_1 = "62e3d5e3-4d0f-461c-b9db-e22cbf3f3b95"

	property ButtonComponent Btn_2 = "4451329f-7cc4-4731-babb-184b16c137e7"

	property ButtonComponent Btn_3 = "025339b8-ccdc-4df8-b998-693ba9e1371a"

	property ButtonComponent Btn_4 = "369b9a2a-e947-462e-88b5-d441abf77e20"

	property ButtonComponent Btn_5 = "bfb77a28-b8f8-426c-a83f-50cdca47fa4b"

	property Entity dimBack = "2c4d55ed-32eb-4b7d-9d33-94f4b9a680a8"

	property ButtonComponent mapViewBtn = "a634fbcb-3d75-4fbc-8e41-f88aaff25061"

	property Entity btnContainer = "f28fbe30-6756-4318-94bb-ad3a3a13d8d5"

	property Entity title = "71b7d146-018c-4089-bfb3-54b381c294d4"

	property Entity helpButton = "54f67d67-f85c-401a-a6ce-dc8a318a5f01"

	property table choiceTiles = {}

	property table handlers = {}

	property integer _remaining = 0

	property table _branchLabels = {}

	property boolean _previewOpen = false

	property any mapBtnHandler = nil

	property string _defaultTitle = ""

	@ExecSpace("ClientOnly")
	method void OnBeginPlay()
		if isvalid(self.panel) then
		  self.panel.Enable = false
		end
		-- 관전 알림에서 제목을 덮어쓰므로, 기본 제목 문구를 저장해 둔다(actor Show에서 복원).
		if isvalid(self.title) then
			local tc = self.title:GetComponent("MOD.Core.TextComponent")
			if tc ~= nil then self._defaultTitle = tc.Text end
		end
		-- 맵 미리보기 버튼은 정적이므로 한 번만 배선(분기 버튼은 Show마다 재배선).
		if isvalid(self.mapViewBtn) then
			self.mapBtnHandler = self.mapViewBtn.Entity:ConnectEvent(ButtonClickEvent, function()
				self:OnMapViewPressed()
			end)
		end
	end

	@ExecSpace("ClientOnly")
	method void Show(table tileNames, table branchTexts, integer remaining)
		-- 분기 선택창 표시. remaining = 분기 시점의 남은 주사위 수(각 분기 도착 칸 예측에 사용).
		log("BranchUI Show 진입! panel valid=" .. tostring(isvalid(self.panel)))
		self:DisconnectAll()   -- 재오픈 시 중복 구독 방지: 기존 핸들러를 먼저 끊는다.
		if isvalid(self.panel) == false then return end
		-- 이전 맵 미리보기 잔재가 있으면 콘텐츠를 정상 표시 상태로 복원한다.
		self:SetPreviewMode(false)
		if isvalid(self.dimBack) then self.dimBack.Enable = true end
		self.panel.Enable = true
		-- 이전에 이 클라가 관전 알림으로 제목을 바꿨을 수 있으니 기본 제목을 복원한다.
		self:SetTitleText(self._defaultTitle)
		-- 관전 알림이 숨겨둔 선택 버튼/맵/도움말은 SetPreviewMode(false)가 이미 복원함.
		log("패널 켜짐, count=" .. #tileNames)
		
		self.choiceTiles = tileNames
		self._branchLabels = branchTexts
		self._remaining = remaining
		
		-- 도착 예측을 위해 클라 타일 그래프 확보(맵뷰와 동일 패턴).
		if next(_TileManager.tileGraph) == nil then _TileManager:BuildTileGraph() end
		local map = ""
		local me = _UserService.LocalPlayer
		if isvalid(me) then map = me.CurrentMapName end
		
		local buttons = {self.Btn_1, self.Btn_2, self.Btn_3, self.Btn_4, self.Btn_5}
		local count = #tileNames
		
		for i = 1, 5 do
			local btn = buttons[i]
			if i <= count then
				log("버튼 " .. i .. " 활성화 시도")
				btn.Entity.Enable = true
				if isvalid(btn.ButtonComponent) then btn.ButtonComponent.Enable = true end   -- 이전 관전(읽기전용) 비활성 잔재 복구
				btn.Entity.TextComponent.Text = branchTexts[i]
				-- 기능 9: 이 분기를 골랐을 때 도착하는 타일의 '종류'를 아이콘+한글명으로 표시.
				self:ShowBranchResult(btn, map, tileNames[i], remaining)
				local tileName = tileNames[i]
				self.handlers[i] = btn.Entity:ConnectEvent(ButtonClickEvent, function()
					self:SelectBranch(tileName)
				end)
			else
				btn.Entity.Enable = false
			end
		end
		log("Show 완료")
	end

	method void ShowBranchResult(ButtonComponent btn, string mapName, string branchTile, integer remaining)
		-- 분기 버튼의 자식 UISprite(아이콘) / UIText(종류명)에 '도착 타일 종류'를 채운다.
		-- 분기 선택 시 그 칸으로 한 칸 이동한 뒤 (remaining-1)칸 더 진행하므로 도착 예측은 (remaining-1)칸.
		local iconEnt = btn.Entity:GetChildByName("UISprite")
		local textEnt = btn.Entity:GetChildByName("UIText")
		local dest = ""
		if mapName ~= "" then dest = _TileManager:PredictLanding(mapName, branchTile, remaining - 1) end
		if dest == "" then
			-- 도중에 또 분기를 만나 도착지가 확정되지 않음 → "?".
			if isvalid(iconEnt) then iconEnt.Enable = false end
			if isvalid(textEnt) and isvalid(textEnt.TextGUIRendererComponent) then
				textEnt.TextGUIRendererComponent.Text = "?"
			end
			return
		end
		local tileType = _TileManager:GetTileType(mapName, dest)
		-- 'Guild' 타일은 내 인생분기(LifePath)에 따라 표시 종류가 갈린다(Romance→연애/Union).
		-- 보드 스프라이트/칸 아이콘(TileManager:LifePathTileArt·TileTypeIconRUID)과 동일 규칙으로 해석해
		-- 아이콘과 한글 텍스트가 어긋나지 않게(예: 연애 아이콘 + "길드" 글자) 맞춘다.
		local displayType = tileType
		if tileType == "Guild" then displayType = _TileManager:LocalLifePathArtType() end
		local ruid = _TileManager:TileTypeIconRUID(displayType)
		if isvalid(iconEnt) then
			local sr = iconEnt.SpriteGUIRendererComponent
			if ruid ~= "" and isvalid(sr) then
				iconEnt.Enable = true
				sr.ImageRUID = DataRef(ruid)
			else
				-- 아이콘 없는 종류(시작/도착 등)는 숨긴다(빈 RUID = 안 보임 방지).
				iconEnt.Enable = false
			end
		end
		if isvalid(textEnt) and isvalid(textEnt.TextGUIRendererComponent) then
			textEnt.TextGUIRendererComponent.Text = self:TypeKorean(displayType)
		end
	end

	method string TypeKorean(string tileType)
		-- 타일 종류 → 분기 버튼에 표시할 한글 이름.
		if tileType == "Start" then return "시작"
		elseif tileType == "Hunt" then return "사냥"
		elseif tileType == "HuntPlus" then return "정예 사냥"
		elseif tileType == "Unlucky" then return "불운"
		elseif tileType == "Boss" then return "보스"
		elseif tileType == "Village" then return "마을"
		elseif tileType == "Guild" then return "길드"
		elseif tileType == "Union" then return "연애"
		elseif tileType == "End" then return "도착"
		end
		return tileType
	end

	@ExecSpace("ClientOnly")
	method void OnMapViewPressed()
		-- 기능 10 토글: 미리보기가 열려 있으면 닫아 분기창으로 복귀, 아니면 도착칸 미리보기를 연다.
		_SFXManager:PlayClick()
		if self._previewOpen then
			_MapViewManager:CloseMapView()   -- CloseMapView가 OnMapPreviewClosed로 분기창을 복원한다.
		else
			self:OpenMapPreview()
		end
	end

	@ExecSpace("ClientOnly")
	method void OpenMapPreview()
		-- 분기창 콘텐츠(맵/도움말 버튼 포함)를 숨기고 보드에서 각 분기 도착 칸을 미리 본다(복귀는 HUD '돌아가기').
		local me = _UserService.LocalPlayer
		if isvalid(me) == false then return end
		local map = me.CurrentMapName
		self:SetPreviewMode(true)
		_MapViewManager:OpenBranchPreview(map, self.choiceTiles, self._branchLabels, self._remaining)
	end

	@ExecSpace("ClientOnly")
	method void OnMapPreviewClosed()
		-- MapViewManager가 미리보기(카메라) 닫힘을 통지 → 분기창 콘텐츠 복원.
		self:SetPreviewMode(false)
	end

	@ExecSpace("ClientOnly")
	method void SetPreviewMode(boolean on)
		-- 미리보기 중에는 배경 딤 / 패널 배경 / 분기 버튼 컨테이너 / 제목 / 맵 버튼 / 도움말 버튼을 모두 숨긴다.
		-- 맵 버튼을 숨겨도 맵뷰 열림 시 HUD에 '돌아가기' 버튼이 뜨므로 그것으로 복귀 → OnMapPreviewClosed에서 다시 켜진다.
		self._previewOpen = on
		local show = not on
		if isvalid(self.dimBack) then self.dimBack.Enable = show end
		if isvalid(self.btnContainer) then self.btnContainer.Enable = show end
		if isvalid(self.title) then self.title.Enable = show end
		if isvalid(self.panel) then
			local bg = self.panel.SpriteGUIRendererComponent
			if isvalid(bg) then bg.Enable = show end
		end
		-- 맵 미리보기가 활성이면 맵 버튼과 도움말 버튼을 감춘다(닫으면 다시 활성).
		if isvalid(self.mapViewBtn) and isvalid(self.mapViewBtn.Entity) then self.mapViewBtn.Entity.Enable = show end
		if isvalid(self.helpButton) then self.helpButton.Enable = show end
	end

	@ExecSpace("ClientOnly")
	method void Hide()
		self:DisconnectAll()
		-- 미리보기가 열린 채로 닫히는 경우 카메라 / HUD도 원복.
		if self._previewOpen then _MapViewManager:CloseMapView() end
		self:SetPreviewMode(false)
		if isvalid(self.panel) then
			self.panel.Enable = false
		end
		if isvalid(self.dimBack) then self.dimBack.Enable = false end
	end

	@ExecSpace("Client")
	method void CloseForAll()
		-- 서버가 분기 확정 시 targetUserId 없이 호출 → 전 클라의 분기창을 강제로 닫는다.
		-- 분기창은 actor에게만 띄우지만, 혹시 다른 클라에 잔재가 남아도 여기서 확실히 닫아 '못 닫는' 상황을 방지.
		-- (관전자의 '분기점 선택 중' 중앙 알림도 같은 패널이라 여기서 함께 닫힌다 — 피드백 13.)
		self:Hide()
	end

	method void SetTitleText(string s)
		-- 분기 패널 제목 텍스트 설정(TextComponent 있을 때만).
		if isvalid(self.title) == false then return end
		local tc = self.title:GetComponent("MOD.Core.TextComponent")
		if tc ~= nil then tc.Text = s end
	end

	@ExecSpace("Client")
	method void SpectatorNotice(table tileNames, table branchTexts, integer remaining, string actorUserId)
		-- 관전자: actor의 분기 선택지를 읽기전용으로 그대로 보여준다(피드백 3). actor는 자기 인터랙티브 선택창을 쓰므로 스킵.
		local lp = _UserService.LocalPlayer
		if isvalid(lp) and lp.PlayerComponent ~= nil and lp.PlayerComponent.UserId == actorUserId then return end
		self:ShowReadOnlyBranch(tileNames, branchTexts, remaining)
	end

	@ExecSpace("ClientOnly")
	method void ShowReadOnlyBranch(table tileNames, table branchTexts, integer remaining)
		-- 관전자용 읽기전용 분기창: actor의 선택지(도착 타일 아이콘+한글명)를 동일하게 채우되
		-- 클릭 핸들러를 걸지 않고 각 버튼 컴포넌트를 비활성화해 누름/호버가 안 되게 한다. 제목은 "어느 쪽으로 갈까?".
		self:DisconnectAll()   -- 이전 구독 잔재 제거(읽기전용이므로 새로 걸지 않음)
		if isvalid(self.panel) == false then return end
		self:SetPreviewMode(false)   -- 미리보기 잔재 정리(버튼/맵/도움말 표시 상태로 리셋)
		if isvalid(self.dimBack) then self.dimBack.Enable = true end
		self.panel.Enable = true
		self:SetTitleText("어느 쪽으로 갈까?")
		-- 선택지 컨테이너는 보이게 유지하되, 관전자는 맵 미리보기/도움말을 못 쓰게 숨긴다.
		if isvalid(self.btnContainer) then self.btnContainer.Enable = true end
		if isvalid(self.mapViewBtn) and isvalid(self.mapViewBtn.Entity) then self.mapViewBtn.Entity.Enable = false end
		if isvalid(self.helpButton) then self.helpButton.Enable = false end

		-- 도착 예측을 위해 클라 타일 그래프 확보(actor Show와 동일). 멀티는 전원 같은 맵이라 관전자 맵=actor 맵.
		if next(_TileManager.tileGraph) == nil then _TileManager:BuildTileGraph() end
		local map = ""
		local me = _UserService.LocalPlayer
		if isvalid(me) then map = me.CurrentMapName end

		local buttons = {self.Btn_1, self.Btn_2, self.Btn_3, self.Btn_4, self.Btn_5}
		local count = #tileNames
		for i = 1, 5 do
			local btn = buttons[i]
			if i <= count then
				btn.Entity.Enable = true
				btn.Entity.TextComponent.Text = branchTexts[i]
				self:ShowBranchResult(btn, map, tileNames[i], remaining)
				if isvalid(btn.ButtonComponent) then btn.ButtonComponent.Enable = false end   -- 읽기전용: 클릭/호버 차단
			else
				btn.Entity.Enable = false
			end
		end
	end

	@ExecSpace("ClientOnly")
	method void ShowNotice(string msg)
		-- 분기 패널을 '읽기전용 중앙 알림'으로 재사용: 딤 + 제목 문구만. 선택 버튼/맵/도움말은 숨겨 상호작용 차단.
		self:DisconnectAll()
		if isvalid(self.panel) == false then return end
		self:SetPreviewMode(false)   -- 미리보기 잔재 정리(버튼/맵/도움말 표시 상태로 리셋)
		if isvalid(self.dimBack) then self.dimBack.Enable = true end
		self.panel.Enable = true
		-- 관전자는 상호작용 불가 → 선택 버튼 컨테이너/맵/도움말 숨김.
		if isvalid(self.btnContainer) then self.btnContainer.Enable = false end
		if isvalid(self.mapViewBtn) and isvalid(self.mapViewBtn.Entity) then self.mapViewBtn.Entity.Enable = false end
		if isvalid(self.helpButton) then self.helpButton.Enable = false end
		self:SetTitleText(msg)
	end

	@ExecSpace("ClientOnly")
	method void SelectBranch(string tileName)
		_SFXManager:PlayClick()
		log("분기 선택: " .. tileName)
		
		-- 로컬 플레이어의 PlayerMovement 컴포넌트를 찾아 서버로 전달
		local player = _UserService.LocalPlayer
		if isvalid(player) and player.PlayerMovement ~= nil then
			player.PlayerMovement:OnBranchSelected(tileName)
		else
			-- 맵/룸 전환 순간 등 LocalPlayer·PlayerMovement가 잠깐 무효일 때 크래시 방지(다른 호출부와 동일 가드).
			log_warning("[BranchSelectUI] 분기 선택 무시 — LocalPlayer/PlayerMovement 없음")
		end

		self:Hide()   -- 선택했으니 UI 닫기
	end

	@ExecSpace("ClientOnly")
	method void OnEndPlay()
		-- 월드 종료 시 핸들러 누수 방지(Hide 경로를 안 타고 끝나는 경우 대비).
		self:DisconnectAll()
		if self.mapBtnHandler ~= nil and isvalid(self.mapViewBtn) then
			self.mapViewBtn.Entity:DisconnectEvent(ButtonClickEvent, self.mapBtnHandler)
			self.mapBtnHandler = nil
		end
	end

	method void DisconnectAll()
		local buttons = {self.Btn_1, self.Btn_2, self.Btn_3, self.Btn_4, self.Btn_5}
		for i = 1, 5 do
			if self.handlers[i] ~= nil then
				buttons[i].Entity:DisconnectEvent(ButtonClickEvent, self.handlers[i])
				self.handlers[i] = nil
			end
		end
	end

end