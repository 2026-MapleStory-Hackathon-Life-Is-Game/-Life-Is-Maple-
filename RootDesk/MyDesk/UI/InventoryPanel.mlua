@Component
script InventoryPanel extends Component

	property Entity panelRoot = "265b6a00-710c-4654-ad3f-85db1bc7685f"

	property Entity gridEntity = "c4fadd74-2612-44e0-913c-94d38acf97f1"

	property Entity cellPrefab = "5c958470-46b3-40e2-a250-24aaa2847a6e"

	property Entity cubeBanner = "e1e4862c-e849-48f2-9de5-22c888cf1634"

	property boolean isOpen = false

	property string activeTab = "Armor"

	property any cellHandlers = nil

	property string _lastClickName = ""

	property number _lastClickTime = 0

	property number _pollTimer = 0

	property string _lastListSig = ""

	property boolean _cubeUseMode = false

	property string _lastBannerSig = ""

	property Entity ctxMenu = "246bd7cf-bcce-4d32-a8ec-6e04e25642a1"

	property ButtonComponent ctxBtnEquip = "db28172c-7b0d-4809-bfad-8b3f2221f029"

	property ButtonComponent ctxBtnCube = "ff23db32-c729-487d-bf5e-a806008f0ade"

	property ButtonComponent ctxBtnForge = "e9df9917-200d-4ffd-803a-25f50091a387"

	property ButtonComponent ctxBtnClose = "160a192d-b859-4ac9-9fa3-9ae0bd99a0d8"

	property string _hoverId = ""

	property string _hoverName = ""

	property boolean _lastMouse1 = false

	property string _ctxTargetId = ""

	property string _ctxTargetName = ""

	property any _ctxHandlers = nil

	property string _ctxEquipLabel = "장착 / 교체"

	property any escHandler = nil

	property boolean _isMobile = false

	property boolean _pressActive = false

	property string _pressId = ""

	property string _pressName = ""

	property number _pressStart = 0

	property boolean _pressFired = false

	property any _pressCursor = nil

	property any _ctxCenter = nil

	property any _ctxSize = nil

	property number _ctxOpenTime = 0

	property any touchDownHandler = nil

	property any touchUpHandler = nil

	method void OnBeginPlay()
		-- 클라: 패널 숨김 + GridView 셀 프리팹 주입 + 탭 버튼 이벤트 배선.
		if self:IsClient() == false then return end
		self.isOpen = false
		self.activeTab = "Armor"
		self.cellHandlers = {}
		self._lastClickName = ""
		self._lastClickTime = 0
		self._T.items = {}
		self._T.tabH = {}
		self._T.tabEnts = {}
		
		if isvalid(self.panelRoot) then
			self.panelRoot.Enable = false
		end
		
		if isvalid(self.gridEntity) and isvalid(self.cellPrefab) then
			local gvc = self.gridEntity.GridViewComponent
			if gvc ~= nil then
				gvc.ItemEntity = self.cellPrefab
				-- 마우스 휠/드래그로 목록을 위아래 스크롤(아이템이 많아 한 화면을 넘침).
				-- 클릭은 ButtonClickEvent가 스크롤에 먹히므로 OnCellState의 Pressed(=2)로 감지한다.
				gvc.UseScroll = true
				gvc.OnRefresh = function(index, cell)
					self:OnGridCellRefresh(index, cell)
				end
				gvc.OnClear = function(index, cell)
					self:OnGridCellClear(index, cell)
				end
			end
		end
		
		-- 탭 버튼 이벤트 배선
		local base = "/ui/InGameUIGroup/Inventory_Panel/Window/"
		local tabs = {
			{ key = "Armor", node = "TabArmor" },
			{ key = "Weapon", node = "TabWeapon" },
			{ key = "Accessory", node = "TabAccessory" },
			{ key = "Item", node = "TabItem" },
		}
		for _, t in ipairs(tabs) do
			local e = _EntityService:GetEntityByPath(base .. t.node)
			if isvalid(e) then
				local capturedKey = t.key
				local h = e:ConnectEvent(ButtonClickEvent, function()
					_SFXManager:PlayClick()
					self:SelectTab(capturedKey)
				end)
				table.insert(self._T.tabH, { entity = e, evtH = h })
				self._T.tabEnts[t.key] = e
			end
		end
		self:UpdateTabVisual()
		
		-- 하단 푸터의 닫기 버튼 → 인벤 닫기. 탭과 동일하게 _T.tabH에 넣어 OnEndPlay에서 함께 해제.
		local closeBtn = _EntityService:GetEntityByPath(base .. "Footer/BtnClose")
		if isvalid(closeBtn) then
			local ch = closeBtn:ConnectEvent(ButtonClickEvent, function()
				_SFXManager:PlayClick()
				self:Close()
			end)
			table.insert(self._T.tabH, { entity = closeBtn, evtH = ch })
		end

		-- 합성(Mix) 버튼 → 합성 대상(메인) 선택 패널 진입. 탭/닫기와 동일하게 _T.tabH로 함께 해제.
		local mixBtn = _EntityService:GetEntityByPath(base .. "BtnMix")
		if isvalid(mixBtn) then
			local mh = mixBtn:ConnectEvent(ButtonClickEvent, function()
				_SFXManager:PlayClick()
				self:OnClickMix()
			end)
			table.insert(self._T.tabH, { entity = mixBtn, evtH = mh })
		end

		-- 큐브 사용 모드 배너는 기본 숨김(미라클 큐브 셀을 누르면 켜진다).
		self._cubeUseMode = false
		self._lastBannerSig = ""
		if isvalid(self.cubeBanner) then self.cubeBanner.Enable = false end
		
		-- 우클릭 컨텍스트 메뉴: 기본 숨김 + 3버튼 클릭 배선.
		self._ctxHandlers = {}
		self._hoverId = ""
		self._hoverName = ""
		self._lastMouse1 = false
		self._ctxTargetId = ""
		self._ctxTargetName = ""
		if isvalid(self.ctxMenu) then self.ctxMenu.Enable = false end
		if isvalid(self.ctxBtnEquip) then
			local he = self.ctxBtnEquip.Entity:ConnectEvent(ButtonClickEvent, function() self:OnCtxEquip() end)
			table.insert(self._ctxHandlers, { entity = self.ctxBtnEquip.Entity, evtH = he })
		end
		if isvalid(self.ctxBtnCube) then
			local hc = self.ctxBtnCube.Entity:ConnectEvent(ButtonClickEvent, function() self:OnCtxCube() end)
			table.insert(self._ctxHandlers, { entity = self.ctxBtnCube.Entity, evtH = hc })
		end
		if isvalid(self.ctxBtnForge) then
			local hf = self.ctxBtnForge.Entity:ConnectEvent(ButtonClickEvent, function() self:OnCtxForge() end)
			table.insert(self._ctxHandlers, { entity = self.ctxBtnForge.Entity, evtH = hf })
		end
		if isvalid(self.ctxBtnClose) then
			local hx = self.ctxBtnClose.Entity:ConnectEvent(ButtonClickEvent, function() self:OnCtxClose() end)
			table.insert(self._ctxHandlers, { entity = self.ctxBtnClose.Entity, evtH = hx })
		end
		-- 컨텍스트 메뉴 'Equip' 버튼의 원래 라벨을 기억(큐브 모드에서 '미라클 큐브 사용'으로 바꿨다 복원).
		if isvalid(self.ctxBtnEquip) then
			local etc = self.ctxBtnEquip.Entity:GetComponent("MOD.Core.TextComponent")
			if etc ~= nil and etc.Text ~= nil and etc.Text ~= "" then self._ctxEquipLabel = etc.Text end
		end
		
		-- ESC 키로 인벤토리 닫기. _InputService의 KeyDownEvent 구독(엔티티가 아닌 서비스에서 구독).
		-- Close()를 직접 호출해도 UnderButton:OnUpdate가 openExclusive를 매 프레임 동기화하므로 desync 없음.
		self.escHandler = _InputService:ConnectEvent(KeyDownEvent, self.OnKeyDown)
		
		-- 플랫폼 판별: 모바일에서만 롱프레스(꾹 누르기)로 컨텍스트 메뉴를 연다. PC는 우클릭 그대로.
		self._isMobile = false
		if Environment ~= nil then self._isMobile = Environment:IsMobilePlatform() end
		self._pressActive = false
		self._pressFired = false
		self._pressId = ""
		self._pressName = ""
		self._pressCursor = nil
		self._ctxCenter = nil
		self._ctxSize = nil
		self._ctxOpenTime = 0
		
		-- 화면 터치/클릭 구독:
		--   다운(ScreenTouchEvent) → 컨텍스트 메뉴 바깥을 누르면 메뉴 닫기(PC 좌클릭·모바일 탭 공통).
		--   릴리즈(ScreenTouchReleaseEvent) → 손가락/버튼을 떼면 대기 중이던 롱프레스 취소.
		--   우클릭(Mouse1)은 ScreenTouchEvent를 발생시키지 않아 PC 우클릭으로 연 메뉴가 자기 클릭에 닫히지 않는다.
		self.touchDownHandler = _InputService:ConnectEvent(ScreenTouchEvent, self.OnScreenTouchDown)
		self.touchUpHandler = _InputService:ConnectEvent(ScreenTouchReleaseEvent, self.OnScreenTouchUp)
		
-- 		log("[InventoryPanel] OnBeginPlay OK mobile=" .. tostring(self._isMobile))
	end

	@ExecSpace("ClientOnly")
	method void OnKeyDown(KeyDownEvent event)
		-- ESC: 인벤토리가 열려 있으면 닫는다(Close가 컨텍스트 메뉴/툴팁도 함께 정리).
		if event.key == KeyboardKey.Escape and self.isOpen then
			self:Close()
-- 			log("[InventoryPanel] ESC → 인벤 닫기")
		end
	end

	method integer CubeCount()
		-- 로컬 플레이어의 미라클 큐브 보유 수(없으면 0).
		local p = _UserService.LocalPlayer
		if isvalid(p) == false then return 0 end
		local bag = p:GetComponent("script.CubeInventory")
		if isvalid(bag) == false then return 0 end
		return bag.MiracleCubeCount
	end

	method integer DiceCardCount(string cardKey)
		-- 로컬 플레이어의 주사위 고정 카드 보유 수(low/high, 없으면 0).
		local p = _UserService.LocalPlayer
		if isvalid(p) == false then return 0 end
		local inv = p:GetComponent("script.DiceCardInventory")
		if isvalid(inv) == false then return 0 end
		return inv:GetCount(cardKey)
	end

	method string DisplayName(string equipName)
		-- equipName의 표시명(EquipmentData.Name). 없으면 equipName 그대로.
		if equipName == "" then return "" end
		local ds = _DataService:GetTable("EquipmentData")
		if isvalid(ds) then
			for i = 1, ds:GetRowCount() do
				if ds:GetCell(i, "EquipName") == equipName then return ds:GetCell(i, "Name") end
			end
		end
		return equipName
	end

	method void UpdateBanner()
		-- 큐브 사용 모드일 때만 안내 배너 표시(평소 숨김). 상태 변화 없으면 스킵(깜빡임 방지).
		if isvalid(self.cubeBanner) == false then return end
		local sig = self._cubeUseMode and "on" or "off"
		if sig == self._lastBannerSig then return end
		self._lastBannerSig = sig
		self.cubeBanner.Enable = self._cubeUseMode
		if self._cubeUseMode then
			local tc = self.cubeBanner:GetComponent("MOD.Core.TextComponent")
			if tc ~= nil then tc.Text = "재설정할 장비를 선택하세요  (취소: 다른 탭)" end
		end
	end

	method void EnterCubeUseMode()
		-- 미라클 큐브 사용: 그리드를 '재설정 대상 장비(전체 장비)'로 전환.
		if self:CubeCount() <= 0 then
-- 			log("[InventoryPanel] 큐브 사용: 보유 0")
			return
		end
		self:CloseContextMenu()
		self._cubeUseMode = true
		self:UpdateBanner()
		self:Rebuild()
-- 		log("[InventoryPanel] 큐브 사용 모드 진입")
	end

	method void ExitCubeUseMode()
		-- 큐브 사용 모드 종료(배너 숨김). Item 탭이면 다시 큐브 셀이 보인다.
		self._cubeUseMode = false
		self:UpdateBanner()
	end

	method boolean IsCubeUseMode()
		-- 큐브 사용(재설정 대상 선택) 모드 여부. 다른 UI 패널이 우클릭 메뉴 억제 판단에 참조한다.
		return self._cubeUseMode
	end

	method string ListSig(table items)
		-- 목록 변경 감지용 시그니처. items = 레코드 배열(kind=cube/equip).
		-- 인스턴스 ID를 이어붙여 '중복 아이템 추가/제거/장착 이동'이 모두 서명에 반영되게 한다.
		local parts = {}
		local p = _UserService.LocalPlayer
		for _, rec in ipairs(items) do
			if rec.kind == "cube" then
				table.insert(parts, "cube")
			elseif rec.kind == "dicecard" then
				table.insert(parts, "dc:" .. tostring(rec.cardKey))
			else
				-- id + 잠재 등급을 함께 서명 → 큐브로 잠재가 바뀌면 아웃라인이 즉시 갱신되도록 Rebuild 유도.
				local g = ""
				if isvalid(p) then
					---@type BaseEquipment
					local mgr = _EquipmentRouter:ManagerForInstance(p, rec.id)
					if isvalid(mgr) then g = _PotentialManager:GradeOf(mgr:GetInstancePotential(rec.id)) end
				end
				table.insert(parts, rec.id .. "@" .. g)
			end
		end
		local s = table.concat(parts, ",")
		if self.activeTab == "Item" and self._cubeUseMode == false then
			s = s .. "|cube" .. tostring(self:CubeCount())
			s = s .. "|dcl" .. tostring(self:DiceCardCount("low")) .. "|dch" .. tostring(self:DiceCardCount("high"))
		end
		return s
	end

	method table AllEquipList(Entity p)
		-- 큐브 사용 대상 후보: 보유+장착 장비 전체(무기/방어구/장신구)를 인스턴스 레코드로.
		-- 각 원소 = { kind="equip", id=인스턴스ID, name=equipName }. 인스턴스는 유일하므로 중복 제거 불필요.
		local out = {}
		local tabs = { "Armor", "Weapon", "Accessory" }
		---@type BaseEquipment
		for _, tab in ipairs(tabs) do
			local m = _EquipmentRouter:ManagerFor(p, tab)
			if isvalid(m) then
				if m.EquippedId ~= "" and m.Equipped ~= "" then
					table.insert(out, { kind = "equip", id = m.EquippedId, name = m.Equipped })
				end
				for _, rec in ipairs(m:OwnedInstancesSorted()) do
					table.insert(out, { kind = "equip", id = rec.id, name = rec.name })
				end
			end
		end
		return out
	end

	method void UpdateTabVisual()
		-- 활성 탭은 파란색, 비활성은 어둡게(.ui 기본 색상 스킴 유지).
		if self._T.tabEnts == nil then return end
		for key, ent in pairs(self._T.tabEnts) do
			if isvalid(ent) then
				local sr = ent.SpriteGUIRendererComponent
				if isvalid(sr) then
					if key == self.activeTab then
						sr.Color = Color(0.2, 0.4, 0.7, 1)
					else
						sr.Color = Color(0.25, 0.25, 0.35, 1)
					end
				end
			end
		end
	end

	method void Open()
		-- 배낭 열기 + 현재 탭 목록 갱신.
		if self:IsClient() == false then return end
		self.isOpen = true
		self._cubeUseMode = false
		self:UpdateBanner()
		if isvalid(self.panelRoot) then
			self.panelRoot.Enable = true
		end
		-- 인벤 열림 동안 마우스 휠은 카메라 줌이 아니라 인벤 스크롤에 쓰이도록 맵뷰에 통지.
		if _MapViewManager ~= nil then _MapViewManager:SetInventoryOpen(true) end
		self:Rebuild()
	end

	method void HideTooltip()
		-- 툴팁(핫패널) 강제 숨김 + 호버 추적 해제. 셀 이탈(Normal) 이벤트가 유실되는 경로
		-- (패널 닫힘 / 셀 재활용 / 스크롤)에서 툴팁이 주인 없이 남는 것을 막는 단일 진입점.
		_EquipTooltip:Hide()
		self._hoverId = ""
		self._hoverName = ""
	end

	method void Close()
		-- 배낭 닫기.
		if self:IsClient() == false then return end
		self.isOpen = false
		self:CloseContextMenu()
		-- ⚠ 툴팁은 인벤 패널의 자식이 아닌 독립 오버레이(/ui/InGameUIGroup/EquipTooltip)라,
		--    패널만 끄면 호버 셀이 비활성화되어 이탈(Normal) 이벤트가 사라지고 툴팁이 그대로 남는다.
		--    닫을 때 명시적으로 내린다.
		self:HideTooltip()
		if isvalid(self.panelRoot) then
			self.panelRoot.Enable = false
		end
		if _MapViewManager ~= nil then _MapViewManager:SetInventoryOpen(false) end
	end

	method void SelectTab(string tab)
		-- 탭 전환 후 활성 탭 색 갱신 + 그리드 재구성. 큐브 사용 모드면 취소(다른 탭 전환=취소).
		self.activeTab = tab
		self:CloseContextMenu()
		if self._cubeUseMode then self:ExitCubeUseMode() end
		self:UpdateTabVisual()
		self:Rebuild()
	end

	method table CurrentList()
		-- 현재 탭 목록(레코드 배열). Item 탭: 평소엔 미라클 큐브 1칸, 큐브 사용 모드면 전체 장비(재설정 대상).
		--   cube 레코드 = { kind="cube" } / equip 레코드 = { kind="equip", id=, name= }.
		local p = _UserService.LocalPlayer
		if isvalid(p) == false then return {} end
		if self.activeTab == "Item" then
			if self._cubeUseMode then return self:AllEquipList(p) end
			-- 소비 아이템: 미라클 큐브 + 주사위 고정 카드(낮은/높은). 보유 0인 항목은 숨김.
			local out = {}
			if self:CubeCount() > 0 then table.insert(out, { kind = "cube" }) end
			if self:DiceCardCount("low") > 0 then table.insert(out, { kind = "dicecard", cardKey = "low", name = "낮은 숫자 카드" }) end
			if self:DiceCardCount("high") > 0 then table.insert(out, { kind = "dicecard", cardKey = "high", name = "높은 숫자 카드" }) end
			return out
		end
		---@type BaseEquipment
		local m = _EquipmentRouter:ManagerFor(p, self.activeTab)
		if isvalid(m) == false then return {} end
		-- 장착중인 아이템은 인벤토리에 표시하지 않는다(캐릭터 정보 패널에서만 보임).
		-- OwnedInstancesSorted()는 이미 장착품(EquippedId)을 제외한 보유목록이므로 레코드로 변환.
		local out = {}
		for _, rec in ipairs(m:OwnedInstancesSorted()) do
			table.insert(out, { kind = "equip", id = rec.id, name = rec.name })
		end
		return out
	end

	method void Rebuild()
		-- 보유 목록으로 GridView 재구성.
		if self:IsClient() == false or self.isOpen == false then return end
		
		-- ⚠ Rebuild에서는 셀 핸들러를 건드리지 않는다. TotalCount가 같으면 gvc:Refresh()가
		--   OnRefresh를 다시 부르지 않아, 여기서 해제하면 핸들러가 영영 재연결되지 않는다(호버 사망).
		--   핸들러 교체/해제는 셀 생애주기 콜백(OnGridCellRefresh/Clear)에서만 처리한다.
		-- ⚠ 재구성은 셀을 재활용하므로 호버 중이던 셀의 이탈(Normal) 이벤트가 유실된다 → 툴팁 고아.
		--   먼저 툴팁을 내리고 호버 추적을 해제한다. 재구성 후 커서가 여전히 셀 위면 Hover가 다시 떠 올바른 툴팁이 복원된다.
		self:HideTooltip()
		local items = self:CurrentList()
		self._T.items = items
		-- 깜빡임 방지: 시그니처를 여기서 동기화해 OnUpdate 폴러가 중복 Rebuild를 또 트리거하지 않게 한다.
		self._lastListSig = self:ListSig(items)
-- 		log("[InventoryPanel] Rebuild tab=" .. self.activeTab .. " count=" .. tostring(#items))
		
		if isvalid(self.gridEntity) then
			local gvc = self.gridEntity.GridViewComponent
			if gvc ~= nil then
				gvc.TotalCount = #items
				-- force=true: 카운트가 같아도(예: 1↔1 교체) 모든 셀을 다시 그린다.
				-- false면 카운트 동일 시 셀 내용/핸들러가 옛 아이템으로 남는다(교체 시 핫패널 오표시).
				gvc:Refresh(true, true)
			end
		end
	end

	method void OnGridCellRefresh(integer index, Entity cell)
		-- GridView OnRefresh 콜백: 셀 1개를 (index+1)번째 아이템(레코드)으로 채운다.
		local items = self._T.items
		if items == nil then return end
		local rec = items[index + 1]
		if rec == nil then return end
		local name = rec.name or ""
		
		local rend = cell.SpriteGUIRendererComponent
		local tc = cell:GetComponent("MOD.Core.TextComponent")
		
		if rec.kind == "cube" then
			-- 미라클 큐브 셀: 아이콘 RUID가 없으므로 보라색 틴트 + 보유 수 텍스트로 표현.
			if isvalid(rend) then
				-- 미라클 큐브 아이콘(sprite RUID → thumbnail:// 없이 직접). 흰색으로 제 색 표시.
				rend.ImageRUID = DataRef("07b0f309e17d4b4ca5564b0c038d889d")
				rend.Color = Color(1, 1, 1, 1)
				-- 큐브는 잠재 개념이 없으므로 아웃라인 해제(셀 재사용 시 이전 잠재 아웃라인 잔상 제거).
				rend.Outline = false
			end
			if tc ~= nil then
				-- TextComponent는 '아이템'일 때만 보유 수량 숫자를 나타낸다(이름 표시 없음). 셀 오른쪽 하단 배치.
				tc.Text = tostring(self:CubeCount())
				tc.FontSize = 18
				tc.Alignment = TextAlignmentType.LowerRight
			end
		elseif rec.kind == "dicecard" then
			-- 주사위 고정 카드 셀: 낮은=주사위 눈2 / 높은=주사위 눈6 아이콘 + 보유 수 텍스트.
			-- 흰색 주사위 스프라이트를 카드 색(낮은=파랑 / 높은=주황)으로 틴트 → 어두운 패널에서도 또렷 + 색으로 구분.
			if isvalid(rend) then
				local icon = "a2ab7e2cb3734c6d9d35e09b602670aa"   -- 눈 2(낮은 카드)
				local tint = Color(0.42, 0.62, 0.98, 1)           -- 낮은=파랑
				if rec.cardKey == "high" then
					icon = "b302d911b3c64014b000b494a95898dc"       -- 눈 6(높은 카드)
					tint = Color(0.98, 0.62, 0.28, 1)              -- 높은=주황
				end
				rend.ImageRUID = DataRef(icon)
				rend.Color = tint
				rend.Outline = false
			end
			if tc ~= nil then
				tc.Text = tostring(self:DiceCardCount(rec.cardKey))
				tc.FontSize = 18
				tc.Alignment = TextAlignmentType.LowerRight
			end
		else
			-- 장비 셀: 아이콘만 표시(이름 텍스트 없음). RUID만 조회.
			local ds = _DataService:GetTable("EquipmentData")
			local ruid = ""
			if isvalid(ds) then
				for i = 1, ds:GetRowCount() do
					if ds:GetCell(i, "EquipName") == name then
						ruid = ds:GetCell(i, "Sprite RUID")
						break
					end
				end
			end
			if isvalid(rend) then
				if ruid ~= "" then
					-- 장비 RUID는 avataritem 타입 → thumbnail:// 접두 + DataRef로 감싸야 아이콘이 렌더된다.
					rend.ImageRUID = DataRef("thumbnail://" .. ruid)
				end
				rend.Color = Color(1, 1, 1, 1)
				-- 이 인스턴스의 잠재 등급에 맞춰 아웃라인 색 반영(잠재 없으면 아웃라인 해제).
				local pot = ""
				local p = _UserService.LocalPlayer
				if isvalid(p) then
					---@type BaseEquipment
					local mgr = _EquipmentRouter:ManagerForInstance(p, rec.id)
					if isvalid(mgr) then pot = mgr:GetInstancePotential(rec.id) end
				end
				_PotentialManager:ApplyGradeOutline(rend, pot)
			end
			-- 장비/방어구/장신구 셀에는 이름 텍스트를 표시하지 않는다(이름 표시 로직 제거).
			if tc ~= nil then tc.Text = "" end
		end
		
		-- 호버/클릭 핸들러 연결. 인스턴스 ID+이름을 클로저에 캡처(큐브 셀은 id 센티넬 "__MIRACLE_CUBE__").
		-- 클릭은 OnCellState의 Pressed로 처리. (capturedId를 아래 재활용 감지에도 재사용)
		local capturedId = "__MIRACLE_CUBE__"
		local capturedName = ""
		if rec.kind == "equip" then
			capturedId = rec.id
			capturedName = rec.name
		elseif rec.kind == "dicecard" then
			-- 카드 셀: 센티넬 id "__DICECARD__" + 이름 자리에 카드키("low"/"high")를 실어 클릭 시 사용.
			capturedId = "__DICECARD__"
			capturedName = rec.cardKey
		end
		-- 이 셀의 기존 핸들러만 교체(누적 방지). Rebuild는 핸들러를 안 건드리므로 여기서 관리한다.
		for i = #self.cellHandlers, 1, -1 do
			local r = self.cellHandlers[i]
			if r.entity == cell then
				if r.stateH ~= nil then cell:DisconnectEvent(ButtonStateChangeEvent, r.stateH) end
				-- 이 셀이 지금 툴팁을 띄운(호버 중) 아이템이었고 다른 아이템으로 재사용된다면,
				-- 이탈(Normal) 이벤트가 유실되므로 여기서 강제로 툴팁을 내린다(스크롤 재활용 대비).
				if r.id ~= nil and r.id ~= "" and r.id == self._hoverId and r.id ~= capturedId then
					self:HideTooltip()
				end
				table.remove(self.cellHandlers, i)
			end
		end
		local hs = cell:ConnectEvent(ButtonStateChangeEvent, function(ev)
			self:OnCellState(capturedId, capturedName, ev)
		end)
		table.insert(self.cellHandlers, { entity = cell, stateH = hs, id = capturedId })
	end

	method void OnGridCellClear(integer index, Entity cell)
		-- GridView OnClear 콜백: 이 셀의 핸들러 해제 + 아이콘/텍스트 초기화(유령 셀이 옛 아이템으로 반응하지 않게).
		local rend = cell.SpriteGUIRendererComponent
		if isvalid(rend) then
			rend.Color = Color(1, 1, 1, 0)
			-- 빈 셀은 아웃라인도 해제(셀 재사용 시 이전 잠재 등급 아웃라인 잔상 방지).
			rend.Outline = false
		end
		local tc = cell:GetComponent("MOD.Core.TextComponent")
		if tc ~= nil then tc.Text = "" end
		for i = #self.cellHandlers, 1, -1 do
			local r = self.cellHandlers[i]
			if r.entity == cell then
				if r.stateH ~= nil then cell:DisconnectEvent(ButtonStateChangeEvent, r.stateH) end
				-- 호버 중이던 셀이 비워지면(스크롤로 화면 밖) 이탈(Normal) 이벤트가 유실되므로 툴팁을 내린다.
				if r.id ~= nil and r.id ~= "" and r.id == self._hoverId then
					self:HideTooltip()
				end
				table.remove(self.cellHandlers, i)
			end
		end
	end

	method void OnCellState(string instanceId, string equipName, ButtonStateChangeEvent ev)
		-- 인벤 셀: 호버→비교 툴팁, 이탈→숨김, Pressed→클릭 처리. instanceId=인스턴스ID(큐브는 "__MIRACLE_CUBE__").
		-- ⚠ GridView(스크롤) 안의 셀은 ButtonClickEvent가 스크롤에 먹혀 안 뜬다. 작동하는
		--    ButtonStateChangeEvent의 Pressed(=2) 상태로 클릭/더블클릭을 감지한다.
		if instanceId == "__MIRACLE_CUBE__" then
			-- 미라클 큐브 셀(장비 셀과 동일한 상호작용):
			--   호버 → 우클릭 폴백용 추적 / 우클릭 → 컨텍스트 메뉴 / 더블클릭 → 큐브 사용.
			--   단일 좌클릭으로 바로 사용되지 않게(오작동 방지) OnCellClicked의 더블클릭 판정을 탄다.
			if ev.state == ButtonState.Hover then
				self._hoverId = "__MIRACLE_CUBE__"
				self._hoverName = ""
			elseif ev.state == ButtonState.Pressed then
				if _InputService:IsKeyPressed(KeyboardKey.Mouse1) then
					self._hoverId = "__MIRACLE_CUBE__"
					self._hoverName = ""
					self:OpenContextMenu("__MIRACLE_CUBE__", "")
				elseif self._isMobile then
					-- 모바일: 탭 1번 → 왼쪽 메뉴('미라클 큐브 사용/닫기') 표시.
					self:OpenMobilePanels("__MIRACLE_CUBE__", "")
				else
					self:OnCellClicked("__MIRACLE_CUBE__", "")
				end
			elseif ev.state == ButtonState.Normal then
				if self._hoverId == "__MIRACLE_CUBE__" then self._hoverId = "" end
			end
			return
		end
		if instanceId == "__DICECARD__" then
			-- 주사위 고정 카드 셀: 더블클릭(또는 모바일 탭 2회)으로 사용(다음 굴림 장전). equipName=카드키("low"/"high").
			-- 컨텍스트 메뉴는 두지 않는다(단순 소비 아이템). 좌클릭 더블탭 판정만 사용.
			if ev.state == ButtonState.Hover then
				self._hoverId = "__DICECARD__"
				self._hoverName = equipName
			elseif ev.state == ButtonState.Pressed then
				self:OnCellClicked("__DICECARD__", equipName)
			elseif ev.state == ButtonState.Normal then
				if self._hoverId == "__DICECARD__" then self._hoverId = "" end
			end
			return
		end
		if ev.state == ButtonState.Hover then
			-- 우클릭 메뉴 대상 추적: 지금 호버 중인 인스턴스를 기억.
			self._hoverId = instanceId
			self._hoverName = equipName
			-- PC만 호버로 툴팁을 띄운다. 모바일은 '호버'가 손가락 누름이라, 탭(Pressed)에서만 패널을 연다.
			if self._isMobile == false then
				local curId = ""
				local p = _UserService.LocalPlayer
				if isvalid(p) then
					---@type BaseEquipment
					local m = _EquipmentRouter:ManagerForItem(p, equipName)
					if isvalid(m) then curId = m.EquippedId end
				end
				_EquipTooltip:ShowCompare(instanceId, curId)
			end
		elseif ev.state == ButtonState.Pressed then
			-- 우클릭이면 컨텍스트 메뉴(좌클릭 장착 로직은 타지 않음 → 메뉴 즉시 닫힘 경합 방지).
			-- 큐브 사용 모드(재설정 대상 선택 중)에는 우클릭 메뉴를 열지 않는다.
			if _InputService:IsKeyPressed(KeyboardKey.Mouse1) then
				if self._cubeUseMode == false then
					self._hoverId = instanceId
					self._hoverName = equipName
					self:OpenContextMenu(instanceId, equipName)
				end
			elseif self._isMobile then
				-- 모바일: 탭 1번 → 오른쪽 정보 + 왼쪽 장착/닫기 메뉴(고정). 장착은 메뉴 버튼으로.
				if self._cubeUseMode then
					self:OnCellClicked(instanceId, equipName)   -- 큐브 사용 모드에선 대상 선택이 우선.
				else
					self:OpenMobilePanels(instanceId, equipName)
				end
			else
				self:OnCellClicked(instanceId, equipName)
			end
		elseif ev.state == ButtonState.Normal then
			-- 이 셀에서 마우스가 빠지면 호버 추적 해제(다른 셀이 이미 잡았으면 건드리지 않음).
			if self._hoverId == instanceId then self._hoverId = "" end
			-- 모바일: 손가락을 떼도(=Normal) 패널을 닫지 않는다(바깥 탭/닫기 버튼으로만 닫힘).
			if self._isMobile == false then _EquipTooltip:Hide() end
		end
	end

	method void OnUpdate(number delta)
		-- 인벤 열린 동안 0.2초마다 목록 변경 감지 → Rebuild.
		if self:IsClient() == false or self.isOpen == false then return end
		
		-- 우클릭 엣지 감지(매 프레임): 장비 셀 위 우클릭 → 컨텍스트 메뉴 열기(폴백 경로).
		self:UpdateRightClick()
		
		-- 모바일 롱프레스(꾹 누르기) 처리: 셀을 눌러 유지하면 컨텍스트 메뉴를 연다.
		self:UpdateLongPress()
		
		self._pollTimer = self._pollTimer + delta
		if self._pollTimer < 0.2 then return end
		self._pollTimer = 0
		self:UpdateBanner()
		local items = self:CurrentList()
		local sig = self:ListSig(items)
		if sig ~= self._lastListSig then
			self._lastListSig = sig
			self:Rebuild()
-- 			log("[InventoryPanel] 목록 변경 감지 → Rebuild count=" .. tostring(#items))
		end
	end

	method void OnCellClicked(string instanceId, string equipName)
		-- 큐브 사용 모드: 클릭한 장비 인스턴스를 재설정 대상으로 큐브 사용 요청.
		-- 일반 모드: 더블클릭(0.3초 내 같은 인스턴스 2회) → 장착 요청.
		-- 좌클릭이 들어오면 떠 있던 우클릭 메뉴는 닫는다.
		self:CloseContextMenu()
		_SFXManager:PlayClick()
		if self._cubeUseMode then
			-- 바로 사용하지 않고 확인 패널을 먼저 띄운다(예→실제 사용 / 아니오→취소).
			-- 모드 종료/RequestCube는 CubeConfirmPopup:OnYes에서 처리.
-- 			log("[InventoryPanel] 큐브 대상 선택(확인 대기): " .. equipName .. "(" .. instanceId .. ")")
			_EquipTooltip:Hide()
			_CubeConfirmPopup:Open(instanceId, equipName)
			return
		end
		local now = _UtilLogic.ElapsedSeconds
		if self._lastClickName == instanceId and (now - self._lastClickTime) <= 0.3 then
			self._lastClickName = ""
			-- 미라클 큐브 셀: 더블클릭 시 장비 선택 패널 열기.
			if instanceId == "__MIRACLE_CUBE__" then
-- 				log("[InventoryPanel] 큐브 더블클릭 → 선택 패널")
				_CubeTargetSelect:Open()
				return
			end
			-- 주사위 고정 카드 셀: 더블클릭 시 사용(다음 굴림 장전). equipName=카드키. 실제 소비는 굴림 시점.
			if instanceId == "__DICECARD__" then
				_ItemDiceCardManager:UseCard(equipName)
				_EquipTooltip:Hide()
				return
			end
-- 			log("[InventoryPanel] 더블클릭 장착: " .. equipName .. "(" .. instanceId .. ")")
			local p = _UserService.LocalPlayer
			if isvalid(p) then
				---@type BaseEquipment
				local m = _EquipmentRouter:ManagerForItem(p, equipName)
				if isvalid(m) then
					m:RequestEquip(instanceId)
				end
			end
			-- 장착되면 그 아이템 셀이 인벤에서 빠지는데, 마우스가 그 자리에 남아 Normal(=Hide)이
			-- 안 불리는 경우가 있어 툴팁이 떠 있게 된다. 장착 시 명시적으로 숨긴다.
			_EquipTooltip:Hide()
			self:Rebuild()
		else
			self._lastClickName = instanceId
			self._lastClickTime = now
-- 			log("[InventoryPanel] 첫 클릭: " .. equipName .. "(" .. instanceId .. ")")
		end
	end

	method void OpenMobilePanels(string instanceId, string equipName)
		-- 모바일: 셀 탭 1번 → 왼쪽 장착/닫기 메뉴 + 오른쪽 아이템 정보(둘 다 고정). 장착은 메뉴 '장착' 버튼으로.
		-- (더블탭=장착, 롱프레스=메뉴는 모바일에서 이 경로로 대체된다.)
		self._hoverId = instanceId
		self._hoverName = equipName
		self:OpenContextMenu(instanceId, equipName)   -- 왼쪽 고정(모바일 분기). 모바일에선 툴팁을 숨기지 않음.
		if instanceId == "__MIRACLE_CUBE__" then
			-- 큐브는 비교할 장비가 없어 오른쪽 정보 패널 생략(메뉴만 표시).
			_EquipTooltip:Hide()
			return
		end
		local curId = ""
		local p = _UserService.LocalPlayer
		if isvalid(p) then
			---@type BaseEquipment
			local m = _EquipmentRouter:ManagerForItem(p, equipName)
			if isvalid(m) then curId = m.EquippedId end
		end
		_EquipTooltip:ShowCompare(instanceId, curId)   -- 오른쪽 고정(모바일=PlaceFixedRight, 추적 안 함)
	end

	method void UpdateRightClick()
		-- 매 프레임 호출. 우클릭 눌림 엣지에서, 호버 중인 인스턴스가 있으면 컨텍스트 메뉴를 띄운다.
		local down = _InputService:IsKeyPressed(KeyboardKey.Mouse1)
		if down and self._lastMouse1 == false then
			-- 우클릭 눌림 엣지. 큐브 사용 모드가 아니고 호버 중인 인스턴스가 있으면 메뉴를 연다.
			-- (셀 Pressed 이벤트가 우클릭을 직접 처리하지 못하는 경우의 폴백 경로.)
			-- 빈 곳 우클릭 시 자동 닫기는 이벤트 경로와의 경합을 막기 위해 하지 않는다(닫기는 닫기 버튼/좌클릭으로).
			if self._cubeUseMode == false and self._hoverId ~= "" then
				self:OpenContextMenu(self._hoverId, self._hoverName)
			end
		end
		self._lastMouse1 = down
	end

	method void ArmLongPress(string instanceId, string equipName)
		-- 모바일 롱프레스 무장: 이 셀을 눌러 유지하면 UpdateLongPress가 0.5초 뒤 컨텍스트 메뉴를 연다.
		-- PC에서는 _isMobile=false라 아무 것도 하지 않아 기존 우클릭 로직이 그대로 유지된다.
		if self._isMobile == false then return end
		if self._cubeUseMode then return end
		self._pressActive = true
		self._pressFired = false
		self._pressId = instanceId
		self._pressName = equipName
		self._pressStart = _UtilLogic.ElapsedSeconds
		self._pressCursor = _InputService:GetCursorPosition()
	end

	method void UpdateLongPress()
		-- 매 프레임(모바일). 무장된 셀을 계속 누르고 있으면 0.5초 뒤 컨텍스트 메뉴를 연다.
		-- 손가락이 크게 움직이면(스크롤) 취소, 손을 떼면 OnScreenTouchUp에서 취소된다.
		if self._isMobile == false then return end
		if self._pressActive == false or self._pressFired then return end
		-- 이동(스크롤) 감지: 시작 지점에서 50px 이상 벗어나면 롱프레스 취소.
		local cur = _InputService:GetCursorPosition()
		if self._pressCursor ~= nil then
			local dx = cur.x - self._pressCursor.x
			local dy = cur.y - self._pressCursor.y
			if (dx * dx + dy * dy) > (50 * 50) then
				self._pressActive = false
				return
			end
		end
		if (_UtilLogic.ElapsedSeconds - self._pressStart) >= 0.5 then
			self._pressFired = true
			self._pressActive = false
			-- 롱프레스로 확정 → 대기 중이던 더블탭(첫 탭) 취소해 이후 탭이 장착으로 오인되지 않게 한다.
			self._lastClickName = ""
			if self._pressId ~= "" and self._cubeUseMode == false then
				self:OpenContextMenu(self._pressId, self._pressName)
-- 				log("[InventoryPanel] 롱프레스 → 컨텍스트 메뉴: " .. self._pressName .. "(" .. self._pressId .. ")")
			end
		end
	end

	method void OpenContextMenu(string instanceId, string equipName)
		-- 장비 셀 옆(커서 기준 오른쪽 약간 아래)에 3버튼 메뉴를 띄운다.
		if isvalid(self.ctxMenu) == false then return end
		self._ctxTargetId = instanceId
		self._ctxTargetName = equipName
		-- 대상에 맞춰 메뉴 버튼 구성(큐브 셀: 2행 '미라클 큐브 사용/닫기', 장비: 3행). RectSize도 여기서 확정.
		self:ConfigureCtxMenu(instanceId == "__MIRACLE_CUBE__")
		local ut = self.ctxMenu.UITransformComponent
		local center
		if self._isMobile then
			-- 모바일: 커서(터치) 추적 없이 화면 왼쪽에 고정(세로 중앙). 캔버스 ±960 기준, 왼쪽 여백 40.
			local hw = 94
			if isvalid(ut) then hw = ut.RectSize.x * 0.5 end
			center = Vector2(-960 + hw + 40, 0)
		else
			-- PC: 메뉴 중심을 커서 오른쪽으로 약 110px 이동 → 왼쪽 변이 커서 옆에 붙는다.
			local uiPos = _UILogic:ScreenToUIPosition(_InputService:GetCursorPosition())
			center = Vector2(uiPos.x + 110, uiPos.y - 30)
		end
		if isvalid(ut) then
			ut.anchoredPosition = center
		end
		self.ctxMenu.Enable = true
		-- 바깥 클릭 닫기용 영역 저장: 메뉴 중심(anchoredPosition과 동일 UI좌표계)과 크기(RectSize).
		self._ctxCenter = center
		if isvalid(ut) then self._ctxSize = ut.RectSize end
		self._ctxOpenTime = _UtilLogic.ElapsedSeconds
		-- PC: 우클릭 메뉴를 열면 호버 툴팁을 숨긴다. 모바일: 오른쪽 정보 패널을 함께 띄우므로 숨기지 않는다.
		if self._isMobile == false then _EquipTooltip:Hide() end
-- 		log("[InventoryPanel] 컨텍스트 메뉴 열기: " .. equipName)
	end

	method void CloseContextMenu()
		-- 컨텍스트 메뉴 숨김.
		if isvalid(self.ctxMenu) and self.ctxMenu.Enable then
			self.ctxMenu.Enable = false
		end
		self._ctxTargetId = ""
		self._ctxTargetName = ""
		self._ctxCenter = nil
		self._ctxSize = nil
		-- 대기 중이던 롱프레스도 정리(메뉴가 닫히면 재무장 전까지 발동 금지).
		self._pressActive = false
		-- 모바일: 메뉴(왼쪽)와 정보 패널(오른쪽)은 함께 뜨고 함께 닫힌다.
		if self._isMobile then _EquipTooltip:Hide() end
	end

	method void UpdateCtxCubeButton()
		-- 미라클 큐브 보유 시 활성(보라색/흰글씨), 없으면 반투명 비활성 표시.
		if isvalid(self.ctxBtnCube) == false then return end
		local e = self.ctxBtnCube.Entity
		if isvalid(e) == false then return end
		local sr = e.SpriteGUIRendererComponent
		local tc = e:GetComponent("MOD.Core.TextComponent")
		if self:CubeCount() > 0 then
			if isvalid(sr) then sr.Color = Color(0.45, 0.30, 0.62, 1.0) end
			if tc ~= nil then tc.FontColor = Color(1, 1, 1, 1) end
		else
			if isvalid(sr) then sr.Color = Color(0.45, 0.30, 0.62, 0.35) end
			if tc ~= nil then tc.FontColor = Color(1, 1, 1, 0.4) end
		end
	end

	method void SetBtnLabel(ButtonComponent btn, string text)
		-- 컨텍스트 메뉴 버튼의 라벨(TextComponent.Text) 설정.
		if isvalid(btn) == false then return end
		local tc = btn.Entity:GetComponent("MOD.Core.TextComponent")
		if tc ~= nil then tc.Text = text end
	end

	method void SetBtnPos(ButtonComponent btn, number y)
		-- 컨텍스트 메뉴 버튼의 세로 위치(anchoredPosition.y) 설정.
		if isvalid(btn) == false then return end
		local ut = btn.Entity.UITransformComponent
		if isvalid(ut) then ut.anchoredPosition = Vector2(0, y) end
	end

	method void ConfigureCtxMenu(boolean isCube)
		-- 컨텍스트 메뉴 버튼 구성.
		--   큐브 셀: 2행('미라클 큐브 사용' / '닫기') — 가운데 '잠재 재설정' 숨김 + 배경 축소.
		--   장비   : 3행('장착/교체' / '잠재능력 재설정' / '닫기') — 원래 레이아웃 복원.
		local menuUt = self.ctxMenu.UITransformComponent
		if isCube then
			self:SetBtnLabel(self.ctxBtnEquip, "사용한다")
			self:SetBtnPos(self.ctxBtnEquip, 27)
			if isvalid(self.ctxBtnCube) then self.ctxBtnCube.Entity.Enable = false end
			if isvalid(self.ctxBtnForge) then self.ctxBtnForge.Entity.Enable = false end
			self:SetBtnPos(self.ctxBtnClose, -27)
			if isvalid(menuUt) then menuUt.RectSize = Vector2(188, 130) end
		else
			-- 장비: 4행('장착/교체' / '잠재능력 재설정' / '합성' / '닫기'). 행 간격 54.
			self:SetBtnLabel(self.ctxBtnEquip, self._ctxEquipLabel)
			self:SetBtnPos(self.ctxBtnEquip, 81)
			if isvalid(self.ctxBtnCube) then
				self.ctxBtnCube.Entity.Enable = true
				self:SetBtnPos(self.ctxBtnCube, 27)
			end
			if isvalid(self.ctxBtnForge) then
				self.ctxBtnForge.Entity.Enable = true
				self:SetBtnLabel(self.ctxBtnForge, "합성")
				self:SetBtnPos(self.ctxBtnForge, -27)
			end
			self:SetBtnPos(self.ctxBtnClose, -81)
			if isvalid(menuUt) then menuUt.RectSize = Vector2(188, 238) end
			-- 장비 메뉴는 큐브 보유 여부로 '재설정' 버튼 활성/반투명 갱신.
			self:UpdateCtxCubeButton()
		end
	end

	method void OnCtxEquip()
		-- 장비: '장착/교체' → 장착 요청. 큐브 셀: '미라클 큐브 사용' → 사용(장비 선택) 모드 진입.
		_SFXManager:PlayClick()
		local id = self._ctxTargetId
		local name = self._ctxTargetName
		self:CloseContextMenu()
		if id == "" then return end
		if id == "__MIRACLE_CUBE__" then
			-- '사용한다' → 장비 선택 패널 열기(무기/방어구/장신구 탭에서 대상 선택).
			_CubeTargetSelect:Open()
			return
		end
		local p = _UserService.LocalPlayer
		if isvalid(p) then
			---@type BaseEquipment
			local m = _EquipmentRouter:ManagerForItem(p, name)
			if isvalid(m) then m:RequestEquip(id) end
		end
		_EquipTooltip:Hide()
		self:Rebuild()
-- 		log("[InventoryPanel] 컨텍스트: 장착/교체 " .. name .. "(" .. id .. ")")
	end

	method void OnCtxCube()
		-- '잠재능력 재설정': 미라클 큐브가 있을 때만 확인 팝업을 띄운다(없으면 무시 — 버튼 반투명).
		if self:CubeCount() <= 0 then
-- 			log("[InventoryPanel] 컨텍스트: 큐브 없음(비활성 클릭 무시)")
			return
		end
		_SFXManager:PlayClick()
		local id = self._ctxTargetId
		local name = self._ctxTargetName
		self:CloseContextMenu()
		if id == "" or id == "__MIRACLE_CUBE__" then return end
		_EquipTooltip:Hide()
		_CubeConfirmPopup:Open(id, name)
-- 		log("[InventoryPanel] 컨텍스트: 잠재능력 재설정 " .. name .. "(" .. id .. ")")
	end

	method void OnCtxForge()
		-- '합성': 같은 아이템을 재료로 스타포스 강화. 재료 선택 패널을 연다.
		_SFXManager:PlayClick()
		local id = self._ctxTargetId
		local name = self._ctxTargetName
		self:CloseContextMenu()
		if id == "" or id == "__MIRACLE_CUBE__" then return end
		local p = _UserService.LocalPlayer
		if isvalid(p) == false then return end
		---@type BaseEquipment
		local m = _EquipmentRouter:ManagerForInstance(p, id)
		if isvalid(m) == false then return end
		-- 이미 최대 스타포스면 재료 소모 없이 안내만.
		if m:GetStar(id) >= m.MaxStar then
			_CubeConfirmPopup:ShowForgeResult(name, "max", m:GetStar(id))
			return
		end
		-- 같은 EquipName의 다른 인스턴스(재료 후보, 장착품 포함) 개수 확인.
		local matCount = #(m:ForgeMaterialsFor(id, name))
		if matCount <= 0 then
			_CubeConfirmPopup:ShowForgeResult(name, "nomat", 0)
			return
		end
		_EquipTooltip:Hide()
		_CubeTargetSelect:OpenForge(id, name)
-- 		log("[InventoryPanel] 컨텍스트: 합성 " .. name .. "(" .. id .. ") 재료후보=" .. tostring(matCount))
	end

	method void OnCtxClose()
		-- '닫기': 메뉴만 닫는다.
		_SFXManager:PlayClick()
		self:CloseContextMenu()
	end

	method void OnClickMix()
		-- 합성 버튼(BtnMix): 우클릭 없이도 합성 시작. 강화할 '대상(메인)' 장비를 먼저 고르는 선택 패널을 연다.
		-- 대상 선택 → 같은 아이템 재료 선택 → 확률 합성(ForgeManager). 흐름은 CubeTargetSelect가 담당.
		if _CubeTargetSelect ~= nil then _CubeTargetSelect:OpenForgeMainSelect() end
-- 		log("[InventoryPanel] BtnMix → 합성 대상 선택")
	end

	@ExecSpace("ClientOnly")
	method void OnScreenTouchDown(ScreenTouchEvent event)
		-- 컨텍스트 메뉴가 열려 있을 때, 메뉴 영역 밖을 누르면(=다른 부분 클릭/탭) 메뉴를 닫는다.
		-- PC 좌클릭(TouchId=1)과 모바일 탭 모두 이 이벤트로 들어온다. 우클릭(Mouse1)은 발생시키지 않는다.
		if self.isOpen == false then return end
		if isvalid(self.ctxMenu) == false or self.ctxMenu.Enable == false then return end
		-- 방금 연 메뉴가 같은 입력에 즉시 닫히는 것 방지(오픈 직후 가드).
		if (_UtilLogic.ElapsedSeconds - self._ctxOpenTime) < 0.15 then return end
		if self._ctxCenter == nil or self._ctxSize == nil then return end
		-- 메뉴 배치와 동일한 변환(ScreenToUIPosition)으로 터치점을 UI좌표로 바꿔 메뉴 사각형과 비교.
		local uiPt = _UILogic:ScreenToUIPosition(event.TouchPoint)
		local hx = self._ctxSize.x * 0.5
		local hy = self._ctxSize.y * 0.5
		if math.abs(uiPt.x - self._ctxCenter.x) <= hx and math.abs(uiPt.y - self._ctxCenter.y) <= hy then
			-- 메뉴 내부 클릭 → 버튼이 직접 처리하도록 두고 여기서 닫지 않는다(다운에서 닫으면 버튼 클릭이 소실됨).
			return
		end
		self:CloseContextMenu()
-- 		log("[InventoryPanel] 바깥 클릭 → 컨텍스트 메뉴 닫기")
	end

	@ExecSpace("ClientOnly")
	method void OnScreenTouchUp(ScreenTouchReleaseEvent event)
		-- 손가락/버튼을 떼면 대기 중이던 롱프레스를 취소한다(짧은 탭은 메뉴를 열지 않음).
		self._pressActive = false
	end

	method void OnEndPlay()
		-- 셀 핸들(클릭+호버) + 탭 핸들 + ESC 키 핸들 모두 해제.
		if self.escHandler ~= nil then
			_InputService:DisconnectEvent(KeyDownEvent, self.escHandler)
			self.escHandler = nil
		end
		if self.touchDownHandler ~= nil then
			_InputService:DisconnectEvent(ScreenTouchEvent, self.touchDownHandler)
			self.touchDownHandler = nil
		end
		if self.touchUpHandler ~= nil then
			_InputService:DisconnectEvent(ScreenTouchReleaseEvent, self.touchUpHandler)
			self.touchUpHandler = nil
		end
		if self._ctxHandlers ~= nil then
			for _, r in ipairs(self._ctxHandlers) do
				if isvalid(r.entity) and r.evtH ~= nil then
					r.entity:DisconnectEvent(ButtonClickEvent, r.evtH)
				end
			end
		end
		if self.cellHandlers ~= nil then
			for _, r in ipairs(self.cellHandlers) do
				if isvalid(r.entity) and r.stateH ~= nil then
					r.entity:DisconnectEvent(ButtonStateChangeEvent, r.stateH)
				end
			end
		end
		if self._T.tabH ~= nil then
			for _, r in ipairs(self._T.tabH) do
				if isvalid(r.entity) then
					r.entity:DisconnectEvent(ButtonClickEvent, r.evtH)
				end
			end
		end
	end

end