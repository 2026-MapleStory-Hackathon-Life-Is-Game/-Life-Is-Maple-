@Logic
script CubeTargetSelect extends Logic

	property Entity selectRoot = "3d02459c-d51d-478a-80d8-6142730bb198"

	property Entity gridEntity = "d5e60ab2-74bc-4451-abcd-453b08ddc5be"

	property Entity cellPrefab = "c93e88f3-3abb-479d-b474-6d67d15fb7bb"

	property Entity tabWeapon = "4303b187-a324-4d90-8055-30f3d959cda0"

	property Entity tabArmor = "0cfd1b79-1f40-4ad4-a328-7cb6a8686970"

	property Entity tabAccessory = "5d75cb74-e0d6-4230-a529-8d182c42583f"

	property Entity btnClose = "e43f15f7-c443-4f82-9b84-bba10ded8736"

	property string activeCat = "Weapon"

	property boolean isOpen = false

	property any cellHandlers = nil

	property any _tabH = nil

	property boolean _forgeMode = false   -- 합성 재료 선택 모드(큐브 대상 선택과 공용 패널)

	property string _forgeMainId = ""     -- 합성 메인(강화 대상) 인스턴스

	property string _forgeMainName = ""   -- 합성 메인 EquipName(같은 아이템만 재료)

	property boolean _forgeSelectMode = false   -- 합성 '대상(메인)' 선택 모드(BtnMix 진입: 대상 선택 → 재료 선택)

	method void OnBeginPlay()
		-- 클라: 패널 숨김 + GridView 셀 프리팹 주입 + 탭/닫기 버튼 배선.
		if self:IsClient() == false then return end
		self.isOpen = false
		self.activeCat = "Weapon"
		self.cellHandlers = {}
		self._tabH = {}
		
		if isvalid(self.selectRoot) then self.selectRoot.Enable = false end
		
		if isvalid(self.gridEntity) and isvalid(self.cellPrefab) then
			local gvc = self.gridEntity.GridViewComponent
			if gvc ~= nil then
				gvc.ItemEntity = self.cellPrefab
				gvc.UseScroll = true
				gvc.OnRefresh = function(index, cell) self:OnGridCellRefresh(index, cell) end
				gvc.OnClear = function(index, cell) self:OnGridCellClear(index, cell) end
			end
		end
		
		self:WireTab(self.tabWeapon, "Weapon")
		self:WireTab(self.tabArmor, "Armor")
		self:WireTab(self.tabAccessory, "Accessory")
		if isvalid(self.btnClose) then
			local hx = self.btnClose:ConnectEvent(ButtonClickEvent, function()
				_SFXManager:PlayClick()
				self:Close()
			end)
			table.insert(self._tabH, { entity = self.btnClose, evtH = hx })
		end
		
-- 		log("[CubeTargetSelect] OnBeginPlay OK")
	end

	method void WireTab(Entity e, string cat)
		-- 탭 버튼 클릭 → 카테고리 전환.
		if isvalid(e) == false then return end
		local capturedCat = cat
		local h = e:ConnectEvent(ButtonClickEvent, function()
			_SFXManager:PlayClick()
			self:SelectTab(capturedCat)
		end)
		table.insert(self._tabH, { entity = e, evtH = h })
	end

	method integer CubeCount()
		-- 로컬 플레이어의 미라클 큐브 보유 수(없으면 0).
		local p = _UserService.LocalPlayer
		if isvalid(p) == false then return 0 end
		local bag = p:GetComponent("script.CubeInventory")
		if isvalid(bag) == false then return 0 end
		return bag.MiracleCubeCount
	end

	method boolean IsMyTurn()
		-- 멀티 진행 중이면 현재 턴 유저만 인터랙티브 잠재(큐브) 사용 가능. 싱글/비활성은 항상 내 턴 취급.
		if _MultiTurnManager == nil or _MultiTurnManager._isActive == false then return true end
		local p = _UserService.LocalPlayer
		if isvalid(p) == false or p.PlayerComponent == nil then return false end
		return p.PlayerComponent.UserId == _MultiTurnManager._currentPlayerUserId
	end

	@ExecSpace("ClientOnly")
	method void Open()
		-- 선택 패널 열기(큐브 보유 시). 기본 탭 = 무기.
		if self:IsClient() == false then return end
		-- (턴 게이트 제거) 큐브 사용은 이제 '배낭 자체를 내 턴에만 열 수 있게' 막는 것으로 일원화한다(UnderButton.OnClickBag).
		-- 배낭이 유일한 진입로라 여기서 별도 턴 체크는 불필요 — 다른 유저 턴엔 애초에 배낭이 열리지 않는다.
		if self:CubeCount() <= 0 then
-- 			log("[CubeTargetSelect] 큐브 보유 0 — 열지 않음")
			return
		end
		self._forgeMode = false             -- 큐브 모드: 합성 모드 잔재 해제
		self._forgeSelectMode = false       -- 합성 대상 선택 모드 잔재 해제
		self:SetTabsVisible(true)
		self:SetTitle("미라클 큐브 사용 대상 선택")
		self.isOpen = true
		self.activeCat = "Weapon"
		if isvalid(self.selectRoot) then self.selectRoot.Enable = true end
		self:BringToFront()
		self:UpdateTabVisual()
		self:Rebuild()
-- 		log("[CubeTargetSelect] Open")
	end

	@ExecSpace("ClientOnly")
	method void OpenForge(string mainId, string mainName)
		-- 합성 재료 선택: 메인(mainId)과 '같은 EquipName'의 다른 보유 인스턴스만 나열한다(외곽선 포함).
		-- 셀 선택 → CubeConfirmPopup.OpenForge(메인, 재료) → ForgeManager.RequestForge.
		if self:IsClient() == false then return end
		self._forgeMode = true
		self._forgeSelectMode = false       -- 재료 선택 단계로 진입 → 대상 선택 모드 해제
		self._forgeMainId = mainId
		self._forgeMainName = mainName
		self:SetTabsVisible(false)          -- 재료는 항상 같은 아이템(같은 분류) → 탭 불필요
		self:SetTitle("합성 재료 선택 (같은 아이템)")
		self.isOpen = true
		if isvalid(self.selectRoot) then self.selectRoot.Enable = true end
		self:BringToFront()
		self:Rebuild()
-- 		log("[CubeTargetSelect] OpenForge main=" .. mainId .. " (" .. mainName .. ")")
	end

	@ExecSpace("ClientOnly")
	method void OpenForgeMainSelect()
		-- 합성 '대상(메인)' 선택: BtnMix(합성 버튼) 진입점.
		-- 전체 장비를 탭으로 훑어 강화할 장비를 먼저 고른다. 셀 선택 → StartForge → (같은 아이템 재료가 있으면) OpenForge(재료 선택)로 전환.
		if self:IsClient() == false then return end
		self._forgeMode = false
		self._forgeSelectMode = true
		self:SetTabsVisible(true)           -- 대상은 무기/방어구/장신구 전체에서 고른다 → 탭 표시
		self:SetTitle("합성할 장비 선택")
		self.isOpen = true
		self.activeCat = "Weapon"
		if isvalid(self.selectRoot) then self.selectRoot.Enable = true end
		self:BringToFront()
		self:UpdateTabVisual()
		self:Rebuild()
-- 		log("[CubeTargetSelect] OpenForgeMainSelect")
	end

	method void StartForge(string mainId, string mainName)
		-- 합성 대상(메인) 확정: 최대 스타포스/재료 없음 가드 후 재료 선택(OpenForge)으로 전환.
		-- 가드 로직은 InventoryPanel.OnCtxForge와 동일 규칙(같은 EquipName 다른 인스턴스가 있어야 합성 가능).
		local p = _UserService.LocalPlayer
		if isvalid(p) == false then return end
		---@type BaseEquipment
		local m = _EquipmentRouter:ManagerForInstance(p, mainId)
		if isvalid(m) == false then return end
		if m:GetStar(mainId) >= m.MaxStar then
			-- 이미 최대 스타포스 → 재료 소모 없이 안내만.
			self:Close()
			_CubeConfirmPopup:ShowForgeResult(mainName, "max", m:GetStar(mainId))
			return
		end
		local matCount = #(m:ForgeMaterialsFor(mainId, mainName))
		if matCount <= 0 then
			-- 같은 아이템(재료 후보)이 없으면 합성 불가 안내.
			self:Close()
			_CubeConfirmPopup:ShowForgeResult(mainName, "nomat", 0)
			return
		end
		self:OpenForge(mainId, mainName)
-- 		log("[CubeTargetSelect] StartForge main=" .. mainName .. "(" .. mainId .. ") 재료후보=" .. tostring(matCount))
	end

	method void SetTabsVisible(boolean v)
		-- 탭(무기/방어구/장신구) 표시 토글. 합성 모드에선 숨긴다.
		if isvalid(self.tabWeapon) then self.tabWeapon.Enable = v end
		if isvalid(self.tabArmor) then self.tabArmor.Enable = v end
		if isvalid(self.tabAccessory) then self.tabAccessory.Enable = v end
	end

	method void SetTitle(string s)
		-- 패널 제목 텍스트(존재하면). 구조 불명 대비 best-effort(못 찾으면 no-op).
		if isvalid(self.selectRoot) == false then return end
		local t = self.selectRoot:GetChildByName("Title", true)
		if isvalid(t) then
			local tc = t:GetComponent("MOD.Core.TextComponent")
			if tc ~= nil then tc.Text = s end
		end
	end

	method table ForgeMaterialList()
		-- 합성 재료 후보: 메인과 같은 EquipName의 '다른 인스턴스'(장착품 포함, 메인 자신 제외).
		local out = {}
		local p = _UserService.LocalPlayer
		if isvalid(p) == false then return out end
		---@type BaseEquipment
		local m = _EquipmentRouter:ManagerForInstance(p, self._forgeMainId)
		if isvalid(m) == false then return out end
		for _, rec in ipairs(m:ForgeMaterialsFor(self._forgeMainId, self._forgeMainName)) do
			table.insert(out, { id = rec.id, name = rec.name, equipped = rec.equipped })
		end
		return out
	end

	method void Close()
		-- 선택 패널 닫기.
		self.isOpen = false
		self._forgeMode = false             -- 합성 모드 잔재 해제(다음 큐브 열기에 누수 방지)
		self._forgeSelectMode = false       -- 합성 대상 선택 모드 잔재 해제
		if isvalid(self.selectRoot) then self.selectRoot.Enable = false end
	end

	method void BringToFront()
		-- z-order(형제 인덱스) 강제 로직 제거됨.
	end

	method void SelectTab(string cat)
		-- 탭 전환 + 그리드 재구성.
		self.activeCat = cat
		self:UpdateTabVisual()
		self:Rebuild()
	end

	method void UpdateTabVisual()
		-- 활성 탭 파란색, 비활성 어둡게(인벤 탭과 동일 스킴).
		self:TintTab(self.tabWeapon, "Weapon")
		self:TintTab(self.tabArmor, "Armor")
		self:TintTab(self.tabAccessory, "Accessory")
	end

	method void TintTab(Entity e, string cat)
		-- 탭 1개 색 갱신.
		if isvalid(e) == false then return end
		local sr = e.SpriteGUIRendererComponent
		if isvalid(sr) == false then return end
		if cat == self.activeCat then
			sr.Color = Color(0.2, 0.4, 0.7, 1)
		else
			sr.Color = Color(0.25, 0.25, 0.35, 1)
		end
	end

	method table CurrentList()
		-- 현재 탭(카테고리) 장비 목록(인스턴스 레코드): 장착품(있으면 맨 앞) + 보유목록.
		--   각 원소 = { id=인스턴스ID, name=equipName }.
		if self._forgeMode then return self:ForgeMaterialList() end
		local p = _UserService.LocalPlayer
		if isvalid(p) == false then return {} end
		---@type BaseEquipment
		local m = _EquipmentRouter:ManagerFor(p, self.activeCat)
		if isvalid(m) == false then return {} end
		local out = {}
		if m.EquippedId ~= "" and m.Equipped ~= "" then
			table.insert(out, { id = m.EquippedId, name = m.Equipped })
		end
		for _, rec in ipairs(m:OwnedInstancesSorted()) do
			table.insert(out, { id = rec.id, name = rec.name })
		end
		return out
	end

	method void Rebuild()
		-- 현재 목록으로 GridView 재구성.
		if self:IsClient() == false or self.isOpen == false then return end
		local items = self:CurrentList()
		self._T.items = items
-- 		log("[CubeTargetSelect] Rebuild cat=" .. self.activeCat .. " count=" .. tostring(#items))
		if isvalid(self.gridEntity) then
			local gvc = self.gridEntity.GridViewComponent
			if gvc ~= nil then
				gvc.TotalCount = #items
				gvc:Refresh(true, true)
			end
		end
	end

	method void OnGridCellRefresh(integer index, Entity cell)
		-- 셀 1개를 (index+1)번째 장비 인스턴스로 채운다(아이콘 + 표시명).
		local items = self._T.items
		if items == nil then return end
		local rec = items[index + 1]
		if rec == nil then return end
		local name = rec.name
		
		-- 셀은 아이콘만 표시(기획: 아이템명 텍스트는 셀 밖으로 노출하지 않음).
		local rend = cell.SpriteGUIRendererComponent
		local ds = _DataService:GetTable("EquipmentData")
		local ruid = ""
		if isvalid(ds) then
			for i = 1, ds:GetRowCount() do
				if ds:GetCell(i, "EquipName") == name then
					ruid = ds:GetCell(i, "Sprite RUID")
					break
				end
			end
		end
		if isvalid(rend) then
			if ruid ~= "" then
				-- 장비 RUID는 avataritem 타입 → thumbnail:// 접두 + DataRef로 감싸야 렌더된다.
				rend.ImageRUID = DataRef("thumbnail://" .. ruid)
			end
			rend.Color = Color(1, 1, 1, 1)
			-- 잠재 등급 외곽선(인벤토리 셀과 동일 규칙): 인스턴스의 잠재를 조회해 등급색 테두리 적용.
			local pot = ""
			local p = _UserService.LocalPlayer
			if isvalid(p) then
				---@type BaseEquipment
				local mgr = _EquipmentRouter:ManagerForInstance(p, rec.id)
				if isvalid(mgr) then pot = mgr:GetInstancePotential(rec.id) end
			end
			_PotentialManager:ApplyGradeOutline(rend, pot)
		end
		
		-- 이 셀의 기존 핸들러만 교체(누적 방지).
		for i = #self.cellHandlers, 1, -1 do
			local r = self.cellHandlers[i]
			if r.entity == cell then
				if r.stateH ~= nil then cell:DisconnectEvent(ButtonStateChangeEvent, r.stateH) end
				table.remove(self.cellHandlers, i)
			end
		end
		local capturedId = rec.id
		local capturedName = rec.name
		local hs = cell:ConnectEvent(ButtonStateChangeEvent, function(ev)
			self:OnCellState(capturedId, capturedName, ev)
		end)
		table.insert(self.cellHandlers, { entity = cell, stateH = hs })
	end

	method void OnGridCellClear(integer index, Entity cell)
		-- 셀 비활성: 핸들러 해제 + 아이콘/텍스트 초기화.
		local rend = cell.SpriteGUIRendererComponent
		if isvalid(rend) then
			rend.Color = Color(1, 1, 1, 0)
			rend.Outline = false   -- 재활용 셀에 이전 등급 외곽선 잔재 방지.
		end
		for i = #self.cellHandlers, 1, -1 do
			local r = self.cellHandlers[i]
			if r.entity == cell then
				if r.stateH ~= nil then cell:DisconnectEvent(ButtonStateChangeEvent, r.stateH) end
				table.remove(self.cellHandlers, i)
			end
		end
	end

	method boolean MaterialIsEnhanced(string instanceId)
		-- 재료 인스턴스가 스타포스(>0) 또는 잠재능력을 가진 '강화된' 장비인지(실수 소모 방지 경고 대상).
		-- 스타포스(StarById)/잠재(PotentialById) 모두 @Sync라 클라에서 조회 가능.
		if instanceId == "" then return false end
		local p = _UserService.LocalPlayer
		if isvalid(p) == false then return false end
		---@type BaseEquipment
		local mgr = _EquipmentRouter:ManagerForInstance(p, instanceId)
		if isvalid(mgr) == false then return false end
		if mgr:GetStar(instanceId) > 0 then return true end
		if mgr:GetInstancePotential(instanceId) ~= "" then return true end
		return false
	end

	method void OnCellState(string instanceId, string equipName, ButtonStateChangeEvent ev)
		-- 셀 Pressed(=클릭) → 확인 팝업. (GridView 스크롤이 ButtonClickEvent를 먹으므로 Pressed 사용.)
		if ev.state == ButtonState.Pressed then
			_SFXManager:PlayClick()
			if self._forgeMode then
				-- 선택 셀 = 합성 재료. 메인은 _forgeMainId(우클릭한 아이템).
				-- 재료가 스타포스/잠재를 가진 '강화된' 장비면 실수 소모 방지 경고를 먼저 띄운다(예 → 정상 합성확인).
				if self:MaterialIsEnhanced(instanceId) then
					_CubeConfirmPopup:OpenForgeWarn(self._forgeMainId, instanceId, self._forgeMainName)
				else
					_CubeConfirmPopup:OpenForge(self._forgeMainId, instanceId, self._forgeMainName)
				end
-- 				log("[CubeTargetSelect] 재료 선택 → 합성확인: " .. equipName .. "(" .. instanceId .. ")")
			elseif self._forgeSelectMode then
				-- 선택 셀 = 합성 대상(메인). 가드 후 같은 아이템 재료 선택으로 전환.
				self:StartForge(instanceId, equipName)
-- 				log("[CubeTargetSelect] 대상 선택 → 재료 선택: " .. equipName .. "(" .. instanceId .. ")")
			else
				_CubeConfirmPopup:Open(instanceId, equipName)
-- 				log("[CubeTargetSelect] 대상 선택 → 확인: " .. equipName .. "(" .. instanceId .. ")")
			end
		end
	end

	method void OnEndPlay()
		-- 셀/탭/닫기 핸들 해제.
		if self.cellHandlers ~= nil then
			for _, r in ipairs(self.cellHandlers) do
				if isvalid(r.entity) and r.stateH ~= nil then
					r.entity:DisconnectEvent(ButtonStateChangeEvent, r.stateH)
				end
			end
		end
		if self._tabH ~= nil then
			for _, r in ipairs(self._tabH) do
				if isvalid(r.entity) and r.evtH ~= nil then
					r.entity:DisconnectEvent(ButtonClickEvent, r.evtH)
				end
			end
		end
	end

end