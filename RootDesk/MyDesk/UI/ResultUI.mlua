@Logic
script ResultUI extends Logic

	property Entity panel = "c6781735-28fb-4baa-976a-b90e6bf5819e"

	property Entity resultText = "3b182062-1996-4f72-b189-4a0c2f5af47e"

	property ButtonComponent confirmButton = "dbcde8a3-2755-42bb-bf2e-b99f3db2deb4"

	property Entity dimBack = "9379a292-313a-4e73-83f7-e36112f8e358"

	property any hConfirm = nil

	property string groupPath = "/ui/ResultGroup"

	property string cardPath = "/ui/ResultGroup/ResultCard"

	property string dimPath = "/ui/ResultGroup/DimBack"

	property any hCardConfirm = nil

	property any hCardRanking = nil

	property string multiCardPath = "/ui/ResultGroup/MultiResultCard"

	property any hMultiConfirm = nil

	@ExecSpace("ClientOnly")
	method void OnBeginPlay()
		-- 시작 시 결과 패널은 숨김. 확인 버튼 연결.
		if isvalid(self.panel) then self.panel.Enable = false end
		if isvalid(self.confirmButton) then
			self.hConfirm = self.confirmButton.Entity:ConnectEvent(ButtonClickEvent, function() self:Hide() end)
		end
		-- 싱글 리치 카드: 기본 숨김 + 확인/랭킹보기 버튼 배선.
		local card = _EntityService:GetEntityByPath(self.cardPath)
		if isvalid(card) then card.Enable = false end
		local btnC = _EntityService:GetEntityByPath(self.cardPath .. "/BtnArea/BtnConfirm")
		if isvalid(btnC) then
			self.hCardConfirm = btnC:ConnectEvent(ButtonClickEvent, function() self:HideCard() end)
		end
		local btnR = _EntityService:GetEntityByPath(self.cardPath .. "/BtnArea/BtnRanking")
		if isvalid(btnR) then
			self.hCardRanking = btnR:ConnectEvent(ButtonClickEvent, function() self:HideCard() end)
		end
		-- 멀티 결과 카드: 기본 숨김 + 확인 버튼 배선.
		local mcard = _EntityService:GetEntityByPath(self.multiCardPath)
		if isvalid(mcard) then mcard.Enable = false end
		local mBtn = _EntityService:GetEntityByPath(self.multiCardPath .. "/BtnConfirm")
		if isvalid(mBtn) then
			self.hMultiConfirm = mBtn:ConnectEvent(ButtonClickEvent, function() self:HideMulti() end)
		end
	end

	@ExecSpace("ClientOnly")
	method void OnEndPlay()
		if self.hConfirm ~= nil and isvalid(self.confirmButton) then
			self.confirmButton.Entity:DisconnectEvent(ButtonClickEvent, self.hConfirm)
			self.hConfirm = nil
		end
		local btnC = _EntityService:GetEntityByPath(self.cardPath .. "/BtnArea/BtnConfirm")
		if self.hCardConfirm ~= nil and isvalid(btnC) then
			btnC:DisconnectEvent(ButtonClickEvent, self.hCardConfirm)
			self.hCardConfirm = nil
		end
		local btnR = _EntityService:GetEntityByPath(self.cardPath .. "/BtnArea/BtnRanking")
		if self.hCardRanking ~= nil and isvalid(btnR) then
			btnR:DisconnectEvent(ButtonClickEvent, self.hCardRanking)
			self.hCardRanking = nil
		end
		local mBtn = _EntityService:GetEntityByPath(self.multiCardPath .. "/BtnConfirm")
		if self.hMultiConfirm ~= nil and isvalid(mBtn) then
			mBtn:DisconnectEvent(ButtonClickEvent, self.hMultiConfirm)
			self.hMultiConfirm = nil
		end
	end

	method string TypeKo(string t)
		-- 타일 타입키 → 한글 라벨.
		if t == "Village" then return "마을" end
		if t == "Boss" then return "보스" end
		if t == "Unlucky" then return "불행" end
		if t == "Hunt" then return "사냥" end
		if t == "HuntPlus" then return "사냥+" end
		return tostring(t)
	end

	method string TypeJosa(string t)
		-- {타일} 뒤 목적격 조사(받침 유무). 보스만 '를', 나머지(마을/불행/사냥/사냥+)는 '을'.
		if t == "Boss" then return "를" end
		return "을"
	end

	@ExecSpace("Client")
	method void ShowSingle(string name, integer power, string job, string camp, integer rank, boolean isNewRecord, string avatar, integer minutes, string lifeInfo, string titleType, integer turns, integer visits)
		-- 싱글 완주 리치 결과 카드(엔딩 요약 통합본).
		-- 좌측 아바타(캡처 코디) + 우측 통계(플레이시간/인생분기/랭킹/전투력) + 최다방문 타이틀 + 신기록/신원.
		_SFXManager:PlayWin()
		local card = _EntityService:GetEntityByPath(self.cardPath)
		if isvalid(card) == false then return end
		local grp = _EntityService:GetEntityByPath(self.groupPath)
		if isvalid(grp) then grp.Enable = true end
		local dim = _EntityService:GetEntityByPath(self.dimPath)
		if isvalid(dim) then dim.Enable = true end
		
		-- 전투력(값). 라벨(PowerCap/RankBig/TotalPlaytime/LifeBranch)은 .ui 고정 문구.
		self:SetCardText("PowerBig", _RankingManager:FormatPower(power))
		-- 랭킹(값): 기록 제출 후 계산된 전체 순위.
		if rank > 0 then
			self:SetCardText("RankBig_1", "전체 " .. tostring(rank) .. "위")
		else
			self:SetCardText("RankBig_1", "-")
		end
		-- 총 플레이 시간(값).
		self:SetCardText("TotalPlaytime_1", tostring(minutes) .. "분")
		-- 인생 분기(값): 길드/애인 등.
		if lifeInfo ~= nil and lifeInfo ~= "" then
			self:SetCardText("LifeBranch_1", lifeInfo)
		else
			self:SetCardText("LifeBranch_1", "-")
		end
		-- 최다 방문 전문가 타이틀(전체폭 문구).
		if titleType ~= nil and titleType ~= "" then
			local ko = self:TypeKo(titleType)
			self:SetCardText("LifeBranch_2", "총 " .. tostring(turns) .. "턴 중 " .. ko .. self:TypeJosa(titleType)
				.. " " .. tostring(visits) .. "번으로 최다 방문하셨습니다!\n"
				.. ko .. " 전문가 타이틀을 획득하셨습니다!")
		else
			self:SetCardText("LifeBranch_2", "")
		end
		local badge = _EntityService:GetEntityByPath(self.cardPath .. "/Badge")
		if isvalid(badge) then badge.Enable = isNewRecord end
		self:SetCardText("Val_Name", tostring(name))
		self:SetCardText("Val_Job", _RankingManager:JobKo(tostring(job)))
		self:SetCardText("Val_Camp", _RankingManager:CampKo(tostring(camp)))
		
		-- 아바타: 완주자=로컬 플레이어. 계정 기본 체형 위에 캡처한 게임 코디를 덮어씀.
		local av = _EntityService:GetEntityByPath(self.cardPath .. "/Avatar")
		if isvalid(av) and isvalid(av.CostumeManagerComponent) then
			local cm = av.CostumeManagerComponent
			cm.UseCustomEquipOnly = false
			local me = _UserService.LocalPlayer
			if isvalid(me) and me.PlayerComponent ~= nil then
				cm.DefaultEquipUserId = tostring(me.PlayerComponent.UserId)
			end
			_RankingManager:ApplyCostume(cm, tostring(avatar))
		end
		
		card.Enable = true
		log("[ResultUI] ShowSingle(통합) name=" .. tostring(name) .. " power=" .. tostring(power)
			.. " rank=" .. tostring(rank) .. " min=" .. tostring(minutes) .. " turns=" .. tostring(turns)
			.. " visits=" .. tostring(visits) .. " title=" .. tostring(titleType) .. " life=" .. tostring(lifeInfo))
	end

	@ExecSpace("ClientOnly")
	method void SetCardText(string node, string text)
		-- 결과 카드 내부 텍스트 노드 Text 설정.
		local e = _EntityService:GetEntityByPath(self.cardPath .. "/" .. node)
		if isvalid(e) and isvalid(e.TextComponent) then e.TextComponent.Text = text end
	end

	@ExecSpace("ClientOnly")
	method void HideCard()
		-- 결과 카드 닫기 → 로딩 오버레이로 Map_03→로비 전환을 가린 뒤 서버에 로비 복귀 요청.
		_SFXManager:PlayClick()
		-- 먼저 로딩 오버레이를 띄운다(로컬 즉시, 카드보다 위). 그 아래에서 카드/딤/그룹을 끄고 텔레포트가 진행돼도 안 보인다.
		_LoadingManager:ShowLoadingAndPreload()
		local card = _EntityService:GetEntityByPath(self.cardPath)
		if isvalid(card) then card.Enable = false end
		local dim = _EntityService:GetEntityByPath(self.dimPath)
		if isvalid(dim) then dim.Enable = false end
		local grp = _EntityService:GetEntityByPath(self.groupPath)
		if isvalid(grp) then grp.Enable = false end
		-- 로비 복귀 + 스탯 초기화(서버). 로딩 오버레이는 최소표시시간 후 자동으로 걷혀 로비를 드러낸다.
		_GameModeManager:ReturnToLobbyAfterResult()
	end

	@ExecSpace("ClientOnly")
	method void Show(string message)
		_SFXManager:PlayWin()   -- 결과(승리) 팡파르
		-- 부모 UIGroup(ResultGroup)이 기본 비활성이라 panel/dim만 켜면 안 보인다. 그룹을 켜고 맨 앞으로.
		local grp = isvalid(self.panel) and self.panel.Parent or nil
		if isvalid(grp) then grp.Enable = true end
		if isvalid(self.dimBack) then self.dimBack.Enable = true end
		if isvalid(self.panel) then self.panel.Enable = true end
		if isvalid(self.resultText) then
			self.resultText.TextComponent.Text = message
		end
		log("[ResultUI] 결과 표시: " .. message)
	end

	@ExecSpace("ClientOnly")
	method void Hide()
		-- 확인 → 결과 패널 닫기 (이미 로비로 복귀된 상태).
		_SFXManager:PlayClick()
		if isvalid(self.panel) then self.panel.Enable = false end
		if isvalid(self.dimBack) then self.dimBack.Enable = false end
		local grp = isvalid(self.panel) and self.panel.Parent or nil
		if isvalid(grp) then grp.Enable = false end
		log("[ResultUI] 결과 닫힘")
	end

	@ExecSpace("ClientOnly")
	method void SetMultiText(integer row, string node, string text)
		-- 멀티 카드 행 텍스트 노드 Text 설정.
		local e = _EntityService:GetEntityByPath(self.multiCardPath .. "/MRow" .. tostring(row) .. "/" .. node)
		if isvalid(e) and isvalid(e.TextComponent) then e.TextComponent.Text = text end
	end

	@ExecSpace("Client")
	method void ShowMulti(table names, table powers, table jobs, table camps, table avatars, table userIds, integer winnerIndex)
		-- 멀티 매치 결과 리치 순위표(최대 4행). 각 행 아바타+순위+이름+전투력+직업+진영, 1위 우승 배지.
		_SFXManager:PlayWin()
		local grp = _EntityService:GetEntityByPath(self.groupPath)
		if isvalid(grp) then grp.Enable = true end
		local dim = _EntityService:GetEntityByPath(self.dimPath)
		if isvalid(dim) then dim.Enable = true end
		local card = _EntityService:GetEntityByPath(self.multiCardPath)
		if isvalid(card) == false then return end

		local n = #names
		for i = 1, 4 do
			local row = _EntityService:GetEntityByPath(self.multiCardPath .. "/MRow" .. tostring(i))
			if isvalid(row) then row.Enable = (i <= n) end
			if i <= n then
				self:SetMultiText(i, "Rank", tostring(i) .. "위")
				self:SetMultiText(i, "Name", tostring(names[i]))
				self:SetMultiText(i, "Power", "전투력 " .. _RankingManager:FormatPower(powers[i]))
				self:SetMultiText(i, "Job", _RankingManager:JobKo(tostring(jobs[i])))
				self:SetMultiText(i, "Camp", _RankingManager:CampKo(tostring(camps[i])))
				local badge = _EntityService:GetEntityByPath(self.multiCardPath .. "/MRow" .. tostring(i) .. "/WinnerBadge")
				if isvalid(badge) then badge.Enable = (i == winnerIndex) end
				local av = _EntityService:GetEntityByPath(self.multiCardPath .. "/MRow" .. tostring(i) .. "/Avatar")
				if isvalid(av) and isvalid(av.CostumeManagerComponent) then
					local cm = av.CostumeManagerComponent
					cm.UseCustomEquipOnly = false
					cm.DefaultEquipUserId = tostring(userIds[i])
					_RankingManager:ApplyCostume(cm, tostring(avatars[i]))
				end
			end
		end
		card.Enable = true
		log("[ResultUI] ShowMulti rows=" .. tostring(n) .. " winner=" .. tostring(winnerIndex))
	end

	@ExecSpace("ClientOnly")
	method void HideMulti()
		-- 멀티 결과 카드 닫기 → 로딩 오버레이로 룸 전환을 가린 뒤 per-user 로비 복귀(싱글 HideCard와 동일).
		_SFXManager:PlayClick()
		_LoadingManager:ShowLoadingAndPreload()
		local card = _EntityService:GetEntityByPath(self.multiCardPath)
		if isvalid(card) then card.Enable = false end
		local dim = _EntityService:GetEntityByPath(self.dimPath)
		if isvalid(dim) then dim.Enable = false end
		local grp = _EntityService:GetEntityByPath(self.groupPath)
		if isvalid(grp) then grp.Enable = false end
		_GameModeManager:ReturnToLobbyAfterResult()
	end

end