@Logic
script EndingSummaryUI extends Logic

	-- 엔딩 정리 표(검은 마법사와 대적한 자의 기록). 검은마법사 최종전 종료(승/패 무관) 후 표시하고,
	-- '다음'을 누르면 서버(GameModeManager:OnEndingSummaryNext)로 신호 → 기존 결과화면(ResultGroup)으로 이어진다.
	-- 데이터는 서버(GameModeManager:ShowEndingSummary)가 Show(...) Client RPC로 소유자 클라에 넘겨준다.
	-- UIBuilder 바인딩 주입으로 아래 참조가 채워진다.

	property Entity dimBack = "1e6a6dd3-2593-4fa2-9283-434a94a21d11"            -- 전체 딤
	property Entity panel = "cf6b57b3-8efb-4e99-bffe-c3131033486b"             -- 기록 카드 패널
	property TextComponent titleText = "c23599d2-e12a-45b5-a5b7-f220c3cefc01"      -- 상단 제목
	property TextComponent statsText = "1d51f7ea-56e4-4854-931e-f27fdc56e700"      -- 시간/턴/전투력/랭킹
	property TextComponent awardText = "6cfe3ef9-3ff5-4b25-a740-e8c9aa48ecc0"      -- "{타일} 전문가 타이틀..."
	property TextComponent identityText = "de83cab6-9b47-4a9f-b466-be5c10f204e6"   -- 진영 · 직업 · 닉네임
	property Entity nextButton = "75f77008-466d-4fef-af31-a6735174ab4d"

	property any _nextH = nil

	@ExecSpace("ClientOnly")
	method void OnBeginPlay()
		-- 평소엔 숨김(그룹 루트는 DefaultShow 유지, 내부만 토글).
		self:HideParts()
	end

	@ExecSpace("ClientOnly")
	method void HideParts()
		-- 딤 + 패널 숨김.
		if isvalid(self.dimBack) then self.dimBack.Enable = false end
		if isvalid(self.panel) then self.panel.Enable = false end
	end

	method string TypeKo(string t)
		-- 타일 타입키 → 한글 라벨.
		if t == "Village" then return "마을" end
		if t == "Boss" then return "보스" end
		if t == "Unlucky" then return "불행" end
		if t == "Hunt" then return "사냥" end
		if t == "HuntPlus" then return "사냥+" end
		return tostring(t)
	end

	method string TypeJosa(string t)
		-- {타일} 뒤 목적격 조사(받침 유무). 보스만 '를', 나머지(마을/불행/사냥/사냥+)는 '을'.
		if t == "Boss" then return "를" end
		return "을"
	end

	@ExecSpace("Client")
	method void Show(string name, string job, string camp, integer power, integer minutes, integer turns, integer visits, string titleType, string lifeInfo, integer rankPercent)
		-- 소유자 클라에서 정리 표를 채우고 표시한다. (targetUserId는 호출측 마지막 인자로 전달)
		if isvalid(self.titleText) then self.titleText.Text = "검은 마법사와 대적한 자의 기록" end

		-- 통계(시간/턴/전투력/랭킹).
		local powS = tostring(power)
		if isvalid(_RankingManager) then powS = _RankingManager:FormatPower(power) end
		local lines = "총 플레이 시간 : " .. tostring(minutes) .. "분"
		if lifeInfo ~= nil and lifeInfo ~= "" then
			lines = lines .. "\n인생 분기 : " .. lifeInfo
		end
		lines = lines .. "\n최종 전투력 : " .. powS
		if rankPercent >= 1 then
			lines = lines .. "\n랭킹 : 상위 " .. tostring(rankPercent) .. "%"
		end
		if isvalid(self.statsText) then self.statsText.Text = lines end

		-- 전문가 타이틀(가장 많이 방문한 타일: 총 N턴 중 M번 방문).
		if isvalid(self.awardText) then
			if titleType ~= nil and titleType ~= "" then
				local ko = self:TypeKo(titleType)
				self.awardText.Text = "총 " .. tostring(turns) .. "턴 중 " .. ko .. self:TypeJosa(titleType)
					.. " " .. tostring(visits) .. "번으로 최다 방문하셨습니다!\n"
					.. ko .. " 전문가 타이틀을 획득하셨습니다!"
			else
				self.awardText.Text = ""
			end
		end

		-- 신원: 진영 · 직업 · 닉네임(직업/진영은 한글화).
		local jobKo = tostring(job)
		local campKo = tostring(camp)
		if isvalid(_RankingManager) then
			jobKo = _RankingManager:JobKo(job)
			campKo = _RankingManager:CampKo(camp)
		end
		if isvalid(self.identityText) then
			self.identityText.Text = campKo .. " · " .. jobKo .. " · " .. tostring(name)
		end

		-- 표시 + '다음' 배선.
		if isvalid(self.dimBack) then self.dimBack.Enable = true end
		if isvalid(self.panel) then self.panel.Enable = true end
		self:WireNext()
		log("[EndingSummaryUI] Show name=" .. tostring(name) .. " turns=" .. tostring(turns) .. " min=" .. tostring(minutes))
	end

	@ExecSpace("ClientOnly")
	method void WireNext()
		-- '다음' 버튼 클릭 연결.
		self:UnwireNext()
		if isvalid(self.nextButton) then
			self._nextH = self.nextButton:ConnectEvent(ButtonClickEvent, function() self:OnNext() end)
		end
	end

	@ExecSpace("ClientOnly")
	method void UnwireNext()
		-- '다음' 버튼 클릭 해제.
		if isvalid(self.nextButton) and self._nextH ~= nil then
			self.nextButton:DisconnectEvent(ButtonClickEvent, self._nextH)
		end
		self._nextH = nil
	end

	@ExecSpace("ClientOnly")
	method void OnNext()
		-- '다음' → 정리 표 닫고 서버에 진행 신호(→ 기존 결과화면).
		if _SFXManager ~= nil then _SFXManager:PlayClick() end
		self:HideParts()
		self:UnwireNext()
		_GameModeManager:OnEndingSummaryNext()
	end

	@ExecSpace("ClientOnly")
	method void OnEndPlay()
		self:UnwireNext()
	end

end
