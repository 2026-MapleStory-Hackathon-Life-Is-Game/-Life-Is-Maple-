@Logic
script RollResultDiceAnimationUI extends Logic

	property Entity panel = "3f6e7924-909b-4856-bff4-06a1c4d4169a"

	property Entity groupRoot = "e507219b-ec70-41f0-bd59-a00a82974aa2"

	property SpriteGUIRendererComponent leftDice = "5e5ae24c-e218-4e4c-a54b-a35ce41cb108"

	property SpriteGUIRendererComponent rightDice = "03c56c53-dbfe-44c6-a3de-98baf3d3aa1f"

	property Entity leftDiceEntity = "5e5ae24c-e218-4e4c-a54b-a35ce41cb108"

	property Entity leftOneDiceEntity = "ba870c13-a3fc-46ad-aa60-de31d4e3e0d5"

	property Entity rightDiceEntity = "03c56c53-dbfe-44c6-a3de-98baf3d3aa1f"

	property Entity rightOneDiceEntity = "a2882f64-00e3-4d68-a301-508f0fd16950"

	property TextGUIRendererComponent resultText = "c65cf185-345f-41a1-a867-23e77171d5fb"

	property TextGUIRendererComponent outcomeText = "33f06587-7ac8-46a9-8eca-80d1fc82a638"

	property table diceSprites = {}

	property Entity diceParticle = "6aa0244c-966a-4524-84e9-206362ba02c9"

	property TextGUIRendererComponent two_Value = "b260fb78-d608-402d-afca-7696ac9c774e"

	property TextGUIRendererComponent three_Value = "0654d502-c9a9-4f20-98dd-a59d8702d03a"

	property TextGUIRendererComponent four_Value = "a1a2e2ed-b9f6-4b86-b6de-08ec21930056"

	property TextGUIRendererComponent five_Value = "e59f674d-afcc-4447-9200-320417073414"

	property TextGUIRendererComponent six_Value = "70bc444b-f0e0-4c8e-a5ab-12fba680f693"

	property TextGUIRendererComponent seven_Value = "017eaf63-e989-4ec9-b8d1-65dfd9c26f3c"

	property TextGUIRendererComponent eight_Value = "521fbbbd-6ecc-49c5-bbe3-5e45a99b00ee"

	property TextGUIRendererComponent nine_Value = "5212b687-952d-4ac2-9cb9-4b82772ba852"

	property TextGUIRendererComponent ten_Value = "e0b0ae19-2671-4d2c-bcf2-f1b48d81e518"

	property TextGUIRendererComponent eleven_Value = "415e430e-e1c7-4209-87e6-57883706b90a"

	property TextGUIRendererComponent twelve_Value = "8c4863cd-02ba-4353-8852-3a1c4956ff64"

	property number GreatPct = 0

	property number SuccessPct = 0

	property number FailPct = 0

	property table currentBoard = {}

	property Entity dicePanel = "3b312053-872f-4bec-a474-1b1b68e0aa3d"

	property Entity RollButton = "52b49e3f-d66f-4fc2-818c-69e1e8402e00"

	property Entity NextButton = "3de88156-4c22-4ee0-93f3-0258ac4f81b9"

	property Entity SkipButton = "18c0fa93-a724-4ae3-a5d0-59b235e679c4"

	property Entity ResultTextPanel = "9ba7d4bd-f38a-4fd4-ac7c-679c2afba32b"

	property integer _pendD1 = 0

	property integer _pendD2 = 0

	property integer _pendTotal = 0

	property string _pendOutcome = ""

	property any _pendOnComplete = nil

	property string _pendActorUserId = ""

	property boolean _pendAllowNext = false

	property boolean _allowSkip = false   -- 완주자 대기 큐브 롤에서만 '넘기기' 버튼 노출(피드백: 30초 동안 배낭 열 시간 확보)

	property number SpectatorBoardHold = 1.0

	property number SpectatorResultHold = 4.0

	property integer _spectatorTimer1 = 0

	property integer _spectatorTimer2 = 0

	property integer _revealTextTimer = 0

	@ExecSpace("ClientOnly")
	method void OnBeginPlay()
		-- 눈금별 RUID 등록 (실제 RUID로 교체)
		        self.diceSprites = {
		            "3ce426e0210343438871297e2806d951", "a2ab7e2cb3734c6d9d35e09b602670aa", "9d70f5c455fe451390e27367fc3692f2",
					"e5851bea94954232bfca1aac0e13c8a9", "8fe157aa853a45f78703e04bb5cb7894", "b302d911b3c64014b000b494a95898dc",
		        }
		        if isvalid(self.panel) then
		            self.panel.Enable = false   -- 평소엔 숨김
		        end
		        -- '굴리기' 버튼 클릭 → 실제 주사위 굴림(OnRollClicked). 평소엔 숨김(패널이 뜰 때만 노출).
		        if isvalid(self.RollButton) then
		            self.RollButton:ConnectEvent(ButtonClickEvent, self.OnRollClicked)
		            self.RollButton.Enable = false
		        end
		        -- '다음' 버튼 클릭 → 결과 확인 후 진행(OnNextClicked). 평소엔 숨김.
		        if isvalid(self.NextButton) then
		            self.NextButton:ConnectEvent(ButtonClickEvent, self.OnNextClicked)
		            self.NextButton.Enable = false
		        end
		        -- '넘기기' 버튼 클릭 → 완주자 대기 큐브 롤 즉시 종료(OnSkipClicked). 평소엔 숨김(_allowSkip일 때만 노출).
		        if isvalid(self.SkipButton) then
		            self.SkipButton:ConnectEvent(ButtonClickEvent, self.OnSkipClicked)
		            self.SkipButton.Enable = false
		        end

				-- 결과 알려주는 패널 비활성화
				if isvalid(self.ResultTextPanel) then
					self.ResultTextPanel.Enable = false
				end
		
				-- 주사위 눈금 표시를 기본 상태(일반 주사위 활성 / 전용 '1' 주사위 비활성)로 초기화.
				self:ResetDiceFaces()
		
	end

	@ExecSpace("ClientOnly")
	method void ResetDiceFaces()
		-- 다음 판을 위해 전용 '1' 주사위는 끄고 일반 주사위를 켠 기본 상태로 되돌린다.
		if isvalid(self.leftOneDiceEntity) then self.leftOneDiceEntity.Enable = false end
		if isvalid(self.rightOneDiceEntity) then self.rightOneDiceEntity.Enable = false end
		if isvalid(self.leftDiceEntity) then self.leftDiceEntity.Enable = true end
		if isvalid(self.rightDiceEntity) then self.rightDiceEntity.Enable = true end
	end

	@ExecSpace("ClientOnly")
	method void ApplyDieFace(integer value, SpriteGUIRendererComponent normalDice, table sprites, Entity normalEntity, Entity oneEntity)
		-- 눈금이 1이면 일반 주사위를 끄고 전용 '1' 주사위를 켠다. 그 외 눈금이면 일반 주사위에 해당 스프라이트를 적용.
		if value == 1 then
			if isvalid(normalEntity) then normalEntity.Enable = false end
			if isvalid(oneEntity) then oneEntity.Enable = true end
		else
			if isvalid(oneEntity) then oneEntity.Enable = false end
			if isvalid(normalEntity) then normalEntity.Enable = true end
			if isvalid(normalDice) then normalDice.ImageRUID = sprites[value] end
		end
	end

	@ExecSpace("ClientOnly")
	method void Show(integer d1, integer d2, integer total, table resultTable, string gameOutcome, any onComplete)
		-- 변경: 패널이 뜨면 자동으로 굴리지 않는다. 보드(2~12) + '굴리기' 버튼만 표시하고,
		--       플레이어가 굴리기 버튼을 눌러야(OnRollClicked) 실제 주사위 결과가 연출된다.
			if self._spectatorTimer1 ~= 0 then _TimerService:ClearTimer(self._spectatorTimer1) self._spectatorTimer1 = 0 end
			if self._spectatorTimer2 ~= 0 then _TimerService:ClearTimer(self._spectatorTimer2) self._spectatorTimer2 = 0 end
			if self._revealTextTimer ~= 0 then _TimerService:ClearTimer(self._revealTextTimer) self._revealTextTimer = 0 end
				-- 굴리기 시 사용할 결과 데이터 보관.
				self._pendActorUserId = ""   -- 싱글 경로 표식
				self._pendD1 = d1
				self._pendD2 = d2
				self._pendTotal = total
				self._pendOutcome = gameOutcome
				self._pendOnComplete = onComplete
		
				self:UpdateBoardUI(resultTable)   -- 보드 텍스트(대성공/성공/실패) 갱신
		
				-- 패널 켜고 앞으로. 굴리기 전에는 주사위/결과/반짝임을 숨기고 굴리기 버튼만 노출.
				self.panel.Enable = true
				self:BringToFront()   -- EventTileGroup 등 다른 그룹 위로 강제(그룹 순서 churn 방지)
				if isvalid(self.dicePanel) then self.dicePanel.Enable = false end
				if isvalid(self.diceParticle) then self.diceParticle.Enable = false end
				if isvalid(self.RollButton) then self.RollButton.Enable = true end
				if isvalid(self.NextButton) then self.NextButton.Enable = false end
				-- '넘기기'는 완주자 대기 큐브 롤(_allowSkip)에서만 노출. 그 외 롤에선 숨김.
				if isvalid(self.SkipButton) then self.SkipButton.Enable = self._allowSkip end
				if isvalid(self.ResultTextPanel) then self.ResultTextPanel.Enable = false end
-- 				log("[RollResultDiceUI] Show → 패널 표시, 굴리기 버튼 대기(수동). RollBtn=" .. tostring(isvalid(self.RollButton)) .. " allowSkip=" .. tostring(self._allowSkip))
	end

	@ExecSpace("ClientOnly")
	method void OnRollClicked()
		-- '굴리기' 클릭. 멀티면 서버에 공개 요청(전원 방송), 싱글이면 로컬 연출 후 '다음' 노출.
			if self._pendActorUserId ~= "" then
				if isvalid(self.RollButton) then self.RollButton.Enable = false end
				_MultiTurnManager:RequestRevealResultDice()
				return
			end
			if isvalid(self.RollButton) then self.RollButton.Enable = false end
			if isvalid(self.SkipButton) then self.SkipButton.Enable = false end
			self:PlayRevealAnimation()
			self._pendAllowNext = true   -- '다음'은 공개 연출(2초) 종료 후에만 노출(결과 확정 전 조기 진행/공개 방지)
			-- 관전자에게도 이 순간(actor가 실제 굴린 시점)에만 공개를 방송한다(서버 경유). actor 본인은 위에서 로컬 연출 재생.
			local myId = ""
			local lp = _UserService.LocalPlayer
			if isvalid(lp) then myId = lp.PlayerComponent.UserId end
			self:RequestSpectatorRoll(self._pendD1, self._pendD2, self._pendTotal, self._pendOutcome, myId)
-- 			log("[RollResultDiceUI] 굴리기 클릭 → 주사위 연출(끝난 뒤 '다음' 노출) + 관전자 공개 방송")
	end

	@ExecSpace("ClientOnly")
	method void PlayRevealAnimation()
			-- 공유: 주사위 눈/반짝임 표시 + 2초 후 합계/결과 텍스트. 싱글·멀티 공용(_pend* 값 사용).
			-- 진입 시 '다음' 노출 플래그를 내린다. 호출자(OnRollClicked/RevealMulti)가 호출 직후 다시 켠다.
			-- 관전자 공개 경로(SpectatorRevealDice)는 켜지 않으므로 false 유지 → 관전자에겐 '다음' 버튼이 안 뜬다.
			self._pendAllowNext = false
			if isvalid(self.SkipButton) then self.SkipButton.Enable = false end   -- 굴림이 시작되면 '넘기기' 숨김
			if self._revealTextTimer ~= 0 then _TimerService:ClearTimer(self._revealTextTimer) self._revealTextTimer = 0 end
			_SFXManager:PlayDice()
			if isvalid(self.dicePanel) then self.dicePanel.Enable = true end
			if isvalid(self.diceParticle) then self.diceParticle.Enable = true end
			self:ApplyDieFace(self._pendD1, self.leftDice, self.diceSprites, self.leftDiceEntity, self.leftOneDiceEntity)
			self:ApplyDieFace(self._pendD2, self.rightDice, self.diceSprites, self.rightDiceEntity, self.rightOneDiceEntity)
			self._revealTextTimer = _TimerService:SetTimerOnce(function()
				self._revealTextTimer = 0
				_ResultDiceManager:PlayTotalResultDiceSFX(self._pendTotal)
				if isvalid(self.ResultTextPanel) then self.ResultTextPanel.Enable = true end
				self.resultText.Text = tostring(self._pendTotal)
				self.outcomeText.Text = self._pendOutcome .. "!"
				-- 결과가 완전히 드러난 뒤에만 '다음'을 노출한다(대사/결과 조기 진행·조기 공개 차단).
				if self._pendAllowNext and isvalid(self.NextButton) then self.NextButton.Enable = true end
			end, 2.0)
	end

	@ExecSpace("ClientOnly")
	method void ClosePanel()
			-- 공유: 결과 패널 닫기 + 반짝임 종료 + 주사위면 초기화. 싱글·멀티 공용(onComplete/상태진행은 호출자 담당).
			if self._revealTextTimer ~= 0 then _TimerService:ClearTimer(self._revealTextTimer) self._revealTextTimer = 0 end
			if isvalid(self.NextButton) then self.NextButton.Enable = false end
			if isvalid(self.SkipButton) then self.SkipButton.Enable = false end
			self._allowSkip = false   -- 롤 종료 시 스킵 허용 해제(다음 롤로 누수 방지)
			if isvalid(self.panel) then self.panel.Enable = false end
			if isvalid(self.diceParticle) then self.diceParticle.Enable = false end
			self:ResetDiceFaces()
	end

	@ExecSpace("ClientOnly")
	method void OnNextClicked()
		-- '다음' 클릭. 멀티면 서버에 종료 요청(닫기 방송 + 상태 진행), 싱글이면 로컬 닫기 + onComplete.
			if self._pendActorUserId ~= "" then
				if isvalid(self.NextButton) then self.NextButton.Enable = false end
				_MultiTurnManager:RequestFinishResultDice()
				return
			end
			self:ClosePanel()
			local onComplete = self._pendOnComplete
			self._pendOnComplete = nil   -- 재진입/중복 실행 방지
-- 			log("[RollResultDiceUI] 다음 클릭 → 패널 닫고 onComplete 실행. cb=" .. tostring(onComplete ~= nil))
			if onComplete ~= nil then
				onComplete()
			end
	end

	@ExecSpace("ClientOnly")
	method void ShowMulti(integer d1, integer d2, integer total, table resultTable, string gameOutcome, string actorUserId)
			-- 멀티: 결과 보드를 전원에게 표시. 현재 턴 플레이어(actor)만 '굴리기' 버튼 노출, 나머지는 관전(대기).
			if self._spectatorTimer1 ~= 0 then _TimerService:ClearTimer(self._spectatorTimer1) self._spectatorTimer1 = 0 end
			if self._spectatorTimer2 ~= 0 then _TimerService:ClearTimer(self._spectatorTimer2) self._spectatorTimer2 = 0 end
			if self._revealTextTimer ~= 0 then _TimerService:ClearTimer(self._revealTextTimer) self._revealTextTimer = 0 end
			self._pendD1 = d1
			self._pendD2 = d2
			self._pendTotal = total
			self._pendOutcome = gameOutcome
			self._pendOnComplete = nil
			self._pendActorUserId = actorUserId

			self:UpdateBoardUI(resultTable)
			self.panel.Enable = true
			self:BringToFront()
			if isvalid(self.dicePanel) then self.dicePanel.Enable = false end
			if isvalid(self.diceParticle) then self.diceParticle.Enable = false end
			if isvalid(self.ResultTextPanel) then self.ResultTextPanel.Enable = false end
			if isvalid(self.NextButton) then self.NextButton.Enable = false end
			if isvalid(self.SkipButton) then self.SkipButton.Enable = false end   -- 턴 결과 주사위엔 '넘기기' 없음

			local isActor = false
			local lp = _UserService.LocalPlayer
			if isvalid(lp) and lp.PlayerComponent ~= nil and lp.PlayerComponent.UserId == actorUserId then isActor = true end
			if isvalid(self.RollButton) then self.RollButton.Enable = isActor end
-- 			log("[RollResultDiceUI] ShowMulti actor=" .. actorUserId .. " isActor=" .. tostring(isActor))
	end

	@ExecSpace("ClientOnly")
	method void RevealMulti()
			-- 멀티: 전원 동시에 주사위 공개 연출. actor에게만 '다음' 버튼 노출.
			self:PlayRevealAnimation()
			local isActor = false
			local lp = _UserService.LocalPlayer
			if isvalid(lp) and lp.PlayerComponent ~= nil and lp.PlayerComponent.UserId == self._pendActorUserId then isActor = true end
			self._pendAllowNext = isActor   -- actor에게만, 그리고 공개 연출(2초) 종료 후에 '다음' 노출(조기 진행/공개 방지)
	end

	@ExecSpace("ClientOnly")
	method void CloseMulti()
			-- 멀티: 전원 패널 닫기(상태 진행은 서버가 소유하므로 onComplete 없음).
			self:ClosePanel()
			if isvalid(self.RollButton) then self.RollButton.Enable = false end
			self._pendActorUserId = ""
	end

	@ExecSpace("Client")
	method void SpectatorDiceBroadcast(integer d1, integer d2, integer total, table resultTable, string gameOutcome, string actorUserId)
		-- 관전자(비-actor)에게 결과 주사위 '보드'만 먼저 표시하고, actor가 실제로 굴린 순간(SpectatorRevealDice)에만 공개한다.
		-- (변경 전엔 롤 시작 시 타이머로 자동 공개 → actor가 굴리기 전에 결과가 노출되던 문제 수정.) actor는 자기 인터랙티브 경로를 쓰므로 스킵.
		local lp = _UserService.LocalPlayer
		if isvalid(lp) and lp.PlayerComponent ~= nil and lp.PlayerComponent.UserId == actorUserId then
-- 			log("[RollResultDiceUI] SpectatorDice 보드 스킵(actor=" .. actorUserId .. ")")
			return
		end
-- 		log("[RollResultDiceUI] SpectatorDice 보드 표시 후 대기(actor=" .. actorUserId .. ")")
		self:ShowSpectatorBoard(d1, d2, total, resultTable, gameOutcome)
	end

	@ExecSpace("ClientOnly")
	method void ShowSpectatorBoard(integer d1, integer d2, integer total, table resultTable, string gameOutcome)
		-- 관전자: 결과판(보드)만 표시하고 actor의 실제 굴림 전까지 대기(주사위/결과 미공개). 공개 타이머 없음.
		if self._spectatorTimer1 ~= 0 then _TimerService:ClearTimer(self._spectatorTimer1) self._spectatorTimer1 = 0 end
		if self._spectatorTimer2 ~= 0 then _TimerService:ClearTimer(self._spectatorTimer2) self._spectatorTimer2 = 0 end
		if self._revealTextTimer ~= 0 then _TimerService:ClearTimer(self._revealTextTimer) self._revealTextTimer = 0 end
		self._pendD1 = d1
		self._pendD2 = d2
		self._pendTotal = total
		self._pendOutcome = gameOutcome
		self._pendOnComplete = nil
		self._pendActorUserId = ""
		self:UpdateBoardUI(resultTable)
		self.panel.Enable = true
		self:BringToFront()
		if isvalid(self.dicePanel) then self.dicePanel.Enable = false end
		if isvalid(self.diceParticle) then self.diceParticle.Enable = false end
		if isvalid(self.ResultTextPanel) then self.ResultTextPanel.Enable = false end
		if isvalid(self.RollButton) then self.RollButton.Enable = false end
		if isvalid(self.NextButton) then self.NextButton.Enable = false end
		if isvalid(self.SkipButton) then self.SkipButton.Enable = false end
	end

	@ExecSpace("Server")
	method void RequestSpectatorBoard(integer d1, integer d2, integer total, table resultTable, string outcome, string actorUserId)
		-- actor의 주사위 보드가 뜬 순간(리드 종료 후), 서버 경유로 관전자에게 결과 '보드'를 방송한다.
		-- (도착 즉시 방송을 대체 → 관전자도 actor처럼 '리드(소개) → 보드' 순서를 그대로 본다.)
		if senderUserId ~= actorUserId then return end   -- actor 본인 요청만 허용(위조 방지).
		self:SpectatorDiceBroadcast(d1, d2, total, resultTable, outcome, actorUserId)
	end

	@ExecSpace("Server")
	method void RequestSpectatorRoll(integer d1, integer d2, integer total, string outcome, string actorUserId)
		-- actor가 이벤트/큐브 주사위 '굴리기'를 실제로 누른 순간, 서버 경유로 관전자에게 공개를 방송한다.
		if senderUserId ~= actorUserId then return end   -- actor 본인 요청만 허용(위조 방지).
		self:SpectatorRevealDice(d1, d2, total, outcome, actorUserId)
	end

	@ExecSpace("Client")
	method void SpectatorRevealDice(integer d1, integer d2, integer total, string outcome, string actorUserId)
		-- 관전자: 대기 중이던 보드에서 실제 주사위 공개 연출 재생 + 씬 결과문구 진행 후 자동 닫힘. actor 본인은 로컬 연출을 쓰므로 스킵.
		local lp = _UserService.LocalPlayer
		if isvalid(lp) and lp.PlayerComponent ~= nil and lp.PlayerComponent.UserId == actorUserId then return end
		if self._spectatorTimer1 ~= 0 then _TimerService:ClearTimer(self._spectatorTimer1) self._spectatorTimer1 = 0 end
		if self._spectatorTimer2 ~= 0 then _TimerService:ClearTimer(self._spectatorTimer2) self._spectatorTimer2 = 0 end
		self._pendD1 = d1
		self._pendD2 = d2
		self._pendTotal = total
		self._pendOutcome = outcome
		self._pendActorUserId = ""
		if isvalid(self.panel) then self.panel.Enable = true end
		self:BringToFront()
		self:PlayRevealAnimation()
		_EventTileUI:SpectatorRevealRollText()     -- 씬 텍스트(결과 문구)도 이 순간에 진행(마을/길드/연애/End)
		_EventTileUI:SpectatorRevealBossFollow()   -- 보스 결과 후속(승패 문구+die)도 이 순간에 공개
		self._spectatorTimer2 = _TimerService:SetTimerOnce(function()
			self._spectatorTimer2 = 0
			self:ClosePanel()
-- 			log("[RollResultDiceUI] SpectatorDice 공개 후 자동 닫힘")
		end, self.SpectatorResultHold)
	end

	@ExecSpace("ClientOnly")
	method void SpectatorForceClose()
		-- 관전 씬이 닫힐 때(스킵/AFK/정상 종료) 대기·공개 중이던 관전용 주사위 보드도 함께 닫는다.
		if self._spectatorTimer1 ~= 0 then _TimerService:ClearTimer(self._spectatorTimer1) self._spectatorTimer1 = 0 end
		if self._spectatorTimer2 ~= 0 then _TimerService:ClearTimer(self._spectatorTimer2) self._spectatorTimer2 = 0 end
		self:ClosePanel()
	end

	@ExecSpace("ClientOnly")
	method void SetAllowSkip(boolean allow)
		-- 다음 큐브 롤에서 '넘기기' 노출 여부 설정(완주자 대기 큐브 롤 전용). Show가 이 값을 읽어 SkipButton을 켠다.
		self._allowSkip = allow
	end

	@ExecSpace("ClientOnly")
	method void OnSkipClicked()
		-- 완주자 대기 큐브 롤 '넘기기'(가안): 주사위 연출을 건너뛰고 즉시 턴 종료(다음 플레이어). 큐브 보상은 롤 시작 시 서버에서 이미 지급됨.
		if self._allowSkip == false then return end   -- 안전장치: 스킵 허용 롤에서만
		if isvalid(self.RollButton) then self.RollButton.Enable = false end
		if isvalid(self.SkipButton) then self.SkipButton.Enable = false end
		self:ClosePanel()
		_EventTileUI:AdvanceActiveTile()   -- 활성 타일(EndTile)에 진행 요청 → RequestAdvance(_waitingRoll) → OnWaitingCubeRollDone
-- 		log("[RollResultDiceUI] 넘기기 클릭 → 대기 큐브 롤 건너뛰고 턴 종료")
	end

	@ExecSpace("ClientOnly")
	method void BringToFront()
		-- z-order(형제 인덱스) 강제 로직 제거됨.
	end

	@ExecSpace("ClientOnly")
	method void UpdateBoardUI(table resultTable)
		local panels = {
					self.two_Value, self.three_Value, self.four_Value,
					self.five_Value, self.six_Value, self.seven_Value, self.eight_Value,
					self.nine_Value, self.ten_Value, self.eleven_Value, self.twelve_Value
				}
				
				for i = 1, 11 do
					local comp = panels[i]
					if comp ~= nil then
						local diceNum = i + 1 -- 배열 1번 인덱스가 주사위 2눈금이므로 +1
		
						-- 기획서: '12 = 무조건 대성공' 규칙 폐기. 결과 테이블 값만 사용.
						local res = resultTable[diceNum]
						if res == 2 then comp.Text = "대성공"
						elseif res == 1 then comp.Text = "성공"
						else comp.Text = "실패" end
					end
				end
	end

	method table NormalizeProbabilities(number greatPct, number successPct, number failPct)
		-- 대성공/성공/실패(%) 합이 100이 되도록 '실패'를 조정해 반환한다.
		-- 실패 = 100 - 대성공 - 성공 으로 재산출한다(합이 이미 100이면 입력 실패와 같고, 아니면 자동 보정).
		-- 대성공+성공이 100을 넘으면 실패만으로 100을 맞출 수 없으므로 실패=0으로 고정한다.
		local great = greatPct or 0
		local success = successPct or 0
		local inFail = failPct or 0
		if great < 0 then great = 0 end
		if success < 0 then success = 0 end
		local fail = 100 - great - success
		if fail < 0 then
			fail = 0
-- 			log_warning("[RollResultDiceUI] 대성공+성공=" .. tostring(great + success) .. "%(>100) — 실패 0%로 고정(합계 100 초과)")
		elseif math.abs((great + success + inFail) - 100) > 0.001 then
-- 			log("[RollResultDiceUI] 합계 " .. tostring(great + success + inFail) .. "% ≠ 100 → 실패를 "
-- 				.. tostring(inFail) .. "% → " .. tostring(fail) .. "%로 조정")
		end
		return { great = great, success = success, fail = fail }
	end

	@ExecSpace("ClientOnly")
	method table SetProbabilities(number greatPct, number successPct, number failPct)
		-- 다른 스크립트가 대성공/성공/실패 확률(%)을 넣으면 resultDice 보드에 즉시 반영한다.
		-- 합이 100이 아니면 실패 확률을 조정해 100에 맞춘다(NormalizeProbabilities).
		-- 반환: 주사위합 2~12 → 실패0/성공1/대성공2 결과판(table). 그대로 Show에 넘겨 굴릴 수 있다.
		local p = self:NormalizeProbabilities(greatPct, successPct, failPct)
		self.GreatPct = p.great
		self.SuccessPct = p.success
		self.FailPct = p.fail
		-- 확률 → 2d6 결과판 계산(누적분포 기반, ResultDiceManager와 동일 규칙) 후 보드 UI 갱신.
		self.currentBoard = _ResultDiceManager:PlaceOutcomes(p.fail, p.success, p.great)
		self:UpdateBoardUI(self.currentBoard)
-- 		log("[RollResultDiceUI] 확률 설정 → 대성공=" .. tostring(p.great)
-- 			.. "% 성공=" .. tostring(p.success) .. "% 실패=" .. tostring(p.fail) .. "%")
		return self.currentBoard
	end

end