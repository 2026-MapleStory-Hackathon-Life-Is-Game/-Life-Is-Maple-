@Logic
script EquipTooltip extends Logic

	property Entity tipRoot = "5329f5e0-0d69-4621-83f9-fa2a682c4845"
	property Entity leftText = "7d8b95f1-7d0c-463b-8518-5e37c79569f1"
	property Entity rightPanel = "a758f39c-16f4-4498-a6df-a1f2ce43f4ed"
	property Entity rightText = "c3c73602-fc17-458e-85fe-8dcd34571e23"

	method void OnBeginPlay()
		-- 클라: 툴팁 패널 숨김.
		if self:IsClient() then
			if isvalid(self.tipRoot) then self.tipRoot.Enable = false end
		end
	end

	method string BuildSpec(string equipName)
		-- 장비 1개의 스펙 문자열(이름/스탯/공마/대미지/보스대미지). 없으면 "".
		if equipName == "" then return "" end
		local ds = _DataService:GetTable("EquipData")
		if isvalid(ds) == false then return "" end
		local row = -1
		for i = 1, ds:GetRowCount() do
			if ds:GetCell(i, "EquipName") == equipName then row = i; break end
		end
		if row == -1 then return "" end
		return ds:GetCell(row, "Name") .. "\n"
			.. "스탯 " .. ds:GetCell(row, "Stat") .. "  공/마 " .. ds:GetCell(row, "Attack") .. "\n"
			.. "대미지 " .. ds:GetCell(row, "Damage") .. "%  보스 " .. ds:GetCell(row, "BossDamage") .. "%"
	end

	method void SetText(Entity e, string s)
		-- 텍스트 엔티티의 TextComponent.Text 설정.
		if isvalid(e) == false then return end
		local tc = e:GetComponent("MOD.Core.TextComponent")
		if tc ~= nil then tc.Text = s end
	end

	method void BringToFront()
		-- 툴팁 그룹을 형제 중 맨 뒤(=화면 최상단)로 이동. displayOrder/GroupOrder가 런타임 정렬을
		-- 그대로 안 따르는 문제(인벤 패널에 가려짐) 우회 — show 시마다 최상단으로 끌어올린다.
		local grp = _EntityService:GetEntityByPath("/ui/InGameUIGroup/EquipTooltip")
		if isvalid(grp) == false then return end
		local uit = grp.UITransformComponent
		if isvalid(uit) == false then return end
		local idx = 99
		local parent = grp.Parent
		if isvalid(parent) and parent.Children ~= nil then idx = #parent.Children - 1 end
		_UILogic:SetSiblingIndex(uit, idx)
	end

	method void ShowItem(string equipName)
		-- 장비칸 호버: 그 장비 스펙만(우측 비교칼럼 숨김).
		if self:IsClient() == false then return end
		if equipName == "" then return end
		self:SetText(self.leftText, self:BuildSpec(equipName))
		if isvalid(self.rightPanel) then self.rightPanel.Enable = false end
		if isvalid(self.tipRoot) then self.tipRoot.Enable = true end
		self:BringToFront()
		log("[EquipTooltip] ShowItem: " .. equipName)
	end

	method void ShowCompare(string newName, string currentName)
		-- 인벤 호버: 좌=새 장비 스펙, 우=현재 장착 장비 스펙.
		if self:IsClient() == false then return end
		if newName == "" then return end
		self:SetText(self.leftText, self:BuildSpec(newName))
		if isvalid(self.rightPanel) then self.rightPanel.Enable = true end
		if currentName == "" then
			self:SetText(self.rightText, "(미장착)")
		else
			self:SetText(self.rightText, self:BuildSpec(currentName))
		end
		if isvalid(self.tipRoot) then self.tipRoot.Enable = true end
		self:BringToFront()
		log("[EquipTooltip] ShowCompare: " .. newName .. " vs " .. currentName)
	end

	method void Hide()
		-- 툴팁 패널 숨김.
		if self:IsClient() then
			if isvalid(self.tipRoot) then self.tipRoot.Enable = false end
		end
	end

end
