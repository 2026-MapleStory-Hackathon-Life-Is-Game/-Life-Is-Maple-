@Component
script PlayerInfoPanel extends Component

	property TextGUIRendererComponent UserName = "226e650b-a9ab-4336-9864-c876e18b077b"

	property TextGUIRendererComponent NewValue2 = "05b6f041-e1ba-4f09-a677-e21e0429fe46"

	-- 전투력 표시 텍스트(UIText_1: "전투력: ..."). NewValue2는 .ui 오버라이드로 다른 텍스트를 가리켜
	-- 별도 프로퍼티로 정확히 바인딩한다.
	property TextGUIRendererComponent powerText = "05b6f041-e1ba-4f09-a677-e21e0429fe46"

	-- 진영/직업 라벨 텍스트(content/UIText, 예전 "모험가/해적"). 실제 진영/직업을 반영한다.
	property TextGUIRendererComponent campJobText = "b38deec1-0973-4ad3-9ab8-f3bff963349d"

	-- 레벨 라벨(content/UIText_Level, 우측 하단). 서있는 타일로 결정된 CombatPowerManager.Level 표시.
	property Entity levelText = "09edce29-fce5-4d8c-a0f9-f421113dbd03"

	property any combatComp = nil      -- 로컬 플레이어의 CombatPowerManager (지연 캐시)
	property number lastShownPower = -1 -- 마지막으로 표시한 전투력(값이 바뀔 때만 텍스트 갱신)
	property integer lastShownLevel = -1 -- 마지막으로 표시한 레벨(값이 바뀔 때만 텍스트 갱신)
	property any buffComp = nil          -- 로컬 플레이어의 BuffManager (진영 라벨용, 지연 캐시)
	property string lastShownCampJob = "" -- 마지막으로 표시한 진영/직업(값이 바뀔 때만 갱신)

	method void OnBeginPlay()
		if self:IsClient() then

			-- 플레이어 정보 창의 Text값을 플레이어의 닉네임으로 설정합니다.
			local player = _UserService.LocalPlayer

			self.UserName.Text = player.PlayerComponent.Nickname

			self.combatComp = nil
			self.lastShownPower = -1
			self.lastShownLevel = -1

		end


	end

	method void OnUpdate(number delta)
		-- 로컬 플레이어의 전투력(@Sync)을 폴링해 값이 바뀌면 패널 텍스트를 갱신한다.
		if self:IsClient() == false then return end

		-- CombatPowerManager는 입장 시 런타임 부착되므로 지연 캐시한다.
		if isvalid(self.combatComp) == false then
			local player = _UserService.LocalPlayer
			if isvalid(player) then
				self.combatComp = player:GetComponent("script.CombatPowerManager")
			end
			if isvalid(self.combatComp) == false then return end
		end

		---@type CombatPowerManager
		local cp = self.combatComp
		local power = cp.CombatPower
		if power ~= self.lastShownPower then
			self.lastShownPower = power
			if isvalid(self.powerText) then
				-- 위에 "전투력" 라벨(Title_capability)이 따로 있으므로 값 줄은 수치만 표시.
				self.powerText.Text = self:FormatPower(power)
			end
		end

		-- 레벨: 서있는 타일(Stage,Tier)로 결정된 CombatPowerManager.Level(@Sync)을 폴링해 갱신.
		local level = cp.Level
		if level ~= self.lastShownLevel then
			self.lastShownLevel = level
			self:SetLevelText("Lv." .. tostring(level))
			log("[PlayerInfoPanel] 레벨 라벨 = Lv." .. tostring(level))
		end

		-- 진영/직업 라벨 갱신(진영=로컬 플레이어 BuffManager.CampName, 직업=전역 currentJob).
		local campJob = self:CampKo(self:LocalCampKey()) .. "/" .. self:JobKo(self:CurrentJobKey())
		if campJob ~= self.lastShownCampJob then
			self.lastShownCampJob = campJob
			if isvalid(self.campJobText) then
				self.campJobText.Text = campJob
			end
			log("[PlayerInfoPanel] 진영/직업 라벨 = " .. campJob)
		end
	end

	method void SetLevelText(string s)
		-- 레벨 라벨 엔티티(content/UIText_Level)의 TextComponent.Text 설정.
		if isvalid(self.levelText) == false then return end
		local tc = self.levelText:GetComponent("MOD.Core.TextComponent")
		if tc ~= nil then tc.Text = s end
	end

	method string LocalCampKey()
		-- 로컬 플레이어의 진영 키(BuffManager.CampName, @TargetUserSync). 미선택/미부착 시 "".
		if isvalid(self.buffComp) == false then
			local player = _UserService.LocalPlayer
			if isvalid(player) then self.buffComp = player:GetComponent("script.BuffManager") end
		end
		if isvalid(self.buffComp) and self.buffComp.CampName ~= nil then return self.buffComp.CampName end
		return ""
	end

	method string CurrentJobKey()
		-- 전역 직업 키(_JobWeaponManager.currentJob, @Sync). 기본값은 "Beginner".
		if _JobWeaponManager ~= nil and _JobWeaponManager.currentJob ~= nil then return _JobWeaponManager.currentJob end
		return ""
	end

	method string CampKo(string camp)
		-- 진영 영문 키 → 한글. 미선택("") → '없음'.
		if camp == nil or camp == "" then return "없음" end
		if camp == "Adventurer" then return "모험가"
		elseif camp == "Cygnus" then return "시그너스"
		elseif camp == "Resistance" then return "레지스탕스"
		elseif camp == "Nova" then return "노바" end
		return camp
	end

	method string JobKo(string job)
		-- 직업 영문 키 → 한글. 미선택("" 또는 Beginner=초기 직업) → '없음'.
		if job == nil or job == "" or job == "Beginner" then return "없음" end
		if job == "Warrior" then return "전사"
		elseif job == "Archer" then return "궁수"
		elseif job == "Mage" then return "마법사"
		elseif job == "Thief" then return "도적"
		elseif job == "Pirate" then return "해적" end
		return job
	end

	method string FormatPower(number value)
		-- 전투력을 메이플식 "○○만 ○○○○" 표기로 변환한다(1만 미만은 그대로).
		local n = math.floor(value)
		if n >= 10000 then
			local man = math.floor(n / 10000)
			local rest = n % 10000
			return tostring(man) .. "만 " .. string.format("%04d", rest)
		end
		return tostring(n)
	end

	@ExecSpace("ClientOnly")
	method void SetPlayerPortrait()
		-- 플레이어의 머리 제외 모든 파츠를 비활성화
		
		local playerPortrait = _EntityService:GetEntityByPath("/ui/DefaultGroup/PlayerInfo_Panel/PlayerPortrait").AvatarGUIRendererComponent
		
		if playerPortrait ~= nil then
				
		end
		
		
	end

end