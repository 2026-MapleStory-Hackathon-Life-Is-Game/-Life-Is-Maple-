@Logic
script UIGroupDefaultShowEnforcer extends Logic

	-- 에디터에서 UIGroup의 DefaultShow가 자꾸 false로 초기화되는 것을 런타임에서 다시 true로 되돌린다.
	-- 대상: /ui의 모든 UIGroup 루트. 재초기화에 대비해 시작 시 + 지연 2회 재적용한다.
	-- ⚠ Enable(실표시)은 건드리지 않는다 — 로비/인게임 HUD·팝업은 각 컨트롤러/맵관리가 Enable로 토글하므로
	--    여기서 강제 enable하면 충돌한다. DefaultShow '값'만 true로 재설정한다.

	-- 선택창 그룹은 인게임 HUD(InGameUIGroup) '위'에 떠야 한다. 그런데 Maker가 재직렬화할 때마다
	-- 이 그룹들의 GroupOrder(UIType order)를 3 같은 낮은 값으로 되돌려버려(파일 값이 churn) HUD 뒤로 가라앉는다.
	-- => 플레이 시점에 GroupType=UIType + 높은 GroupOrder + 형제 최상단으로 런타임 강제 고정한다.
	property table orderTargets = {}

	@ExecSpace("ClientOnly")
	method void OnBeginPlay()
		-- 강제 대상 그룹과 order 값 등록(InGameUIGroup=5 보다 충분히 큼, 서로 겹치지 않게 분산).
		self.orderTargets = {
			{ path = "/ui/First_CampSelectGroup",   order = 30 },
			{ path = "/ui/JobSelectGroup",          order = 31 },
			{ path = "/ui/LifePathSelectGroup",     order = 32 },
			{ path = "/ui/RomanceGuildSelectGroup", order = 33 },
		}
		-- 시작 시 1회 + 로드 타이밍 대비 지연 재적용.
		self:EnforceAll()
		self:EnforceSelectOrder()
		_TimerService:SetTimerOnce(function() self:EnforceAll() self:EnforceSelectOrder() end, 0.5)
		_TimerService:SetTimerOnce(function() self:EnforceAll() self:EnforceSelectOrder() end, 1.5)
	end

	@ExecSpace("ClientOnly")
	method void EnforceSelectOrder()
		-- 각 선택창 그룹을 UIType(2) + 높은 GroupOrder로 강제하고 형제 최상단으로 올린다.
		-- (같은 GroupType 안에서 GroupOrder/형제 순서가 큰 쪽이 위로 렌더된다.)
		for i = 1, #self.orderTargets do
			local t = self.orderTargets[i]
			local g = _EntityService:GetEntityByPath(t.path)
			if isvalid(g) and isvalid(g.UIGroupComponent) then
				g.UIGroupComponent.GroupType = UIGroupType.UIType
				g.UIGroupComponent.GroupOrder = t.order
				if isvalid(g.UITransformComponent) then
					_UILogic:SetSiblingIndex(g.UITransformComponent, 1000000)
				end
				log("[UIGroupDefaultShowEnforcer] " .. t.path .. " GroupOrder=" .. tostring(t.order) .. " 강제")
			end
		end
	end

	@ExecSpace("ClientOnly")
	method void EnforceAll()
		-- /ui의 모든 그룹 루트를 순회하며 UIGroupComponent.DefaultShow = true로 되돌린다.
		local uiRoot = _EntityService:GetEntityByPath("/ui")
		if isvalid(uiRoot) == false then return end
		local kids = uiRoot.Children
		if kids == nil then return end
		local list = kids:ToTable()
		local n = 0
		for i = 1, #list do
			local g = list[i]
			if isvalid(g) and isvalid(g.UIGroupComponent) then
				g.UIGroupComponent.DefaultShow = true
				n += 1
			end
		end
		log("[UIGroupDefaultShowEnforcer] DefaultShow=true 재적용 그룹 수: " .. tostring(n))
	end

end
