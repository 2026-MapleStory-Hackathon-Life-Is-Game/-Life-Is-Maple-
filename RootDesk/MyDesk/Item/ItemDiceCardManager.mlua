@Logic
script ItemDiceCardManager extends Logic

	property any _cardDefs = nil

	property any _cardOrder = nil

	method table CardDefs()
		-- 주사위 고정 카드 정의. 사용 시 min~max 범위 랜덤 값 1개로 다음 이동 주사위를 고정한다.
		-- key → { name=표시명, min, max, num=정확한 숫자(숫자카드만) }. num 카드는 min==max라 정확값 고정.
		if self._cardDefs ~= nil then return self._cardDefs end
		local defs = {
			low  = { name = "낮은 숫자 카드", min = 1, max = 6 },
			high = { name = "높은 숫자 카드", min = 7, max = 12 },
		}
		for i = 1, 12 do
			defs["num" .. i] = { name = tostring(i) .. " 카드", min = i, max = i, num = i }
		end
		self._cardDefs = defs
		return defs
	end

	method table CardOrder()
		-- UI 표시/랜덤 순회용 정렬된 카드키 목록: low, high, num1..num12.
		if self._cardOrder ~= nil then return self._cardOrder end
		local order = { "low", "high" }
		for i = 1, 12 do
			table.insert(order, "num" .. i)
		end
		self._cardOrder = order
		return order
	end

	method any CardDef(string cardKey)
		-- 카드 정의 조회. 없으면 nil.
		if cardKey == nil then return nil end
		return self:CardDefs()[cardKey]
	end

	@ExecSpace("ServerOnly")
	method integer RollCardValue(string cardKey)
		-- 카드 범위 내 랜덤 값 1개를 뽑아 반환. 알 수 없는 카드면 0.
		local def = self:CardDef(cardKey)
		if def == nil then return 0 end
		return _UtilLogic:RandomIntegerRange(def.min, def.max)
	end

	method any InvOf(string userId)
		-- userId의 플레이어 DiceCardInventory 컴포넌트(없으면 nil). 서버/클라 공용 조회.
		if userId == nil or userId == "" then return nil end
		local p = _UserService:GetUserEntityByUserId(userId)
		if isvalid(p) == false then return nil end
		return p:GetComponent("script.DiceCardInventory")
	end

	@ExecSpace("ServerOnly")
	method integer ApplyCardFor(string userId, string cardKey)
		-- 서버 진입점: 지정 유저의 '다음 이동 주사위'를 카드 범위 내 랜덤 값으로 고정 예약. 확정값 반환(0=실패).
		-- 소비는 여기서 하지 않는다(실제 굴림 시 DiceManager가 ConsumeCardOnRoll 호출).
		if userId == nil or userId == "" then return 0 end
		local value = self:RollCardValue(cardKey)
		if value <= 0 then return 0 end
		_DiceManager:SetForcedTotal(userId, value, cardKey)
		local inv = self:InvOf(userId)
		if isvalid(inv) then inv:SetArmed(cardKey) end   -- 클라 하이라이트용 장전 표시(동기화)
-- 		log("[ItemDiceCard] " .. tostring(cardKey) .. " → " .. tostring(userId) .. " 다음 주사위=" .. tostring(value))
		return value
	end

	@ExecSpace("ServerOnly")
	method void ConsumeCardOnRoll(string userId, string cardKey)
		-- 실제 굴림 시 DiceManager가 호출. 예약을 발생시킨 카드 1개를 인벤에서 차감 + 장전 해제.
		local inv = self:InvOf(userId)
		if isvalid(inv) then
			inv:Consume(cardKey)
			inv:SetArmed("")
		end
	end

	@ExecSpace("ServerOnly")
	method void GrantCard(string userId, string cardKey, integer n)
		-- 카드 n개 지급(보상/디버그 진입점).
		local inv = self:InvOf(userId)
		if isvalid(inv) then inv:Add(cardKey, n) end
	end

	-- 턴 종료 시 카드 획득 이벤트 발동 확률(0~1). 나중에 밸런싱 시 이 값만 조정.
	property number AcquireChance = 0.5

	method string RollAcquiredCard()
		-- 획득 성공 시 지급할 카드 1종을 확률로 뽑는다.
		-- 분포(조정 지점): 낮은 30% / 높은 30% / 숫자 12종 합 40%(각 ≈3.33%).
		local r = _UtilLogic:RandomIntegerRange(1, 100)
		if r <= 30 then return "low" end
		if r <= 60 then return "high" end
		local n = _UtilLogic:RandomIntegerRange(1, 12)
		return "num" .. tostring(n)
	end

	@ExecSpace("ServerOnly")
	method void RollAcquisition(string userId)
		-- 턴 종료 시 actor 대상으로 호출. AcquireChance 확률로 획득 이벤트 발동 → 성공 시 카드 1장 지급 + 획득 팝업.
		if userId == nil or userId == "" then return end
		local threshold = math.floor(self.AcquireChance * 100)
		if _UtilLogic:RandomIntegerRange(1, 100) > threshold then return end   -- 미발동
		local cardKey = self:RollAcquiredCard()
		self:GrantCard(userId, cardKey, 1)
		self:ShowAcquirePopup(cardKey, userId)
-- 		log("[ItemDiceCard] 턴종료 카드 획득 " .. tostring(cardKey) .. " → " .. tostring(userId))
	end

	@ExecSpace("Client")
	method void ShowAcquirePopup(string cardKey)
		-- 카드 획득 연출(본인 클라). 3단계에서 팝업 UI 연동.
		if _DiceCardGetPopup ~= nil then
			_DiceCardGetPopup:Open(cardKey)
		end
	end

	@ExecSpace("Server")
	method void UseCard(string cardKey)
		-- 클라(아이템 사용) → 서버. 보유 중일 때만 다음 이동 주사위를 카드로 고정 예약.
		-- (실제 카드 소비는 굴림 시점. 보유 0이면 장전조차 하지 않는다.)
		local inv = self:InvOf(senderUserId)
		if isvalid(inv) == false or inv:GetCount(cardKey) <= 0 then
			return
		end
		local value = self:ApplyCardFor(senderUserId, cardKey)
		if value <= 0 then return end
		self:NotifyCardApplied(cardKey, value, senderUserId)
	end

	@ExecSpace("Server")
	method void ClearCard()
		-- 클라(카드 장전 해제) → 서버. 요청자의 예약된 주사위 고정값을 취소(카드 소비 없음) + 장전 표시 해제.
		_DiceManager:ClearForced(senderUserId)
		local inv = self:InvOf(senderUserId)
		if isvalid(inv) then inv:SetArmed("") end
	end

	@ExecSpace("Client")
	method void NotifyCardApplied(string cardKey, integer value)
		-- 결과 피드백(기본: 로그). 토스트/UI 연동은 다음 단계.
-- 		log("[ItemDiceCard] 다음 주사위가 " .. tostring(value) .. "(으)로 고정됨 (" .. tostring(cardKey) .. ")")
	end

end
