@Logic
script ItemDiceCardManager extends Logic

	method table CardDefs()
		-- 주사위 고정 카드 정의. 사용 시 범위 내 랜덤 값 1개로 다음 이동 주사위를 고정한다.
		-- key → { name = 표시명, min, max }
		return {
			low  = { name = "낮은 숫자 카드", min = 1,  max = 6 },
			high = { name = "높은 숫자 카드", min = 7,  max = 12 },
		}
	end

	method any CardDef(string cardKey)
		-- 카드 정의 조회. 없으면 nil.
		if cardKey == nil then return nil end
		return self:CardDefs()[cardKey]
	end

	@ExecSpace("ServerOnly")
	method integer RollCardValue(string cardKey)
		-- 카드 범위 내 랜덤 값 1개를 뽑아 반환. 알 수 없는 카드면 0.
		local def = self:CardDef(cardKey)
		if def == nil then return 0 end
		return _UtilLogic:RandomIntegerRange(def.min, def.max)
	end

	@ExecSpace("ServerOnly")
	method integer ApplyCardFor(string userId, string cardKey)
		-- 서버 진입점: 지정 유저의 '다음 이동 주사위'를 카드 범위 내 랜덤 값으로 고정. 확정값 반환(0=실패).
		if userId == nil or userId == "" then return 0 end
		local value = self:RollCardValue(cardKey)
		if value <= 0 then return 0 end
		_DiceManager:SetForcedTotal(userId, value)
-- 		log("[ItemDiceCard] " .. tostring(cardKey) .. " → " .. tostring(userId) .. " 다음 주사위=" .. tostring(value))
		return value
	end

	@ExecSpace("Server")
	method void UseCard(string cardKey)
		-- 클라(아이템 사용) → 서버. 요청자의 다음 이동 주사위를 카드로 고정.
		-- (인벤토리 보유/소비 처리는 다음 단계. 지금은 효과 적용만.)
		local value = self:ApplyCardFor(senderUserId, cardKey)
		if value <= 0 then return end
		self:NotifyCardApplied(cardKey, value, senderUserId)
	end

	@ExecSpace("Server")
	method void ClearCard()
		-- 클라(카드 장전 해제) → 서버. 요청자의 예약된 주사위 고정값을 취소.
		_DiceManager:ClearForced(senderUserId)
	end

	@ExecSpace("Client")
	method void NotifyCardApplied(string cardKey, integer value)
		-- 결과 피드백(기본: 로그). 토스트/UI 연동은 다음 단계.
-- 		log("[ItemDiceCard] 다음 주사위가 " .. tostring(value) .. "(으)로 고정됨 (" .. tostring(cardKey) .. ")")
	end

end
