--[[
    InGameMapManagement
    ----------------------------------------------------------------------------
    게임 맵(InGame) 루트에 붙는 맵 스코프 컴포넌트.
    이 맵이 로드될 때(=로컬 플레이어가 게임 맵에 진입할 때) 인게임 UI를 켜고 로비 UI를 끈다.

    ※ UIGroup의 DefaultShow가 false면 스크립트로 Enable 토글이 먹지 않으므로
       LobbyUIGroup / InGameUIGroup 둘 다 DefaultShow=true 여야 한다(현재 둘 다 true).
--]]
@Component
script InGameMapManagement extends Component

	property Entity lobbyGroup = "1b439576-8c6f-4a2a-bbfe-7538a59c5a8a"   -- LobbyUIGroup
	property Entity inGameGroup = "a322b09a-023e-427d-9c6c-19724156dab7"  -- InGameUIGroup

	@ExecSpace("ClientOnly")
	method void OnBeginPlay()
		-- 게임 맵 진입: 인게임 UI 켜고 로비 UI 끔.
		self:ApplyUI()
		-- 게임 시작(1단계) 시 진영 선택 패널을 자동으로 연다.
		_CampSelectUI:ShowPanel()
	end

	@ExecSpace("ClientOnly")
	method void ApplyUI()
		if isvalid(self.inGameGroup) then self.inGameGroup.Enable = true end
		if isvalid(self.lobbyGroup) then self.lobbyGroup.Enable = false end
		log("[InGameMapManagement] 인게임 UI 활성 / 로비 UI 비활성")
	end

end
