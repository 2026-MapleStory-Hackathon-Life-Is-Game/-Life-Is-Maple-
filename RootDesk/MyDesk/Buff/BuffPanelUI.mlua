@Logic
script BuffPanelUI extends Logic

	property Entity cardTemplate = "e091d5dd-1324-49e3-9f7b-1a7f49306d89"

	property Entity tooltip = "fd4d1d5e-f4a9-404a-977a-ff09e048ba96"

	property TextComponent tooltipText = "fb396ad9-7baf-445c-ad73-3461cdb93a42"

	property number startX = -900

	property number rowY = 360

	property number stepX = 64

	-- 툴팁 자동 크기조절 상수(조정 쉽게 프로퍼티로). 캔버스 1920x1080 중심원점 기준.
	property number tooltipBoxW = 360       -- 툴팁 박스 폭(고정)
	property number tooltipTextWidth = 330  -- 텍스트 폭(박스 − 패딩/스크롤바 여유)
	property number tooltipPadV = 18        -- 상하 패딩 합
	property number tooltipMinH = 40        -- 최소 박스 높이
	property number tooltipMaxH = 900       -- 최대 박스 높이(넘으면 스크롤). 화면(1080) 안에 들어오는 값

	property any cards = nil

	property any hoverHandlers = nil

	-- 서버가 SetBuffs와 함께 보낸 현재 길드원 수(길드 버프 툴팁에 표시).
	property integer _guildMemberCount = 0

	-- 서버가 SetBuffs와 함께 보낸 현재 가족 구성원 수(결혼 버프 툴팁에 표시).
	property integer _familyMemberCount = 0

	method void OnBeginPlay()
		-- 템플릿/툴팁을 숨기고 내부 상태를 초기화한다.
		self.cards = {}
		self.hoverHandlers = {}
		if isvalid(self.cardTemplate) then self.cardTemplate.Enable = false end
		if isvalid(self.tooltip) then self.tooltip.Enable = false end
	end

	method void OnEndPlay()
		-- 카드/핸들러 정리.
		self:ClearCards()
	end

	@ExecSpace("Client")
	method void SetBuffs(table buffNames, integer guildMemberCount, integer familyCount)
		-- 서버가 보낸 활성 버프 이름 목록으로 카드 한 줄을 다시 만든다. guildMemberCount/familyCount는 각각 길드/결혼 버프 툴팁용.
		self._guildMemberCount = guildMemberCount
		self._familyMemberCount = familyCount
		self:ClearCards()
		if isvalid(self.cardTemplate) == false then
			log_error("[BuffPanelUI] cardTemplate 없음")
			return
		end
		local ds = _DataService:GetTable("BuffData")
		if isvalid(ds) == false then
			log_error("[BuffPanelUI] dataset 'BuffData' 없음")
			return
		end
		for i = 1, #buffNames do
			self:MakeCard(ds, buffNames[i], i)
		end
		log("[BuffPanelUI] 버프 카드 " .. tostring(#buffNames) .. "개 표시")
	end

	method integer FindRow(any ds, string buffName)
		-- BuffData에서 buffName에 해당하는 행 인덱스를 찾는다. 없으면 -1.
		for i = 1, ds:GetRowCount() do
			if ds:GetCell(i, "BuffName") == buffName then
				return i
			end
		end
		return -1
	end

	method void MakeCard(any ds, string buffName, integer index)
		-- 버프 1개에 대한 카드를 복제·배치하고 아이콘/호버 툴팁을 세팅한다.
		local rowIdx = self:FindRow(ds, buffName)
		if rowIdx == -1 then
			log_warning("[BuffPanelUI] 버프 행 없음: " .. buffName)
			return
		end
		
		-- 1) 템플릿 복제 후 활성화 + 좌→우 배치
		local card = self.cardTemplate:Clone("BuffCard_" .. buffName)
		if isvalid(card) == false then return end
		card.Enable = true
		local tr = card.UITransformComponent
		if isvalid(tr) then
			tr.anchoredPosition = Vector2(self.startX + (index - 1) * self.stepX, self.rowY - 10)
		end
		
		-- 2) 버프 아이콘을 카드(버튼) 자체의 배경 이미지로 적용한다(자식 없는 단일 버튼).
		local iconRuid = ds:GetCell(rowIdx, "ImageRUID")
		if iconRuid ~= nil and iconRuid ~= "" then
			local sr = card.SpriteGUIRendererComponent
			if isvalid(sr) then sr.ImageRUID = DataRef(iconRuid) end
		end
		
		-- 3) 효과 설명 문자열을 미리 구성하고, 카드(버튼) 자체의 상태 변화(호버/누름)에 연결한다.
		--    MSW에서 PC 마우스오버는 ButtonComponent의 ButtonStateChangeEvent(state=Hover)로 감지한다.
		--    모바일은 길게 누르면 Pressed 상태가 되므로 Hover/Pressed면 툴팁을 띄우고, 그 외엔 숨긴다.
		local effectText = self:BuildEffectText(ds, rowIdx)
		local capturedCard = card
		local capturedText = effectText
		local h = card:ConnectEvent(ButtonStateChangeEvent, function(ev)
			local st = ev.state
			if st == ButtonState.Hover or st == ButtonState.Pressed then
				self:BringToFront(capturedCard)   -- 호버한 카드를 형제 맨 앞으로 → 옆 카드에 안 가림
				self:ShowTooltip(capturedCard, capturedText)
			else
				self:HideTooltip()
			end
		end)
		table.insert(self.hoverHandlers, { entity = card, cb = h })
		
		table.insert(self.cards, card)
	end

	method string BuildEffectText(any ds, integer rowIdx)
		-- 버프 행에서 비어있지 않은 효과 수치를 사람이 읽을 텍스트로 조립한다.
		local name = ds:GetCell(rowIdx, "Name")
		local desc = self:StripQuotes(ds:GetCell(rowIdx, "Description"))
		
		local lines = {}
		if name ~= nil and name ~= "" then table.insert(lines, name) end
		if desc ~= nil and desc ~= "" then table.insert(lines, desc) end
		
		self:AppendEffect(lines, ds, rowIdx, "MainStat_Num", "주스탯 +", "")
		self:AppendEffect(lines, ds, rowIdx, "MainStat_Percent", "주스탯 +", "%")
		self:AppendEffect(lines, ds, rowIdx, "AllStat_Num", "올스탯 +", "")
		self:AppendEffect(lines, ds, rowIdx, "AllStat_Percent", "올스탯 +", "%")
		self:AppendEffect(lines, ds, rowIdx, "MainPower_Num", "공격력/마력 +", "")
		self:AppendEffect(lines, ds, rowIdx, "MainPower_Percent", "공격력/마력 +", "%")
		self:AppendEffect(lines, ds, rowIdx, "Damage_Percent", "데미지 +", "%")
		self:AppendEffect(lines, ds, rowIdx, "Boss_Percent", "보스 공격력 +", "%")
		self:AppendEffect(lines, ds, rowIdx, "CriticalDamage_Percent", "크리티컬 데미지 +", "%")

		-- 길드 버프(Category=Guild)면 현재 영입한 길드원 수를 덧붙인다.
		if ds:GetCell(rowIdx, "Category") == "Guild" then
			table.insert(lines, "영입한 길드원: " .. tostring(self._guildMemberCount) .. "명")
		end

		-- 결혼 버프(웨딩 팡파르)면 현재 가족 구성원 수를 덧붙인다.
		if ds:GetCell(rowIdx, "BuffName") == "Wedding_Fanfare" then
			table.insert(lines, "가족 구성원: " .. tostring(self._familyMemberCount) .. "명")
		end

		return table.concat(lines, "\n")
	end

	method void AppendEffect(table lines, any ds, integer rowIdx, string column, string prefix, string suffix)
		-- 해당 컬럼 값이 0이 아니면 "라벨 +값" 한 줄을 lines에 추가한다.
		local v = tonumber(ds:GetCell(rowIdx, column))
		if v ~= nil and v ~= 0 then
			table.insert(lines, prefix .. tostring(v) .. suffix)
		end
	end

	method string StripQuotes(string s)
		-- GetCell이 제거하지 않는 양끝 큰따옴표를 방어적으로 제거한다.
		if s == nil then return "" end
		if #s >= 2 and string.sub(s, 1, 1) == "\"" and string.sub(s, #s, #s) == "\"" then
			return string.sub(s, 2, #s - 1)
		end
		return s
	end

	method void BringToFront(Entity card)
		-- 호버한 카드의 UITransform을 형제 중 맨 뒤 인덱스로 옮긴다(=최상단 렌더). 큰 값은 마지막으로 클램프된다.
		if isvalid(card) == false then return end
		local tr = card.UITransformComponent
		if isvalid(tr) then
			_UILogic:SetSiblingIndex(tr, 2)
		end
	end

	method number Clamp(number v, number lo, number hi)
		-- v를 [lo, hi]로 제한. 범위가 뒤집히면 중앙값.
		if lo > hi then return (lo + hi) / 2 end
		if v < lo then return lo end
		if v > hi then return hi end
		return v
	end

	method void ShowTooltip(Entity card, string text)
		-- 툴팁을 내용 높이에 맞춰 자동 크기조절하고, 박스가 화면(±960/±540) 밖으로 안 나가게 위치를 보정한다.
		-- 내용이 tooltipMaxH보다 길면 ScrollLayoutGroup(AutoHide)이 스크롤바를 자동 표시하고 Mask가 클립한다.
		if isvalid(self.tooltip) == false then return end
		if isvalid(self.tooltipText) == false then return end
		self.tooltipText.Text = text

		-- 1) 내용 높이 계산 → 텍스트/박스 크기 자동 조절.
		local textW = self.tooltipTextWidth
		local contentH = self.tooltipText:GetPreferredHeight(text, textW)
		if contentH < self.tooltipMinH then contentH = self.tooltipMinH end
		local boxH = contentH + self.tooltipPadV
		if boxH > self.tooltipMaxH then boxH = self.tooltipMaxH end

		local textTr = self.tooltipText.Entity.UITransformComponent
		if isvalid(textTr) then textTr.RectSize = Vector2(textW, contentH) end
		local tt = self.tooltip.UITransformComponent
		if isvalid(tt) then tt.RectSize = Vector2(self.tooltipBoxW, boxH) end

		-- 2) 카드 기준 위치 → 박스가 화면 안에 완전히 들어오게 클램프.
		local baseX = 0
		local baseY = 0
		if isvalid(card) then
			local ctr = card.UITransformComponent
			if isvalid(ctr) then
				baseX = ctr.anchoredPosition.x + 220
				baseY = ctr.anchoredPosition.y - 60
			end
		end
		local halfW = self.tooltipBoxW / 2
		local halfH = boxH / 2
		local x = self:Clamp(baseX, -960 + halfW, 960 - halfW)
		local y = self:Clamp(baseY, -540 + halfH, 540 - halfH)
		if isvalid(tt) then tt.anchoredPosition = Vector2(x, y) end

		-- 3) 스크롤 최상단 초기화 + 표시.
		local scroll = self.tooltip.ScrollLayoutGroupComponent
		if isvalid(scroll) then scroll:ResetScrollPosition(UITransformAxis.Vertical) end
		self.tooltip.Enable = true
	end

	method void HideTooltip()
		-- 툴팁 패널을 숨긴다.
		if isvalid(self.tooltip) then self.tooltip.Enable = false end
	end

	@ExecSpace("ClientOnly")
	method void SetVisible(boolean visible)
		-- 버프 카드 전체 + 툴팁 표시/숨김(맵 뷰 토글용).
		if self.cards ~= nil then
			for i = 1, #self.cards do
				if isvalid(self.cards[i]) then self.cards[i].Enable = visible end
			end
		end
		if visible == false then self:HideTooltip() end
	end

	method void ClearCards()
		-- 기존 카드 클론과 호버 핸들러를 모두 제거한다.
		if self.hoverHandlers ~= nil then
			for i = 1, #self.hoverHandlers do
				local h = self.hoverHandlers[i]
				if isvalid(h.entity) then
					h.entity:DisconnectEvent(ButtonStateChangeEvent, h.cb)
				end
			end
		end
		self.hoverHandlers = {}
		
		if self.cards ~= nil then
			for i = 1, #self.cards do
				if isvalid(self.cards[i]) then
					self.cards[i]:Destroy()
				end
			end
		end
		self.cards = {}
		
		self:HideTooltip()
	end

end