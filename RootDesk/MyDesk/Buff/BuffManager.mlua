@Component
script BuffManager extends Component

	property table SlotBuffs = {}

	property table ListBuffs = {}

	property table DynamicMods = {}

	@TargetUserSync
	property string CampName = ""

	method void OnBeginPlay()
		-- @Component라 인스턴스(플레이어)마다 테이블을 새로 만든다(공유 방지).
		self.SlotBuffs = {}
		self.ListBuffs = {}
		self.DynamicMods = self:EmptyModifier()
	end

	method table EmptyModifier()
		-- 모든 수치 키가 0인 빈 modifier 골격.
		return {
			statFlat = 0, statPct = 0,
			allStatFlat = 0, allStatPct = 0,
			attackFlat = 0, attackPct = 0,
			damagePct = 0,
			bossDamagePct = 0,
			critPct = 0,
		}
	end

	@ExecSpace("ServerOnly")
	method void ResetAll()
		self.SlotBuffs = {}
		self.ListBuffs = {}
		self.DynamicMods = self:EmptyModifier()
		self.CampName = ""   -- 진영 라벨도 초기화(진영 버프 슬롯은 위에서 비워지지만 이름 라벨은 별도 필드).
		log("BuffManager: 버프 전체 초기화")
		-- 전투력 재계산 + 버프바 UI 갱신.
		self:OnBuffsChanged()
	end

	method integer FindBuffRow(string buffName)
		-- BuffData에서 buffName에 해당하는 행 인덱스를 반환한다. 없으면 -1.
		local userDataSet = _DataService:GetTable("BuffData")
		
		if isvalid(userDataSet) == false then
			log_error("BuffManager: dataset 'BuffData' not found")
			return -1
		end
		
		for i = 1, userDataSet:GetRowCount() do
			
			if userDataSet:GetCell(i, "BuffName") == buffName then
				return i
			end
		end
		
		return -1
	end

	@ExecSpace("ServerOnly")
	method void SetBuff(string buffName)
		-- 버프 이름을 받아 CSV에서 수치를 읽고, Category 유무에 따라 슬롯/리스트에 넣는다.
		local rowIdx = self:FindBuffRow(buffName)
		
		if rowIdx == -1 then
			log_warning("BuffManager.SetBuff: no buff named " .. buffName)
			return
		end
		
		-- BuffData라는 DataSet에서 테이블 정보를 가져옵니다.
		local userDataSet = _DataService:GetTable("BuffData")
		
		-- 가져온 테이블 정보에서, 'Category' 열을 확인합니다.
		local category = userDataSet:GetCell(rowIdx, "Category")
		
		-- 주스탯(MainStat)과 올스탯(AllStat)을 분리해서 저장한다.
		--   주스탯 항목 → 주스탯에만, 올스탯 항목 → 주스탯+부스탯 전체에 적용(전투력 계산에서 처리).
		-- CSV의 빈 칸은 ""이므로 tonumber가 nil → 0으로 처리한다.
		local buff = {
			buffName    = buffName,
			statFlat    = tonumber(userDataSet:GetCell(rowIdx, "MainStat_Num"))          or 0,
			statPct     = tonumber(userDataSet:GetCell(rowIdx, "MainStat_Percent"))      or 0,
			allStatFlat = tonumber(userDataSet:GetCell(rowIdx, "AllStat_Num"))           or 0,
			allStatPct  = tonumber(userDataSet:GetCell(rowIdx, "AllStat_Percent"))       or 0,
			attackFlat  = tonumber(userDataSet:GetCell(rowIdx, "MainPower_Num"))          or 0,
			attackPct   = tonumber(userDataSet:GetCell(rowIdx, "MainPower_Percent"))      or 0,
			damagePct   = tonumber(userDataSet:GetCell(rowIdx, "Damage_Percent"))         or 0,
			bossDamagePct = tonumber(userDataSet:GetCell(rowIdx, "Boss_Percent"))          or 0,
			critPct     = tonumber(userDataSet:GetCell(rowIdx, "CriticalDamage_Percent")) or 0,
			tier        = tonumber(userDataSet:GetCell(rowIdx, "Tier"))                   or 0,
		}
		
		
		-- 대분류 '카테고리'가 있으면 카테고리별 SlotBuff(교체형), 없으면 ListBuff(누적형).
		if category ~= "" then
			-- 같은 카테고리에 이미 버프가 있으면, 새 버프의 Tier가 '같거나 높을 때만' 교체한다.
			-- (더 낮은 Tier만 무시 → 더 높은 등급 버프가 강등되지 않음. 동일 Tier는 갱신 허용)
			local cur = self.SlotBuffs[category]
			if cur ~= nil and (cur.tier or 0) > buff.tier then
				log("BuffManager: [슬롯:" .. category .. "] 유지 — 기존 Tier("
					.. tostring(cur.tier) .. ") > 새 Tier(" .. tostring(buff.tier)
					.. "), " .. buffName .. " 무시")
				return
			end
			self.SlotBuffs[category] = buff
			if category == "Camp" then
				self.CampName = buffName
				log("BuffManager: 진영 키 = " .. self.CampName)
			end
			log("BuffManager: [슬롯:" .. category .. "] → " .. buffName
				.. " 적용 (Tier " .. tostring(buff.tier) .. ")")
		else
			-- 대분류 없음 → 리스트에 누적된다.
			table.insert(self.ListBuffs, buff)
			log("BuffManager: [리스트] + " .. buffName .. " 추가")
		end
		
		-- 전투력 재계산 + 버프바 UI 갱신.
		self:OnBuffsChanged()
	end

	@ExecSpace("ServerOnly")
	method void ClearBuff(string buffName)
		-- 슬롯 버프면 해당 슬롯을 비우고, 리스트 버프면 같은 이름 항목을 모두 제거합니다.
		local rowIdx = self:FindBuffRow(buffName)
		if rowIdx == -1 then
			log_warning("BuffManager.ClearBuff: no buff named " .. buffName)
			return
		end
		
		-- BuffData라는 DataSet(CSV)의 데이터 정보를 가져옵니다.
		local userDataSet = _DataService:GetTable("BuffData")
		
		-- rowIdx에 위치한 버프 데이터의 'Category'를 확인합니다.
		local category = userDataSet:GetCell(rowIdx, "Category")
		
		-- 만약 카테고리가 존재한다면, 슬롯 버프(갈아끼워지는 버프)를 제거합니다.
		if category ~= "" then
			self.SlotBuffs[category] = nil
			if category == "Camp" then self.CampName = "" end
			log("BuffManager: [슬롯:" .. category .. "] 제거")
		else -- 만약 카테고리가 존재하지 않는다면 동일한 버프의 이름을 전부 제거합니다.
			for i = #self.ListBuffs, 1, -1 do
				if self.ListBuffs[i].buffName == buffName then
					table.remove(self.ListBuffs, i)
				end
			end
			log("BuffManager: [리스트] " .. buffName .. " 제거")
		end
		
		-- 전투력 재계산 + 버프바 UI 갱신.
		self:OnBuffsChanged()
	end

	method string GetSlotBuffName(string category)
		-- 해당 대분류 슬롯에 적용된 버프 이름을 반환한다. 없으면 "".
		local buff = self.SlotBuffs[category]
		if buff == nil then
			return ""
		end
		return buff.buffName
	end

	method integer GetSlotTier(string category)
		-- 해당 대분류 슬롯에 적용된 버프의 Tier를 반환한다. 없으면 0.
		local buff = self.SlotBuffs[category]
		if buff == nil then
			return 0
		end
		return buff.tier or 0
	end

	method string FindBuffByCategoryTier(string category, integer tier)
		-- BuffData에서 (Category, Tier)가 일치하는 버프 이름을 찾는다. 없으면 "".
		local ds = _DataService:GetTable("BuffData")
		if isvalid(ds) == false then return "" end
		for i = 1, ds:GetRowCount() do
			if ds:GetCell(i, "Category") == category
				and (tonumber(ds:GetCell(i, "Tier")) or 0) == tier then
				return ds:GetCell(i, "BuffName")
			end
		end
		return ""
	end

	@ExecSpace("ServerOnly")
	method void UpgradeSlot(string category)
		-- 해당 카테고리 슬롯을 '다음 Tier' 버프로 한 단계 승급한다(현재 Tier+1을 CSV에서 찾아 적용).
		-- 다음 Tier가 없으면(이미 최고 등급) 아무것도 하지 않는다.
		local nextTier = self:GetSlotTier(category) + 1
		local nextName = self:FindBuffByCategoryTier(category, nextTier)
		if nextName == "" then
			log("BuffManager: [" .. category .. "] 더 높은 Tier 없음 → 승급 없음")
			return
		end
		self:SetBuff(nextName)
	end

	@ExecSpace("ServerOnly")
	method void AddRawModifier(table mods)
		-- 타일/이벤트가 주는 동적 수치 버프를 누적한다. (이름 없는 버프 — 버프바엔 표시되지 않음)
		-- mods 예: { allStatFlat = 10 } / { statPct = 5, attackFlat = 10 }. 음수면 감소.
		-- 사용 가능한 키: statFlat statPct allStatFlat allStatPct attackFlat attackPct damagePct critPct
		self:Accumulate(self.DynamicMods, mods)
		log("BuffManager: [동적] 수치 버프 누적 → "
			.. "stat(" .. tostring(self.DynamicMods.statFlat) .. "/" .. tostring(self.DynamicMods.statPct) .. "%) "
			.. "all(" .. tostring(self.DynamicMods.allStatFlat) .. "/" .. tostring(self.DynamicMods.allStatPct) .. "%) "
			.. "atk(" .. tostring(self.DynamicMods.attackFlat) .. "/" .. tostring(self.DynamicMods.attackPct) .. "%) "
			.. "dmg(" .. tostring(self.DynamicMods.damagePct) .. "%) crit(" .. tostring(self.DynamicMods.critPct) .. "%)")
		-- 전투력 재계산 + 버프바 UI 갱신.
		self:OnBuffsChanged()
	end

	method void Accumulate(table total, table b)
		-- GetModifiers에서 호출됨
		
		-- 버프 하나의 수치를 total에 더한다.
		total.statFlat    = total.statFlat    + (b.statFlat or 0)
		total.statPct     = total.statPct     + (b.statPct or 0)
		total.allStatFlat = total.allStatFlat + (b.allStatFlat or 0)
		total.allStatPct  = total.allStatPct  + (b.allStatPct or 0)
		total.attackFlat = total.attackFlat + (b.attackFlat or 0)
		total.attackPct  = total.attackPct  + (b.attackPct or 0)
		total.damagePct  = total.damagePct  + (b.damagePct or 0)
		total.bossDamagePct = total.bossDamagePct + (b.bossDamagePct or 0)
		total.critPct    = total.critPct    + (b.critPct or 0)
	end

	method table GetModifiers()
		-- 슬롯 딕셔너리 + 리스트 + 동적 modifier의 모든 버프를 합산해 modifier 하나로 반환한다.
		local total = self:EmptyModifier()
		
		-- 1) 대분류 슬롯 버프 합산
		for _, b in pairs(self.SlotBuffs) do
			self:Accumulate(total, b)
		end
		-- 2) 대분류 없는 리스트 버프 합산
		for i = 1, #self.ListBuffs do
			self:Accumulate(total, self.ListBuffs[i])
		end
		-- 3) 타일/이벤트가 준 동적 수치 버프 합산
		self:Accumulate(total, self.DynamicMods)
		
		return total
	end

	method table GetActiveBuffNames()
		-- 활성 버프 이름을 좌→우 표시 순서로 모은다(슬롯: 고정 카테고리 순 → 그 외 슬롯 → 리스트 순).
		local names = {}
		local order = { "Camp", "Guild", "Union" }
		local used = {}
		for i = 1, #order do
			local b = self.SlotBuffs[order[i]]
			if b ~= nil then
				table.insert(names, b.buffName)
				used[order[i]] = true
			end
		end
		-- order 목록에 없는 카테고리 슬롯도 빠짐없이 추가
		for cat, b in pairs(self.SlotBuffs) do
			if used[cat] == nil and b ~= nil then
				table.insert(names, b.buffName)
			end
		end
		for i = 1, #self.ListBuffs do
			table.insert(names, self.ListBuffs[i].buffName)
		end
		return names
	end

	@ExecSpace("ServerOnly")
	method void OnBuffsChanged()
		-- 버프가 추가/제거/초기화될 때마다 호출되는 함수
		
		self:RecalculateCombatPower() -- 전투력 재계산
		self:PushBuffUI() -- 버프바의 UI 갱신
	end

	@ExecSpace("ServerOnly")
	method void RecalculateCombatPower()
		-- 같은 플레이어의 CombatPowerManager 전투력을 즉시 재계산한다.
		-- (CombatPower는 @Sync라 재계산하면 클라로 동기화되고, 게임 종료 판정도 최신값을 읽게 된다.)
		if isvalid(self.Entity) == false then return end
		
		---@type CombatPowerManager
		local cp = self.Entity:GetComponent("script.CombatPowerManager")
		if isvalid(cp) then
			cp:CalculateCurrentCombatPower()
			log("BuffManager: 버프 반영 전투력 재계산 → " .. tostring(cp.CombatPower))
		end
	end

	@ExecSpace("ServerOnly")
	method void PushBuffUI()
		-- 현재 활성 버프 이름 목록을 소유 플레이어 클라이언트로 보내 버프바 UI를 갱신한다.
		if isvalid(self.Entity) == false then return end
		local pc = self.Entity.PlayerComponent
		if pc == nil then return end
		local userId = pc.UserId
		if userId == nil or userId == "" then return end
		-- 길드원 수(같은 플레이어의 GuildManager)를 함께 보내 길드 버프 툴팁에 표시한다. 미부착/미창설 시 0.
		local memberCount = 0
		local guild = self.Entity:GetComponent("script.GuildManager")
		if isvalid(guild) then memberCount = guild.GeneralMembers end
		-- 가족 구성원 수(같은 플레이어의 RomanceManager)를 함께 보내 결혼 버프(웨딩 팡파르) 툴팁에 표시한다. 미부착 시 0.
		local familyCount = 0
		local romance = self.Entity:GetComponent("script.RomanceManager")
		if isvalid(romance) then familyCount = romance.FamilyMembers end
		_BuffPanelUI:SetBuffs(self:GetActiveBuffNames(), memberCount, familyCount, userId)
	end

end