--[[
    HexaTileManager
    ----------------------------------------------------------------------------
    보드의 모든 타일 정보를 한 곳에서 관리하는 매니저(Logic).

    - tileGraph    : "타일 이름 -> { 연결, 종류, 분기표시 }" 논리 데이터.
                     이동/분기 판정의 진실 소스. (서버가 판정에 사용)
    - tileEntities : "타일 이름 -> 실제 씬 엔티티". 위치(WorldPosition) 연출에 사용.

    두 테이블은 '타일 이름'을 공통 key로 사용한다.
    타일 이름은 씬 하이어라키의 엔티티 이름(v.Name)과 1:1로 일치해야 한다.
    타일 엔티티는 TagComponent에 "HexaTile" 태그가 달려 있어야 수집된다.
--]]
@Logic
script HexaTileManager extends Logic

    @DisplayName("tileGraph")
    @Description("타일들이 어떻게 연결돼있는지를 나타내는 리스트입니다.")
    property table tileGraph = {}

    @DisplayName("tileEntities")
    @Description("실제 타일들의 엔티티입니다.")
    property table tileEntities = {}

    -- 타일 이름 -> HexaTile(또는 서브클래스) 컴포넌트. base HexaTile.OnBeginPlay가 자신을 등록한다.
    property table tileComponents = {}

    property integer _collectRetries = 0    -- InGame 진입 시 타일 수집 재시도 카운터

    method void OnBeginPlay()
        -- 1) 타일 연결 그래프 정의
        --    next   : 다음으로 갈 수 있는 타일 이름 목록 (2개 이상이면 분기)
        --    type   : 칸 종류 (Start/Hunt/Tax/Boss/Village/Guild/End ...)
        --    branch : 분기 갈래에만 존재. 선택 UI 버튼에 표시할 이름.
        self.tileGraph = {
            ["HexaTile_0"]  = { next = {"HexaTile_1"},                  type = "Start" },
            ["HexaTile_1"]  = { next = {"HexaTile_2"},                  type = "Hunt" },
            ["HexaTile_2"]  = { next = {"HexaTile_3"},                  type = "Hunt" },
            ["HexaTile_3"]  = { next = {"HexaTile_4"},                  type = "HuntPlus" },
            ["HexaTile_4"]  = { next = {"HexaTile_5"},                  type = "Tax" },
            ["HexaTile_5"]  = { next = {"HexaTile_6"},                  type = "Hunt" },
            ["HexaTile_6"]  = { next = {"HexaTile_7A", "HexaTile_7B"},  type = "Boss" },
            ["HexaTile_7A"] = { next = {"HexaTile_8"},                  type = "Village", branch = "왼쪽" },
            ["HexaTile_7B"] = { next = {"HexaTile_9"},                  type = "Guild",   branch = "오른쪽" },
            ["HexaTile_8"]  = { next = {},                              type = "End" },
            ["HexaTile_9"]  = { next = {"HexaTile_10"},                 type = "Union" },
            ["HexaTile_10"] = { next = {},                              type = "End" },
        }

        -- 2~3) 타일 엔티티 수집 + (서버) 칸 컴포넌트 부착.
        --       맵 분리 구조에서는 시작 시점(로비)에 게임 맵이 안 떠 있어 0개가 잡힌다.
        --       그래서 InGame 진입 시 PlayerMovement가 EnsureTilesCollected()로 재수집한다.
        self:CollectTiles()
    end

    -- "HexaTile" 태그 타일을 이름으로 매핑(서버·클라 공통) + 서버는 칸 컴포넌트 부착.
    -- 멱등: 여러 번 호출돼도 안전하며, 이미 부착된 칸 컴포넌트는 다시 달지 않는다.
    method void CollectTiles()
        self.tileEntities = {}
        local entities = _EntityService:GetEntitiesByTag("HexaTile")
        local count = 0
        for _, entity in pairs(entities) do
            self.tileEntities[entity.Name] = entity
            count += 1
        end
        log("[HexaTileManager] 타일 수집: " .. tostring(count) .. "개")

        if self:IsServer() then
            for name, entity in pairs(self.tileEntities) do
                local data = self.tileGraph[name]
                if data ~= nil then
                    local compName = self:TypeToComponent(data.type)
                    if compName ~= "" and self.tileComponents[name] == nil then
                        entity:AddComponent(compName)
                        self.tileComponents[name] = entity:GetComponent("script." .. compName)
                    end
                end
            end
        end
    end

    -- 타일이 아직 안 잡혔으면 수집하고, 0개면 맵 로드 지연을 감안해 잠깐 후 재시도한다.
    method void EnsureTilesCollected()
        self._collectRetries = 0
        self:TryCollect()
    end

    method void TryCollect()
        -- CollectTiles 후 0개면 0.2초 간격으로 최대 15회 재시도(클라 비동기 맵 로드 대비).
        self:CollectTiles()
        if self:CountTiles() > 0 then return end
        self._collectRetries += 1
        if self._collectRetries <= 15 then
            _TimerService:SetTimerOnce(function() self:TryCollect() end, 0.2)
        else
            log_warning("[HexaTileManager] 타일 수집 실패: 재시도 초과")
        end
    end

    -- 현재 수집된 타일 개수.
    method integer CountTiles()
        local c = 0
        for _, e in pairs(self.tileEntities) do c += 1 end
        return c
    end

    -- 칸 종류 문자열을 타일 컴포넌트 스크립트 이름으로 변환한다.
    method string TypeToComponent(string tileType)
        if tileType == "Start" then return "StartTile"
        elseif tileType == "Hunt" then return "HuntTile"
        elseif tileType == "HuntPlus" then return "HuntPlusTile"
        elseif tileType == "Tax" then return "TaxTile"
        elseif tileType == "Boss" then return "BossTile"
        elseif tileType == "Village" then return "VillageTile"
        elseif tileType == "Guild" then return "GuildTile"
        elseif tileType == "Union" then return "UnionTile"
        elseif tileType == "End" then return "EndTile"
        end
        return ""
    end

    -- 해당 타일의 다음 타일 목록을 반환한다.
    -- 0개면 End, 1개면 직선, 2개 이상이면 분기.
    method table GetNextTiles(string tileName)
        local data = self.tileGraph[tileName]
        if data == nil then
            return {}
        end
        return data.next
    end

    -- 해당 타일의 칸 종류(type)를 반환한다. (도착 칸 이벤트 판정용)
    method string GetTileType(string tileName)
        local data = self.tileGraph[tileName]
        if data == nil then
            return ""
        end
        return data.type
    end

    -- 해당 타일의 실제 씬 엔티티를 반환한다. (위치 연출용)
    method Entity GetTileEntity(string tileName)
        return self.tileEntities[tileName]
    end

    -- 분기 갈래 타일의 표시 이름(branch)을 반환한다. 분기가 아니면 "".
    method string GetTileBranch(string tileName)
        local data = self.tileGraph[tileName]
        if data == nil or data.branch == nil then
            return ""
        end
        return data.branch
    end

    -- ─────────────────── 타일 컴포넌트 등록/디스패치 ───────────────────

    -- base HexaTile 컴포넌트가 OnBeginPlay에서 자신을 등록한다.
    @ExecSpace("ServerOnly")
    method void RegisterTile(string tileName, HexaTile tile)
        self.tileComponents[tileName] = tile
    end

    -- 이름으로 타일 컴포넌트를 반환한다. (없으면 nil)
    method HexaTile GetTileComponent(string tileName)
        return self.tileComponents[tileName]
    end

    -- 말이 도착한 타일의 OnArrive를 호출한다(서브클래스 override로 폴리모픽 동작).
    @ExecSpace("ServerOnly")
    method void TriggerArrive(string tileName, Entity piece)
        local comp = self.tileComponents[tileName]
        if comp == nil then
            log("[HexaTileManager] 타일 컴포넌트 미등록: " .. tileName)
            return
        end
        comp:OnArrive(piece)
    end

end
