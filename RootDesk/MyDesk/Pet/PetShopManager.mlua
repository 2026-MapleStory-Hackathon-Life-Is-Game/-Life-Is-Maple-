@Logic
script PetShopManager extends Logic

	property string shopBtnPath = "/ui/LobbyUIGroup/ShopBtn"

	property string shopPanelPath = "/ui/LobbyUIGroup/ShopPanel"

	property string petPanelPath = "/ui/LobbyUIGroup/ShopPanel/PetPanel"

	property any userEnterHandler = nil

	property any _spawned = nil

	property any _btnH = nil

	property any _hoverH = nil

	property any _nameToId = nil

	property any _idToName = nil

	property any _owned = nil

	property string _equipped = ""

	method table PetList()
		-- 이름(안정 키) ↔ 인게임 팔로워/썸네일 스프라이트(쁘띠 move 애니). 서버/클라 공통.
		-- productId는 월드마다 바뀌므로 하드코딩하지 않고 이름으로 런타임 조회(BuildShopMaps).
		-- 순서 = 상점 그리드 Row1..Row6. 상점에 등록한 상품명과 name이 정확히 일치해야 매칭됨.
		-- bonus = 장착 시 부여하는 추가 스탯 옵션(퍼센트). 특정 스탯 %는 그 스탯에만, allStatPct는 4스탯 전체.
		--   아란=STR10 / 메르=DEX10 / 에반·루미=INT10 / 팬텀=LUK10 / 은월=올스탯9.
		-- buff = 해당 펫의 BuffData 행 이름(게임 시작 시 SetBuff로 버프바에 표시. 스탯은 bonus/PetStatBonus가 담당).
		return {
			{ name = "쁘띠 루미", ruid = "079d10343b0c41718d67fb619cc8ee60", bonus = { intPct = 10 }, buff = "Pet_Lumi" },
			{ name = "쁘띠 팬텀", ruid = "a4954fe77b3148fa9bbb85543498fb82", bonus = { lukPct = 10 }, buff = "Pet_Phantom" },
			{ name = "쁘띠 아란", ruid = "0b3329aa82ac46a7a44e053d133eda89", bonus = { strPct = 10 }, buff = "Pet_Aran" },
			{ name = "쁘띠 메르", ruid = "e51e5cb8822846569ab2d69f99cbac58", bonus = { dexPct = 10 }, buff = "Pet_Mer" },
			{ name = "쁘띠 은월", ruid = "42d1bed405ec48c4a3cd7de63aff0d44", bonus = { allStatPct = 9 }, buff = "Pet_Eunwol" },
			{ name = "쁘띠 에반", ruid = "6fc322e47e2d415f967865a632ec1b1e", bonus = { intPct = 10 }, buff = "Pet_Evan" },
		}
	end

	method table Categories()
		-- 카테고리 키 → (버튼 이름, 패널 이름). 펫만 기능, 나머지는 더미 패널.
		-- Cash(환전)는 LeftTabGroup에 탭 버튼이 없다 → btn="" (WireBtn이 무효 경로를 스킵).
		-- 여기에 포함시키는 목적은 ShowCategory 배타 전환 + BtnClose 배선 + 시작 시 숨김을 태우기 위함.
		-- 실제 열기는 LifeCoinExchange가 캐시 헤더 클릭으로 ShowCategory("Cash")를 호출한다.
		return {
			{ key = "Pet",       btn = "PetBtn",       panel = "PetPanel" },
			{ key = "Potential", btn = "PotentialBtn", panel = "PotentialPanel" },
			{ key = "Guild",     btn = "GuildBtn",     panel = "GuildPanel" },
			{ key = "Romance",   btn = "RomanceBtn",   panel = "RomancePanel" },
			{ key = "Cash",      btn = "",             panel = "CashPanel" },
		}
	end

	method string ProductIdByName(string name)
		-- 상품명 → 현재 월드 productId(없으면 nil). LifeCoinExchange 등 다른 상점이 재사용.
		if self._nameToId == nil then return nil end
		return self._nameToId[name]
	end

	method any PetByName(string name)
		-- 이름으로 펫 데이터 조회. 없으면 nil.
		for _, p in ipairs(self:PetList()) do
			if p.name == name then return p end
		end
		return nil
	end

	method void OnBeginPlay()
		-- 상점 이름↔Id 맵을 먼저 구성(서버·클라 각자). 서버: 결제 콜백/입장. 클라: 상점 UI 배선.
		self:BuildShopMaps()
		if self:IsServer() then
			self._spawned = {}
			_WorldShopService:SetProcessPurchaseCallback(function(info) return self:OnProcessPurchase(info) end)
			self.userEnterHandler = _UserService:ConnectEvent(UserEnterEvent, self.OnUserEnter)
-- 			log("[PetShop] 서버 초기화: 구매 콜백 + 입장 이벤트 등록")
		else
			self:WireClient()
		end
	end

	method void BuildShopMaps()
		-- 현재 월드 상점(Item)을 훑어 이름↔productId 맵 구성. productId는 월드마다 달라지므로 런타임 조회.
		-- 이관 후 그룹 월드에 '같은 이름'으로 상품만 재등록하면 코드 수정 없이 자동 매칭된다.
		self._nameToId = {}
		self._idToName = {}
		-- 판매중(Ing) 우선. Maker 테스트(판매기간 시작 전) 대비 대기/등록 상태도 보조로 채움.
		self:WalkProducts(WorldShopProductStatus.Ing)
		self:WalkProducts(WorldShopProductStatus.Waiting)
		self:WalkProducts(WorldShopProductStatus.Register)
-- 		log("[PetShop] 상점 맵 구성 완료")
	end

	method void WalkProducts(any status)
		-- 특정 판매상태의 Item 상품을 페이지 순회하며 이름↔Id에 누적(이미 있으면 유지 → Ing 우선).
		local pages = _WorldShopService:GetProductsAndWait(WorldShopProductType.Item, status)
		if isvalid(pages) == false then return end
		while true do
			local datas = pages:GetCurrentPageDatas()
			if datas ~= nil then
				for _, prod in ipairs(datas) do
					if self._nameToId[prod.Name] == nil then
						self._nameToId[prod.Name] = prod.Id
						self._idToName[prod.Id] = prod.Name
					end
				end
			end
			if pages.IsLastPage then break end
			pages:MoveToNextPageAndWait()
		end
	end

	@ExecSpace("ServerOnly")
	method boolean OnProcessPurchase(any info)
		-- 결제 완료 콜백(WorldShopPurchaseInfo). 우리 펫 상품이면 지급 후 true(성공), 아니면 false.
		-- info: { ProductId, PurchaseId, UserId, OrderNumber } — 무료 상품은 OrderNumber=0.
		-- 현재 월드 productId → 이름으로 역매핑해 어떤 펫인지 판별.
		local name = nil
		if self._idToName ~= nil then name = self._idToName[info.ProductId] end
		local pet = nil
		if name ~= nil then pet = self:PetByName(name) end
		if pet == nil then
			-- 펫이 아니면 라이프 코인 환전 팩인지 확인(결제 콜백은 월드당 1개라 여기서 분기).
			if name ~= nil and _LifeCoinExchange ~= nil and _LifeCoinExchange:TryGrant(info.UserId, name) then
				return true
			end
-- 			log_warning("[PetShop] 알 수 없는 상품 결제: " .. tostring(info.ProductId))
			return false
		end
		-- 구매 = 소유만 기록(자동 장착 안 함). 이후 상점 버튼이 '장착하기'로 바뀐다.
		self:GrantOwnership(info.UserId, pet.name)
-- 		log("[PetShop] 구매 지급 완료: user=" .. tostring(info.UserId) .. " pet=" .. pet.name)
		return true
	end

	@ExecSpace("ServerOnly")
	method void GrantPet(string userId, string petName)
		-- 소유(장착) 저장 + 즉시 소환. 식별자는 이름(월드 간 안정).
		self:SaveEquipped(userId, petName)
		self:SpawnPetFor(userId, petName)
	end

	method table OwnedNames(table set)
		-- 소유 집합 → PetList 순서의 이름 배열(안정 정렬). 상점 그리드 순서와 일치.
		local names = {}
		for _, p in ipairs(self:PetList()) do
			if set[p.name] == true then table.insert(names, p.name) end
		end
		return names
	end

	@ExecSpace("ServerOnly")
	method table LoadOwnedSet(string userId)
		-- OwnedPets(콤마 문자열) → { name=true } 집합. 레거시 호환: EquippedPet도 소유로 간주.
		local set = {}
		local st = _DataStorageService:GetUserDataStorage(userId)
		if isvalid(st) == false then return set end
		local ec, raw = st:GetAndWait("OwnedPets")
		if ec == 0 and raw ~= nil and raw ~= "" then
			for token in string.gmatch(raw, "([^,]+)") do
				if token ~= "" then set[token] = true end
			end
		end
		local ec2, eq = st:GetAndWait("EquippedPet")
		if ec2 == 0 and eq ~= nil and eq ~= "" then set[eq] = true end
		return set
	end

	@ExecSpace("ServerOnly")
	method void GrantOwnership(string userId, string petName)
		-- 구매 완료 처리: 소유 목록에 추가 + 상태 전송.
		-- 장착 중인 펫이 없으면 방금 산 펫을 즉시 장착·소환한다(빈 슬롯에 구매 = 바로 적용).
		-- 이미 다른 펫을 장착 중이면 그대로 둔다 — 사용자가 카드의 '교체하기'로 직접 정한다.
		-- 방금 SaveOwned로 쓴 값을 다시 읽지 않고, 계산한 names로 바로 전송(SetAsync 경쟁 회피).
		local set = self:LoadOwnedSet(userId)
		set[petName] = true
		local names = self:OwnedNames(set)
		self:SaveOwned(userId, names)
		local equipped = self:LoadEquipped(userId)
		if equipped == "" then
			-- GrantPet = EquippedPet 저장 + 소환(+ ApplyPetBonus).
			self:GrantPet(userId, petName)
			equipped = petName
		end
		self:SendPetState(userId, table.concat(names, ","), equipped)
	end

	@ExecSpace("ServerOnly")
	method string LoadEquipped(string userId)
		-- 현재 장착 펫 이름(없으면 ""). 상태 전송용 조회.
		local st = _DataStorageService:GetUserDataStorage(userId)
		if isvalid(st) == false then return "" end
		local ec, eq = st:GetAndWait("EquippedPet")
		if ec == 0 and eq ~= nil then return eq end
		return ""
	end

	@ExecSpace("ServerOnly")
	method void PushPetStateTo(string userId)
		-- 저장소에서 소유/장착을 읽어 해당 클라로 전송(방금 쓴 값이 없는 조회 상황용).
		local set = self:LoadOwnedSet(userId)
		local ownedCsv = table.concat(self:OwnedNames(set), ",")
		self:SendPetState(userId, ownedCsv, self:LoadEquipped(userId))
	end

	@ExecSpace("ServerOnly")
	method void SendPetState(string userId, string ownedCsv, string equipped)
		-- 계산된 소유/장착 상태를 해당 클라로 전송(버튼 라벨 갱신용).
		self:ReceivePetState(ownedCsv, equipped or "", userId)
	end

	@ExecSpace("Server")
	method void RequestPetState()
		-- 클라→서버: 요청 클라의 현재 소유/장착 상태를 되돌려 push.
		local userId = senderUserId
		if userId == nil or userId == "" then return end
		self:PushPetStateTo(userId)
	end

	@ExecSpace("Server")
	method void RequestEquipPet(string petName)
		-- 클라→서버: 소유한 펫을 무료로 장착/교체(재결제 없음). 미소유 펫은 차단.
		local userId = senderUserId
		if userId == nil or userId == "" then return end
		if self:PetByName(petName) == nil then return end
		local set = self:LoadOwnedSet(userId)
		if set[petName] ~= true then
-- 			log_warning("[PetShop] 미소유 펫 장착 시도 차단: " .. tostring(petName))
			return
		end
		self:SaveEquipped(userId, petName)
		self:SpawnPetFor(userId, petName)
		self:SendPetState(userId, table.concat(self:OwnedNames(set), ","), petName)
	end

	@ExecSpace("ServerOnly")
	method void SaveEquipped(string userId, string petName)
		-- 유저별 DataStorage에 장착 펫 '이름' 비동기 저장(월드 간 안정 키).
		local st = _DataStorageService:GetUserDataStorage(userId)
		if isvalid(st) == false then return end
		st:SetAsync("EquippedPet", petName, function(ec, key)
-- 			if ec ~= 0 then log_warning("[PetShop] 소유 저장 오류코드=" .. tostring(ec)) end
		end)
	end

	@ExecSpace("ServerOnly")
	method void SpawnPetFor(string userId, string petName)
		-- 해당 유저 옆에 펫 모델 인스턴스를 소환하고 스프라이트/팔로워를 세팅한다.
		local pet = self:PetByName(petName)
		if pet == nil then return end
		local p = _UserService:GetUserEntityByUserId(userId)
		if isvalid(p) == false then return end
		local map = p.CurrentMap
		if isvalid(map) == false then return end
		
		-- 기존 펫 제거(중복 소환 방지).
		self:DespawnPet(userId)
		
		local pos0 = p.TransformComponent.WorldPosition
		local spawnPos = Vector3(pos0.x - 0.55, pos0.y + 0.15, pos0.z)
		local e = _SpawnService:SpawnByModelId("pet", "Pet_" .. userId, spawnPos, map)
		if isvalid(e) == false then
-- 			log_warning("[PetShop] 펫 스폰 실패: " .. tostring(userId))
			return
		end
		
		local sr = e.SpriteRendererComponent
		if isvalid(sr) then sr.SpriteRUID = pet.ruid end
		
		e:AddComponent("script.PetFollow")
		local pf = e:GetComponent("script.PetFollow")
		if isvalid(pf) then pf.OwnerUserId = userId end

		self._spawned[userId] = e
		-- 장착 펫의 추가 스탯 옵션 적용(전투력 재계산 포함).
		self:ApplyPetBonus(userId, pet)
-- 		log("[PetShop] 펫 소환: " .. pet.name .. " (user=" .. tostring(userId) .. ")")
	end

	@ExecSpace("ServerOnly")
	method void ApplyPetBonus(string userId, table pet)
		-- 장착 펫의 bonus(퍼센트 옵션)를 플레이어 PetStatBonus에 SET하고 전투력을 재계산한다.
		-- SET 의미라 펫 교체/재소환에 안전(중복 누적 없음). bonus 없으면 전부 0.
		local p = _UserService:GetUserEntityByUserId(userId)
		if isvalid(p) == false then return end
		local pb = p:GetComponent("script.PetStatBonus")
		if isvalid(pb) == false then
			-- 입장 핸들러 순서 경쟁으로 아직 미부착일 수 있음 → 직접 부착(중복은 AddComponent가 무시).
			p:AddComponent("script.PetStatBonus")
			pb = p:GetComponent("script.PetStatBonus")
		end
		if isvalid(pb) == false then return end
		local b = {}
		if pet ~= nil and pet.bonus ~= nil then b = pet.bonus end
		pb:SetBonus(b.strPct or 0, b.dexPct or 0, b.intPct or 0, b.lukPct or 0, b.allStatPct or 0)
		local cp = p:GetComponent("script.CombatPowerManager")
		if isvalid(cp) then cp:CalculateCurrentCombatPower() end
	end

	@ExecSpace("ServerOnly")
	method void ApplyPetBuff(string userId)
		-- 게임 맵 진입 시 호출: 현재 장착 펫(EquippedPet)의 버프를 버프바에 표시(시각 전용).
		-- 스탯은 PetStatBonus가 담당하므로 이 버프의 CSV 스탯 컬럼은 비어 있음(이중 적용 없음).
		-- 펫이 없으면 아무것도 안 함(SetBuff 미호출). 슬롯 버프라 이후 펫 교체 시 자동 교체.
		local p = _UserService:GetUserEntityByUserId(userId)
		if isvalid(p) == false then return end
		local st = _DataStorageService:GetUserDataStorage(userId)
		if isvalid(st) == false then return end
		local ec, raw = st:GetAndWait("EquippedPet")
		if ec ~= 0 or raw == nil or raw == "" then return end
		local pet = self:PetByName(raw)
		if pet == nil or pet.buff == nil or pet.buff == "" then return end
		local bm = p:GetComponent("script.BuffManager")
		if isvalid(bm) == false then return end
		bm:SetBuff(pet.buff)
-- 		log("[PetShop] 펫 버프 적용: " .. tostring(pet.buff) .. " (user=" .. tostring(userId) .. ")")
	end

	@ExecSpace("ServerOnly")
	method void ClearPetBonus(string userId)
		-- 펫 해제 시 옵션 제거 + 전투력 재계산.
		local p = _UserService:GetUserEntityByUserId(userId)
		if isvalid(p) == false then return end
		local pb = p:GetComponent("script.PetStatBonus")
		if isvalid(pb) then pb:Clear() end
		local cp = p:GetComponent("script.CombatPowerManager")
		if isvalid(cp) then cp:CalculateCurrentCombatPower() end
	end

	@ExecSpace("ServerOnly")
	method void DespawnPet(string userId)
		-- 기존 소환 펫 제거 + 스탯 옵션 해제. (SpawnPetFor 중간 호출 시엔 직후 ApplyPetBonus가 다시 SET)
		local old = self._spawned[userId]
		if isvalid(old) then old:Destroy() end
		self._spawned[userId] = nil
		self:ClearPetBonus(userId)
	end

	@ExecSpace("ServerOnly")
	method void OnUserEnter(UserEnterEvent event)
		-- 입장 시 저장된 장착 펫을 읽어 자동 재소환.
		local st = _DataStorageService:GetUserDataStorage(event.UserId)
		if isvalid(st) == false then return end
		local ec, raw = st:GetAndWait("EquippedPet")
		if ec == 0 and raw ~= nil and raw ~= "" then
			if self:PetByName(raw) ~= nil then
				self:SpawnPetFor(event.UserId, raw)
-- 				log("[PetShop] 재입장 펫 재소환: " .. tostring(raw))
			end
		elseif ec ~= 0 and ec ~= 1000002 then
			-- 1000002 = NotFound(펫 없음). 그 외만 경고.
-- 			log_warning("[PetShop] 소유 로드 오류코드=" .. tostring(ec))
		end
	end

	@ExecSpace("ServerOnly")
	method void GrantAllPets(string userId)
		-- 모든 펫을 소유목록에 기록하고 대표펫(첫 펫)을 장착·소환.
		local pets = self:PetList()
		if #pets == 0 then return end
		local names = {}
		for _, p in ipairs(pets) do table.insert(names, p.name) end
		self:SaveOwned(userId, names)
		-- 대표펫 = 목록 첫 번째. GrantPet가 EquippedPet 저장 + 소환 처리.
		self:GrantPet(userId, pets[1].name)
		-- 소유 전체 + 대표펫 장착 상태를 클라에 반영(버튼 라벨 교체하기).
		self:SendPetState(userId, table.concat(names, ","), pets[1].name)
-- 		log("[PetShop] 전체 펫 지급 완료: user=" .. tostring(userId) .. " 소유=" .. tostring(#names) .. "종 대표=" .. pets[1].name)
	end

	@ExecSpace("ServerOnly")
	method void ResetAllPets(string userId)
		-- 소유목록 + 장착 펫 데이터 제거 + 소환 펫 제거.
		self:ClearPetData(userId)
		self:DespawnPet(userId)
		-- 소유/장착 모두 비워졌음을 클라에 반영(버튼 라벨 구매하기).
		self:SendPetState(userId, "", "")
-- 		log("[PetShop] 펫 데이터 전부 제거 완료: user=" .. tostring(userId))
	end

	@ExecSpace("ServerOnly")
	method void SaveOwned(string userId, table names)
		-- 소유 펫 '이름' 목록을 콤마 조인 문자열로 저장(펫 이름에 콤마 없음 → 충돌 없음).
		local st = _DataStorageService:GetUserDataStorage(userId)
		if isvalid(st) == false then return end
		local joined = table.concat(names, ",")
		st:SetAsync("OwnedPets", joined, function(ec, key)
-- 			if ec ~= 0 then log_warning("[PetShop] 소유목록 저장 오류코드=" .. tostring(ec)) end
		end)
	end

	@ExecSpace("ServerOnly")
	method void ClearPetData(string userId)
		-- EquippedPet / OwnedPets 키를 빈 문자열로 초기화(재입장 시 자동 소환 안 됨).
		local st = _DataStorageService:GetUserDataStorage(userId)
		if isvalid(st) == false then return end
		st:SetAsync("EquippedPet", "", function(ec, key)
-- 			if ec ~= 0 then log_warning("[PetShop] 장착 초기화 오류코드=" .. tostring(ec)) end
		end)
		st:SetAsync("OwnedPets", "", function(ec, key)
-- 			if ec ~= 0 then log_warning("[PetShop] 소유목록 초기화 오류코드=" .. tostring(ec)) end
		end)
	end

	@ExecSpace("ClientOnly")
	method void WireClient()
		-- 열기/카테고리/닫기/구매 버튼 배선 + 펫 카드(이름/아이콘) 세팅. 상점은 시작 시 숨김.
		self._btnH = {}
		self._hoverH = {}
		self._owned = {}
		self._equipped = ""
		local shop = _EntityService:GetEntityByPath(self.shopPanelPath)
		if isvalid(shop) then shop.Enable = false end
		
		self:WireBtn(self.shopBtnPath, function() self:OpenShop() end)
		
		-- 카테고리 버튼 + 각 패널 닫기 버튼 + 시작 시 패널 숨김.
		for _, c in ipairs(self:Categories()) do
			local key = c.key
			-- 카테고리 버튼은 ShopPanel/LeftTabGroup 하위에 있음(직속 아님).
			-- btn 빈 문자열(Cash 등 탭 없는 카테고리)은 스킵 → 트레일링 슬래시 경로 오배선 방지.
			if c.btn ~= nil and c.btn ~= "" then
				self:WireBtn(self.shopPanelPath .. "/LeftTabGroup/" .. c.btn, function() self:ShowCategory(key) end)
			end
			self:WireBtn(self.shopPanelPath .. "/" .. c.panel .. "/BtnClose", function() self:CloseShop() end)
			local pnl = _EntityService:GetEntityByPath(self.shopPanelPath .. "/" .. c.panel)
			if isvalid(pnl) then pnl.Enable = false end
		end
		
		-- 개발/테스트용 버튼(ShopPanel 직속): 전체 펫 지급 / 전체 펫 데이터 제거.
		self:WireBtn(self.shopPanelPath .. "/GetAllPetData_Btn", function() self:OnGetAllClick() end)
		self:WireBtn(self.shopPanelPath .. "/ResetAllPetData_Btn", function() self:OnResetAllClick() end)
		
		-- 펫 카드: 이름/아이콘(움직이는 펫 애니) 세팅 + 구매 버튼.
		local pets = self:PetList()
		for i = 1, #pets do
			local rowPath = self.petPanelPath .. "/Rows/Row" .. tostring(i)
			local nameE = _EntityService:GetEntityByPath(rowPath .. "/Name")
			if isvalid(nameE) and isvalid(nameE.TextComponent) then
				nameE.TextComponent.Text = pets[i].name
			end
			local iconE = _EntityService:GetEntityByPath(rowPath .. "/UISprite")
			if isvalid(iconE) and isvalid(iconE.SpriteGUIRendererComponent) then
				iconE.SpriteGUIRendererComponent.ImageRUID = DataRef(pets[i].ruid)
			end
			local capturedName = pets[i].name
			-- 상태 수신 전 기본 라벨: 구매하기.
			local btnE = _EntityService:GetEntityByPath(rowPath .. "/BtnBuy")
			if isvalid(btnE) and isvalid(btnE.TextComponent) then btnE.TextComponent.Text = "구매하기" end
			-- 클릭은 소유 여부에 따라 구매/장착으로 분기(OnRowClick).
			self:WireBtn(rowPath .. "/BtnBuy", function() self:OnRowClick(capturedName) end)
			-- 펫 옵션 호버 툴팁 배선.
			self:WirePetHover(rowPath, pets[i])
		end

		-- 내 소유/장착 상태 요청 → 서버가 push하면 버튼 라벨이 갱신됨.
		self:RequestPetState()
	end

	@ExecSpace("ClientOnly")
	method void WirePetHover(string rowPath, table pet)
		-- HoverZone(자식 없는 투명 버튼) 호버 시 HoverInfo(정보 박스)를 표시한다.
		-- 정보 텍스트는 펫 옵션으로 1회 세팅. 기본은 숨김.
		local info = _EntityService:GetEntityByPath(rowPath .. "/HoverInfo")
		if isvalid(info) then info.Enable = false end
		local txtE = _EntityService:GetEntityByPath(rowPath .. "/HoverInfo/Txt")
		if isvalid(txtE) and isvalid(txtE.TextComponent) then
			txtE.TextComponent.Text = self:BonusText(pet)
		end
		local zone = _EntityService:GetEntityByPath(rowPath .. "/HoverZone")
		if isvalid(zone) == false then return end
		local capturedInfo = info
		local h = zone:ConnectEvent(ButtonStateChangeEvent, function(ev)
			-- PC=Hover, 모바일 롱프레스=Pressed → 표시. 그 외(Normal/Released)=숨김.
			local st = ev.state
			local show = (st == ButtonState.Hover or st == ButtonState.Pressed)
			if isvalid(capturedInfo) then capturedInfo.Enable = show end
		end)
		table.insert(self._hoverH, { entity = zone, evtH = h })
	end

	method string BonusText(table pet)
		-- 펫 옵션을 사람이 읽을 텍스트로 조립한다(헤더 + 스탯 1줄).
		local b = nil
		if pet ~= nil then b = pet.bonus end
		local line = ""
		if b ~= nil then
			if (b.strPct or 0) ~= 0 then line = "STR +" .. tostring(b.strPct) .. "%"
			elseif (b.dexPct or 0) ~= 0 then line = "DEX +" .. tostring(b.dexPct) .. "%"
			elseif (b.intPct or 0) ~= 0 then line = "INT +" .. tostring(b.intPct) .. "%"
			elseif (b.lukPct or 0) ~= 0 then line = "LUK +" .. tostring(b.lukPct) .. "%"
			elseif (b.allStatPct or 0) ~= 0 then line = "올스탯 +" .. tostring(b.allStatPct) .. "%" end
		end
		if line == "" then line = "옵션 없음" end
		return "추가 옵션\n\n" .. line
	end

	@ExecSpace("ClientOnly")
	method void WireBtn(string path, any fn)
		-- 경로 버튼에 ButtonClickEvent 연결 + 핸들 보관(OnEndPlay 해제용).
		local e = _EntityService:GetEntityByPath(path)
		if isvalid(e) == false then return end
		local h = e:ConnectEvent(ButtonClickEvent, fn)
		table.insert(self._btnH, { entity = e, evtH = h })
	end

	@ExecSpace("ClientOnly")
	method void OpenShop()
		-- 상점 표시 + 맨 앞으로 + 기본 펫 카테고리.
		_SFXManager:PlayClick()
		local shop = _EntityService:GetEntityByPath(self.shopPanelPath)
		if isvalid(shop) == false then return end
		shop.Enable = true
		self:ShowCategory("Pet")
		-- 열 때마다 최신 소유/장착 상태 재요청(버튼 라벨 최신화).
		self:RequestPetState()
	end

	@ExecSpace("ClientOnly")
	method void CloseShop()
		-- 상점 전체 숨김.
		_SFXManager:PlayClick()
		local shop = _EntityService:GetEntityByPath(self.shopPanelPath)
		if isvalid(shop) then shop.Enable = false end
	end

	@ExecSpace("ClientOnly")
	method void ShowCategory(string key)
		-- 선택 카테고리 패널만 표시, 나머지 숨김.
		_SFXManager:PlayClick()
		for _, c in ipairs(self:Categories()) do
			local pnl = _EntityService:GetEntityByPath(self.shopPanelPath .. "/" .. c.panel)
			if isvalid(pnl) then pnl.Enable = (c.key == key) end
		end
	end

	@ExecSpace("ClientOnly")
	method void OnBuyClick(string petName)
		-- 구매 버튼: 이름으로 현재 월드 productId를 찾아 결제창 표시(무료=0코인). 결과는 서버 콜백에서 지급.
		_SFXManager:PlayClick()
		local pid = nil
		if self._nameToId ~= nil then pid = self._nameToId[petName] end
		if pid == nil then
			-- 이 월드 상점에 해당 이름의 상품이 없음(미등록/이름 불일치) → 무반응 대신 경고.
			log_warning("[PetShop] 상점 미등록 상품(구매 불가): " .. tostring(petName))
			return
		end
-- 		log("[PetShop] 구매창 요청: " .. tostring(petName) .. " → " .. tostring(pid))
		_WorldShopService:PromptPurchase(pid)
	end

	@ExecSpace("ClientOnly")
	method void OnRowClick(string petName)
		-- 카드 버튼 클릭: 미소유=결제창, 소유=무료 장착/교체 요청.
		local owned = self._owned
		if owned ~= nil and owned[petName] == true then
			-- 이미 이 펫을 장착 중이면 무시(버튼도 비활성이지만 이중 안전장치).
			if self._equipped == petName then return end
			_SFXManager:PlayClick()
			self:RequestEquipPet(petName)
		else
			-- OnBuyClick가 클릭음 + 결제창 처리.
			self:OnBuyClick(petName)
		end
	end

	@ExecSpace("Client")
	method void ReceivePetState(string ownedCsv, string equipped)
		-- 서버가 보낸 내 펫 소유/장착 상태 수신 → 캐시 후 버튼 라벨 갱신.
		self._owned = self:ParseCsvSet(ownedCsv)
		self._equipped = equipped or ""
		self:RefreshButtons()
	end

	method table ParseCsvSet(string csv)
		-- 콤마 조인 문자열 → { name=true } 집합. 빈 문자열이면 빈 집합.
		local set = {}
		if csv == nil or csv == "" then return set end
		for token in string.gmatch(csv, "([^,]+)") do
			if token ~= "" then set[token] = true end
		end
		return set
	end

	@ExecSpace("ClientOnly")
	method void RefreshButtons()
		-- 소유/장착 상태에 따라 각 펫 카드 버튼 라벨/활성을 4분기로 갱신.
		--   미소유=구매하기 / 소유+아무것도 장착안함=장착하기 / 소유+다른 펫 장착중=교체하기 /
		--   소유+이 펫 장착중=장착중(버튼 비활성: 보이지만 클릭 불가).
		local owned = self._owned
		if owned == nil then owned = {} end
		local hasEquipped = (self._equipped ~= nil and self._equipped ~= "")
		local pets = self:PetList()
		for i = 1, #pets do
			local name = pets[i].name
			local rowPath = self.petPanelPath .. "/Rows/Row" .. tostring(i)
			local btnE = _EntityService:GetEntityByPath(rowPath .. "/BtnBuy")
			if isvalid(btnE) then
				local label = "구매하기"
				local clickable = true
				if owned[name] == true then
					if self._equipped == name then
						-- 이미 이 펫을 장착 중 → 비활성 + '장착중'.
						label = "장착중"
						clickable = false
					elseif hasEquipped then
						-- 다른 펫을 장착 중.
						label = "교체하기"
					else
						-- 소유했지만 아무것도 장착 안 함.
						label = "장착하기"
					end
				end
				if isvalid(btnE.TextComponent) then btnE.TextComponent.Text = label end
				-- 엔티티가 아니라 ButtonComponent만 꺼서 '보이지만 클릭 불가'로 만든다
				-- (스프라이트/텍스트는 별도 컴포넌트라 그대로 표시). RefreshButtons가 매번 재설정하므로
				-- 장착 해제/교체 시 자동으로 다시 활성화된다.
				if isvalid(btnE.ButtonComponent) then btnE.ButtonComponent.Enable = clickable end
			end
		end
	end

	@ExecSpace("ClientOnly")
	method void OnGetAllClick()
		-- 모든 펫 구매처리 요청(본인). 실제 소유 저장/소환은 서버에서 처리.
		_SFXManager:PlayClick()
-- 		log("[PetShop] 전체 펫 구매처리 요청")
		self:RequestGrantAll()
	end

	@ExecSpace("ClientOnly")
	method void OnResetAllClick()
		-- 펫 구매 데이터 전부 제거 요청(본인). 실제 삭제/디스폰은 서버에서 처리.
		_SFXManager:PlayClick()
-- 		log("[PetShop] 전체 펫 데이터 제거 요청")
		self:RequestResetAll()
	end

	@ExecSpace("Server")
	method void RequestGrantAll()
		-- 클라→서버 RPC. 요청한 클라(senderUserId)에게 모든 펫 지급.
		local userId = senderUserId
		if userId == nil or userId == "" then return end
		self:GrantAllPets(userId)
	end

	@ExecSpace("Server")
	method void RequestResetAll()
		-- 클라→서버 RPC. 요청한 클라(senderUserId)의 펫 데이터 전부 제거.
		local userId = senderUserId
		if userId == nil or userId == "" then return end
		self:ResetAllPets(userId)
	end

	@ExecSpace("ClientOnly")
	method void OnEndPlay()
		-- 버튼 이벤트 핸들 해제.
		if self._btnH ~= nil then
			for _, r in ipairs(self._btnH) do
				if isvalid(r.entity) and r.evtH ~= nil then
					r.entity:DisconnectEvent(ButtonClickEvent, r.evtH)
				end
			end
			self._btnH = nil
		end
		-- 펫 옵션 호버 핸들 해제.
		if self._hoverH ~= nil then
			for _, r in ipairs(self._hoverH) do
				if isvalid(r.entity) and r.evtH ~= nil then
					r.entity:DisconnectEvent(ButtonStateChangeEvent, r.evtH)
				end
			end
			self._hoverH = nil
		end
	end

end