@Component
script LobbyMapManagement extends Component

	property Entity lobbyGroup = "1b439576-8c6f-4a2a-bbfe-7538a59c5a8a"

	property Entity inGameGroup = "a322b09a-023e-427d-9c6c-19724156dab7"

	@ExecSpace("ClientOnly")
	method void OnBeginPlay()
		-- 로비 맵 진입: 로비 UI 켜고 인게임 UI 끔.
		self:ApplyUI()
	end

	@ExecSpace("ClientOnly")
	method void ApplyUI()
		if isvalid(self.lobbyGroup) then self.lobbyGroup.Enable = true end
		if isvalid(self.inGameGroup) then self.inGameGroup.Enable = false end
		log("[LobbyMapManagement] 로비 UI 활성 / 인게임 UI 비활성")
	end

end