@Component
script FirstMapManagement extends Component

	property Entity lobbyGroup = "1b439576-8c6f-4a2a-bbfe-7538a59c5a8a"

	property Entity inGameGroup = "a322b09a-023e-427d-9c6c-19724156dab7"

	property boolean _roomGameTriggered = false

	property integer _roomCheckTimer = 0

	@ExecSpace("ClientOnly")
	method void OnBeginPlay()
		-- 인스턴스 룸(싱글 세션)으로 이동하면 Map_01이 '새로' 로드되며 플레이어가 이미 들어와 있다.
		-- 이 경우 map-scoped 컴포넌트는 OnMapEnter가 아니라 OnBeginPlay를 받으므로, 여기서 초기 UI를 세팅하고
		-- 인스턴스 룸이면 게임 시작 트리거를 위한 짧은 폴링을 시작한다(맵 로드/플레이어 등록 타이밍 안전).
		self:ApplyUI()
		if self._roomCheckTimer ~= 0 then _TimerService:ClearTimer(self._roomCheckTimer) end
		self._roomCheckTimer = _TimerService:SetTimerRepeat(function() self:PollRoomStart() end, 0.1)
	end

	@ExecSpace("ClientOnly")
	method void OnEndPlay()
		-- 폴링 타이머 정리.
		if self._roomCheckTimer ~= 0 then _TimerService:ClearTimer(self._roomCheckTimer) self._roomCheckTimer = 0 end
	end

	@ExecSpace("ClientOnly")
	method void OnMapEnter(Entity enteredMap)
		-- 같은 룸 안에서 Map_01로 '전환'해 들어온 경우(직접 플레이/테스트 등)의 초기 UI 정리.
		-- 룸 이동으로 새로 로드되는 정상 싱글 플로우는 OnBeginPlay + PollRoomStart가 담당한다.
		if _MapViewManager ~= nil then _MapViewManager:CloseMapView() end
		self:ApplyUI()
	end

	@ExecSpace("ClientOnly")
	method void PollRoomStart()
		-- [룸 분리] 이 클라의 플레이어가 자기 인스턴스 룸의 Map_01에 실제로 들어온 순간을 한 번 잡아
		-- 오프닝 인트로를 띄우고 서버에 실제 게임 시작(BeginSingleRoomGame)을 요청한다.
		if self._roomGameTriggered then
			if self._roomCheckTimer ~= 0 then _TimerService:ClearTimer(self._roomCheckTimer) self._roomCheckTimer = 0 end
			return
		end
		if _RoomService == nil or _RoomService:IsInstanceRoom() == false then return end
		local lp = _UserService.LocalPlayer
		if isvalid(lp) == false or lp.CurrentMapName ~= "Map_01" then return end
		-- 조건 충족 → 한 번만 트리거하고 폴링 종료.
		self._roomGameTriggered = true
		if self._roomCheckTimer ~= 0 then _TimerService:ClearTimer(self._roomCheckTimer) self._roomCheckTimer = 0 end
		if _MapViewManager ~= nil then _MapViewManager:CloseMapView() end
		self:ApplyUI()
		_LevelUpCelebration:MarkOpeningCampPending()
		if isvalid(_IntroCutscene) then _IntroCutscene:BeginOpening() end
		_GameModeManager:BeginSingleRoomGame()
		log("[FirstMapManagement] 인스턴스 룸 싱글 게임 시작 트리거")
	end

	@ExecSpace("ClientOnly")
	method void ApplyUI()
		-- 인게임 UI 켜고 로비 UI 끈다.
		if isvalid(self.inGameGroup) then self.inGameGroup.Enable = true end
		if isvalid(self.lobbyGroup) then self.lobbyGroup.Enable = false end
		log("[InGameMapManagement] 인게임 UI 활성 / 로비 UI 비활성")
	end

end