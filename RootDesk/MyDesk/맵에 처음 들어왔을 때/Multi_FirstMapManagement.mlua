@Component
script Multi_FirstMapManagement extends Component

	property Entity lobbyGroup = "1b439576-8c6f-4a2a-bbfe-7538a59c5a8a"

	property Entity inGameGroup = "a322b09a-023e-427d-9c6c-19724156dab7"

	property boolean _arrivalTriggered = false

	property integer _checkTimer = 0

	@ExecSpace("ClientOnly")
	method void OnBeginPlay()
		-- 멀티 공유 인스턴스 룸(Map_01) 도착을 서버에 등록하기 위한 폴링 시작.
		self:ApplyUI()
		if self._checkTimer ~= 0 then _TimerService:ClearTimer(self._checkTimer) end
		self._checkTimer = _TimerService:SetTimerRepeat(function() self:PollArrival() end, 0.1)
	end

	@ExecSpace("ClientOnly")
	method void OnEndPlay()
		-- 도착 폴링 타이머 정리.
		if self._checkTimer ~= 0 then _TimerService:ClearTimer(self._checkTimer) self._checkTimer = 0 end
	end

	@ExecSpace("ClientOnly")
	method void PollArrival()
		-- 멀티 룸("Multi_")의 Map_01에 로컬 플레이어가 로드된 순간 1회만 도착 등록.
		if self._arrivalTriggered then
			if self._checkTimer ~= 0 then _TimerService:ClearTimer(self._checkTimer) self._checkTimer = 0 end
			return
		end
		if _RoomService == nil or _RoomService:IsInstanceRoom() == false then return end
		local rk = _RoomService.RoomKey
		if rk == nil or string.sub(rk, 1, 6) ~= "Multi_" then return end
		local lp = _UserService.LocalPlayer
		if isvalid(lp) == false or lp.CurrentMapName ~= "Map_01" then return end
		self._arrivalTriggered = true
		if self._checkTimer ~= 0 then _TimerService:ClearTimer(self._checkTimer) self._checkTimer = 0 end
		self:ApplyUI()
		_GameModeManager:RegisterMultiArrival()
		log("[Multi_FirstMapManagement] 멀티 Map_01 도착 등록")
	end

	@ExecSpace("ClientOnly")
	method void ApplyUI()
		-- 인게임 UI 켜고 로비 UI 끈다.
		if isvalid(self.inGameGroup) then self.inGameGroup.Enable = true end
		if isvalid(self.lobbyGroup) then self.lobbyGroup.Enable = false end
	end

end
