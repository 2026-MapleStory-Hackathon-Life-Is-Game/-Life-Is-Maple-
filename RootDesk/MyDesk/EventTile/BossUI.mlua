@Logic
script BossUI extends Logic

	property Entity BossGroup = "b3478f61-f3f7-45ae-a10d-396161da6527"

	property Entity SelectionPanel = "ddde3d93-9f2c-40bb-a070-c4ac99b84613"

	property Entity DetailPanel = "352c550f-af4f-4375-9883-7134c23babb0"

	property Entity BossCard1 = "e223d50e-cbe3-4b23-80db-37a531b2b143"

	property Entity BossCard2 = "b02bf98b-61c8-4fce-94de-024e4e6c60f4"

	property Entity BossCard3 = "c2ea2ceb-18e7-4462-a7e2-a1649e2b39b8"

	property Entity BossCard4 = "e8a4749f-02f4-4b9e-a068-328744594bf7"

	property Entity BossCard1Img = "d0fd5057-96b1-4fbd-bb44-a7cd390b3fd6"

	property Entity BossCard2Img = "959ae41a-8c96-465e-a043-4e4611a5235d"

	property Entity BossCard3Img = "ed6a742a-43b9-4d1d-9a0e-9a18b0b14042"

	property Entity BossCard4Img = "67150637-54c7-4e43-ba1f-fcdac22ca3f6"

	property Entity DetailBossImage = "2a57bd64-4464-451b-ab7a-501e559a5292"

	property Entity BossCard1Name = "b4aca9e8-cc7a-45fe-8215-354ed8fa4170"

	property Entity BossCard2Name = "dd64ef7b-cf44-4a15-b60b-f28e5b77dc94"

	property Entity BossCard3Name = "5fa5ecd7-abc8-4176-a085-a2e364261318"

	property Entity BossCard4Name = "f522b41a-9d87-4be1-91d1-3117b3869e44"

	property Entity BossCard1Item = "8f925984-2a3b-4e6d-b07c-0d010fe00a13"

	property Entity BossCard2Item = "1d0def31-2202-494e-ae1b-b63a3110e6ea"

	property Entity BossCard3Item = "f6fd839d-24b5-4e1f-aa53-292379d58bf1"

	property Entity BossCard4Item = "e4a1bd1e-9df4-410e-b17d-ce4e156f1369"

	property string _card1DefaultName = "4카루타"

	property table _bossDiffs = {}

	property Entity DetailBossName = "36060171-5658-42a6-b756-204cdd114f62"

	property Entity MyPowerText = "0466a161-21b7-4af1-bdc4-6954032c1206"

	property Entity EasyButton = "983189c4-66cd-4971-b802-4d30ebc1a2e8"

	property Entity NormalButton = "47ee2787-2240-4454-9c54-dc8cf8cfbdf7"

	property Entity HardButton = "269e9bdd-61cc-4772-9bb1-2258fcca1f59"

	property Entity ChaosButton = "af964015-c85e-4fc4-b13f-b1f0c8f20bcd"

	-- 검은 마법사 전용 '익스트림' 난이도 버튼(HardButton 복제, 붉은 틴트). BossProbability에 Extreme 행이 있는 보스에만 노출된다.
	property Entity ExtremeButton = "d92916f6-6a36-49eb-9abf-2f5156064feb"

	property Entity BackButton = "3c201d98-f990-403a-84b4-95714351580b"

	property Entity SelectionText = "d297d26f-19c2-49d4-b639-3f61c446a0fb"

	property Entity InGameGroup = "a322b09a-023e-427d-9c6c-19724156dab7"

	property any _bossTile = nil

	property integer _selectedIndex = 1

	property table _bossKeys = {}

	property table _bossNames = {}

	property table _diffButtons = {}

	property table _cardHandlers = {}

	property table _diffHandlers = {}

	property any _backHandler = nil

	@ExecSpace("ClientOnly")
	method void OnBeginPlay()
		-- 보스 키/표시명 매핑 + 카드/난이도/뒤로 버튼 핸들러 연결. 평소엔 그룹 숨김.
		-- 보스 키는 BossProbability.csv의 BossName(영문키)과 일치시킨다 → RollByBossTable이 바로 매칭.
		self._bossKeys = { "Root_Abyss", "Papulatus", "Lotus", "Damien" }
		self._bossNames = { "루타비스", "파풀라투스", "스우", "데미안" }
		
		-- 1번 카드 이름 기본값 저장(단일 모드(검은 마법사) 후 일반 보스칸에서 복원용).
		if isvalid(self.BossCard1Name) and isvalid(self.BossCard1Name.TextComponent) then
			self._card1DefaultName = self.BossCard1Name.TextComponent.Text
		end
		
		-- 난이도 버튼 구성(고정 4종). 순서 = 이지 → 노말 → 하드 → 카오스.
		self._diffButtons = {
			{ key = "Easy",    label = "이지",     e = self.EasyButton },
			{ key = "Normal",  label = "노말",     e = self.NormalButton },
			{ key = "Hard",    label = "하드",     e = self.HardButton },
			{ key = "Chaos",   label = "카오스",   e = self.ChaosButton },
			{ key = "Extreme", label = "익스트림", e = self.ExtremeButton },
		}
		
		if isvalid(self.BossGroup) then
			self.BossGroup.Enable = false
		end
		
		self._cardHandlers = {}
		local cards = { self.BossCard1, self.BossCard2, self.BossCard3, self.BossCard4 }
		for i = 1, 4 do
			local card = cards[i]
			if isvalid(card) then
				local idx = i
				local h = card:ConnectEvent(ButtonClickEvent, function() self:OnCardClicked(idx) end)
				table.insert(self._cardHandlers, { entity = card, eventHandler = h })
			end
		end
		
		-- 난이도 버튼 각각을 RequestSelect(그 난이도)에 연결(클로저로 키 캡처).
		self._diffHandlers = {}
		for i = 1, #self._diffButtons do
			local d = self._diffButtons[i]
			if isvalid(d.e) then
				local dk = d.key
				local h = d.e:ConnectEvent(ButtonClickEvent, function() self:RequestSelect(dk) end)
				table.insert(self._diffHandlers, { entity = d.e, eventHandler = h })
			end
		end
		
		if isvalid(self.BackButton) then
			self._backHandler = self.BackButton:ConnectEvent(ButtonClickEvent, self.OnBackClicked)
		end
	end

	@ExecSpace("ClientOnly")
	method void OnEndPlay()
		-- 핸들러 해제.
		for i = 1, #self._cardHandlers do
			local rec = self._cardHandlers[i]
			if isvalid(rec.entity) and rec.eventHandler ~= nil then
				rec.entity:DisconnectEvent(ButtonClickEvent, rec.eventHandler)
			end
		end
		self._cardHandlers = {}
		for i = 1, #self._diffHandlers do
			local rec = self._diffHandlers[i]
			if isvalid(rec.entity) and rec.eventHandler ~= nil then
				rec.entity:DisconnectEvent(ButtonClickEvent, rec.eventHandler)
			end
		end
		self._diffHandlers = {}
		if isvalid(self.BackButton) and self._backHandler ~= nil then
			self.BackButton:DisconnectEvent(ButtonClickEvent, self._backHandler)
		end
	end

	method table DiffRow(string bossKey, string diff)
		-- BossProbability에서 (보스, 난이도) 행을 찾아 표시용 데이터를 반환한다. 없으면 nil.
		-- (데이터셋은 serveronly=false라 클라에서도 조회 가능.)
		local ds = _DataService:GetTable("BossProbability")
		if isvalid(ds) == false then return nil end
		for i = 1, ds:GetRowCount() do
			local en = ds:GetCell(i, "BossName")
			local kr = ds:GetCell(i, "BossNameKR")
			if (en == bossKey or kr == bossKey) and ds:GetCell(i, "Difficulty") == diff then
				return { drop = ds:GetCell(i, "DropEquip"), req = ds:GetCell(i, "RequiredPower") }
			end
		end
		return nil
	end

	method string MyCombatPower()
		-- 로컬 플레이어의 현재 전투력을 콤마 포맷 문자열로 반환. CombatPowerManager.CombatPower(@Sync)를 읽는다.
		-- 값을 못 구하면 "-".
		local me = _UserService.LocalPlayer
		if isvalid(me) == false then return "-" end
		---@type CombatPowerManager
		local cp = me:GetComponent("script.CombatPowerManager")
		if isvalid(cp) == false then return "-" end
		return self:FormatPower(tostring(cp.CombatPower))
	end

	method string FormatPower(string raw)
		-- 적정 전투력 표시용: "450000" → "450,000". 숫자가 아니면 원본 그대로.
		local n = tonumber(raw)
		if n == nil then return tostring(raw) end
		local s = tostring(math.floor(n))
		local out = ""
		local cnt = 0
		for i = #s, 1, -1 do
			out = string.sub(s, i, i) .. out
			cnt = cnt + 1
			if cnt % 3 == 0 and i > 1 then out = "," .. out end
		end
		return out
	end

	method string FormatDrop(string raw, string sep)
		-- 드랍 문자열의 구분자 "/"를 sep으로 바꾼다. 단 "세트/무기"는 같은 줄(",무기")로 묶는다.
		local s = (string.gsub(tostring(raw), "/무기", ",무기"))
		s = (string.gsub(s, "/", sep))
		return s
	end

	@ExecSpace("ClientOnly")
	method void SetCard1Name(string name)
		-- 1번 카드 이름 텍스트(BossCard1/NameBack/NameText)를 런타임으로 설정한다.
		if isvalid(self.BossCard1Name) and isvalid(self.BossCard1Name.TextComponent) then
			self.BossCard1Name.TextComponent.Text = name
		end
	end

	method table SplitDiffs(string csv)
		-- 허용 난이도 CSV("Normal/Chaos") → { "Normal", "Chaos" }. 빈 값이면 빈 목록.
		local list = {}
		if csv == nil or csv == "" then return list end
		for part in string.gmatch(csv, "[^/]+") do
			table.insert(list, part)
		end
		return list
	end

	method boolean DiffAllowed(table allowed, string diff)
		-- allowed 목록에 diff가 포함돼 있으면 true. allowed가 nil이면(지역 제한 없음) 항상 true.
		if allowed == nil then return true end
		for i = 1, #allowed do
			if allowed[i] == diff then return true end
		end
		return false
	end

	method string BossDisplayName(string key)
		-- 보스 키 → 표시명(BossProbability.BossNameKR). 없으면 키 그대로.
		local bp = _DataService:GetTable("BossProbability")
		if isvalid(bp) then
			for i = 1, bp:GetRowCount() do
				if bp:GetCell(i, "BossName") == key then
					local nm = bp:GetCell(i, "BossNameKR")
					if nm ~= nil and nm ~= "" then return nm end
				end
			end
		end
		return key
	end

	@ExecSpace("ClientOnly")
	method void SetCardName(integer idx, string name)
		-- idx번(1~4) 카드의 이름 텍스트를 설정한다.
		local names = { self.BossCard1Name, self.BossCard2Name, self.BossCard3Name, self.BossCard4Name }
		local e = names[idx]
		if isvalid(e) and isvalid(e.TextComponent) then
			e.TextComponent.Text = name
		end
	end

	method table BossImageRow(string key)
		-- BossImage에서 보스 키의 { select, detail } RUID를 반환한다. 없으면 nil.
		local ds = _DataService:GetTable("BossImage")
		if isvalid(ds) == false then return nil end
		for i = 1, ds:GetRowCount() do
			if ds:GetCell(i, "BossName") == key then
				return {
					select = ds:GetCell(i, "BossSelectRUID"),
					detail = ds:GetCell(i, "DetailPanelRUID"),
				}
			end
		end
		return nil
	end

	@ExecSpace("ClientOnly")
	method void SetImageRUID(Entity e, string ruid)
		-- SpriteGUIRendererComponent.ImageRUID 교체. ruid가 비었으면(미등록) 변경하지 않는다.
		if isvalid(e) == false or ruid == nil or ruid == "" then return end
		if isvalid(e.SpriteGUIRendererComponent) then
			e.SpriteGUIRendererComponent.ImageRUID = DataRef(ruid)
		end
	end

	method table BossUITransform(string bossKey)
		-- BossImage에서 보스별 표시 보정값(scale/offX/offY)을 반환한다. 없거나 빈 칸이면 기본(1/0/0 = 변화 없음).
		local res = { scale = 1, offX = 0, offY = 0 }
		local ds = _DataService:GetTable("BossImage")
		if isvalid(ds) == false then return res end
		for i = 1, ds:GetRowCount() do
			if ds:GetCell(i, "BossName") == bossKey then
				res.scale = tonumber(ds:GetCell(i, "UIScale")) or 1
				res.offX  = tonumber(ds:GetCell(i, "UIOffsetX")) or 0
				res.offY  = tonumber(ds:GetCell(i, "UIOffsetY")) or 0
				return res
			end
		end
		return res
	end

	@ExecSpace("ClientOnly")
	method void SetCardImage(integer idx, string bossKey)
		-- idx번 카드의 보스 선택 이미지(Img)를 BossImage.BossSelectRUID로 설정한다.
		-- 카드는 고정 슬롯 크기 그대로 표시한다(BossImage.UIScale은 인게임 보스 전투 크기에만 쓰고, 선택 카드에는 적용하지 않는다).
		local imgs = { self.BossCard1Img, self.BossCard2Img, self.BossCard3Img, self.BossCard4Img }
		local row = self:BossImageRow(bossKey)
		if row ~= nil then self:SetImageRUID(imgs[idx], row.select) end
	end

	method string CardInfoText(string bossKey, table allowed)
		-- 선택 카드의 드랍 안내 텍스트를 BossProbability 기반으로 만든다(더미 대체).
		-- 이 보스가 (지역이 허용하고) 실존하는 난이도별로 "난이도 · 드랍" 한 줄씩. 없으면 "".
		-- 난이도가 여러 개면 드랍이 다르므로 난이도 라벨을 붙인다. detail 패널과 같은 BossProbability 값을 참조.
		-- 검은 마법사는 드랍 아이템이 없다 → 더미 안내([드랍 아이템] 헤더/빈 라벨)를 표시하지 않고 빈칸으로 둔다. (다른 보스엔 영향 없음)
		if bossKey == "Black_Mage" then return "" end
		local lines = { "[드랍 아이템]" }
		local order = { "Easy", "Normal", "Hard", "Chaos" }
		local labels = { Easy = "이지", Normal = "노말", Hard = "하드", Chaos = "카오스" }
		local count = 0
		for oi = 1, #order do
			local dk = order[oi]
			if self:DiffAllowed(allowed, dk) then
				local row = self:DiffRow(bossKey, dk)
				if row ~= nil then
					count = count + 1
					table.insert(lines, labels[dk] .. " · " .. self:FormatDrop(row.drop, ", "))
				end
			end
		end
		if count == 0 then return "" end
		return table.concat(lines, "\n")
	end

	@ExecSpace("ClientOnly")
	method void SetCardDrops(integer idx, string bossKey, table allowed)
		-- idx번 카드의 드랍 안내 텍스트(ItemText…)를 BossProbability 기반으로 설정한다.
		local items = { self.BossCard1Item, self.BossCard2Item, self.BossCard3Item, self.BossCard4Item }
		local e = items[idx]
		if isvalid(e) and isvalid(e.TextComponent) then
			e.TextComponent.Text = self:CardInfoText(bossKey, allowed)
		end
	end

	@ExecSpace("ClientOnly")
	method void PrefetchForTile(string mapName, string tileName)
		-- 도착 예정 타일이 보스칸으로 확정되면, 그 지역 로스터의 보스 선택 이미지를 미리 카드에 올려둔다.
		-- (실제 리소스 프리로드는 EventTileUI.PrefetchForTile의 PreloadAsync가 담당 — 여기선 카드 Img 선반영.)
		if _TileManager:GetTileType(mapName, tileName) ~= "Boss" then return end
		local stage = _TileManager:GetTileStage(mapName, tileName)
		local region = _TileManager:GetTileRegion(mapName, tileName)
		local spawn = _DataService:GetTable("BossSpawn")
		if isvalid(spawn) == false then return end
		local idx = 0
		for i = 1, spawn:GetRowCount() do
			if (tonumber(spawn:GetCell(i, "Stage")) or 0) == stage and spawn:GetCell(i, "Region") == region then
				idx = idx + 1
				if idx <= 4 then self:SetCardImage(idx, spawn:GetCell(i, "BossName")) end
			end
		end
-- 		log("[BossUI] 보스 이미지 프리캐시 tile=" .. tostring(tileName) .. " 보스수=" .. tostring(idx))
	end

	@ExecSpace("ClientOnly")
	method void ShowRoster(Component bossTile, string introText, table bossKeys, table bossDiffs)
		-- 지역 기반 보스 선택 화면. bossKeys[i]=보스 키, bossDiffs[i]=이 지역 허용 난이도 CSV("Normal/Chaos").
		-- 로스터 개수(최대 4)만큼 카드를 노출하고 각 카드 이름을 보스명으로 설정한다.
		self._bossTile = bossTile
		self._selectedIndex = 1
		local n = #bossKeys
		if n > 4 then n = 4 end
		self._bossKeys = {}
		self._bossNames = {}
		self._bossDiffs = {}
		for i = 1, n do
			self._bossKeys[i] = bossKeys[i]
			self._bossNames[i] = self:BossDisplayName(bossKeys[i])
			self._bossDiffs[i] = self:SplitDiffs(bossDiffs[i])
		end
		self:HideOtherUIs()
		if isvalid(self.BossGroup) then self.BossGroup.Enable = true end
		if isvalid(self.SelectionPanel) then self.SelectionPanel.Enable = true end
		if isvalid(self.DetailPanel) then self.DetailPanel.Enable = false end
		if isvalid(self.SelectionText) and isvalid(self.SelectionText.TextComponent) then
			-- 대사 색칠(스탯 이름=파랑 / 숫자=빨강)은 EventTileUI.Colorize로 일원화한다.
			self.SelectionText.TextComponent.Text = _EventTileUI:Colorize(introText)
		end
		-- N개 카드만 노출 + 이름/보스 선택 이미지 설정. 나머지 카드는 숨김.
		local cards = { self.BossCard1, self.BossCard2, self.BossCard3, self.BossCard4 }
		for i = 1, 4 do
			if isvalid(cards[i]) then
				cards[i].Enable = (i <= n)
				if isvalid(cards[i].ButtonComponent) then cards[i].ButtonComponent.Enable = true end   -- 이전 관전(비활성) 잔재 복구
			end
			if i <= n then
				self:SetCardName(i, self._bossNames[i])
				self:SetCardImage(i, self._bossKeys[i])
				self:SetCardDrops(i, self._bossKeys[i], self._bossDiffs[i])
			end
		end
-- 		log("[BossUI] 지역 보스 로스터 표시 보스수=" .. tostring(n))
	end

	@ExecSpace("ClientOnly")
	method void ShowSingle(Component bossTile, string bossKey, string bossName, string introText)
		-- 단일 보스 선택 화면(예: 검은 마법사 최종 결전). 1번 카드만 노출하고 나머지는 숨긴다.
		-- 카드 클릭 → 상세(실존 난이도만; BossProbability에 Hard만 있으면 하드 버튼 1개) → RequestSelect → bossTile:RequestSelect(bossKey, diffKey).
		self._bossTile = bossTile
		self._selectedIndex = 1
		self._bossKeys = { bossKey }
		self._bossNames = { bossName }
		self._bossDiffs = {}   -- 단일 모드: 지역 난이도 제한 없음(BossProbability 실존 난이도 모두 허용)
		self:HideOtherUIs()
		if isvalid(self.BossGroup) then self.BossGroup.Enable = true end
		if isvalid(self.SelectionPanel) then self.SelectionPanel.Enable = true end
		if isvalid(self.DetailPanel) then self.DetailPanel.Enable = false end
		if isvalid(self.SelectionText) and isvalid(self.SelectionText.TextComponent) then
			-- 대사 색칠(스탯 이름=파랑 / 숫자=빨강)은 EventTileUI.Colorize로 일원화한다.
			self.SelectionText.TextComponent.Text = _EventTileUI:Colorize(introText)
		end
		-- 1번 카드만 노출(선택지 1개), 2~4번 숨김.
		local cards = { self.BossCard1, self.BossCard2, self.BossCard3, self.BossCard4 }
		for i = 1, 4 do
			if isvalid(cards[i]) then
				cards[i].Enable = (i == 1)
				-- 이전에 일반 보스칸을 관전(ShowRosterReadOnly)해 버튼이 비활성으로 남았을 수 있으므로 복구한다.
				-- (복구 누락 시 검은 마법사 결전 카드가 안 눌리는 버그 — 피드백 13.)
				if isvalid(cards[i].ButtonComponent) then cards[i].ButtonComponent.Enable = true end
			end
		end
		self:SetCard1Name(bossName)   -- 1번 카드 이름을 보스명(검은 마법사)으로 런타임 교체
		self:SetCardImage(1, bossKey) -- 1번 카드 보스 선택 이미지도 교체
		self:SetCardDrops(1, bossKey, nil) -- 단일 모드: 제한 없음(BossProbability 실존 난이도 전부)
-- 		log("[BossUI] 단일 보스 선택 표시: " .. tostring(bossName))
	end

	@ExecSpace("Client")
	method void SpectatorShowRoster(string introText, table bossKeys, table bossDiffs, string actorUserId)
		-- 관전자: actor의 보스 로스터를 읽기전용으로 방송(어떤 보스를 고르는지 보이게, 피드백 11). actor는 자기 경로를 쓰므로 스킵.
		local lp = _UserService.LocalPlayer
		if isvalid(lp) and lp.PlayerComponent ~= nil and lp.PlayerComponent.UserId == actorUserId then return end
		local who = "다른 유저"
		local ae = _UserService:GetUserEntityByUserId(actorUserId)
		if isvalid(ae) and ae.PlayerComponent ~= nil and ae.PlayerComponent.Nickname ~= nil and ae.PlayerComponent.Nickname ~= "" then
			who = ae.PlayerComponent.Nickname
		end
		self:ShowRosterReadOnly(introText, bossKeys, bossDiffs, who)
	end

	@ExecSpace("ClientOnly")
	method void ShowRosterReadOnly(string introText, table bossKeys, table bossDiffs, string who)
		-- 관전 표시: 로스터 카드(이름/이미지/드랍)만 채우고 카드 버튼은 비활성(클릭 불가) + '고르는 중' 상태.
		-- 상세/난이도 진입·선택 경로는 열지 않는다(_bossTile=nil로 RequestSelect 원천 차단).
		self._bossTile = nil
		local n = #bossKeys
		if n > 4 then n = 4 end
		self:HideOtherUIs()
		if isvalid(self.BossGroup) then self.BossGroup.Enable = true end
		if isvalid(self.SelectionPanel) then self.SelectionPanel.Enable = true end
		if isvalid(self.DetailPanel) then self.DetailPanel.Enable = false end
		if isvalid(self.SelectionText) and isvalid(self.SelectionText.TextComponent) then
			self.SelectionText.TextComponent.Text = _EventTileUI:Colorize(introText) .. "\n(" .. who .. " 고르는 중...)"
		end
		local cards = { self.BossCard1, self.BossCard2, self.BossCard3, self.BossCard4 }
		for i = 1, 4 do
			if isvalid(cards[i]) then
				cards[i].Enable = (i <= n)
				if isvalid(cards[i].ButtonComponent) then cards[i].ButtonComponent.Enable = false end   -- 읽기전용(눌림/호버 차단)
			end
			if i <= n then
				self:SetCardName(i, self:BossDisplayName(bossKeys[i]))
				self:SetCardImage(i, bossKeys[i])
				self:SetCardDrops(i, bossKeys[i], self:SplitDiffs(bossDiffs[i]))
			end
		end
-- 		log("[BossUI] 관전 보스 로스터 표시 보스수=" .. tostring(n) .. " actor=" .. who)
	end

	@ExecSpace("Client")
	method void SpectatorHide(string actorUserId)
		-- 관전자 보스 로스터 닫기(actor가 선택을 완료해 전투 연출로 넘어갈 때). actor 스킵.
		local lp = _UserService.LocalPlayer
		if isvalid(lp) and lp.PlayerComponent ~= nil and lp.PlayerComponent.UserId == actorUserId then return end
		self:Hide()
	end

	@ExecSpace("ClientOnly")
	method void Hide()
		-- 보스 UI 닫기 + 보스 선택 중 숨겼던 인게임 HUD 복원.
		if isvalid(self.BossGroup) then self.BossGroup.Enable = false end
		if isvalid(self.InGameGroup) then self.InGameGroup.Enable = true end
	end

	@ExecSpace("ClientOnly")
	method void HideOtherUIs()
		-- 보스 선택 화면은 BossUI만 보이게 — 인게임 HUD / EventTileGroup / 이동·결과 주사위 UI를 모두 숨긴다.
		if isvalid(self.InGameGroup) then self.InGameGroup.Enable = false end
		if isvalid(_EventTileUI.EventGroup) then _EventTileUI.EventGroup.Enable = false end
		if isvalid(_RollDiceAnimationUI.panel) then _RollDiceAnimationUI.panel.Enable = false end
		if isvalid(_RollDiceAnimationUI.DiceBuffPanel) then _RollDiceAnimationUI.DiceBuffPanel.Enable = false end
		if isvalid(_RollDiceAnimationUI.diceParticle) then _RollDiceAnimationUI.diceParticle.Enable = false end
		if isvalid(_RollResultDiceAnimationUI.panel) then _RollResultDiceAnimationUI.panel.Enable = false end
		if isvalid(_RollResultDiceAnimationUI.diceParticle) then _RollResultDiceAnimationUI.diceParticle.Enable = false end
	end

	@ExecSpace("ClientOnly")
	method void OnCardClicked(integer idx)
		-- 카드 클릭 → 상세 화면(난이도 선택지)으로. 보스 이름 세팅 + 실존 난이도만 활성화.
		self._selectedIndex = idx
		if isvalid(self.DetailBossName) and isvalid(self.DetailBossName.TextComponent) then
			self.DetailBossName.TextComponent.Text = self._bossNames[idx]
		end
		-- 난이도 버튼 위에 현재 내 전투력 표시.
		if isvalid(self.MyPowerText) and isvalid(self.MyPowerText.TextComponent) then
			self.MyPowerText.TextComponent.Text = "내 전투력 : " .. self:MyCombatPower()
		end
		-- DetailPanel 보스 이미지 = BossImage.DetailPanelRUID (고정 슬롯 크기 그대로 — BossImage.UIScale은 인게임 전투에만 적용).
		local imgRow = self:BossImageRow(self._bossKeys[idx])
		if imgRow ~= nil then self:SetImageRUID(self.DetailBossImage, imgRow.detail) end
		
		-- 이 지역이 허용하고(_bossDiffs) 또한 BossProbability에 실존하는 난이도만 버튼 활성화.
		-- (_bossDiffs[idx]가 nil이면 단일 모드 → 지역 제한 없음. 없는/미허용 난이도는 Enable=false.)
		local bossKey = self._bossKeys[idx]
		local allowed = self._bossDiffs[idx]
		for i = 1, #self._diffButtons do
			local d = self._diffButtons[i]
			if isvalid(d.e) then
				local row = self:DiffRow(bossKey, d.key)
				if row ~= nil and self:DiffAllowed(allowed, d.key) then
					d.e.Enable = true
					if isvalid(d.e.TextComponent) then
						-- 버튼 본문은 난이도 라벨(제목, 큰 글씨)만.
						d.e.TextComponent.Text = d.label
					end
					-- 세부 설명(적정 전투력 / 드랍)은 버튼 하위 Desc 텍스트(작은 글씨)에 표시.
					-- 포맷: "제목\n: 내용", 두 파트 사이에는 빈 줄 하나. 드랍 항목의 "/"는 ", "로.
					local desc = d.e:GetChildByName("Desc")
					if isvalid(desc) and isvalid(desc.TextComponent) then
						if bossKey == "Black_Mage" then
							-- 검은 마법사는 드랍 아이템이 없다 → 드랍 안내를 빈칸으로 두고 적정 전투력만 표시. (다른 보스엔 영향 없음)
							desc.TextComponent.Text = "적정 전투력\n: " .. self:FormatPower(row.req)
						else
							-- "세트/무기"는 같은 줄(",무기")로 묶고, 나머지 "/"는 줄바꿈으로.
							local dropRaw = (string.gsub(tostring(row.drop), "/무기", ",무기"))
							local dropText = (string.gsub(dropRaw, "/", "\n"))
							desc.TextComponent.Text = "적정 전투력\n: " .. self:FormatPower(row.req)
								.. "\n\n드랍 아이템\n: " .. dropText
						end
					end
				else
					d.e.Enable = false
				end
			end
		end
		
		if isvalid(self.SelectionPanel) then self.SelectionPanel.Enable = false end
		if isvalid(self.DetailPanel) then self.DetailPanel.Enable = true end
-- 		log("[BossUI] 보스 상세: " .. tostring(self._bossNames[idx]))
	end

	@ExecSpace("ClientOnly")
	method void OnBackClicked(ButtonClickEvent event)
		-- 뒤로가기 → 보스 선택지로 복귀.
		if isvalid(self.DetailPanel) then self.DetailPanel.Enable = false end
		if isvalid(self.SelectionPanel) then self.SelectionPanel.Enable = true end
	end

	@ExecSpace("ClientOnly")
	method void RequestSelect(string diffKey)
		-- 현재 상세 보스 + 난이도로 BossTile에 최종 선택을 보낸다.
		if isvalid(self._bossTile) == false then return end
		local key = self._bossKeys[self._selectedIndex]
		if key == nil then return end
		self._bossTile:RequestSelect(key, diffKey)
	end

end