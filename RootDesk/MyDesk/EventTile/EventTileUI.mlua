@Logic
script EventTileUI extends Logic

	-- 이벤트 타일 UI(EventTileGroup) 클라 컨트롤러.
	-- UI 그룹 바깥의 @Logic 이라 그룹을 켜고/끄는 동안 자기 자신이 비활성화되지 않는다.
	-- 서버 타일(EventTileBase)이 도착 플레이어 클라에 Show(eventType, message)를 호출한다.

	-- EventTileGroup 루트 엔티티(표시/숨김 토글 대상).
	property Entity EventGroup = "707f4eb6-99f6-4e7d-878c-c3a90cec9a81"

	-- 결과 문구를 출력할 UIText 엔티티 경로(TextComponent 보유).
	property string TextPath = "/ui/EventTileGroup/EventBack/UISprite/UIText"

	-- ATTACK 모션을 보여줄 초상화(아바타) 경로.
	property string PortraitPath = "/ui/EventTileGroup/EventBack/BackgroundMap/PlayerPortrait"

	-- 이벤트 UI 자동 닫힘까지의 시간(초).
	property number AutoHideSeconds = 5.0

	-- 마을 수락 연출에서 각 문구(퀘스트 문구 / 결과 문구)를 보여주는 시간(초).
	property number VillageStepSeconds = 5.0

	property integer attackTimer = 0
	property integer autoHideTimer = 0

	-- ===== 마을(인터랙티브) 이벤트용 — 수락/거절 버튼 =====
	property Entity AcceptButton = "2a91f613-50ec-455f-8610-6fdc36bfeca4"
	property Entity DeclineButton = "27c567d9-0abf-44ed-8536-a916699f3a8b"
	property any _acceptHandler = nil
	property any _declineHandler = nil
	-- 진행 중인 마을 타일 컴포넌트(버튼 콜백을 서버로 보내기 위해 보관).
	property any _villageTile = nil

	@ExecSpace("ClientOnly")
	method void OnBeginPlay()
		-- 평소엔 숨김. (그룹 바깥 Logic이라 안전하게 끌 수 있다.)
		if isvalid(self.EventGroup) then
			self.EventGroup.Enable = false
		end
		-- 마을 이벤트 버튼: 평소 비활성 + 클릭 핸들러 연결.
		if isvalid(self.AcceptButton) then
			self.AcceptButton.Enable = false
			self._acceptHandler = self.AcceptButton:ConnectEvent(ButtonClickEvent, self.OnAcceptClicked)
		end
		if isvalid(self.DeclineButton) then
			self.DeclineButton.Enable = false
			self._declineHandler = self.DeclineButton:ConnectEvent(ButtonClickEvent, self.OnDeclineClicked)
		end
	end

	@ExecSpace("ClientOnly")
	method void OnEndPlay()
		self:ClearTimers()
		if isvalid(self.AcceptButton) and self._acceptHandler ~= nil then
			self.AcceptButton:DisconnectEvent(ButtonClickEvent, self._acceptHandler)
		end
		if isvalid(self.DeclineButton) and self._declineHandler ~= nil then
			self.DeclineButton:DisconnectEvent(ButtonClickEvent, self._declineHandler)
		end
	end

	@ExecSpace("ClientOnly")
	method void Show(string eventType, string message)
		-- 도착 플레이어 클라에서 호출(EventTileBase.ShowEventUI 경유). 그룹을 켜고 문구/연출을 세팅한다.
		-- eventType은 추후 여러 이벤트 UI로 분기하기 위한 키(현재는 "Hunt"만).
		if isvalid(self.EventGroup) == false then
			log_warning("[EventTileUI] EventGroup 엔티티를 찾을 수 없습니다.")
			return
		end
		self.EventGroup.Enable = true
		-- 사냥 등 단순 이벤트에서는 마을 버튼이 보이지 않도록 강제로 끈다.
		self:SetButtons(false)

		-- 결과 문구 출력.
		self:SetText(message)
		log("[EventTileUI] 이벤트 표시(" .. tostring(eventType) .. "): " .. message)

		-- 초상화 ATTACK 모션 시작 + 일정 시간 후 자동 닫힘.
		self:StartPortraitAttack()
		self:ClearTimer("autoHideTimer")
		self.autoHideTimer = _TimerService:SetTimerOnce(function()
			self:Hide()
		end, self.AutoHideSeconds)
	end

	@ExecSpace("ClientOnly")
	method void Hide()
		-- 이벤트 UI 닫기: 타이머 정리 후 그룹 숨김.
		self:ClearTimers()
		if isvalid(self.EventGroup) then
			self.EventGroup.Enable = false
		end
	end

	@ExecSpace("ClientOnly")
	method void StartPortraitAttack()
		-- 즉시 1회 적용 후, 아바타 로딩 타이밍을 대비해 1초마다 재적용한다.
		self:ApplyPortraitAttack()
		self:ClearTimer("attackTimer")
		self.attackTimer = _TimerService:SetTimerRepeat(function()
			self:ApplyPortraitAttack()
		end, 1.0)
	end

	@ExecSpace("ClientOnly")
	method void ApplyPortraitAttack()
		-- 초상화 아바타가 ATTACK(공격) 모션을 재생하도록 강제한다.
		local portrait = _EntityService:GetEntityByPath(self.PortraitPath)
		if isvalid(portrait) == false then
			return
		end
		local event = BodyActionStateChangeEvent()
		event.ActionState = MapleAvatarBodyActionState.Attack
		event.needResetAction = false
		portrait:SendEvent(event)
	end

	method void ClearTimer(string field)
		-- 지정한 타이머 필드를 해제하고 0으로 만든다.
		if field == "attackTimer" then
			if self.attackTimer ~= 0 then
				_TimerService:ClearTimer(self.attackTimer)
				self.attackTimer = 0
			end
		elseif field == "autoHideTimer" then
			if self.autoHideTimer ~= 0 then
				_TimerService:ClearTimer(self.autoHideTimer)
				self.autoHideTimer = 0
			end
		end
	end

	method void ClearTimers()
		self:ClearTimer("attackTimer")
		self:ClearTimer("autoHideTimer")
	end

	-- ============================================================================
	-- 마을(인터랙티브) 이벤트 — 질문 + 수락/거절 버튼 + 결과 주사위 연출
	-- ============================================================================

	@ExecSpace("ClientOnly")
	method void SetText(string message)
		-- UIText 엔티티에 문구를 출력한다.
		local textEntity = _EntityService:GetEntityByPath(self.TextPath)
		if isvalid(textEntity) and isvalid(textEntity.TextComponent) then
			textEntity.TextComponent.Text = message
		else
			log_warning("[EventTileUI] UIText/TextComponent 를 찾을 수 없습니다: " .. self.TextPath)
		end
	end

	@ExecSpace("ClientOnly")
	method void SetButtons(boolean on)
		-- 수락/거절 버튼 표시 토글.
		if isvalid(self.AcceptButton) then self.AcceptButton.Enable = on end
		if isvalid(self.DeclineButton) then self.DeclineButton.Enable = on end
	end

	@ExecSpace("ClientOnly")
	method void ShowVillage(string question, Component villageTile)
		-- 마을 질문 표시: 그룹을 켜고 문구 + 수락/거절 버튼 활성. 자동닫힘 없음(버튼 선택까지 유지).
		self._villageTile = villageTile
		self:ClearTimers()
		if isvalid(self.EventGroup) == false then
			log_warning("[EventTileUI] EventGroup 엔티티를 찾을 수 없습니다.")
			return
		end
		self.EventGroup.Enable = true
		self:SetText(question)
		self:SetButtons(true)
		self:StartPortraitAttack()
		log("[EventTileUI] 마을 질문 표시: " .. question)
	end

	@ExecSpace("ClientOnly")
	method void OnAcceptClicked(ButtonClickEvent event)
		-- 수락: 버튼 끄고 서버(VillageTile)에 수락 요청.
		if isvalid(self._villageTile) == false then return end
		self:SetButtons(false)
		self._villageTile:RequestAccept()
	end

	@ExecSpace("ClientOnly")
	method void OnDeclineClicked(ButtonClickEvent event)
		-- 거절: 버튼/그룹 끄고 서버(VillageTile)에 거절 요청(결과 주사위 없이 종료).
		if isvalid(self._villageTile) == false then return end
		self:SetButtons(false)
		if isvalid(self.EventGroup) then self.EventGroup.Enable = false end
		self._villageTile:RequestDecline()
	end

	@ExecSpace("ClientOnly")
	method void VillageQuestText(string questText, Component villageTile)
		-- 수락 1단계: 버튼 off → 퀘스트 문구를 VillageStepSeconds 동안 표시 → 서버에 결과 굴림 요청.
		-- (굴림을 이 시점으로 미뤄야 결과주사위 효과음이 패널 표시와 맞는다.)
		self._villageTile = villageTile
		self:SetButtons(false)
		self:SetText(questText)
		self:ClearTimer("autoHideTimer")
		self.autoHideTimer = _TimerService:SetTimerOnce(function()
			if isvalid(self._villageTile) then
				self._villageTile:RequestQuestRoll()
			end
		end, self.VillageStepSeconds)
	end

	@ExecSpace("ClientOnly")
	method void VillageDice(integer d1, integer d2, integer total, table resultTable, string outcome, string outcomeText, Component villageTile)
		-- 수락 2단계: 결과 주사위 연출(기존 UI 재사용) → 결과 문구(VillageStepSeconds) → 서버에 종료 신호.
		self._villageTile = villageTile
		_RollResultDiceAnimationUI:Show(d1, d2, total, resultTable, outcome, function()
			self:SetText(outcomeText)
			self:ClearTimer("autoHideTimer")
			self.autoHideTimer = _TimerService:SetTimerOnce(function()
				if isvalid(self.EventGroup) then self.EventGroup.Enable = false end
				if isvalid(self._villageTile) then
					self._villageTile:RequestFinish()
				end
			end, self.VillageStepSeconds)
		end)
	end

end
