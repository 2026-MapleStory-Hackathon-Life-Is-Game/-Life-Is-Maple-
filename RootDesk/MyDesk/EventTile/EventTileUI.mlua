	@ExecSpace("ClientOnly")
	method void OnBeginPlay()
		-- 평소엔 그룹 숨김 + 모든 버튼 비활성.
		if isvalid(self.EventGroup) then self.EventGroup.Enable = false end
		self:StopTyping()
		self:HideAllButtons()
	end

	@ExecSpace("ClientOnly")
	method void OnEndPlay()
		self:StopTyping()
		self:StopPortraitMotion()
		self:PortraitResetEmotion()
		self:ClearPortrait()
		self:HideAllButtons()
	end

	@ExecSpace("ClientOnly")
	method any GetTextComp()
		-- 출력 대상 UIText의 TextComponent를 조회(실패 시 nil).
		local e = _EntityService:GetEntityByPath(self.TextPath)
		if isvalid(e) and isvalid(e.TextComponent) then return e.TextComponent end
		return nil
	end

	@ExecSpace("ClientOnly")
	method table Utf8Chars(string s)
		-- 문자열을 UTF-8 문자 단위 목록으로 분리한다(한글=3바이트 안전 처리).
		-- 선행 바이트 값으로 문자 길이를 판별: <0x80 1B / >=0xF0 4B / >=0xE0 3B / >=0xC0 2B.
		local chars = {}
		if s == nil then return chars end
		local i = 1
		local n = #s
		while i <= n do
			local b = string.byte(s, i)
			local len = 1
			if b >= 0xF0 then len = 4
			elseif b >= 0xE0 then len = 3
			elseif b >= 0xC0 then len = 2
			end
			table.insert(chars, string.sub(s, i, i + len - 1))
			i = i + len
		end
		return chars
	end

	@ExecSpace("ClientOnly")
	method void EnsureNameKws()
		-- 장비/장신구/아이템 이름(파랑) 목록을 EquipmentData.Name에서 1회 구축 후 캐시한다.
		-- 데이터셋을 실제로 읽었을 때만 확정(_nameLoaded)하고, 그 전엔 정적 이름(미라클큐브)만으로 동작하다 다음 호출에 재시도.
		-- 긴 이름이 먼저 매칭되도록 바이트 길이 내림차순 정렬(예: '보스 장신구 세트(9)'가 '장비'보다 먼저).
		if self._nameLoaded then return end
		local names = { "미라클 큐브", "미라클큐브" }
		local ds = _DataService:GetTable("EquipmentData")
		if isvalid(ds) then
			for i = 1, ds:GetRowCount() do
				local nm = ds:GetCell(i, "Name")
				if nm ~= nil and nm ~= "" then table.insert(names, nm) end
			end
			self._nameLoaded = true
		end
		table.sort(names, function(a, b) return #a > #b end)
		self._nameKws = names
	end

	@ExecSpace("ClientOnly")
	method string Colorize(string s)
		-- 대사 리치텍스트 색칠: 증가 스탯 '이름'(장비/주스탯/올스탯/공격력 등)은 파란색,
		-- '증가량' 숫자만 빨간색, 그 외 글자·숫자는 기본색(검은색) 그대로 둔다.
		-- 숫자를 빨강으로 칠하는 경우:
		--   (a) %로 끝나는 숫자, 또는
		--   (b) 스탯 키워드 문맥(키워드+조사/공백) 바로 뒤 & 뒤에 단위어(턴/시간/마리 …)가 안 붙은 숫자, 또는
		--   (c) 개수 키워드(길드원/가족/구성원/수) 문맥 바로 뒤 숫자(단위어 무관 — '1명'도 포함).
		--   → '3턴', '100마리', '큐브 x5' 등 스탯·개수와 무관한 숫자는 빨강 제외.
		-- 좌→우 1회 스캔. 타이핑 연출과 함께 쓰도록 '평문'을 받아 매 렌더마다 새로 태깅한다(태그가 한 글자씩 노출 안 됨).
		if s == nil or s == "" then return s end
		self:EnsureNameKws()
		local blue = "#2E6BFF"
		local red = "#E53935"
		-- 스탯 이름 키워드(파랑). 긴/구체 키워드를 먼저(같은 시작 위치에서 더 긴 이름 우선 매칭).
		local kws = {
			"공격력/마력", "보스 공격력", "보스 대미지", "추가 대미지", "크리티컬 대미지",
			"올스탯", "주스탯", "크리티컬", "공격력", "마력", "대미지", "전투력", "장비", "스탯"
		}
		-- 장비/장신구/아이템 이름(파랑, 문맥 없음). EquipmentData에서 구축한 캐시(미라클큐브 포함, 길이 내림차순).
		-- 이름만 파랑이고 뒤의 '(x5)'·'(9)' 등 숫자는 이름의 일부로 함께 파랑 처리된다.
		local nameKws = self._nameKws
		-- 개수 키워드(색칠 안 함·검정). 뒤따르는 숫자를 '개수 증가량'으로 보고 빨강 처리하는 문맥만 연다.
		local countKws = { "길드원", "가족", "구성원", "수" }
		-- 키워드와 숫자 사이에 올 수 있는 조사/공백(이것만 지나면 문맥 유지).
		local josa = { ["이"] = true, ["가"] = true, ["은"] = true, ["는"] = true,
			["을"] = true, ["를"] = true, ["의"] = true, [" "] = true }
		-- 숫자 뒤에 붙으면 '스탯 증가량이 아님'으로 보는 단위어(기간/개수 등). 개수 문맥에는 적용 안 함.
		local units = { "턴", "시간", "마리", "명", "일", "초", "분", "개", "번", "년", "살", "회", "층" }
		local out = {}
		local i = 1
		local n = #s
		local statCtx = false    -- 직전에 스탯 키워드(+조사/공백)가 이어지는 중.
		local countCtx = false   -- 직전에 개수 키워드(+조사/공백)가 이어지는 중.
		while i <= n do
			local matched = false
			-- (1a) 스탯 이름 키워드(파랑) → 스탯 증가량 문맥 시작.
			for k = 1, #kws do
				local kw = kws[k]
				local L = #kw
				if i + L - 1 <= n and string.sub(s, i, i + L - 1) == kw then
					table.insert(out, "<color=" .. blue .. ">" .. kw .. "</color>")
					i = i + L
					matched = true
					statCtx = true
					countCtx = false
					break
				end
			end
			-- (1b) 장비/장신구/아이템 이름(파랑) → 문맥 없음(뒤 숫자에 영향 주지 않음).
			if matched == false then
				for k = 1, #nameKws do
					local kw = nameKws[k]
					local L = #kw
					if i + L - 1 <= n and string.sub(s, i, i + L - 1) == kw then
						table.insert(out, "<color=" .. blue .. ">" .. kw .. "</color>")
						i = i + L
						matched = true
						statCtx = false
						countCtx = false
						break
					end
				end
			end
			-- (1c) 개수 키워드(검정) → 개수 증가량 문맥 시작.
			if matched == false then
				for k = 1, #countKws do
					local kw = countKws[k]
					local L = #kw
					if i + L - 1 <= n and string.sub(s, i, i + L - 1) == kw then
						table.insert(out, kw)
						i = i + L
						matched = true
						countCtx = true
						statCtx = false
						break
					end
				end
			end
			if matched == false then
				-- (2) 숫자: 선택적 +/- 부호 → 숫자 → 선택적 %.
				local num = string.match(s, "^[%+%-]?%d+%%?", i)
				if num ~= nil and num ~= "" then
					local afterPos = i + #num
					local isPercent = string.sub(num, #num) == "%"
					local followedByUnit = false
					for u = 1, #units do
						local ul = #units[u]
						if afterPos + ul - 1 <= n and string.sub(s, afterPos, afterPos + ul - 1) == units[u] then
							followedByUnit = true
							break
						end
					end
					-- 증가량(스탯 %/스탯 문맥/개수 문맥)이면 빨강, 그 외는 기본색.
					if isPercent or (statCtx and followedByUnit == false) or countCtx then
						table.insert(out, "<color=" .. red .. ">" .. num .. "</color>")
					else
						table.insert(out, num)
					end
					i = afterPos
					statCtx = false
					countCtx = false
				else
					-- (3) 그 외: UTF-8 한 글자 통과(한글 3바이트 안전). 조사/공백이 아니면 문맥 해제.
					local b = string.byte(s, i)
					local len = 1
					if b >= 0xF0 then len = 4
					elseif b >= 0xE0 then len = 3
					elseif b >= 0xC0 then len = 2
					end
					local ch = string.sub(s, i, i + len - 1)
					if josa[ch] ~= true then
						statCtx = false
						countCtx = false
					end
					table.insert(out, ch)
					i = i + len
				end
			end
		end
		return table.concat(out)
	end

	@ExecSpace("ClientOnly")
	method void StopTyping()
		-- 진행 중인 타이핑 타이머만 정리한다(이미 출력된 텍스트는 건드리지 않는다).
		if self._typeTimer ~= 0 then
			_TimerService:ClearTimer(self._typeTimer)
			self._typeTimer = 0
		end
		self._typing = false
	end

	@ExecSpace("ClientOnly")
	method void FinishTyping()
		-- 타이핑 중인 문장을 즉시 전부 출력하고 종료한다(‘다음’ 클릭 스킵용).
		self:StopTyping()
		local comp = self._textComp
		if isvalid(comp) == false then comp = self:GetTextComp() end
		if comp ~= nil then comp.Text = self:Colorize(table.concat(self._typeChars)) end
	end

	@ExecSpace("ClientOnly")
	method void TypeStep()
		-- 타이머 콜백: 한 글자씩 누적 출력. 마지막 글자에 도달하면 타이머를 멈춘다.
		local comp = self._textComp
		if isvalid(comp) == false then self:StopTyping() return end
		self._typeIdx = self._typeIdx + 1
		self._typeBuf = self._typeBuf .. (self._typeChars[self._typeIdx] or "")
		comp.Text = self:Colorize(self._typeBuf)
		if self._typeIdx >= #self._typeChars then
			self:StopTyping()
		end
	end

	@ExecSpace("ClientOnly")
	method void SetText(string message)
		-- UIText에 문구를 '한 글자씩' 타이핑 연출로 출력한다. 새 문장이 오면 이전 타이핑은 취소하고 처음부터 시작.
		self:StopTyping()
		local comp = self:GetTextComp()
		if comp == nil then
			log_warning("[EventTileUI] UIText/TextComponent 를 찾을 수 없습니다: " .. self.TextPath)
			return
		end
		self._textComp = comp
		self._typeChars = self:Utf8Chars(message or "")
		self._typeIdx = 0
		self._typeBuf = ""
		comp.Text = ""
		if #self._typeChars == 0 then return end
		self._typing = true
		self._typeTimer = _TimerService:SetTimerRepeat(function() self:TypeStep() end, self.TypeInterval)
	end

	@ExecSpace("ClientOnly")
	method void ShowGroup()
		-- 이벤트 그룹을 켠다. (몬스터/NPC 이미지는 기본 숨김 — 각 이벤트에서 필요한 쪽만 켠다.)
		if isvalid(self.EventGroup) then self.EventGroup.Enable = true end
		self:ApplyRegionBackground()   -- 모든 이벤트 공통: 현재 지역 배경으로 BackgroundMap 교체.
		self:SetMonsterImages("")
		self:SetNPCImage(false, "")
		self._imgNpcFromPage = 0   -- 페이지별 이미지 전환 상태 초기화(이번 표시에서만 재설정).
		self._pageNpcRUIDs = {}    -- 페이지별 NPC 목록도 초기화.
		self._pageEndEmote = ""    -- 마지막-페이지 예약 연출 초기화(이전 이벤트의 예약이 이어지지 않도록).
		self._pageEndEmoteFired = false
	end

	@ExecSpace("ClientOnly")
	method string RegionBackgroundRUID(string region)
		-- EventBackground에서 Region 일치 행의 RUID를 반환. 없으면 "".
		if region == nil or region == "" then return "" end
		local ds = _DataService:GetTable("EventBackground")
		if isvalid(ds) == false then return "" end
		for i = 1, ds:GetRowCount() do
			if ds:GetCell(i, "Region") == region then
				local ruid = ds:GetCell(i, "RUID")
				if ruid == nil then return "" end
				return ruid
			end
		end
		return ""
	end

	@ExecSpace("ClientOnly")
	method void PrefetchForTile(string mapName, string tileName)
		-- 도착 '전'(이동 중/분기 선택 시) 호출. 목적지 타일의 배경을 미리 적용하고,
		-- 배경 + 그 칸에서 나올 수 있는 NPC/몬스터 RUID 후보를 프리로드해 도착 시 pop-in을 없앤다.
		local list = {}
		-- 배경(지역 결정적): 숨겨진 상태에서 미리 적용 + 프리로드(도착 시 ApplyRegionBackground가 같은 값 재적용).
		local region = _TileManager:GetTileRegion(mapName, tileName)
		local bg = self:RegionBackgroundRUID(region)
		if bg ~= "" then
			table.insert(list, bg)
			if isvalid(self.BackgroundMap) and isvalid(self.BackgroundMap.SpriteGUIRendererComponent) then
				self.BackgroundMap.SpriteGUIRendererComponent.ImageRUID = DataRef(bg)
			end
		end
		-- NPC/몬스터/보스 후보(롤 확정 없이 후보 전체를 캐시).
		local cands = _TileManager:GatherArrivalRUIDs(mapName, tileName)
		for i = 1, #cands do table.insert(list, cands[i]) end
		-- 보스칸이면 선택 카드 이미지를 미리 카드에 올려둔다(도착 시 pop-in 방지).
		_BossUI:PrefetchForTile(mapName, tileName)
		if #list == 0 then return end
		_ResourceService:PreloadAsync(list, function(_results) end)
	end

	method void NormalizeActorMarker()
		-- 내가 현재 턴 actor(또는 싱글/멀티 비활성)면 관전 마커(_specActorUserId)를 비운다.
		-- 관전 마커는 '남을 관전 중'일 때만 유효해야 한다. 이전 관전이 SpectatorSceneHide 없이 끝나(예: actor 퇴장)
		-- 마커가 남으면, 내 턴 이벤트가 남의 초상화/지역배경으로 렌더된다(피드백 1·4). 여기서 방어적으로 정규화.
		if _MultiTurnManager == nil or _MultiTurnManager._isActive == false then
			self._specActorUserId = ""
			return
		end
		local lp = _UserService.LocalPlayer
		if isvalid(lp) and lp.PlayerComponent ~= nil and lp.PlayerComponent.UserId == _MultiTurnManager._currentPlayerUserId then
			self._specActorUserId = ""
		end
	end

	method void ParkPortraitLocal()
		-- 초상화 아바타를 로컬 플레이어 계정 아바타로 되돌린다(이벤트 사이 남의 아바타 잔상 방지, 피드백 4).
		-- 무거운 코디 슬롯 복사는 생략 — 다음 이벤트에서 EnsurePortraitIdentity가 전체 정체성을 재고정한다.
		local lp = _UserService.LocalPlayer
		if isvalid(lp) == false or lp.PlayerComponent == nil then return end
		local portrait = _EntityService:GetEntityByPath(self.PortraitPath)
		if isvalid(portrait) == false then return end
		local cm = portrait.CostumeManagerComponent
		if isvalid(cm) == false then return end
		cm.UseCustomEquipOnly = false
		cm.DefaultEquipUserId = tostring(lp.PlayerComponent.UserId)
	end

	@ExecSpace("ClientOnly")
	method void ApplyRegionBackground()
		-- 정체성 주체의 현재 타일 지역으로 BackgroundMap 스프라이트를 교체한다.
		-- 마커(_specActorUserId)가 있으면 관전 모드 → actor의 지역, 없으면 LocalPlayer(=이벤트 도착 본인).
		-- 지역 배경이 미등록(예: 사자왕성)이거나 주체 미발견이면 기존 배경을 그대로 둔다.
		self:NormalizeActorMarker()   -- 내가 actor면 이전 관전 잔재 마커를 비운다(피드백 1)
		local me = _UserService.LocalPlayer
		if self._specActorUserId ~= "" then me = _UserService:GetUserEntityByUserId(self._specActorUserId) end
		if isvalid(me) == false then return end
		local pm = me:GetComponent("script.PlayerMovement")
		if isvalid(pm) == false then return end
		local region = _TileManager:GetTileRegion(me.CurrentMapName, pm.currentTile)
		local ruid = self:RegionBackgroundRUID(region)
		if ruid == "" then return end
		if isvalid(self.BackgroundMap) and isvalid(self.BackgroundMap.SpriteGUIRendererComponent) then
			self.BackgroundMap.SpriteGUIRendererComponent.ImageRUID = DataRef(ruid)
		end
	end

	method table SlotBase(Entity e, string key)
		-- 슬롯의 '원본' anchoredPosition을 (고유 키로) 최초 1회 캐시해 반환한다. 런타임 오프셋 누적 방지용.
		-- (보스 카드 이미지처럼 이름이 겹치는 슬롯도 있어 엔티티 이름 대신 호출자가 주는 고유 키로 캐시한다.)
		if isvalid(e) == false or isvalid(e.UITransformComponent) == false then return { x = 0, y = 0 } end
		if self._slotBase[key] == nil then
			local ap = e.UITransformComponent.anchoredPosition
			self._slotBase[key] = { x = ap.x, y = ap.y }
		end
		return self._slotBase[key]
	end

	@ExecSpace("ClientOnly")
	method void ApplySlotTransform(Entity e, string key, number scale, number offX, number offY)
		-- 슬롯에 표시 크기(UIScale)와 위치 오프셋을 적용한다. 위치는 '원본(SlotBase) + 오프셋' 기준이라 반복 표시에도 누적되지 않는다.
		-- scale/offX/offY 기본값(1/0/0)이면 원본 그대로가 된다.
		if isvalid(e) == false or isvalid(e.UITransformComponent) == false then return end
		local base = self:SlotBase(e, key)
		local ut = e.UITransformComponent
		ut.UIScale = Vector3(scale, scale, 1)
		ut.anchoredPosition = Vector2(base.x + offX, base.y + offY)
	end

	@ExecSpace("ClientOnly")
	method table SlotTransformForRUID(string ruid)
		-- NPC 슬롯(박스 맞춤)용 표시 보정값(scale/offX/offY)을 NpcInfo에서 역조회한다. 없으면 기본(1/0/0).
		-- (보스는 여기서 조회하지 않는다 — 연애 등 일반 이벤트의 보스/NPC는 박스에 맞춰 표시하고, 보스 전투에서만 SetBossFightImage로 크게 띄운다.)
		local res = { scale = 1, offX = 0, offY = 0 }
		if ruid == nil or ruid == "" then return res end
		local npc = _DataService:GetTable("NpcInfo")
		if isvalid(npc) then
			for i = 1, npc:GetRowCount() do
				if npc:GetCell(i, "SpriteRUID") == ruid then
					res.scale = tonumber(npc:GetCell(i, "UIScale")) or 1
					res.offX  = tonumber(npc:GetCell(i, "UIOffsetX")) or 0
					res.offY  = tonumber(npc:GetCell(i, "UIOffsetY")) or 0
					return res
				end
			end
		end
		return res
	end

	method boolean ShouldFlipNpcRUID(string ruid)
		-- 좌우 반전(FlipX)해서 표시할 NPC 스프라이트인지 여부. 현재는 '여신의 조각상'(NpcInfo Statue) 하나만 해당.
		-- 다른 NPC/보스/몬스터는 반전하지 않는다. NPCImage는 공유 엔티티라, 스프라이트를 바꿀 때마다 이 값으로 FlipX를 명시해야 잔상이 남지 않는다.
		return ruid == "6e662c08b4d544058f207e1acc6036fb"
	end

	@ExecSpace("ClientOnly")
	method void SetNPCImage(boolean show, string ruid)
		-- NPC 이미지 표시/숨김 + RUID 적용. 마을·사냥+·불행·연애 이벤트에서 켜고, 그 외에는 끈다.
		-- ruid가 빈 값이면 UI의 기본 이미지를 그대로 유지한다.
		--   · 몬스터(TierMonster STAND) → 원본 크기(NativeSize) + 전역 배율(MonsterNativeScale) × 몬스터별. (사냥+ 엘리트)
		--   · 그 외(인간형 NPC / 연애 상대 보스 등) → 슬롯 박스에 비율 맞춤(AspectOnly) + NpcInfo 보정.
		-- 보스를 원본 크기로 크게 띄우는 건 보스 전투 전용 SetBossFightImage에서만 — 연애 등에서 보스가 나와도 여기선 박스에 맞춘다.
		if isvalid(self.NPCImage) == false then return end
		-- ruid가 비어있으면 표시하지 않는다. (과거엔 show=true인데 ruid=""면 .ui에 구워진 기본 더미
		--  스프라이트가 그대로 남아, 완주 미라클 큐브 롤 등 NPC 없는 이벤트에서 더미 이미지가 노출됐다 - 피드백 1.)
		local reallyShow = show and ruid ~= nil and ruid ~= ""
		self.NPCImage.Enable = reallyShow
		if reallyShow and isvalid(self.NPCImage.SpriteGUIRendererComponent) then
			local r = self.NPCImage.SpriteGUIRendererComponent
			r.ImageRUID = DataRef(ruid)
			r.FlipX = self:ShouldFlipNpcRUID(ruid)   -- 여신의 조각상만 좌우 반전, 그 외엔 항상 반전 해제(공유 엔티티 잔상 방지)
			local mon = _TileManager:MonsterAnimsByStand(ruid)   -- nil이면 몬스터가 아님
			if mon ~= nil then
				r.PreserveSprite = PreserveSpriteType.NativeSize
				local sc = self.MonsterNativeScale * mon.scale
				self:ApplySlotTransform(self.NPCImage, "npc", sc, mon.offX, mon.offY)
			else
				r.PreserveSprite = PreserveSpriteType.AspectOnly   -- 인간형 NPC/연애 상대 등은 슬롯 박스에 맞춤
				local t = self:SlotTransformForRUID(ruid)
				self:ApplySlotTransform(self.NPCImage, "npc", t.scale, t.offX, t.offY)
			end
		end
	end

	@ExecSpace("ClientOnly")
	method void SetBossFightImage(string ruid)
		-- 보스 전투 전용: 상대 보스를 원본 크기(NativeSize) + 전역 배율(BossNativeScale) × 보스별 보정으로 크게 표시한다.
		-- (연애 등 다른 이벤트에서 같은 보스가 나와도 SetNPCImage로 박스에 맞춰 표시된다 — 3배 확대는 보스 전투에서만.)
		if isvalid(self.NPCImage) == false then return end
		self.NPCImage.Enable = true
		if ruid == nil or ruid == "" or isvalid(self.NPCImage.SpriteGUIRendererComponent) == false then return end
		local r = self.NPCImage.SpriteGUIRendererComponent
		r.ImageRUID = DataRef(ruid)
		r.FlipX = self:ShouldFlipNpcRUID(ruid)   -- 보스는 반전 대상이 아니므로 항상 해제(공유 NPCImage 잔상 방지)
		r.PreserveSprite = PreserveSpriteType.NativeSize
		local bt = self:BossTransformForRUID(ruid)   -- stand/die/BossFightStand 모두 인식
		local sc = self.BossNativeScale
		local ox = 0
		local oy = 0
		if bt ~= nil then
			sc = self.BossNativeScale * bt.scale
			ox = bt.offX
			oy = bt.offY
		end
		self:ApplySlotTransform(self.NPCImage, "npc", sc, ox, oy + self.BossOffsetY)
	end

	@ExecSpace("ClientOnly")
	method void BossSceneText(string text, string anim, string bossRUID, Component tile)
		-- 보스 텍스트 씬(검은 마법사 최종전 등): 상대를 NPC(박스 맞춤)가 아니라 보스 이미지로 원본 크기 × 전역 배율(SetBossFightImage)로 크게 표시.
		-- 텍스트 진행은 SceneText와 동일(마지막 장 '다음' → tile:RequestAdvance).
		self._activeTile = tile
		self:ShowGroup()
		self:SetBossFightImage(bossRUID)
		self:SetPortrait(anim)
		self:ShowPagedText(text, self.OnTextAdvance)
	end

	@ExecSpace("ClientOnly")
	method table BossTransformForRUID(string ruid)
		-- BossImage에서 stand(IngameStandRUID) 또는 die(DieAnimRUID) 일치 행의 표시 보정값(scale/offX/offY)을 반환한다. 보스가 아니면 nil.
		-- (NPC 슬롯에서 보스만 원본 크기로 렌더할지 판별 + stand→die 애니 전환에도 크기 유지되도록 두 RUID를 모두 인식한다.)
		if ruid == nil or ruid == "" then return nil end
		local boss = _DataService:GetTable("BossImage")
		if isvalid(boss) == false then return nil end
		for i = 1, boss:GetRowCount() do
			if boss:GetCell(i, "IngameStandRUID") == ruid or boss:GetCell(i, "DieAnimRUID") == ruid or boss:GetCell(i, "BossFightStandRUID") == ruid then
				return {
					scale = tonumber(boss:GetCell(i, "UIScale")) or 1,
					offX  = tonumber(boss:GetCell(i, "UIOffsetX")) or 0,
					offY  = tonumber(boss:GetCell(i, "UIOffsetY")) or 0,
				}
			end
		end
		return nil
	end

	@ExecSpace("ClientOnly")
	method table MonsterScaleForRUID(string ruid)
		-- 사냥 몬스터 이미지 RUID로 개별 표시 보정값(scale/offX/offY)을 역조회한다.
		-- TierMonster(STAND) → HuntEvent(MonsterRUID) 순. 없으면 기본(1/0/0).
		-- (사냥 몬스터 이미지는 HuntEvent.MonsterRUID로 넘어오는 경우가 있어 TierMonster에 없을 수 있다 — 예: 에스페라 아라냐.)
		local res = { scale = 1, offX = 0, offY = 0 }
		if ruid == nil or ruid == "" then return res end
		local tm = _DataService:GetTable("TierMonster")
		if isvalid(tm) then
			for i = 1, tm:GetRowCount() do
				if tm:GetCell(i, "STAND") == ruid then
					res.scale = tonumber(tm:GetCell(i, "UIScale")) or 1
					res.offX  = tonumber(tm:GetCell(i, "UIOffsetX")) or 0
					res.offY  = tonumber(tm:GetCell(i, "UIOffsetY")) or 0
					return res
				end
			end
		end
		local he = _DataService:GetTable("HuntEvent")
		if isvalid(he) then
			for i = 1, he:GetRowCount() do
				if he:GetCell(i, "MonsterRUID") == ruid then
					res.scale = tonumber(he:GetCell(i, "UIScale")) or 1
					res.offX  = tonumber(he:GetCell(i, "UIOffsetX")) or 0
					res.offY  = tonumber(he:GetCell(i, "UIOffsetY")) or 0
					return res
				end
			end
		end
		return res
	end

	@ExecSpace("ClientOnly")
	method void SizeMonsterSlots(number scale, number offX, number offY)
		-- 3개 몬스터 이미지의 표시 크기(전역 × 개별)와 기준 위치(원본 + 오프셋)를 설정한다.
		-- 슬롯은 PreserveSprite=NativeSize라 원본 크기로 렌더되고, 여기에 UIScale만 곱한다.
		-- _monBaseXs(흔들림 기준 x)에 오프셋을 미리 더해두어 MonBob이 그 위에서 흔든다. (anim 유무와 무관하게 항상 호출)
		local imgs = self:MonImgs()
		self._monBaseXs = {}
		local sc = self.MonsterNativeScale * scale
		for i = 1, #imgs do
			local e = imgs[i]
			if isvalid(e) and isvalid(e.UITransformComponent) then
				local base = self:SlotBase(e, "mon" .. i)
				self._monBaseXs[i] = base.x + offX
				e.UITransformComponent.anchoredPosition = Vector2(self._monBaseXs[i], base.y + offY)
				e.UITransformComponent.UIScale = Vector3(sc, sc, 1)
			end
		end
		self._monBaseSet = true
	end

	@ExecSpace("ClientOnly")
	method void SetMonsterImages(string ruid)
		-- 사냥 몬스터 RUID를 Monsters 하위 3개 이미지에 동일하게 적용. 빈 값이면 Monsters 숨김.
		-- 크기는 anim 데이터 유무와 무관하게 항상 원본 크기 × 전역 × 개별로 맞춘다(HuntEvent 전용 몬스터도 포함).
		-- 애니 데이터(TierMonster)가 있으면 MOVE 재생 + 좌우 흔들림 + 자동 처치 연출을 시작한다.
		if ruid == nil or ruid == "" then
			self:StopMonsterAnim()
			if isvalid(self.MonstersGroup) then self.MonstersGroup.Enable = false end
			return
		end
		if isvalid(self.MonstersGroup) then self.MonstersGroup.Enable = true end
		self:SetMonstersClip(ruid)     -- 우선 STAND(넘어온 RUID) 적용 — 연출 데이터 없으면 정적 그대로.
		local sd = self:MonsterScaleForRUID(ruid)          -- 개별 배율/오프셋(TierMonster/HuntEvent)
		self:SizeMonsterSlots(sd.scale, sd.offX, sd.offY)  -- 원본 크기 × 전역 × 개별 + 위치(anim 유무 무관 항상)
		self:StartMonsterAnim(ruid)    -- 연출 데이터 있으면 MOVE + 흔들림 + 처치 연출.
	end

	method table MonImgs()
		-- 몬스터 이미지 3개를 배열로.
		return { self.MonsterImage1, self.MonsterImage2, self.MonsterImage3 }
	end

	@ExecSpace("ClientOnly")
	method void SetMonstersClip(string ruid)
		-- Monsters 하위 3개 이미지에 동일 클립(sprite/animationclip RUID) 적용 + (이전 처치로 꺼졌으면) 재활성.
		local imgs = self:MonImgs()
		for i = 1, #imgs do
			local e = imgs[i]
			if isvalid(e) then
				e.Enable = true
				if isvalid(e.SpriteGUIRendererComponent) then
					e.SpriteGUIRendererComponent.ImageRUID = DataRef(ruid)
				end
			end
		end
	end

	method void ClearMonTimers()
		-- 처치 시퀀스 타이머 전부 정리.
		for i = 1, #self._monTimers do
			if self._monTimers[i] ~= 0 then _TimerService:ClearTimer(self._monTimers[i]) end
		end
		self._monTimers = {}
	end

	@ExecSpace("ClientOnly")
	method void StopMonsterAnim()
		-- 몬스터 연출 타이머 정리 + 이미지별 흔들림 위치 원복.
		if self._monBobTimer ~= 0 then _TimerService:ClearTimer(self._monBobTimer) self._monBobTimer = 0 end
		self:ClearMonTimers()
		self._monBusy = false
		self._monDone = {}
		if self._monBaseSet then
			local imgs = self:MonImgs()
			for i = 1, #imgs do
				local e = imgs[i]
				if isvalid(e) and isvalid(e.UITransformComponent) and self._monBaseXs[i] ~= nil then
					local ut = e.UITransformComponent
					ut.anchoredPosition = Vector2(self._monBaseXs[i], ut.anchoredPosition.y)
				end
			end
		end
	end

	@ExecSpace("ClientOnly")
	method void StartMonsterAnim(string standRUID)
		-- 사냥 몬스터 연출 시작: MOVE 재생 + (이미지별 방향/위상/진폭) 좌우 흔들림 + (이미지별 엇갈린) 자동 처치.
		if self._monBobTimer ~= 0 then _TimerService:ClearTimer(self._monBobTimer) self._monBobTimer = 0 end
		self:ClearMonTimers()
		self._monBusy = false
		self._monDone = {}
		self._monAnims = {}
		
		local anims = _TileManager:MonsterAnimsByStand(standRUID)
		if anims == nil then return end   -- 연출 데이터 없으면 정적 STAND 유지.
		self._monAnims = anims
		
		-- 크기/기준 위치(_monBaseXs)는 SetMonsterImages → SizeMonsterSlots에서 이미 설정됨(anim 유무 무관).
		local imgs = self:MonImgs()
		
		-- MOVE(없으면 STAND) 재생.
		local moveClip = anims.move
		if moveClip == nil or moveClip == "" then moveClip = anims.stand end
		if moveClip ~= nil and moveClip ~= "" then self:SetMonstersClip(moveClip) end
		
		-- 좌우 흔들림 시작(한 타이머로 3개를 각기 다른 위상/방향/진폭으로 갱신).
		self._monBobPhase = 0
		self._monBobTimer = _TimerService:SetTimerRepeat(function() self:MonBob() end, 0.05)
		
		-- 문구 표시 후 자동 처치: 처치 순서를 랜덤으로 섞고, 세 마리를 최대 ~5초에 걸쳐
		-- 랜덤 간격으로 '한 마리씩' 순차 처치한다.
		local order = {}
		for i = 1, #imgs do order[i] = i end
		for i = #order, 2, -1 do
			local j = _UtilLogic:RandomIntegerRange(1, i)
			local tmp = order[i]
			order[i] = order[j]
			order[j] = tmp
		end
		local at = 0.8 + _UtilLogic:RandomDouble() * 0.7   -- 첫 마리: 0.8~1.5초
		for k = 1, #order do
			if k > 1 then
				at = at + 1.1 + _UtilLogic:RandomDouble() * 0.9   -- 마리 사이 간격: 1.1~2.0초
			end
			if at > 5.0 then at = 5.0 end   -- 처치 시작은 최대 5초.
			local idx = order[k]
			local h = _TimerService:SetTimerOnce(function() self:MonDefeatOne(idx) end, at)
			table.insert(self._monTimers, h)
		end
	end

	@ExecSpace("ClientOnly")
	method void MonBob()
		-- 3개 이미지를 각기 다른 위상/방향/진폭으로 좌우로 흔든다. 이미 처치 시작된 이미지는 건너뛴다.
		self._monBobPhase = self._monBobPhase + 0.18
		local imgs = self:MonImgs()
		for i = 1, #imgs do
			local e = imgs[i]
			if self._monDone[i] ~= true and isvalid(e) and isvalid(e.UITransformComponent) and self._monBaseXs[i] ~= nil then
				local phase = self._monBobPhase + i * 2.1      -- 위상 차
				local amp = 16 + i * 7                          -- 진폭 차(23/30/37)
				local dir = 1
				if i % 2 == 0 then dir = -1 end                 -- 짝수 이미지는 반대 방향
				local ut = e.UITransformComponent
				local x = self._monBaseXs[i] + dir * amp * math.sin(phase)
				ut.anchoredPosition = Vector2(x, ut.anchoredPosition.y)
			end
		end
	end

	@ExecSpace("ClientOnly")
	method void MonDefeatOne(integer index)
		-- 개별 몬스터 처치: 첫 처치 순간에만 초상화 attack. 이 이미지는 흔들림 제외 후 HIT → DIE → 사라짐.
		if self._monBusy == false then
			self._monBusy = true
			self:SetPortrait("attack")   -- 첫 사망 순간 플레이어 공격 포즈.
		end
		self._monDone[index] = true
		local e = self:MonImgs()[index]
		if isvalid(e) == false then return end
		-- 흔들림 제외 → 기준 위치로 정렬.
		if isvalid(e.UITransformComponent) and self._monBaseXs[index] ~= nil then
			local ut = e.UITransformComponent
			ut.anchoredPosition = Vector2(self._monBaseXs[index], ut.anchoredPosition.y)
		end
		-- HIT.
		local hit = self._monAnims.hit
		if hit ~= nil and hit ~= "" and isvalid(e.SpriteGUIRendererComponent) then
			e.SpriteGUIRendererComponent.ImageRUID = DataRef(hit)
		end
		-- 0.5초 뒤 DIE, 다시 0.85초 뒤 이 이미지만 사라짐.
		local t1 = _TimerService:SetTimerOnce(function()
			local die = self._monAnims.die
			if isvalid(e) and die ~= nil and die ~= "" and isvalid(e.SpriteGUIRendererComponent) then
				e.SpriteGUIRendererComponent.ImageRUID = DataRef(die)
			end
			local t2 = _TimerService:SetTimerOnce(function()
				if isvalid(e) then e.Enable = false end
			end, 0.85)
			table.insert(self._monTimers, t2)
		end, 0.5)
		table.insert(self._monTimers, t1)
	end

	@ExecSpace("ClientOnly")
	method void SetPortrait(string anim)
		-- 초상화 애니(idle→Stand / attack→Attack) 적용 + 로딩 타이밍 대비 1초마다 재적용.
		-- ★ 이벤트 시작 시 강제 초기화: 이전 이벤트에서 남은 울음/누움(prone)·점프·표정이 이어지지 않도록,
		--   진행 중인 모션/표정을 정리하고 포즈를 needReset=true로 강제 전환한다(누움 → 최소 idle, 또는 attack).
		self._portraitState = anim
		-- 모션보다 먼저 외형을 로컬 플레이어와 동일하게 고정한다(기본 아바타=토벤머리 폴백 방지).
		self:EnsurePortraitIdentity()
		self:StopPortraitMotion()      -- 이전 점프/울음 연출 타이머 정리 + 위치 복구
		self:PortraitResetEmotion()    -- 이전 표정(울음/웃음) 중립 복귀
		self:PortraitPose(anim, true)  -- 누움 등 held 포즈에서도 확실히 idle/attack로 강제 재생(needReset)
		self:ClearPortrait()
		self._portraitTimer = _TimerService:SetTimerRepeat(function() self:ApplyPortrait() end, 1.0)
	end

	method table PortraitSlotDefs()
		-- 라이브 플레이어 코스튬 → 초상화로 복사할 슬롯(속성명 p, SetEquip 카테고리 c). 무기 등 런타임 CustomEquip 반영용.
		return {
			{ p = "CustomBodyEquip",            c = MapleAvatarItemCategory.Body },
			{ p = "CustomHairEquip",            c = MapleAvatarItemCategory.Hair },
			{ p = "CustomFaceEquip",            c = MapleAvatarItemCategory.Face },
			{ p = "CustomCapEquip",             c = MapleAvatarItemCategory.Cap },
			{ p = "CustomCapeEquip",            c = MapleAvatarItemCategory.Cape },
			{ p = "CustomCoatEquip",            c = MapleAvatarItemCategory.Coat },
			{ p = "CustomLongcoatEquip",        c = MapleAvatarItemCategory.Longcoat },
			{ p = "CustomPantsEquip",           c = MapleAvatarItemCategory.Pants },
			{ p = "CustomGloveEquip",           c = MapleAvatarItemCategory.Glove },
			{ p = "CustomShoesEquip",           c = MapleAvatarItemCategory.Shoes },
			{ p = "CustomOneHandedWeaponEquip", c = MapleAvatarItemCategory.OneHandedWeapon },
			{ p = "CustomTwoHandedWeaponEquip", c = MapleAvatarItemCategory.TwoHandedWeapon },
			{ p = "CustomSubWeaponEquip",       c = MapleAvatarItemCategory.SubWeapon },
			{ p = "CustomFaceAccessoryEquip",   c = MapleAvatarItemCategory.FaceAccessory },
			{ p = "CustomEyeAccessoryEquip",    c = MapleAvatarItemCategory.EyeAccessory },
			{ p = "CustomEarAccessoryEquip",    c = MapleAvatarItemCategory.EarAccessory },
			{ p = "CustomEarEquip",             c = MapleAvatarItemCategory.Ear },
		}
	end

	@ExecSpace("ClientOnly")
	method void EnsurePortraitIdentity()
		-- 초상화 아바타를 '정체성 주체'와 동일 외형으로 맞춘다.
		-- 마커(_specActorUserId)가 있으면 관전 모드 → actor 정체성, 없으면 LocalPlayer(=이벤트 도착 본인).
		-- 빈 DefaultEquipUserId면 계정 아바타 로드 전 순간에 MSW 기본 아바타(토벤머리)로 폴백 → 이벤트마다 정체성을 다시 고정한다.
		self:NormalizeActorMarker()   -- 내가 actor면 이전 관전 잔재 마커를 비워 내 정체성으로 렌더(피드백 1·4)
		local portrait = _EntityService:GetEntityByPath(self.PortraitPath)
		if isvalid(portrait) == false then return end
		local cm = portrait.CostumeManagerComponent
		if isvalid(cm) == false then return end
		local identityUserId = ""
		local source = nil
		if self._specActorUserId ~= "" then
			identityUserId = self._specActorUserId
			source = _UserService:GetUserEntityByUserId(self._specActorUserId)
		else
			source = _UserService.LocalPlayer
			if isvalid(source) == false or source.PlayerComponent == nil then
				log_warning("[EventTileUI] EnsurePortraitIdentity: LocalPlayer 미확보 — 초상화 외형 고정 실패")
				return
			end
			identityUserId = tostring(source.PlayerComponent.UserId)
		end
		-- 계정 기본 체형/헤어/얼굴을 DefaultEquipUserId로 깐다(엔티티 미발견이어도 기본 아바타 확보).
		cm.UseCustomEquipOnly = false
		cm.DefaultEquipUserId = identityUserId
		-- 그 위에 정체성 주체의 런타임 코디(직업 무기 등)를 슬롯별로 덮어써 공격 모션이 실제 무기 스윙으로 나오게 한다.
		if isvalid(source) then
			local pcm = source.CostumeManagerComponent
			if isvalid(pcm) then
				for _, d in ipairs(self:PortraitSlotDefs()) do
					local v = pcm[d.p]
					if v ~= nil and v ~= "" then cm:SetEquip(d.c, v) end
				end
			end
		end
		log("[EventTileUI] 초상화 외형 고정 완료 user=" .. identityUserId .. " spec=" .. self._specActorUserId)
	end

	@ExecSpace("ClientOnly")
	method void PortraitPose(string state, boolean needReset)
		-- 초상화 몸 포즈를 state에 맞춰 전송한다. needReset=true면 진행 중인 애니(attack 등)를 멈추고 처음부터 재생한다.
		self._portraitState = state
		local portrait = _EntityService:GetEntityByPath(self.PortraitPath)
		if isvalid(portrait) == false then return end
		local st = MapleAvatarBodyActionState.Stand
		if state == "attack" then st = MapleAvatarBodyActionState.Attack
		elseif state == "cry" then st = MapleAvatarBodyActionState.Crouch   -- crouch → prone(엎드림) 스프라이트
		elseif state == "jump" then st = MapleAvatarBodyActionState.Fall     -- fall → jump(공중) 스프라이트
		end
		local ev = BodyActionStateChangeEvent()
		ev.ActionState = st
		ev.needResetAction = needReset
		portrait:SendEvent(ev)
	end

	@ExecSpace("ClientOnly")
	method void ApplyPortrait()
		-- 현재 _portraitState 를 초상화에 재적용한다(재시작 없이 — 로딩 타이밍 대비 반복 적용용).
		self:PortraitPose(self._portraitState, false)
	end

	@ExecSpace("ClientOnly")
	method void ClearPortrait()
		-- 초상화 재적용 타이머 해제.
		if self._portraitTimer ~= 0 then
			_TimerService:ClearTimer(self._portraitTimer)
			self._portraitTimer = 0
		end
	end

	@ExecSpace("ClientOnly")
	method void PortraitEmote(string outcome)
		-- 결과 등급(성공/대성공/실패)에 따라 초상화(PlayerPortrait)에 표정 + 동작을 연출한다.
		--   좋은 결과 → 표정(대성공=Cheers/성공=Smile) + 제자리 폴짝 점프 1회
		--   나쁜 결과(실패 등) → 표정 Cry + 엎드림 포즈 유지(이벤트 끝까지 — 종료 시 Hide에서 정리)
		if outcome == "대성공" or outcome == "great" then
			self:PortraitPlayEmotion("Cheers")
			self:PortraitHop()
		elseif outcome == "성공" or outcome == "success" then
			self:PortraitPlayEmotion("Smile")
			self:PortraitHop()
		else
			self:PortraitPlayEmotion("Cry")
			self:PortraitCry()
		end
		log("[EventTileUI] 초상화 결과 연출 outcome=" .. tostring(outcome))
	end

	@ExecSpace("ClientOnly")
	method void PortraitEmoteKind(string kind)
		-- 결과 등급 대신 명시적 표정("happy"/"cry")으로 초상화 연출한다. (불행칸/길드영입/검은마법사 등 outcome 없이 직접 지정)
		if kind == "happy" then
			self:PortraitPlayEmotion("Cheers")
			self:PortraitHop()
		elseif kind == "cry" then
			self:PortraitPlayEmotion("Cry")
			self:PortraitCry()
		end
		log("[EventTileUI] 초상화 결과 연출(명시) kind=" .. tostring(kind))
	end

	@ExecSpace("ClientOnly")
	method void PortraitPlayEmotion(string emotionName)
		-- 초상화 UI 아바타 얼굴 표정 재생(AvatarGUIRendererComponent.PlayEmotion). 이벤트 끝까지 유지되도록 길게 재생.
		local portrait = _EntityService:GetEntityByPath(self.PortraitPath)
		if isvalid(portrait) == false then return end
		local r = portrait.AvatarGUIRendererComponent
		if isvalid(r) == false then return end
		r:PlayEmotion(EmotionalType.CastFrom(emotionName), self.EmoteHoldSeconds)
	end

	@ExecSpace("ClientOnly")
	method void PortraitResetEmotion()
		-- 초상화 표정을 기본(중립)으로 되돌린다(이벤트 종료 시 다음 이벤트로 표정이 남지 않도록).
		local portrait = _EntityService:GetEntityByPath(self.PortraitPath)
		if isvalid(portrait) == false then return end
		local r = portrait.AvatarGUIRendererComponent
		if isvalid(r) == false then return end
		r:PlayEmotion(EmotionalType.Default, 0.1)
	end

	@ExecSpace("ClientOnly")
	method void PortraitHop()
		-- 초상화를 제자리에서 위로 폴짝 뛰어오르게 한다(공중 jump 포즈 + anchoredPosition 포물선 → 착지 idle).
		local portrait = _EntityService:GetEntityByPath(self.PortraitPath)
		if isvalid(portrait) == false or isvalid(portrait.UITransformComponent) == false then return end
		self:StopPortraitMotion()
		self._portraitHopBase = portrait.UITransformComponent.anchoredPosition
		self._portraitHopT = 0
		self:PortraitPose("jump", true)   -- 기존 애니(attack 등)를 멈추고 점프(공중) 포즈로 강제 전환
		self._portraitHopTimer = _TimerService:SetTimerRepeat(function() self:PortraitHopStep() end, 0.02)
	end

	@ExecSpace("ClientOnly")
	method void PortraitHopStep()
		-- 점프 프레임 갱신: sin 곡선으로 0→정점→0. 끝나면 원위치 복귀 + idle 포즈.
		local portrait = _EntityService:GetEntityByPath(self.PortraitPath)
		if isvalid(portrait) == false or isvalid(portrait.UITransformComponent) == false then
			self:StopPortraitMotion() return
		end
		self._portraitHopT = self._portraitHopT + 0.02
		local prog = self._portraitHopT / self.PortraitHopDuration
		local b = self._portraitHopBase
		if prog >= 1 then
			portrait.UITransformComponent.anchoredPosition = b
			if self._portraitHopTimer ~= 0 then _TimerService:ClearTimer(self._portraitHopTimer) self._portraitHopTimer = 0 end
			self:PortraitPose("idle", true)   -- 점프 멈추고 idle(Stand)로 복귀
			return
		end
		local y = self.PortraitHopHeight * math.sin(math.pi * prog)
		portrait.UITransformComponent.anchoredPosition = Vector2(b.x, b.y + y)
	end

	@ExecSpace("ClientOnly")
	method void PortraitCry()
		-- 기존 애니를 멈추고 엎드린(prone) 포즈로 전환 → 이벤트가 끝날 때까지 유지한다.
		-- 초상화 재적용 타이머(_portraitTimer)가 _portraitState="cry"를 계속 반영해 포즈가 유지되고,
		-- 이벤트 종료(Hide)에서 정리된다(별도 복귀 타이머 없음 = 표정/포즈 끝까지 유지).
		self:StopPortraitMotion()
		self:PortraitPose("cry", true)
	end

	@ExecSpace("ClientOnly")
	method void StopPortraitMotion()
		-- 점프/울음 연출 타이머 정리 + 점프 중이면 초상화 위치를 원위치로 복구.
		if self._portraitHopTimer ~= 0 then
			_TimerService:ClearTimer(self._portraitHopTimer)
			self._portraitHopTimer = 0
			local portrait = _EntityService:GetEntityByPath(self.PortraitPath)
			if isvalid(portrait) and isvalid(portrait.UITransformComponent) then
				portrait.UITransformComponent.anchoredPosition = self._portraitHopBase
			end
		end
	end

	@ExecSpace("ClientOnly")
	method void ClearNext()
		-- 진행(NextButton) 핸들러 해제 + 숨김.
		if isvalid(self.NextButton) and self._nextHandler ~= nil then
			self.NextButton:DisconnectEvent(ButtonClickEvent, self._nextHandler)
		end
		self._nextHandler = nil
		if isvalid(self.NextButton) then self.NextButton.Enable = false end
	end

	@ExecSpace("ClientOnly")
	method void HideAllButtons()
		-- NextButton + 수락/거절 + Select_1~4 핸들러 해제 + 전부 숨김.
		self:ClearNext()
		for i = 1, #self._choiceHandlers do
			local rec = self._choiceHandlers[i]
			if isvalid(rec.entity) then rec.entity:DisconnectEvent(ButtonClickEvent, rec.hd) end
		end
		self._choiceHandlers = {}
		local btns = { self.AcceptButton, self.DeclineButton, self.Select1, self.Select2, self.Select3, self.Select4 }
		for i = 1, #btns do
			if isvalid(btns[i]) then btns[i].Enable = false end
		end
		if isvalid(self.BinaryChoiceGroup) then self.BinaryChoiceGroup.Enable = false end
		if isvalid(self.MultipleChoiceGroup) then self.MultipleChoiceGroup.Enable = false end
	end

	@ExecSpace("ClientOnly")
	method void ShowNext(any onClick)
		-- 진행(NextButton)만 표시하고 클릭 시 onClick(self) 실행.
		-- 단, 아직 타이핑이 끝나지 않았다면 첫 클릭은 '현재 문장 즉시 완성(스킵)'으로 동작하고 넘어가지 않는다.
		self:HideAllButtons()
		if isvalid(self.NextButton) then
			self.NextButton.Enable = true
			self._nextHandler = self.NextButton:ConnectEvent(ButtonClickEvent, function()
				if self._typing then
					self:FinishTyping()
					return
				end
				onClick(self)
			end)
		end
	end

	@ExecSpace("ClientOnly")
	method void WireChoiceButton(Entity btn, string label, integer index)
		-- 버튼 1개에 라벨/클릭(→ index 선택 전달) 연결 후 활성화.
		if isvalid(btn) == false then return end
		btn.Enable = true
		if isvalid(btn.TextComponent) then btn.TextComponent.Text = label end
		local idx = index
		local hd = btn:ConnectEvent(ButtonClickEvent, function() self:OnChoicePick(idx) end)
		table.insert(self._choiceHandlers, { entity = btn, hd = hd })
	end

	@ExecSpace("ClientOnly")
	method string TrimText(string s)
		-- 앞뒤 개행/공백 제거(페이지 내부의 단일 줄바꿈은 유지).
		local a, _n1 = string.gsub(s, "^%s+", "")
		local b, _n2 = string.gsub(a, "%s+$", "")
		return b
	end

	@ExecSpace("ClientOnly")
	method table SplitPages(string s)
		-- '\n\n'(빈 줄) 기준으로 페이지를 나눈다. 빈 페이지 제외, 경계 없으면 통째로 1페이지.
		local pages = {}
		local start = 1
		while true do
			local i, _e = string.find(s, "\n\n", start, true)
			if i == nil then
				local seg = self:TrimText(string.sub(s, start))
				if seg ~= "" then table.insert(pages, seg) end
				break
			end
			local seg = self:TrimText(string.sub(s, start, i - 1))
			if seg ~= "" then table.insert(pages, seg) end
			start = i + 2
		end
		if #pages == 0 then table.insert(pages, self:TrimText(s)) end
		return pages
	end

	@ExecSpace("ClientOnly")
	method void ShowPagedText(string fullText, any onComplete)
		-- 텍스트를 페이지로 나눠 첫 장 표시 + '다음'. 마지막 장에서 '다음' → onComplete(self).
		self._pages = self:SplitPages(fullText)
		self._pageIdx = 1
		self._pageDone = onComplete
		self:SetText(self._pages[1] or "")
		self:ShowNext(self.OnPageNext)
	end

	@ExecSpace("ClientOnly")
	method void OnPageNext()
		-- '다음' 클릭: 다음 페이지가 있으면 그 장을 출력, 없으면 완료 콜백 실행.
		if self._pageIdx < #self._pages then
			self._pageIdx = self._pageIdx + 1
			self:SetText(self._pages[self._pageIdx])
			-- 분할 이미지 모드: 지정 페이지(_imgNpcFromPage)에 도달하면 몬스터 이미지를 끄고 NPC 이미지로 전환(1회).
			if self._imgNpcFromPage > 0 and self._pageIdx >= self._imgNpcFromPage then
				self:SetMonsterImages("")
				self:SetNPCImage(true, self._imgNpcRUID)
				self._imgNpcFromPage = 0
			end
			-- 페이지별 NPC 교체(불행 씬 등): 이 페이지 지정 NPC RUID가 있으면 적용(부족하면 마지막 값 유지).
			if #self._pageNpcRUIDs > 0 then
				local r = self._pageNpcRUIDs[self._pageIdx]
				if r == nil then r = self._pageNpcRUIDs[#self._pageNpcRUIDs] end
				if r ~= nil and r ~= "" then self:SetNPCImage(true, r) end
			end
			-- 마지막 페이지에 도달하면 예약된 연출(불행칸 울음 등)을 1회 재생한다.
			if self._pageIdx >= #self._pages then
				self:FirePageEndEmote()
			end
		else
			local cb = self._pageDone
			if cb ~= nil then cb(self) end
		end
	end

	@ExecSpace("ClientOnly")
	method void ArmPageEndEmote(string kind)
		-- 진행 중인 페이지 텍스트의 '마지막 페이지'에 도달하는 순간 kind("cry"/"happy") 연출을 1회 재생하도록 예약한다.
		-- (불행칸: 이벤트 시작이 아니라 스탯 감소 문구가 나오는 마지막 페이지에서 울도록.)
		-- 이미 마지막 페이지(단일 페이지 등)를 보고 있으면 즉시 재생한다.
		self._pageEndEmote = kind
		self._pageEndEmoteFired = false
		if #self._pages > 0 and self._pageIdx >= #self._pages then
			self:FirePageEndEmote()
		end
	end

	@ExecSpace("ClientOnly")
	method void FirePageEndEmote()
		-- 예약된 마지막-페이지 연출을 1회만 재생한다(이후 페이지 재진입/재적용에도 중복 재생 방지).
		if self._pageEndEmote == "" or self._pageEndEmoteFired then return end
		self._pageEndEmoteFired = true
		self:PortraitEmoteKind(self._pageEndEmote)
	end

	@ExecSpace("ClientOnly")
	method void Hide()
		-- 이벤트 UI 닫기: 타이핑/버튼/몬스터연출/타이머 정리 후 그룹 숨김.
		self:StopTyping()
		self:StopMonsterAnim()
		self:HideAllButtons()
		self:StopPortraitMotion()
		self:PortraitResetEmotion()   -- 이벤트 종료 → 표정 중립 복귀(다음 이벤트로 표정 잔류 방지)
		-- ★ 몸 포즈를 Stand로 되돌린다(울음=Crouch/prone 등 held 포즈가 다음 이벤트로 이어지지 않도록).
		--   그룹을 끄기 '전에'(아바타가 아직 켜져 있는 동안) 보내야 포즈 이벤트가 확실히 전달된다.
		self:PortraitResetPose()
		self:ClearPortrait()
		-- 이벤트 종료 후 초상화 정체성을 로컬 플레이어로 park한다(다음 열림 시 이전 actor 아바타 1프레임 잔상 방지, 피드백 4).
		self._specActorUserId = ""
		self:ParkPortraitLocal()
		self:HideLevelUpFx()          -- 레벨업 이펙트 정리
		self:ClearEventImages()       -- ★ 공유 NPC/몬스터 이미지의 RUID를 완전히 비워 다음 이벤트의 '뒤늦게 교체'(잔상) 방지
		if self._luHidHud then        -- 레벨업 배너가 숨긴 HUD만 복원(다른 이벤트 Hide는 HUD를 건드리지 않음)
			if isvalid(self.InGameGroup) then self.InGameGroup.Enable = true end
			self._luHidHud = false
		end
		if isvalid(self.EventGroup) then self.EventGroup.Enable = false end
	end

	@ExecSpace("ClientOnly")
	method void ClearEventImages()
		-- 이벤트 종료(패널 닫힘) 시 공유 이미지(NPCImage/몬스터 3개)의 RUID를 빈 값으로 완전히 비운다.
		-- NPCImage·MonsterImage는 매 이벤트가 재사용하는 '공유 엔티티'라, RUID를 남겨두면 다음 이벤트가
		-- 새 RUID를 렌더러에 반영하기 전 '이전 이벤트 스프라이트'가 한 프레임 노출되어 '뒤늦게 교체'되는 잔상이 생긴다.
		-- 여기서 비워 두면 다음 표시 때 잔상 없이 (프리로드된) 새 스프라이트만 나타난다.
		if isvalid(self.NPCImage) then
			self.NPCImage.Enable = false
			if isvalid(self.NPCImage.SpriteGUIRendererComponent) then
				self.NPCImage.SpriteGUIRendererComponent.ImageRUID = DataRef("")
				self.NPCImage.SpriteGUIRendererComponent.FlipX = false   -- 공유 엔티티 반전 잔류 방지(여신 조각상 등)
			end
		end
		local imgs = self:MonImgs()
		for i = 1, #imgs do
			local e = imgs[i]
			if isvalid(e) then
				e.Enable = false
				if isvalid(e.SpriteGUIRendererComponent) then
					e.SpriteGUIRendererComponent.ImageRUID = DataRef("")
				end
			end
		end
		if isvalid(self.MonstersGroup) then self.MonstersGroup.Enable = false end
		log("[EventTileUI] ClearEventImages: NPC/몬스터 이미지 RUID 비움")
	end

	@ExecSpace("ClientOnly")
	method void PortraitResetPose()
		-- 초상화 몸 포즈를 기본 Stand(idle)로 강제 복귀시킨다(needReset=true).
		-- Hide에서 그룹 비활성화 직전에 호출 → 다음에 UI가 다시 열릴 때 이전 이벤트의 누움/포즈가 남지 않는다.
		self._portraitState = "idle"
		self:PortraitPose("idle", true)
	end

	@ExecSpace("ClientOnly")
	method void ShowEventText(string message, string anim, string monsterRUID, string imageKind, string npcKey, integer npcFromPage, string page2Ruid, Component tile)
		-- EventTileBase(사냥/세금/사냥+/불행 등): 텍스트(페이지 단위) + 초상화(타일 지정 anim) + 이미지.
		-- imageKind = "npc"(사냥+·불행 → NPC 이미지) / 그 외(사냥 → 몬스터 이미지). anim은 칸의 기본값.
		-- npcKey = 등장 NPC 이름 키(NpcInfo 조회용, 없으면 ""). 마지막 장 '다음' → 종료.
		-- npcFromPage > 0 이면 '분할 이미지' 모드: 페이지1은 몬스터 이미지(monsterRUID), 그 페이지부터 사냥+ 이미지로 전환.
		--   (사냥+ 타일: 페이지1=기본 사냥 몬스터, 페이지2+=사냥+ 이미지)
		-- page2Ruid = 페이지2 이미지의 이미 해석된 RUID(엘리트 몬스터/NPC). 있으면 npcKey 조회보다 우선.
		self._activeTile = tile
		self:ShowGroup()
		if npcFromPage > 0 then
			self._imgNpcFromPage = npcFromPage
			if page2Ruid ~= nil and page2Ruid ~= "" then
				self._imgNpcRUID = page2Ruid   -- 이미 해석된 RUID(엘리트 몬스터/NPC) 우선
			else
				self._imgNpcRUID = _NpcInfoManager:GetNpcRUID(npcKey)
			end
			self:SetMonsterImages(monsterRUID)   -- 시작(페이지1)은 몬스터 이미지
		elseif imageKind == "npc" then
			self:SetNPCImage(true, _NpcInfoManager:GetNpcRUID(npcKey))
		else
			self:SetMonsterImages(monsterRUID)
		end
		self:SetPortrait(anim)
		self:ShowPagedText(message, self.OnEventDone)
	end

	@ExecSpace("ClientOnly")
	method void OnEventDone()
		-- 사냥 등 단순 이벤트 '다음' → UI 닫고 서버에 종료 신호.
		self:Hide()
		if isvalid(self._activeTile) then self._activeTile:RequestDone() end
	end

	@ExecSpace("ClientOnly")
	method void ShowPagedNpcEvent(string message, string anim, string npcRuidsCsv, Component tile)
		-- 불행 등 '씬(페이지)별 NPC 교체' 이벤트 표시. npcRuidsCsv = ';'로 구분한 페이지별 NPC RUID 목록(서버에서 해석 완료).
		--   페이지1은 목록[1], 이후 '다음'마다 목록[i]로 교체(목록보다 페이지가 많으면 마지막 값 유지, 목록이 비면 NPC 숨김).
		-- 문구는 '\n\n'(빈 줄) 기준 페이지 분할(ShowPagedText 재사용). 마지막 장 '다음' → OnEventDone → 종료.
		self._activeTile = tile
		self:ShowGroup()
		self._pageNpcRUIDs = self:SplitSemi(npcRuidsCsv)
		self:SetPortrait(anim)
		local first = ""
		if #self._pageNpcRUIDs > 0 then first = self._pageNpcRUIDs[1] end
		if first ~= "" then
			self:SetNPCImage(true, first)
		else
			self:SetNPCImage(false, "")   -- NPC 없는 불행(예: 리멘)은 초상 숨김.
		end
		self:ShowPagedText(message, self.OnEventDone)
	end

	@ExecSpace("ClientOnly")
	method table SplitSemi(string s)
		-- ';'로 구분된 문자열을 목록으로 나눈다(빈 값이면 빈 목록).
		local list = {}
		if s == nil or s == "" then return list end
		for part in string.gmatch(s, "[^;]+") do
			table.insert(list, part)
		end
		return list
	end

	@ExecSpace("ClientOnly")
	method void ShowPlain(string message)
		-- 버튼 없이 문구만 표시(보스 선택 안내 등).
		self:HideAllButtons()
		self:ShowGroup()
		self:SetText(message)
		self:SetPortrait("attack")
	end

	@ExecSpace("ClientOnly")
	method void ShowLevelUpFx()
		-- 배너에서 호출. 맵 전환 프리로드 로딩 오버레이가 떠 있으면, 오버레이가 사라진 뒤
		-- LevelUpFxDelay 만큼 있다가 이펙트를 재생한다(오버레이 뒤에서 원샷이 끝나 안 보이는 문제 방지).
		self._luFxWanted = true
		self:ClearLuFxSched()
		self:ScheduleLevelUpFx()
	end

	@ExecSpace("ClientOnly")
	method void PlayOpeningLevelUpFx()
		-- 인트로(또는 폴백 타이머)가 호출: 보류했던 오프닝 레벨업 이펙트를 지금 재생한다.
		-- 로딩 오버레이는 이미 걷힌 상태 → ShowLevelUpFx가 LevelUpFxDelay 후 재생한다.
		if self._openingLevelUpDeferred == false then return end
		self._openingLevelUpDeferred = false
		if self._luFxFallbackTimer ~= 0 then _TimerService:ClearTimer(self._luFxFallbackTimer) self._luFxFallbackTimer = 0 end
		self:ShowLevelUpFx()
	end

	@ExecSpace("ClientOnly")
	method void ScheduleLevelUpFx()
		-- 로딩 오버레이가 끝날 때까지 폴링 대기 → 끝나면 LevelUpFxDelay 후 재생. 배너가 닫혔으면(_luFxWanted=false) 취소.
		if self._luFxWanted == false then return end
		if _LoadingManager ~= nil and _LoadingManager:IsOverlayShown() then
			self._luFxSchedTimer = _TimerService:SetTimerOnce(function() self:ScheduleLevelUpFx() end, 0.2)
			return
		end
		self._luFxSchedTimer = _TimerService:SetTimerOnce(function() self:PlayLevelUpFx() end, self.LevelUpFxDelay)
	end

	@ExecSpace("ClientOnly")
	method void PlayLevelUpFx()
		-- 초상화 중심(LevelUpFx 자식)에 레벨업 이펙트를 1회 재생. ImageRUID 재할당으로 클립을 처음부터 재생.
		if self._luFxWanted == false then return end
		local e = _EntityService:GetEntityByPath(self.LevelUpFxPath)
		if isvalid(e) == false then
			log_warning("[EventTileUI] LevelUpFx 엔티티를 찾을 수 없습니다: " .. self.LevelUpFxPath)
			return
		end
		if isvalid(e.SpriteGUIRendererComponent) then
			e.SpriteGUIRendererComponent.ImageRUID = DataRef(self.LevelUpFxRUID)
		end
		e.Enable = true
		if self._luFxTimer ~= 0 then _TimerService:ClearTimer(self._luFxTimer) end
		self._luFxTimer = _TimerService:SetTimerOnce(function() self:HideLevelUpFx() end, self.LevelUpFxSeconds)
		log("[EventTileUI] 레벨업 이펙트 재생")
	end

	@ExecSpace("ClientOnly")
	method void ClearLuFxSched()
		-- 예약(로딩 대기/지연 재생) 타이머 해제.
		if self._luFxSchedTimer ~= 0 then _TimerService:ClearTimer(self._luFxSchedTimer) self._luFxSchedTimer = 0 end
	end

	@ExecSpace("ClientOnly")
	method void HideLevelUpFx()
		-- 이펙트 숨김 + 예약/자동숨김 타이머 정리(배너 종료/자동 종료 공용). 로딩 중 배너가 닫히면 예약도 취소된다.
		self._luFxWanted = false
		self._openingLevelUpDeferred = false
		if self._luFxFallbackTimer ~= 0 then _TimerService:ClearTimer(self._luFxFallbackTimer) self._luFxFallbackTimer = 0 end
		self:ClearLuFxSched()
		if self._luFxTimer ~= 0 then _TimerService:ClearTimer(self._luFxTimer) self._luFxTimer = 0 end
		local e = _EntityService:GetEntityByPath(self.LevelUpFxPath)
		if isvalid(e) then e.Enable = false end
	end

	method string StripQuotes(string s)
		-- 손으로 쓴 CSV에서 쉼표 때문에 "..."로 감싼 필드는 런타임에 리터럴 따옴표가 남는다 → 감싼 따옴표 1쌍 제거.
		if s == nil then return "" end
		if #s >= 2 and string.sub(s, 1, 1) == "\"" and string.sub(s, #s, #s) == "\"" then
			return string.sub(s, 2, #s - 1)
		end
		return s
	end

	method string NormalizePages(string s)
		-- CSV 문구를 페이지 텍스트로 변환. '|' 또는 '\n\n'(줄바꿈 두 번) = 다음 페이지, '\n' = 같은 페이지 줄바꿈.
		if s == nil then return "" end
		s = string.gsub(s, "|", "\n\n")     -- '|' → 페이지 경계
		s = string.gsub(s, "\\n", "\n")     -- 리터럴 '\n' → 실제 개행(연속 두 개면 '\n\n'=페이지 경계)
		return s
	end

	@ExecSpace("ClientOnly")
	method string LevelBannerText(integer level)
		-- 레벨업 배너 헤드라인(1페이지~). LevelDialogue.Banner에 값이 있으면 그 문구,
		-- 없으면 기본 "Lv.N 달성!". → 문구는 CSV의 Banner 칸만 고치면 코드 수정 없이 바뀐다.
		local ds = _DataService:GetTable("LevelDialogue")
		if isvalid(ds) then
			for i = 1, ds:GetRowCount() do
				if tonumber(ds:GetCell(i, "Level")) == level then
					local b = ds:GetCell(i, "Banner")
					if b ~= nil and b ~= "" then return self:StripQuotes(b) end
					break
				end
			end
		end
		return "Lv." .. tostring(level) .. " 달성!"
	end

	@ExecSpace("ClientOnly")
	method string LevelDialogueText(integer level)
		-- LevelDialogue 데이터셋에서 해당 레벨의 내레이션 대사(Text)를 반환한다. 행이 없거나 빈 칸이면 "".
		-- 레벨→대사는 데이터로만 관리 → 새 레벨 대사는 CSV에 행만 추가하면 자동 반영(코드 수정 불필요).
		local ds = _DataService:GetTable("LevelDialogue")
		if isvalid(ds) == false then return "" end
		for i = 1, ds:GetRowCount() do
			if tonumber(ds:GetCell(i, "Level")) == level then
				local t = ds:GetCell(i, "Text")
				if t == nil then return "" end
				return self:StripQuotes(t)
			end
		end
		return ""
	end

	@ExecSpace("ClientOnly")
	method void ShowLevelUp(integer level)
		-- 레벨업 축하 배너: EventTileGroup 재사용. 몬스터/NPC는 ShowGroup에서 숨기고,
		-- 플레이어 초상화를 화면 중앙으로 옮겨 축하 표정(Cheers)+제자리 폴짝 + "Lv.N 달성!" 문구 + '다음'.
		-- LevelDialogue에 해당 레벨 대사가 있으면 배너 '다음' 뒤에 내레이션 페이지로 이어붙인다(없으면 배너만).
		-- 마지막 페이지 '다음'(OnLevelUpNext)에서 그룹을 닫고 서버(_LevelUpCelebration)에 완료를 신호해 다운스트림을 진행한다.
		self._activeTile = nil
		self._luHidHud = true            -- 레벨업 배너 동안 인게임 HUD 숨김(닫힐 때 복원)
		if isvalid(self.InGameGroup) then self.InGameGroup.Enable = false end
		self:ShowGroup()                 -- 그룹 on + 현재 지역 배경 + 몬스터/NPC 숨김
		self:CenterPortrait(true)        -- 초상화를 수평 중앙으로(원위치 캐시)
		self:SetPortrait("idle")         -- 초상화 외형을 로컬 플레이어와 동일하게 고정
		self:PortraitEmoteKind("happy")  -- Cheers 표정 + 제자리 폴짝
		-- 오프닝(Lv.10) 배너면: 인트로가 단풍잎을 머리에 안착시킨 뒤 이펙트를 재생하도록 '보류'한다.
		-- 인트로가 없거나 오프닝이 아니면 기존대로 즉시 예약.
		if isvalid(_IntroCutscene) and isvalid(_LevelUpCelebration) and _LevelUpCelebration:IsOpeningCampPending() then
			self._openingLevelUpDeferred = true
			_IntroCutscene:OnOpeningBannerReady()
			if self._luFxFallbackTimer ~= 0 then _TimerService:ClearTimer(self._luFxFallbackTimer) end
			self._luFxFallbackTimer = _TimerService:SetTimerOnce(function() self:PlayOpeningLevelUpFx() end, 12.0)
			log("[EventTileUI] 오프닝 레벨업 이펙트 보류(인트로 트리거 대기)")
		else
			self:ShowLevelUpFx()             -- 초상화 중심에 레벨업 이펙트 1회 재생
		end
		-- 배너(1페이지~) + 내레이션을 합쳐 페이지로 나눈다. 페이지/줄바꿈 규칙은 CSV에서 관리:
		--   '|' 또는 '\n\n'(줄바꿈 두 번) = 다음 스크립트(페이지)로 넘김,  '\n' = 같은 페이지 줄바꿈.
		-- Banner 칸에 '|'로 여러 페이지를 넣어도, Text 칸의 '\n\n'로 넘겨도 모두 동작한다.
		local banner = self:LevelBannerText(level)
		local line = self:LevelDialogueText(level)
		local full = banner
		if line ~= "" then full = banner .. "\n\n" .. line end
		self:ShowPagedText(self:NormalizePages(full), self.OnLevelUpNext)
		log("[EventTileUI] 레벨업 배너 표시 Lv." .. tostring(level) .. " 대사=" .. tostring(line ~= ""))
	end

	@ExecSpace("ClientOnly")
	method void OnLevelUpNext()
		-- 배너 '다음' → 초상화 원위치 복구 + 그룹 닫기 + 서버에 완료 신호(다운스트림 진행).
		self:CenterPortrait(false)
		self:Hide()
		_LevelUpCelebration:RequestDone()
	end

	@ExecSpace("ClientOnly")
	method void CenterPortrait(boolean on)
		-- 초상화(PlayerPortrait)를 수평 중앙(x=0)으로 옮기거나 원위치로 되돌린다. 원위치는 최초 1회만 캐시한다.
		local portrait = _EntityService:GetEntityByPath(self.PortraitPath)
		if isvalid(portrait) == false or isvalid(portrait.UITransformComponent) == false then return end
		local ut = portrait.UITransformComponent
		if on then
			if self._luPortraitCached == false then
				self._luPortraitBase = ut.anchoredPosition
				self._luPortraitCached = true
			end
			ut.anchoredPosition = Vector2(0, self._luPortraitBase.y)
		elseif self._luPortraitCached then
			ut.anchoredPosition = self._luPortraitBase
		end
	end

	@ExecSpace("ClientOnly")
	method void SceneText(string text, string anim, string npcKey, Component tile)
		-- 텍스트 씬: 그룹/초상화/텍스트(페이지 단위). 마지막 장에서 '다음' → 서버에 진행 요청.
		self._activeTile = tile
		self:ShowGroup()
		self:SetNPCImage(true, _NpcInfoManager:GetNpcRUID(npcKey))   -- 마을 이벤트: 등장 NPC 이미지 표시
		self:SetPortrait(anim)
		self:ShowPagedText(text, self.OnTextAdvance)
	end

	@ExecSpace("ClientOnly")
	method void OnTextAdvance()
		-- 텍스트 씬 '다음' → 서버에 진행 요청.
		-- 클릭 즉시 버튼을 숨겨 서버 왕복(다음 씬/주사위 도착 전) 동안 재클릭(중복 진행)을 막는다.
		self:HideAllButtons()
		if isvalid(self._activeTile) then self._activeTile:RequestAdvance() end
	end

	@ExecSpace("ClientOnly")
	method void AdvanceActiveTile()
		-- '넘기기' 등에서 주사위/문구 연출 없이 즉시 활성 타일에 진행을 요청한다(완주자 대기 큐브 롤 종료 → 턴 진행).
		if isvalid(self._activeTile) then self._activeTile:RequestAdvance() end
	end

	@ExecSpace("ClientOnly")
	method void SceneRoll(string leadText, string anim, string resultText, integer d1, integer d2, integer diceTotal, number greatPct, number successPct, number failPct, string outcomeLabel, string npcKey, Component tile)
		-- 확률게임 roll 씬: 리드 텍스트(페이지) → '다음' → 주사위 연출(resultDice) → 결과 문구(페이지) → '다음' → 진행.
		-- 서버가 넘긴 대성공/성공/실패 확률을 보관 → OnRollLeadDone에서 SetProbabilities로 결과판 구성.
		self._activeTile = tile
		self._rollResult = resultText
		self._rollD1 = d1
		self._rollD2 = d2
		self._rollTotal = diceTotal
		self._rollGreat = greatPct
		self._rollSuccess = successPct
		self._rollFail = failPct
		self._rollOutcome = outcomeLabel
		self:ShowGroup()
		self:SetNPCImage(true, _NpcInfoManager:GetNpcRUID(npcKey))   -- 마을 이벤트: 등장 NPC 이미지 표시
		self:SetPortrait(anim)
		self:ShowPagedText(leadText, self.OnRollLeadDone)
	end

	@ExecSpace("ClientOnly")
	method void OnRollLeadDone()
		-- 리드 텍스트 끝 → 확률게임 주사위 연출(resultDiceUIGroup)을 거친 뒤 결과 문구 표시.
		self:HideAllButtons()
		-- 확률 → SetProbabilities로 결과판 구성(+보드 UI 갱신) 후 그 보드로 주사위 연출.
		local board = _RollResultDiceAnimationUI:SetProbabilities(self._rollGreat, self._rollSuccess, self._rollFail)
		_RollResultDiceAnimationUI:Show(self._rollD1, self._rollD2, self._rollTotal, board, self._rollOutcome, function()
			self:ShowPagedText(self._rollResult, self.OnTextAdvance)
			self:PortraitEmote(self._rollOutcome)   -- 결과(성공/대성공=웃음, 실패=울음) 기반 표정+동작
		end)
		-- 관전자 주사위 보드도 '지금'(actor가 리드를 넘겨 보드가 뜬 순간) 방송한다(도착 즉시 방송 대체).
		local myId = ""
		local lp = _UserService.LocalPlayer
		if isvalid(lp) then myId = lp.PlayerComponent.UserId end
		_RollResultDiceAnimationUI:RequestSpectatorBoard(self._rollD1, self._rollD2, self._rollTotal, board, self._rollOutcome, myId)
	end

	@ExecSpace("ClientOnly")
	method void SceneChoices(string text, string anim, table labels, string npcKey, Component tile)
		-- 선택지 씬: 프롬프트를 페이지 단위로 보여주고, 마지막 장에서 선택 버튼을 노출한다.
		self._activeTile = tile
		self._choiceLabels = labels
		self:ShowGroup()
		self:SetNPCImage(true, _NpcInfoManager:GetNpcRUID(npcKey))   -- 마을 이벤트: 등장 NPC 이미지 표시
		self:SetPortrait(anim)
		self._pages = self:SplitPages(text)
		self._pageIdx = 1
		self:ShowChoicePage()
	end

	@ExecSpace("ClientOnly")
	method void ShowChoicePage()
		-- 현재 프롬프트 페이지 출력. 마지막 장이면 선택 버튼, 아니면 '다음' 버튼.
		self:SetText(self._pages[self._pageIdx] or "")
		if self._pageIdx < #self._pages then
			self:ShowNext(self.OnChoicePageNext)
		else
			self:RevealChoices(self._choiceLabels)
		end
	end

	@ExecSpace("ClientOnly")
	method void OnChoicePageNext()
		self._pageIdx = self._pageIdx + 1
		self:ShowChoicePage()
	end

	@ExecSpace("ClientOnly")
	method void SetButtonImage(Entity btn, string ruid)
		-- 버튼 배경 이미지(SpriteGUIRendererComponent.ImageRUID) 교체. 파랑/회색 선택지 버튼 구분용.
		if isvalid(btn) == false then return end
		if isvalid(btn.SpriteGUIRendererComponent) then
			btn.SpriteGUIRendererComponent.ImageRUID = DataRef(ruid)
		end
	end

	@ExecSpace("ClientOnly")
	method boolean IsAcceptDeclineLabels(table labels)
		-- 수락/거절형 2지선다 판별: 라벨에 '수락' 또는 '거절'이 하나라도 있으면 참.
		-- ('거절'은 오직 거절 선택지에만, '수락'은 수락 선택지에만 등장하므로 중립 선지와 확실히 구분된다.)
		for i = 1, #labels do
			if labels[i] ~= nil and (string.find(labels[i], "수락") ~= nil or string.find(labels[i], "거절") ~= nil) then
				return true
			end
		end
		return false
	end

	@ExecSpace("ClientOnly")
	method void RevealChoices(table labels)
		-- 선택 버튼 노출: 2개 이하 → 2지선다(BinaryChoice) / 3개 이상 → MultipleChoice.
		self:HideAllButtons()
		local n = #labels
		if n <= 2 then
			if isvalid(self.BinaryChoiceGroup) then self.BinaryChoiceGroup.Enable = true end
			local bbtns = { self.AcceptButton, self.DeclineButton }
			-- 수락/거절형이면 1번=파랑, 2번(거절)=회색. 그 외 중립 2지선다는 둘 다 파랑.
			local acceptDecline = self:IsAcceptDeclineLabels(labels)
			log("[EventTileUI] 2지선다 노출 n=" .. tostring(n) .. " 수락/거절형=" .. tostring(acceptDecline))
			for i = 1, n do
				local ruid = self.BinaryBlueRUID
				if i == 2 and acceptDecline then ruid = self.BinaryGrayRUID end
				self:SetButtonImage(bbtns[i], ruid)
				self:WireChoiceButton(bbtns[i], labels[i], i)
			end
		else
			if isvalid(self.MultipleChoiceGroup) then self.MultipleChoiceGroup.Enable = true end
			local sbtns = { self.Select1, self.Select2, self.Select3, self.Select4 }
			if n > 4 then n = 4 end
			for i = 1, n do
				self:WireChoiceButton(sbtns[i], labels[i], i)
			end
		end
	end

	@ExecSpace("ClientOnly")
	method void OnChoicePick(integer index)
		-- 선택지 클릭 → 서버에 선택 인덱스 전달.
		-- 클릭 즉시 버튼을 숨겨 서버 왕복(주사위/다음 씬 도착 전) 동안 다른 선택지 재클릭(중복 굴림)을 막는다.
		self:HideAllButtons()
		if isvalid(self._activeTile) then self._activeTile:RequestChoice(index) end
	end

	@ExecSpace("ClientOnly")
	method void SceneHide()
		-- 마을 이벤트 UI 닫기.
		self:Hide()
		self._activeTile = nil
	end

	@ExecSpace("ClientOnly")
	method void VillageQuestText(string questText, Component villageTile)
		-- 도전 문구(페이지 단위) 표시 → 마지막 장에서 '다음' → 서버에 결과 굴림 요청.
		self._activeTile = villageTile
		self:ShowGroup()
		self:SetPortrait("attack")
		self:ShowPagedText(questText, self.OnQuestNext)
	end

	@ExecSpace("ClientOnly")
	method void OnQuestNext()
		-- '다음' 클릭 즉시 버튼을 숨겨 주사위 UI가 뜨기까지의 서버 왕복 동안 재클릭(중복 굴림)을 막는다.
		self:HideAllButtons()
		if isvalid(self._activeTile) then self._activeTile:RequestQuestRoll() end
	end

	@ExecSpace("ClientOnly")
	method void VillageDice(integer d1, integer d2, integer total, table resultTable, string outcome, string outcomeText, Component villageTile)
		-- 결과 주사위 연출 → 결과 문구 + '다음' 클릭 시 종료 신호.
		self._activeTile = villageTile
		self:HideAllButtons()   -- 주사위 UI가 뜬 동안 밑의 EventTileGroup 버튼이 눌리지 않도록 방어적으로 재차 숨김.
		_RollResultDiceAnimationUI:Show(d1, d2, total, resultTable, outcome, function()
			self:ShowPagedText(outcomeText, self.OnDiceNext)
		end)
	end

	@ExecSpace("ClientOnly")
	method void OnDiceNext()
		-- 결과 문구 '다음' → UI 닫고 종료 신호.
		self:Hide()
		if isvalid(self._activeTile) then self._activeTile:RequestFinish() end
	end

	@ExecSpace("ClientOnly")
	method void BossFightText(string challengeText, string bossStandRUID, Component bossTile)
		-- 보스 전투 연출: 플레이어는 공격 모션, 상대 NPCImage에는 보스 stand 스프라이트를 넣어 싸우는 장면 + 도전 문구.
		-- 마지막 장 '다음' → RequestQuestRoll (공용 OnQuestNext 재사용).
		self._activeTile = bossTile
		self:ShowGroup()
		self:SetPortrait("attack")
		self:SetBossFightImage(bossStandRUID)   -- 보스 전투: 원본 크기 × 3배(전역)
		self:ShowPagedText(challengeText, self.OnQuestNext)
	end

	@ExecSpace("ClientOnly")
	method void BossFightDice(integer d1, integer d2, integer total, table resultTable, string outcome, string outcomeText, string bossDieRUID, Component bossTile)
		-- 보스 결과 주사위 → 주사위 종료 후 EventTileUI 복귀 연출:
		--   성공/대성공 → 플레이어 idle 복귀 + 보스 die 애니 재생 / 실패 → 플레이어 idle + 보스는 기본(stand) 유지.
		-- 이어서 결과 문구 표시, '다음' → 종료(공용 OnDiceNext 재사용).
		self._activeTile = bossTile
		self:HideAllButtons()
		local win = (outcome == "성공" or outcome == "대성공")
		_RollResultDiceAnimationUI:Show(d1, d2, total, resultTable, outcome, function()
			self:SetPortrait("idle")
			if win and bossDieRUID ~= "" then
				self:SetBossFightImage(bossDieRUID)   -- 보스 전투 die 애니도 동일 크기 유지
			end
			self:ShowPagedText(outcomeText, self.OnDiceNext)
			self:PortraitEmote(outcome)   -- 결과 표정+동작을 초상화에 연출(SetPortrait("idle") 뒤에 덮어씀)
		end)
		-- 관전자 주사위 보드도 '지금'(actor가 도전 문구를 넘겨 보드가 뜬 순간) 방송한다(도착 즉시 방송 대체).
		local myId = ""
		local lp = _UserService.LocalPlayer
		if isvalid(lp) then myId = lp.PlayerComponent.UserId end
		_RollResultDiceAnimationUI:RequestSpectatorBoard(d1, d2, total, resultTable, outcome, myId)
	end

	@ExecSpace("ClientOnly")
	method void StopSpectatorTimers()
		-- 관전 자동 넘김 타이머 정지(새 씬 진입/닫기 시 잔상·이중 넘김 방지).
		if self._specPageTimer ~= 0 then _TimerService:ClearTimer(self._specPageTimer) self._specPageTimer = 0 end
	end

	@ExecSpace("ClientOnly")
	method void ShowSpectatorPaged(table pages, any onLast)
		-- 관전 페이지 자동 넘김: pages[1] 표시 → SpectatorPageInterval마다 다음 페이지 → 마지막 도달 시 정지 + onLast(있으면) 1회.
		self:StopSpectatorTimers()
		self._specPages = pages
		self._specPageIdx = 1
		local n = #pages
		if n == 0 then
			if onLast ~= nil then onLast() end
			return
		end
		self:SetText(pages[1])
		if n == 1 then
			if onLast ~= nil then onLast() end
			return
		end
		self._specPageTimer = _TimerService:SetTimerRepeat(function()
			self._specPageIdx = self._specPageIdx + 1
			-- 사냥+ 관전: 지정 페이지에 도달하면 몬스터 이미지를 끄고 사냥+(엘리트/NPC) 이미지로 전환(1회).
			if self._specImgFromPage > 0 and self._specPageIdx >= self._specImgFromPage then
				self:SetMonsterImages("")
				if self._specImgPage2RUID ~= "" then self:SetNPCImage(true, self._specImgPage2RUID) end
				self._specImgFromPage = 0
			end
			if self._specPageIdx >= n then
				self:SetText(pages[n])
				if self._specPageTimer ~= 0 then _TimerService:ClearTimer(self._specPageTimer) self._specPageTimer = 0 end
				if onLast ~= nil then onLast() end
			else
				self:SetText(pages[self._specPageIdx])
			end
		end, self.SpectatorPageInterval)
	end

	@ExecSpace("Client")
	method void SpectatorSceneText(string text, string anim, string npcKey, string actorUserId)
		-- 관전자: 텍스트 씬 읽기전용 미러(자동 넘김). actor는 자기 인터랙티브 경로를 쓰므로 스킵.
		local lp = _UserService.LocalPlayer
		if isvalid(lp) and lp.PlayerComponent.UserId == actorUserId then return end
		self._specActorUserId = actorUserId
		self:ShowSpectatorText(text, anim, npcKey)
	end

	@ExecSpace("ClientOnly")
	method void ShowSpectatorText(string text, string anim, string npcKey)
		-- 관전 텍스트 표시: 그룹/NPC이미지/초상화 + 자동 넘김 페이지.
		self:StopSpectatorTimers()
		self:ShowGroup()
		self:SetNPCImage(true, _NpcInfoManager:GetNpcRUID(npcKey))
		self:SetPortrait(anim)
		self:ShowSpectatorPaged(self:SplitPages(text), nil)
	end

	@ExecSpace("Client")
	method void SpectatorSceneChoices(string text, string anim, table labels, string npcKey, string actorUserId)
		-- 관전자: 선택지 씬 읽기전용 미러(프롬프트 자동 넘김 → 선택지 라벨 정적 표시). 버튼 미생성. actor 스킵.
		local lp = _UserService.LocalPlayer
		if isvalid(lp) and lp.PlayerComponent.UserId == actorUserId then return end
		self._specActorUserId = actorUserId
		self:ShowSpectatorChoices(text, anim, labels, npcKey)
	end

	@ExecSpace("ClientOnly")
	method void ShowSpectatorChoices(string text, string anim, table labels, string npcKey)
		-- 관전 선택지 표시: 프롬프트 페이지 뒤에 선택지 라벨을 담은 합성 페이지를 붙여 자동 넘김. 실제 버튼은 만들지 않는다.
		self:StopSpectatorTimers()
		self:ShowGroup()
		self:SetNPCImage(true, _NpcInfoManager:GetNpcRUID(npcKey))
		self:SetPortrait(anim)
		local pages = self:SplitPages(text)
		local labelText = ""
		for i = 1, #labels do
			if labels[i] ~= nil and labels[i] ~= "" then
				if labelText ~= "" then labelText = labelText .. "\n" end
				labelText = labelText .. "▶ " .. labels[i]
			end
		end
		if labelText ~= "" then table.insert(pages, labelText) end
		self:ShowSpectatorPaged(pages, nil)
	end

	@ExecSpace("Client")
	method void SpectatorSceneRoll(string leadText, string resultText, string anim, string npcKey, string actorUserId)
		-- 관전자: roll 씬 리드/결과 문구 미러(주사위 자체는 2a 병행). actor 스킵.
		local lp = _UserService.LocalPlayer
		if isvalid(lp) and lp.PlayerComponent.UserId == actorUserId then return end
		self._specActorUserId = actorUserId
		self:ShowSpectatorRoll(leadText, resultText, anim, npcKey)
	end

	@ExecSpace("ClientOnly")
	method void ShowSpectatorRoll(string leadText, string resultText, string anim, string npcKey)
		-- 관전 roll 표시: 리드 대사만 표시하고, actor가 실제로 주사위를 굴린 순간(SpectatorRevealRollText)에 결과 문구로 진행.
		-- (변경 전엔 SpectatorRollLeadHold 타이머로 결과 문구를 자동 노출 → actor가 굴리기 전에 결과가 스포일되던 문제 수정.)
		self:StopSpectatorTimers()
		self:ShowGroup()
		self:SetNPCImage(true, _NpcInfoManager:GetNpcRUID(npcKey))
		self:SetPortrait(anim)
		self._specRollResultText = resultText   -- actor 굴림 시 표시할 결과 문구 보관(대기)
		self:ShowSpectatorPaged(self:SplitPages(leadText), nil)
	end

	@ExecSpace("ClientOnly")
	method void SpectatorRevealRollText()
		-- actor가 실제로 주사위를 굴린 순간, 관전 roll 씬의 리드 문구를 결과 문구로 진행한다(대기 중이던 관전자용).
		-- roll 씬이 아니거나(보관된 결과문구 없음) 이미 진행했다면 no-op.
		if self._specRollResultText == "" then return end
		local rt = self._specRollResultText
		self._specRollResultText = ""
		self:ShowSpectatorPaged(self:SplitPages(rt), nil)
	end

	@ExecSpace("Client")
	method void SpectatorBossFightText(string challengeText, string bossStandRUID, string actorUserId)
		-- 관전자: 보스 도전 문구 미러. actor 스킵.
		local lp = _UserService.LocalPlayer
		if isvalid(lp) and lp.PlayerComponent.UserId == actorUserId then return end
		self._specActorUserId = actorUserId
		self:ShowSpectatorBossFight(challengeText, bossStandRUID)
	end

	@ExecSpace("ClientOnly")
	method void ShowSpectatorBossFight(string challengeText, string bossStandRUID)
		-- 관전 보스 도전: 초상화 attack + 보스 stand 이미지 + 도전 문구 자동 넘김.
		self:StopSpectatorTimers()
		self:ShowGroup()
		self:SetPortrait("attack")
		self:SetBossFightImage(bossStandRUID)
		self:ShowSpectatorPaged(self:SplitPages(challengeText), nil)
	end

	@ExecSpace("Client")
	method void SpectatorBossFollow(boolean win, string outcome, string outcomeText, string bossDieRUID, string actorUserId)
		-- 관전자: 보스 결과 후속(성공 시 die 이미지 + 결과 문구) 즉시 미러. actor 스킵.
		-- ⚠ 즉시 표시 버전: 주사위 롤이 없는 흐름(EndTile 검은 마법사=CP 판정) 전용. 주사위 롤이 있는 BossTile은 SpectatorBossFollowDeferred 사용.
		local lp = _UserService.LocalPlayer
		if isvalid(lp) and lp.PlayerComponent.UserId == actorUserId then return end
		self._specActorUserId = actorUserId
		self:ShowSpectatorBossFollow(win, outcome, outcomeText, bossDieRUID)
	end

	@ExecSpace("Client")
	method void SpectatorBossFollowDeferred(boolean win, string outcome, string outcomeText, string bossDieRUID, string actorUserId)
		-- 관전자: 보스 결과 후속을 도착 즉시 표시하지 않고 보관 → actor가 실제 주사위를 굴린 순간(SpectatorRevealBossFollow)에 공개.
		--         그때까지 화면엔 도전 문구(SpectatorBossFightText) 미러가 유지된다(승패 조기 스포일 방지). 주사위 롤이 있는 BossTile 전용.
		local lp = _UserService.LocalPlayer
		if isvalid(lp) and lp.PlayerComponent.UserId == actorUserId then return end
		self._specActorUserId = actorUserId
		self._specBossWin = win
		self._specBossOutcome = outcome
		self._specBossOutcomeText = outcomeText
		self._specBossDieRUID = bossDieRUID
		self._specBossFollowPending = true
	end

	@ExecSpace("ClientOnly")
	method void SpectatorRevealBossFollow()
		-- actor가 실제로 주사위를 굴린 순간, 보관해둔 보스 결과 후속(승패 문구+die 이미지)을 공개한다.
		-- 보스 롤 씬이 아니거나(보관된 후속 없음) 이미 공개했다면 no-op.
		if self._specBossFollowPending == false then return end
		self._specBossFollowPending = false
		self:ShowSpectatorBossFollow(self._specBossWin, self._specBossOutcome, self._specBossOutcomeText, self._specBossDieRUID)
	end

	@ExecSpace("ClientOnly")
	method void ShowSpectatorBossFollow(boolean win, string outcome, string outcomeText, string bossDieRUID)
		-- 관전 보스 후속: 그룹 유지 + 초상화 idle + (성공 시 보스 die 이미지) + 결과 문구 자동 넘김 + 표정.
		self:StopSpectatorTimers()
		self:ShowGroup()
		self:SetPortrait("idle")
		if win and bossDieRUID ~= "" then self:SetBossFightImage(bossDieRUID) end
		self:ShowSpectatorPaged(self:SplitPages(outcomeText), nil)
		self:PortraitEmote(outcome)
	end

	@ExecSpace("Client")
	method void SpectatorSceneHide(string actorUserId)
		-- 관전자: 씬 미러 닫기. actor는 자기 ClientHide를 쓰므로 스킵.
		local lp = _UserService.LocalPlayer
		if isvalid(lp) and lp.PlayerComponent.UserId == actorUserId then return end
		self:HideSpectatorScene()
	end

	@ExecSpace("ClientOnly")
	method void HideSpectatorScene()
		-- 관전 씬 정리: 타이머 정지 + 패널 닫기 + 정체성 마커 리셋. 대기/공개 중이던 관전용 주사위 보드도 함께 닫는다.
		self:StopSpectatorTimers()
		self:Hide()
		self._specActorUserId = ""
		self._specRollResultText = ""
		self._specBossFollowPending = false
		_RollResultDiceAnimationUI:SpectatorForceClose()
	end

	@ExecSpace("Client")
	method void SpectatorEventText(string message, string anim, string monsterRUID, string imageKind, string npcKey, integer npcFromPage, string page2Ruid, string actorUserId)
		-- 관전자: 사냥/사냥+ 등 EventTileBase 텍스트 이벤트 미러(몬스터/NPC 이미지 + 자동 넘김). actor 스킵.
		-- npcFromPage > 0 이면 사냥+ 분할 이미지: 페이지1=일반 사냥 몬스터, 그 페이지부터 사냥+(엘리트/NPC) 이미지로 전환.
		local lp = _UserService.LocalPlayer
		if isvalid(lp) and lp.PlayerComponent.UserId == actorUserId then return end
		self._specActorUserId = actorUserId
		self:ShowSpectatorEvent(message, anim, monsterRUID, imageKind, npcKey, npcFromPage, page2Ruid)
	end

	@ExecSpace("ClientOnly")
	method void ShowSpectatorEvent(string message, string anim, string monsterRUID, string imageKind, string npcKey, integer npcFromPage, string page2Ruid)
		-- 관전 표시: 이미지(사냥=몬스터 / 사냥+·NPC=NPC 이미지) + 초상화(anim, actor 정체성) + 자동 넘김 텍스트.
		self:StopSpectatorTimers()
		self:ShowGroup()
		self._specImgFromPage = 0
		self._specImgPage2RUID = ""
		if npcFromPage > 0 then
			-- 사냥+: actor와 동일하게 페이지1은 일반 사냥 몬스터 이미지로 시작하고, npcFromPage에서 엘리트/NPC로 전환한다(피드백 5).
			local p2 = page2Ruid
			if p2 == nil or p2 == "" then p2 = _NpcInfoManager:GetNpcRUID(npcKey) end
			self._specImgFromPage = npcFromPage
			self._specImgPage2RUID = p2 or ""
			self:SetMonsterImages(monsterRUID)
		elseif imageKind == "npc" then
			self:SetNPCImage(true, _NpcInfoManager:GetNpcRUID(npcKey))
		elseif page2Ruid ~= nil and page2Ruid ~= "" then
			self:SetNPCImage(true, page2Ruid)
		else
			self:SetMonsterImages(monsterRUID)
		end
		self:SetPortrait(anim)
		self:ShowSpectatorPaged(self:SplitPages(message), nil)
	end

	@ExecSpace("Client")
	method void SpectatorUnlucky(string message, string anim, string npcKeysCsv, string actorUserId)
		-- 관전자: 불행 이벤트 미러(첫 페이지 NPC 이미지 + 자동 넘김 + 마지막 울음). actor 스킵.
		-- npcKeysCsv는 NPC 이름 키(';' 구분) — RUID 해석은 여기(클라)에서 한다(피드백 7, 서버 해석 실패 방지).
		local lp = _UserService.LocalPlayer
		if isvalid(lp) and lp.PlayerComponent.UserId == actorUserId then return end
		self._specActorUserId = actorUserId
		self:ShowSpectatorUnlucky(message, anim, npcKeysCsv)
	end

	@ExecSpace("ClientOnly")
	method void ShowSpectatorUnlucky(string message, string anim, string npcKeysCsv)
		-- 관전 불행 표시: 첫 NPC 이미지(있으면) + 초상화(anim) + 자동 넘김, 마지막 페이지에서 울음 표정.
		self:StopSpectatorTimers()
		self:ShowGroup()
		local keys = self:SplitSemi(npcKeysCsv)
		local first = ""
		if #keys > 0 then first = _NpcInfoManager:GetNpcRUID(keys[1]) end
		if first ~= "" then
			self:SetNPCImage(true, first)
		else
			self:SetNPCImage(false, "")
		end
		self:SetPortrait(anim)
		self:ShowSpectatorPaged(self:SplitPages(message), function() self:PortraitEmoteKind("cry") end)
	end

end