@Component
script GuildManager extends Component

	-- 플레이어별 길드 진행 상태 홀더. 길드 타일은 맵에 1개뿐이고 여러 플레이어가 통과하므로,
	-- 진행 상태는 반드시 말(piece = 플레이어 엔티티)에 저장한다. (BuffManager와 동일한 per-player 패턴)
	--   Stage : 다음에 진행할 길드 이벤트 단계
	--     0 = 길드 미창설      (다음 방문 → 길드창설: 주사위)
	--     1 = 창설 완료        (다음 방문 → 부길마영입)
	--     2 = 부길마 완료      (다음 방문 → 길드원영입 반복)
	--   Tier : 0 없음 / 1 초보 길드 / 2 마스터 길드
	--   GeneralMembers : 부길마를 제외한 일반 길드원 수(초보→마스터 승급 조건: 2명)
	--   PromotionPending : 승급 조건을 충족했으나 아직 '길드 승급' 이벤트를 안 본 상태.
	--     true면 다음 길드 타일 방문에서 승급 이벤트가 뜬다(Tier 상승/축복 강화는 그때 적용).
	property integer Stage = 0
	property integer Tier = 0
	property integer GeneralMembers = 0
	property boolean PromotionPending = false

	method void OnBeginPlay()
		-- @Component라 인스턴스(플레이어)마다 상태를 새로 초기화한다(공유 방지).
		self.Stage = 0
		self.Tier = 0
		self.GeneralMembers = 0
		self.PromotionPending = false
	end

	@ExecSpace("ServerOnly")
	method void CreateGuild(integer tier)
		-- 길드 창설: 등급(1 초보 / 2 마스터) 설정 후 다음 단계(부길마영입)로 진행.
		self.Tier = tier
		self.Stage = 1
		log("[GuildManager] 길드 창설 tier=" .. tostring(tier))
	end

	@ExecSpace("ServerOnly")
	method void CompleteVice()
		-- 부길마 영입 완료: 다음 단계(길드원영입 반복)로 진행.
		self.Stage = 2
		log("[GuildManager] 부길마 영입 완료")
	end

	@ExecSpace("ServerOnly")
	method boolean AddMember()
		-- 일반 길드원 1명 영입. 초보 길드(Tier==1)가 2명에 도달하면 '승급 대기'로 표시하고 true 반환.
		-- (실제 Tier 상승/축복 강화는 다음 방문의 '길드 승급' 이벤트(Promote)에서 처리한다.)
		self.GeneralMembers += 1
		log("[GuildManager] 일반 길드원 영입 → " .. tostring(self.GeneralMembers) .. "명")
		if self.Tier == 1 and self.GeneralMembers >= 2 and self.PromotionPending == false then
			self.PromotionPending = true
			log("[GuildManager] 초보→마스터 승급 조건 충족 → 승급 대기")
			return true
		end
		return false
	end

	@ExecSpace("ServerOnly")
	method void Promote()
		-- 길드 승급 이벤트에서 호출: 초보→마스터로 Tier를 올리고 승급 대기를 해제한다.
		self.Tier = 2
		self.PromotionPending = false
		log("[GuildManager] 마스터 길드로 승급 완료")
	end

	@ExecSpace("ServerOnly")
	method void ResetAll()
		-- 게임 종료 시 초기화(GameModeManager.ResetPlayerStats에서 호출).
		self.Stage = 0
		self.Tier = 0
		self.GeneralMembers = 0
		self.PromotionPending = false
		log("[GuildManager] 상태 전체 초기화")
	end

end
