@Logic
script DebugResetPotentialShop extends Logic

	-- [디버그] 잠재 성장 상점(로비 ShopPanel)의 구매(영구 업글) 상태를 되돌리는 버튼.
	-- 이미 구매/최대치가 된 상태에서 구매 플로우를 재확인하기 위한 개발용. 출시 전 제거 대상.
	-- 버튼은 ShopPanel 좌측 탭 그룹 아래에 별도로 추가된 DebugResetBtn(경로 참조, 바인딩주입 X).

	property string btnPath = "/ui/LobbyUIGroup/ShopPanel/DebugResetBtn"

	property any _handler = nil

	@ExecSpace("ClientOnly")
	method void OnBeginPlay()
		-- 좌측 디버그 버튼 클릭 배선(클라).
		local btn = _EntityService:GetEntityByPath(self.btnPath)
		if isvalid(btn) == false then return end
		self._handler = btn:ConnectEvent(ButtonClickEvent, self.OnClick)
	end

	@ExecSpace("ClientOnly")
	method void OnClick(ButtonClickEvent event)
		-- 클릭 → 서버에 잠재상점(메타 프로그레션) 초기화 요청.
		_SFXManager:PlayClick()
		self:RequestReset()
	end

	@ExecSpace("Server")
	method void RequestReset()
		-- [디버그] 요청 클라의 상점 구매 초기화: (1)잠재 성장 상점(메타 영구 업글) + (2)펫 상점(소유/장착 펫).
		--   메타: MetaProgressionManager의 기존 공개 API만 사용(캐시 참조 수정 → 저장 → UI 푸시).
		--     LoadState는 인메모리 캐시 테이블을 '참조'로 반환하므로 s의 필드 수정이 곧 캐시 반영이다.
		local userId = senderUserId
		if userId == nil or userId == "" then return end
		-- (1) 잠재 성장 상점 초기화 + 재테스트용 코인 지급.
		if _MetaProgressionManager ~= nil then
			local s = _MetaProgressionManager:LoadState(userId)
			s.incomeLv = 0
			s.probLv = 0
			s.coin = 9999   -- 구매 재테스트를 바로 할 수 있도록 넉넉히 지급.
			if s.totalEarned == nil or s.totalEarned < s.coin then s.totalEarned = s.coin end
			_MetaProgressionManager:SaveState(userId)
			_MetaProgressionManager:PushMeta(s.coin, s.incomeLv, s.probLv, s.totalEarned, userId)
		end
		-- (2) 펫 상점 초기화: 소유/장착 펫 데이터 제거 + 소환 펫 디스폰 + 상점 버튼 라벨 갱신(기존 구현 재사용).
		if _PetShopManager ~= nil then _PetShopManager:ResetAllPets(userId) end
		log("[DebugResetPotentialShop] 상점 구매 초기화: user=" .. userId .. " (잠재 coin=9999/0/0 + 펫 소유/장착 제거)")
	end

	@ExecSpace("ClientOnly")
	method void OnEndPlay()
		-- 버튼 이벤트 핸들 해제.
		local btn = _EntityService:GetEntityByPath(self.btnPath)
		if isvalid(btn) and self._handler ~= nil then
			btn:DisconnectEvent(ButtonClickEvent, self._handler)
		end
	end

end
