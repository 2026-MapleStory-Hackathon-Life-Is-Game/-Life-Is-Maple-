@Logic
script DebugEndButton extends Logic

	property Entity DebugBtn = "f18b3307-490a-4094-a0cf-acfa3350b396"

	property any _handler = nil

	@ExecSpace("ClientOnly")
	method void OnBeginPlay()
		-- 버튼 클릭 → 서버에 강제 종료 요청.
		if isvalid(self.DebugBtn) then
			self._handler = self.DebugBtn:ConnectEvent(ButtonClickEvent, self.OnClick)
		end
	end

	@ExecSpace("ClientOnly")
	method void OnEndPlay()
		-- 핸들러 해제.
		if isvalid(self.DebugBtn) and self._handler ~= nil then
			self.DebugBtn:DisconnectEvent(ButtonClickEvent, self._handler)
		end
	end

	@ExecSpace("ClientOnly")
	method void OnClick(ButtonClickEvent event)
		-- 게임 종료 이벤트(싱글) 강제 실행.
-- 		log("[DebugEndButton] 게임종료(TEST) 클릭 → DebugFinishGame")
		_GameModeManager:DebugFinishGame()
	end

end