@Logic
script PotentialManager extends Logic

	-- 잠재능력 시스템(미라클 큐브). 등급: ""(없음) < RARE < EPIC < UNIQUE < LEGENDARY.
	-- 잠재 직렬화 포맷: "GRADE|key:val|key:val|key:val" (key=전투력 모디파이어 키). 없음 = "".
	-- 데이터: PotentialOption(Grade,StatType,Value) / PotentialUpgrade(FromGrade,ToGrade,Percent).

	property table _pending = {}   -- 서버: 재설정 후보 대기. key="userId:equipName" → 후보 직렬화 문자열.

	method integer LinesForGrade(string grade)
		-- 전 등급 3줄 고정(기획 확정).
		return 3
	end

	method string StatTypeToKey(string statType)
		-- PotentialOption.StatType → 전투력 모디파이어 키.
		if statType == "MainStatPct" then return "statPct" end
		if statType == "AttackPct" then return "attackPct" end
		if statType == "DamagePct" then return "damagePct" end
		if statType == "BossDamagePct" then return "bossDamagePct" end
		if statType == "AllStatPct" then return "allStatPct" end
		if statType == "MainStatFlat" then return "statFlat" end
		if statType == "AttackFlat" then return "attackFlat" end
		return ""
	end

	method string RollGrade(string curGrade)
		-- 큐브 결과 등급. 없음→분포(레어/에픽), 그 외→다음등급 승급 확률(실패 시 현 등급 유지).
		local cur = curGrade
		if cur == nil or cur == "" then cur = "NONE" end
		local ds = _DataService:GetTable("PotentialUpgrade")
		if isvalid(ds) == false then
			if cur == "NONE" then return "RARE" end
			return cur
		end
		if cur == "NONE" then
			local total = 0
			for i = 1, ds:GetRowCount() do
				if ds:GetCell(i, "FromGrade") == "NONE" then total += (tonumber(ds:GetCell(i, "Percent")) or 0) end
			end
			if total <= 0 then return "RARE" end
			local roll = _UtilLogic:RandomIntegerRange(1, total)
			local acc = 0
			for i = 1, ds:GetRowCount() do
				if ds:GetCell(i, "FromGrade") == "NONE" then
					acc += (tonumber(ds:GetCell(i, "Percent")) or 0)
					if roll <= acc then return ds:GetCell(i, "ToGrade") end
				end
			end
			return "RARE"
		end
		for i = 1, ds:GetRowCount() do
			if ds:GetCell(i, "FromGrade") == cur then
				local p = tonumber(ds:GetCell(i, "Percent")) or 0
				if _UtilLogic:RandomIntegerRange(1, 100) <= p then return ds:GetCell(i, "ToGrade") end
				return cur
			end
		end
		return cur   -- 승급 행 없음(LEGENDARY 등) → 유지
	end

	method table RollLines(string grade)
		-- 해당 등급 옵션 풀에서 N줄(중복 허용 균등 롤).
		local ds = _DataService:GetTable("PotentialOption")
		local pool = {}
		if isvalid(ds) then
			for i = 1, ds:GetRowCount() do
				if ds:GetCell(i, "Grade") == grade then
					table.insert(pool, { key = self:StatTypeToKey(ds:GetCell(i, "StatType")), val = tonumber(ds:GetCell(i, "Value")) or 0 })
				end
			end
		end
		local lines = {}
		if #pool == 0 then return lines end
		local n = self:LinesForGrade(grade)
		for i = 1, n do
			table.insert(lines, pool[_UtilLogic:RandomIntegerRange(1, #pool)])
		end
		return lines
	end

	method string Serialize(string grade, table lines)
		-- {grade, lines} → "GRADE|key:val|...".
		local parts = { grade }
		for _, ln in ipairs(lines) do
			table.insert(parts, ln.key .. ":" .. tostring(ln.val))
		end
		return table.concat(parts, "|")
	end

	method string RollPotential(string curGrade)
		-- 큐브 1회 결과 직렬화. 순서가 핵심:
		--   1) 먼저 승급 여부를 결정한다(RollGrade).
		--      - 없음        → 가중분포로 레어/에픽 부여(항상 성공)
		--      - 등급 있음    → 다음 등급 승급 확률 판정. 실패하면 현 등급 유지.
		--   2) 그 결과 등급의 풀에서 옵션 3줄을 뽑는다(RollLines).
		--      - 승급 성공이면 새 등급 풀에서, 실패(유지)면 현 등급 풀에서 재추첨.
		local grade = self:RollGrade(curGrade)
		return self:Serialize(grade, self:RollLines(grade))
	end

	method string GradeOf(string potStr)
		-- 직렬화 문자열의 등급 토큰("" = 없음).
		if potStr == nil or potStr == "" then return "" end
		local grade = string.match(potStr, "^[^|]*")
		if grade == nil then return potStr end
		return grade
	end

	method table ModifiersOf(string potStr)
		-- 잠재 직렬화 → 전투력 모디파이어 합산 테이블.
		local m = { statFlat = 0, statPct = 0, attackFlat = 0, attackPct = 0, damagePct = 0, bossDamagePct = 0, allStatFlat = 0, allStatPct = 0 }
		if potStr == nil or potStr == "" then return m end
		for k, v in string.gmatch(potStr, "(%a+):(%-?%d+)") do
			if m[k] ~= nil then m[k] = m[k] + tonumber(v) end
		end
		return m
	end

	-- ===== 표시용(툴팁) =====

	method string GradeKorean(string grade)
		if grade == "RARE" then return "레어" end
		if grade == "EPIC" then return "에픽" end
		if grade == "UNIQUE" then return "유니크" end
		if grade == "LEGENDARY" then return "레전드리" end
		return "없음"
	end

	method string KeyKorean(string key)
		if key == "statPct" or key == "statFlat" then return "주스탯" end
		if key == "attackPct" or key == "attackFlat" then return "공/마" end
		if key == "damagePct" then return "데미지" end
		if key == "bossDamagePct" then return "보스 데미지" end
		if key == "allStatPct" then return "올스탯" end
		return key
	end

	method boolean IsPctKey(string key)
		return key == "statPct" or key == "attackPct" or key == "damagePct" or key == "bossDamagePct" or key == "allStatPct"
	end

	method string DisplayText(string potStr)
		-- 툴팁용 멀티라인: "등급\n옵션1\n옵션2\n...". 없음이면 "".
		if potStr == nil or potStr == "" then return "" end
		local out = { self:GradeKorean(self:GradeOf(potStr)) }
		for k, v in string.gmatch(potStr, "(%a+):(%-?%d+)") do
			local suffix = self:IsPctKey(k) and ("+" .. v .. "%") or ("+" .. v)
			table.insert(out, self:KeyKorean(k) .. " " .. suffix)
		end
		return table.concat(out, "\n")
	end

	-- ===== 큐브 사용 흐름 =====

	method any BagOf(Entity player)
		return player:GetComponent("script.CubeInventory")
	end

	@ExecSpace("Server")
	method void RequestCube(string equipName)
		-- 미라클 큐브 사용 요청. 없음→자동 확정, 있음→Before/After 대기(ChooseCube로 확정).
		local player = _UserService:GetUserEntityByUserId(senderUserId)
		if isvalid(player) == false then return end
		local comp = _EquipmentRouter:ManagerForItem(player, equipName)
		if isvalid(comp) == false then return end
		if comp.Owned[equipName] ~= true and comp.Equipped ~= equipName then return end

		-- [가드] 이 장비에 미확정 후보가 이미 있으면 큐브를 더 쓰지 않고 선택을 먼저 강제한다.
		-- (선택을 건너뛴 채 재요청해서 큐브가 증발하고 이전 후보가 소실되는 버그 방지)
		local key = senderUserId .. ":" .. equipName
		if self._pending[key] ~= nil then
			log_warning("[PotentialManager] 선택 대기 중 재요청 거부: " .. key)
			self:NotifyCubeResult(equipName, comp:GetPotential(equipName), self._pending[key], false, senderUserId)
			return
		end

		local bag = self:BagOf(player)
		if isvalid(bag) == false or bag.MiracleCubeCount <= 0 then
			log_warning("[PotentialManager] 미라클 큐브 부족: " .. tostring(senderUserId))
			return
		end
		bag.MiracleCubeCount = bag.MiracleCubeCount - 1

		-- 잠재 유무와 무관하게 항상 후보를 대기열에 넣고 카드 선택으로 확정한다(자동확정 없음).
		-- 잠재 없던 장비는 Before="" (없음) 카드로, 클릭 선택 시 ChooseCube에서 적용/유지가 갈린다.
		local cur = comp:GetPotential(equipName)
		local cand = self:RollPotential(self:GradeOf(cur))
		self._pending[key] = cand
		self:NotifyCubeResult(equipName, cur, cand, false, senderUserId)
	end

	@ExecSpace("Server")
	method void ChooseCube(string equipName, boolean accept)
		-- Before/After 선택 확정. accept=true면 후보 적용, false면 기존 유지.
		local key = senderUserId .. ":" .. equipName
		local cand = self._pending[key]
		if cand == nil then return end
		self._pending[key] = nil
		if accept == false then return end
		local player = _UserService:GetUserEntityByUserId(senderUserId)
		if isvalid(player) == false then return end
		local comp = _EquipmentRouter:ManagerForItem(player, equipName)
		if isvalid(comp) == false then return end
		-- 소유/장착 재검증(대기 중 아이템을 잃었거나 부정 요청 방지).
		if comp.Owned[equipName] ~= true and comp.Equipped ~= equipName then return end
		comp:SetPotential(equipName, cand)
		comp:Recalc()
	end

	@ExecSpace("Server")
	method void RerollCube(string equipName)
		-- 재설정: 선택 대기(미확정 후보)가 있는 상태에서 큐브를 한 번 더 소모해 다시 굴린다.
		-- 재추첨 기준은 '현재 적용된 잠재(Before)' 등급 — 미적용 후보(After)를 누적해 승급시키지 않는다.
		local player = _UserService:GetUserEntityByUserId(senderUserId)
		if isvalid(player) == false then return end
		local comp = _EquipmentRouter:ManagerForItem(player, equipName)
		if isvalid(comp) == false then return end
		if comp.Owned[equipName] ~= true and comp.Equipped ~= equipName then return end

		local key = senderUserId .. ":" .. equipName
		-- 후보가 없으면(선택 모드가 아니면) 재설정 버튼이 노출될 일이 없지만, 방어적으로 무시.
		if self._pending[key] == nil then
			log_warning("[PotentialManager] 재설정 거부: 대기 후보 없음 " .. key)
			return
		end

		local bag = self:BagOf(player)
		if isvalid(bag) == false or bag.MiracleCubeCount <= 0 then
			-- 큐브 부족: 기존 후보를 유지한 채 팝업만 다시 띄운다(상태 손실 방지).
			log_warning("[PotentialManager] 재설정: 미라클 큐브 부족 " .. tostring(senderUserId))
			self:NotifyCubeResult(equipName, comp:GetPotential(equipName), self._pending[key], false, senderUserId)
			return
		end
		bag.MiracleCubeCount = bag.MiracleCubeCount - 1

		local cur = comp:GetPotential(equipName)
		local cand = self:RollPotential(self:GradeOf(cur))
		self._pending[key] = cand
		self:NotifyCubeResult(equipName, cur, cand, false, senderUserId)
	end

	@ExecSpace("Client")
	method void NotifyCubeResult(string equipName, string before, string after, boolean autoConfirmed)
		-- 큐브 결과를 클라 팝업으로 통지. autoConfirmed면 결과+확인, 아니면 Before/After 선택.
		if autoConfirmed then
			log("[PotentialManager] 큐브 결과(자동확정) " .. equipName .. " → " .. after)
		else
			log("[PotentialManager] 큐브 결과(선택) " .. equipName .. " | Before=" .. before .. " | After=" .. after)
		end
		_PotentialCubePopup:Open(equipName, before, after, autoConfirmed)
	end

end
