@Component
script CombatPowerManager extends Component

	@Sync
	property number STR = 0

	@Sync
	property number DEX = 0

	@Sync
	property number INT = 0

	@Sync
	property number LUK = 0

	@Sync
	property number MainAttack = 0

	@Sync
	property number BaseStatPct = 0

	@Sync
	property number BaseAttackPct = 0

	@Sync
	property number ExtraDamage = 0

	@Sync
	property number ExtraBossDamage = 0

	@Sync
	property number CriticalDamage = 1.35

	@Sync
	property number CombatPower = 0

	@Sync
	property SyncTable<string, number> CurrentExtra

	-- 레벨: 타일 도착 시 (Stage,Tier)로 동적 설정. 기본 Lv.10. LevelStat = 레벨 환산 주스탯 base(표시용).
	@Sync
	property integer Level = 10

	@Sync
	property number LevelStat = 0

	@Sync
	property string MainStatType = ""

	@Sync
	property string MainAttackType = ""

	@Sync
	property number HuntStatGain = 5

	@Sync
	property number HuntPlusStatGain = 15

	@Sync
	property number TaxStatLoss = 5

	@ExecSpace("ServerOnly")
	method void SetJob(string job)
		-- 직업에 맞는 주스탯/공마 '타입'을 기록한다. (수치 값은 건드리지 않음)
		self.MainStatType   = _JobDataSetManager:GetMainStatType(job)
		self.MainAttackType = _JobDataSetManager:GetMainAttackType(job)
		log("CombatPowerManager: 직업=" .. job
			.. " 주스탯타입=" .. self.MainStatType
			.. " 공마타입=" .. self.MainAttackType)
	end

	method number LevelMainStat()
		-- 현재 레벨의 주스탯 base 환산값(전투력 문서: 4+5n / Lv.100 초과 18+5n).
		if self.Level <= 100 then return 4 + 5 * self.Level end
		return 18 + 5 * self.Level
	end

	@ExecSpace("ServerOnly")
	method void SetLevel(integer level)
		-- 레벨 설정 → 주스탯 base 환산 갱신 + 전투력 재계산. (역행 클램프 없음)
		self.Level = level
		self:CalculateCurrentCombatPower()
		log("CombatPowerManager: 레벨=" .. tostring(level) .. " → 주스탯base=" .. tostring(self:LevelMainStat()))
	end

	method number DisplayStat(string name)
		-- 패널 표시용 스탯: 주스탯이면 base+레벨환산, 부스탯이면 base.
		local v = self:GetStat(name)
		if name == self:MainStatField() then v = v + self:LevelMainStat() end
		return v
	end

	@ExecSpace("ServerOnly")
	method void ResetAll()
		self.STR = 0
		self.DEX = 0
		self.INT = 0
		self.LUK = 0
		self.MainAttack = 0
		self.BaseStatPct = 0
		self.BaseAttackPct = 0
		self.ExtraDamage = 0
		self.ExtraBossDamage = 0
		self.CriticalDamage = 1.35
		self.MainStatType = ""
		self.MainAttackType = ""
		self.Level = 10
		self:CalculateCurrentCombatPower()
		log("CombatPowerManager: 전투력 base 초기화")
	end

	@ExecSpace("ServerOnly")
	method void AddMainStat(string kind, number value)
		-- 주스탯: flat → 직업 주스탯 필드(STR/DEX/INT/LUK 중 하나, 0 미만 방지), percent → BaseStatPct.
		if kind == "percent" then
			self.BaseStatPct = self.BaseStatPct + value
		else
			local field = self:MainStatField()
			self:AddToStat(field, value)
		end
		self:CalculateCurrentCombatPower()
		log("CombatPowerManager: 주스탯(" .. self:MainStatField() .. ") " .. kind .. " " .. tostring(value)
			.. " → 값=" .. tostring(self:GetStat(self:MainStatField()))
			.. " StatPct=" .. tostring(self.BaseStatPct)
			.. " 전투력=" .. tostring(self.CombatPower))
	end

	@ExecSpace("ServerOnly")
	method void AddMainAttack(string kind, number value)
		-- 공/마: flat → MainAttack(0 미만 방지), percent → BaseAttackPct.
		if kind == "percent" then
			self.BaseAttackPct = self.BaseAttackPct + value
		else
			self.MainAttack = self.MainAttack + value
			if self.MainAttack < 0 then
				self.MainAttack = 0
			end
		end
		self:CalculateCurrentCombatPower()
		log("CombatPowerManager: 공마 " .. kind .. " " .. tostring(value)
			.. " → MainAttack=" .. tostring(self.MainAttack)
			.. " AttackPct=" .. tostring(self.BaseAttackPct)
			.. " 전투력=" .. tostring(self.CombatPower))
	end

	@ExecSpace("ServerOnly")
	method void AddDamage(number value)
		-- 대미지% 증감.
		self.ExtraDamage = self.ExtraDamage + value
		self:CalculateCurrentCombatPower()
		log("CombatPowerManager: 대미지% " .. tostring(value) .. " → ExtraDamage=" .. tostring(self.ExtraDamage))
	end

	@ExecSpace("ServerOnly")
	method void AddBossDamage(number value)
		-- 보스 대미지%(전투력엔 합산, 표시는 분리).
		self.ExtraBossDamage = self.ExtraBossDamage + value
		self:CalculateCurrentCombatPower()
		log("CombatPowerManager: 보스대미지% " .. tostring(value) .. " → " .. tostring(self.ExtraBossDamage))
	end

	@ExecSpace("ServerOnly")
	method void AddCritical(number value)
		-- 크리티컬 대미지 증감. value는 %포인트(예: 10 → 배율 +0.10).
		self.CriticalDamage = self.CriticalDamage + value / 100
		self:CalculateCurrentCombatPower()
		log("CombatPowerManager: 크리% " .. tostring(value) .. " → CriticalDamage=" .. tostring(self.CriticalDamage))
	end

	@ExecSpace("ServerOnly")
	method void ReduceMainStat(number amount)
		self:AddMainStat("flat", -amount)
	end

	@ExecSpace("ServerOnly")
	method void HuntStat()
		-- 사냥 칸: 주스탯 소폭 증가.
		self:AddMainStat("flat", self.HuntStatGain)
	end

	@ExecSpace("ServerOnly")
	method void HuntPlusStat()
		-- 사냥+ 칸: 주스탯 중폭 증가.
		self:AddMainStat("flat", self.HuntPlusStatGain)
	end

	@ExecSpace("ServerOnly")
	method void TaxStat()
		-- 세금 칸: 주스탯 감소.
		self:AddMainStat("flat", -self.TaxStatLoss)
	end

	method string MainStatField()
		-- 직업 주스탯 타입이 STR/DEX/INT/LUK 중 하나면 그것, 아니면(미설정/미지원) 기본 STR.
		local t = self.MainStatType
		if t == "STR" or t == "DEX" or t == "INT" or t == "LUK" then
			return t
		end
		return "STR"
	end

	method number GetStat(string name)
		-- 이름으로 스탯 값을 읽는다.
		if name == "STR" then return self.STR
		elseif name == "DEX" then return self.DEX
		elseif name == "INT" then return self.INT
		elseif name == "LUK" then return self.LUK end
		return 0
	end

	method void AddToStat(string name, number value)
		-- 이름으로 스탯에 value를 더한다(0 미만 방지).
		local v = self:GetStat(name) + value
		if v < 0 then v = 0 end
		if name == "STR" then self.STR = v
		elseif name == "DEX" then self.DEX = v
		elseif name == "INT" then self.INT = v
		elseif name == "LUK" then self.LUK = v end
	end

	method number CalculateCurrentMainStat(table extra)
		-- 메이플식: 유효스탯 = 주스탯_적용 + (부스탯 3개 합)_적용 / 4
		--   주스탯_적용     = (주스탯값 + 주가산 + 올스탯가산) * (1 + (base% + 주스탯% + 올스탯%) / 100)
		--   부스탯합_적용   = (부스탯합 + 3×올스탯가산) * (1 + 올스탯% / 100)   ← 부스탯엔 주스탯%는 미적용
		-- ※ 올스탯(allStat)은 4스탯 모두에, 주스탯(stat)은 주스탯 1개에만 적용된다.
		local allFlat = extra.allStatFlat or 0
		local allPct  = extra.allStatPct or 0
		
		local mainBase = self:GetStat(self:MainStatField())
		local subVal   = (self.STR + self.DEX + self.INT + self.LUK) - mainBase  -- 부스탯 3개 합(레벨 미포함)
		local mainVal  = mainBase + self:LevelMainStat()                          -- 주스탯 base + 레벨 환산
		
		local mainPct     = self.BaseStatPct + extra.statPct + allPct
		local mainApplied = (mainVal + extra.statFlat + allFlat) * (1 + mainPct / 100)
		local subApplied  = (subVal + 3 * allFlat) * (1 + allPct / 100)
		
		local effective = mainApplied + subApplied / 4
		return effective * 4.5 / 100
	end

	method number CalculateCurrentMainAttack(table extra)
		-- 공/마 = 기본공마 * (1 + (base% + 버프%)) + 가산공마. 무기 미장착 등으로 0 이하면 최소 1(디폴트).
		local pct = self.BaseAttackPct + extra.attackPct
		local atk = self.MainAttack * (1 + pct / 100) + extra.attackFlat
		if atk < 1 then atk = 1 end
		return atk
	end

	method number CalculateCurrentExtraDamage(table extra)
		-- 대미지 곱셈자 = 1 + (일반+보스+버프/장비 일반·보스)%. 전투력 합산, 표시만 분리.
		local total = self.ExtraDamage + self.ExtraBossDamage + extra.damagePct + (extra.bossDamagePct or 0)
		return 1 + total / 100
	end

	method number CalculateCurrentCriticalDamage(table extra)
		-- 크리티컬 대미지 = base 크리 + 크리 버프%
		return self.CriticalDamage + (extra.critPct or 0) / 100
	end

	method number CalculateCurrentCombatPower()
		-- 최종 전투력 = 스탯 * 공/마 * 대미지 * 크리티컬 대미지
		-- extra(버프+장비)는 같은 플레이어의 ExtraTableManager에서 가져온다.
		local extra
		local ext = self.Entity:GetComponent("script.ExtraTableManager")
		if isvalid(ext) then
			extra = ext:GetExtra()
		else
			extra = { statFlat = 0, statPct = 0, allStatFlat = 0, allStatPct = 0, attackFlat = 0, attackPct = 0, damagePct = 0, critPct = 0 }
		end
		
		local stat   = self:CalculateCurrentMainStat(extra)
		local attack = self:CalculateCurrentMainAttack(extra)
		local damage = self:CalculateCurrentExtraDamage(extra)
		local crit   = self:CalculateCurrentCriticalDamage(extra)
		
		self.CombatPower = stat * attack * damage * crit
		if self:IsServer() then
			self.LevelStat = self:LevelMainStat()
			self.CurrentExtra["statFlat"]      = extra.statFlat or 0
			self.CurrentExtra["statPct"]       = extra.statPct or 0
			self.CurrentExtra["allStatFlat"]   = extra.allStatFlat or 0
			self.CurrentExtra["allStatPct"]    = extra.allStatPct or 0
			self.CurrentExtra["attackFlat"]    = extra.attackFlat or 0
			self.CurrentExtra["attackPct"]     = extra.attackPct or 0
			self.CurrentExtra["damagePct"]     = extra.damagePct or 0
			self.CurrentExtra["bossDamagePct"] = extra.bossDamagePct or 0
			self.CurrentExtra["critPct"]       = extra.critPct or 0
		end
		return self.CombatPower
	end

	method table BuildExtraTable()
		-- CurrentExtra(SyncTable) → plain table.
		return {
			statFlat      = self.CurrentExtra["statFlat"] or 0,
			statPct       = self.CurrentExtra["statPct"] or 0,
			allStatFlat   = self.CurrentExtra["allStatFlat"] or 0,
			allStatPct    = self.CurrentExtra["allStatPct"] or 0,
			attackFlat    = self.CurrentExtra["attackFlat"] or 0,
			attackPct     = self.CurrentExtra["attackPct"] or 0,
			damagePct     = self.CurrentExtra["damagePct"] or 0,
			bossDamagePct = self.CurrentExtra["bossDamagePct"] or 0,
			critPct       = self.CurrentExtra["critPct"] or 0,
		}
	end

	method number PreviewPowerWithSwap(string candidate)
		-- 후보를 해당 타입 슬롯에 끼웠을 때 전투력(상태변경 없음). 서버/클라 공용.
		local cur    = self:BuildExtraTable()
		local curEq  = _EquipmentRouter:TotalModifiers(self.Entity)
		local swapEq = _EquipmentRouter:ModifiersWithSwap(self.Entity, candidate)
		local pe = {
			statFlat      = cur.statFlat - curEq.statFlat + swapEq.statFlat,
			statPct       = cur.statPct - curEq.statPct + swapEq.statPct,
			allStatFlat   = cur.allStatFlat,
			allStatPct    = cur.allStatPct,
			attackFlat    = cur.attackFlat - curEq.attackFlat + swapEq.attackFlat,
			attackPct     = cur.attackPct - curEq.attackPct + swapEq.attackPct,
			damagePct     = cur.damagePct - curEq.damagePct + swapEq.damagePct,
			bossDamagePct = cur.bossDamagePct - curEq.bossDamagePct + swapEq.bossDamagePct,
			critPct       = cur.critPct,
		}
		return self:CalculateCurrentMainStat(pe) * self:CalculateCurrentMainAttack(pe)
			* self:CalculateCurrentExtraDamage(pe) * self:CalculateCurrentCriticalDamage(pe)
	end

	method number DisplayMainAttack()
		-- 표시용 현재 공/마.
		return self:CalculateCurrentMainAttack(self:BuildExtraTable())
	end

	method number DisplayDamagePct()
		-- 표시용 일반 대미지%.
		return self.ExtraDamage + (self.CurrentExtra["damagePct"] or 0)
	end

	method number DisplayBossDamagePct()
		-- 표시용 보스 대미지%.
		return self.ExtraBossDamage + (self.CurrentExtra["bossDamagePct"] or 0)
	end

	method number ItemStandalonePower(table m)
		-- 단독 전투력 환산값(정렬용, 결정적, 장착상태 무관). 곱셈구조 근사.
		local dmg = 1 + ((m.damagePct or 0) + (m.bossDamagePct or 0)) / 100
		local stat = (1 + (m.statFlat or 0)) * (1 + (m.statPct or 0) / 100)
		local atk = (1 + (m.attackFlat or 0)) * (1 + (m.attackPct or 0) / 100)
		return stat * atk * dmg
	end

end