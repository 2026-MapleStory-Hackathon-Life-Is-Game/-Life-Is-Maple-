@Logic
script PlayerStatInit extends Logic

	property any userEnterHandler = nil

	@Sync
	property boolean debugGrantTestItems = false

	method void OnBeginPlay()
		if self:IsServer() then
			self.userEnterHandler = _UserService:ConnectEvent(UserEnterEvent, self.OnUserEnter)
		end
	end

	method void OnEndPlay()
		if self.userEnterHandler ~= nil then
			_UserService:DisconnectEvent(UserEnterEvent, self.userEnterHandler)
			self.userEnterHandler = nil
		end
	end

	@ExecSpace("ServerOnly")
	method void OnUserEnter(UserEnterEvent event)
		-- 입장한 플레이어 엔티티에 전투 컴포넌트를 부착한다(중복 방지).
		local p = _UserService:GetUserEntityByUserId(event.UserId)
		if isvalid(p) == false then
-- 			log_error("[PlayerStatInit] 플레이어 엔티티 없음: " .. tostring(event.UserId))
			return
		end
		self:AddIfMissing(p, "script.BuffManager")
		self:AddIfMissing(p, "script.GuildManager")
		self:AddIfMissing(p, "script.RomanceManager")
		self:AddIfMissing(p, "script.LifePathManager")
		self:AddIfMissing(p, "script.WeaponEquipment")
		self:AddIfMissing(p, "script.ArmorEquipment")
		self:AddIfMissing(p, "script.AccessoryEquipment")
		self:AddIfMissing(p, "script.ExtraTableManager")
		self:AddIfMissing(p, "script.CombatPowerManager")
		self:AddIfMissing(p, "script.CubeInventory")
		self:AddIfMissing(p, "script.DiceCardInventory")   -- 주사위 고정 카드(낮은/높은) 보유
		self:AddIfMissing(p, "script.RunStatsManager")   -- 엔딩 정리용 런 기록(턴/시간/타일방문)
-- 		log("[PlayerStatInit] 전투 컴포넌트 부착 완료: " .. event.UserId)
		
		-- [임시/디버그] 입장 시 기본 지급(토글 기본 ON). 이후 인게임 DebugGrantItemsButton이 즉시 지급/회수한다.
		if self.debugGrantTestItems then
			self:GrantTestItems(p)
		else
			-- 빈 장비 기준 전투력 초기 계산.
			local cp = p:GetComponent("script.CombatPowerManager")
			if isvalid(cp) then cp:CalculateCurrentCombatPower() end
		end
	end

	@ExecSpace("Server")
	method void SetTestItems(boolean on)
		-- [디버그] 인게임 토글 버튼 콜백. 요청 플레이어에게 더미 아이템을 즉시 지급/회수한다.
		local p = _UserService:GetUserEntityByUserId(senderUserId)
		if isvalid(p) == false then
-- 			log_warning("[PlayerStatInit] SetTestItems: 플레이어 엔티티 없음: " .. tostring(senderUserId))
			return
		end
		if on then
			self:GrantTestItems(p)
		else
			self:RevokeTestItems(p)
		end
	end

	@ExecSpace("ServerOnly")
	method void GrantTestItems(Entity p)
		-- [임시/디버그] 구현된 모든 장비(EquipmentData 전체 행) + 미라클 큐브 999개를 지급. 재호출 안전(큐브는 999로 고정).
		local ds = _DataService:GetTable("EquipmentData")
		local count = 0
		if isvalid(ds) then
			for i = 1, ds:GetRowCount() do
				local equipName = ds:GetCell(i, "EquipName")
				if equipName ~= "" then
					_EquipmentRouter:Acquire(p, equipName)
					count += 1
				end
			end
		end
-- 		log("[PlayerStatInit] (디버그) 전체 장비 지급: " .. tostring(count) .. "개")
		
		-- 잠재 재설정 테스트용 미라클 큐브: 중복 지급 방지로 0으로 되돌린 뒤 999개.
		local bag = p:GetComponent("script.CubeInventory")
		if isvalid(bag) then
			bag:ResetAll()
			bag:AddMiracleCube(999)
		end

		-- 주사위 고정 카드 테스트용: 낮은/높은 각 5장(중복 지급 방지로 0으로 되돌린 뒤 지급).
		local dcards = p:GetComponent("script.DiceCardInventory")
		if isvalid(dcards) then
			dcards:ResetAll()
			dcards:Add("low", 5)
			dcards:Add("high", 5)
		end

		local cp = p:GetComponent("script.CombatPowerManager")
		if isvalid(cp) then cp:CalculateCurrentCombatPower() end
	end

	@ExecSpace("ServerOnly")
	method void RevokeTestItems(Entity p)
		-- [디버그] 지급된 더미 아이템 회수: 3종 장비(슬롯/보유/잠재) + 미라클 큐브를 모두 비운다.
		local cats = { "script.WeaponEquipment", "script.ArmorEquipment", "script.AccessoryEquipment" }
		for _, c in ipairs(cats) do
			local eq = p:GetComponent(c)
			if isvalid(eq) then eq:ResetAll() end
		end
		local bag = p:GetComponent("script.CubeInventory")
		if isvalid(bag) then bag:ResetAll() end
		local dcards = p:GetComponent("script.DiceCardInventory")
		if isvalid(dcards) then dcards:ResetAll() end
-- 		log("[PlayerStatInit] (디버그) 더미 아이템 회수 완료")
		
		local cp = p:GetComponent("script.CombatPowerManager")
		if isvalid(cp) then cp:CalculateCurrentCombatPower() end
	end

	@ExecSpace("ServerOnly")
	method void AddIfMissing(Entity e, string comp)
		-- 컴포넌트가 없을 때만 추가한다.
		if e:GetComponent(comp) == nil then
			e:AddComponent(comp)
		end
	end

end