@Component
script BaseEquipment extends Component

	@TargetUserSync
	property string Equipped = ""

	@TargetUserSync
	property string EquippedId = ""

	@Sync
	property SyncTable<string, string> Owned

	@Sync
	property SyncTable<string, string> PotentialById

	@Sync
	property SyncTable<string, integer> StarById

	@Sync
	property integer InstanceSeq = 0

	method string EquipCategory()
		-- 서브클래스가 override("Weapon"/"Armor"/"Accessory"). base는 미지정.
		return ""
	end

	method void ApplyEquipVisual()
		-- 장착 상태(self.Equipped)가 바뀐 뒤 아바타 비주얼을 갱신하는 훅. 기본은 no-op.
		-- WeaponEquipment만 override하여 무기 아바타를 CostumeManager 무기 슬롯에 반영한다.
	end

	method string NewInstanceId()
		-- 이 컴포넌트 내에서 유일한 인스턴스 ID 발급(카테고리 접두 + 증가 시퀀스).
		-- 서버 보유/장착 변경 경로에서만 호출된다(모두 @Sync 프로퍼티를 쓰므로 서버측 실행 전제).
		self.InstanceSeq = self.InstanceSeq + 1
		return self:EquipCategory() .. "#" .. tostring(self.InstanceSeq)
	end

	method integer FindRow(string equipName)
		-- EquipData에서 equipName 행 인덱스(없으면 -1).
		local ds = _DataService:GetTable("EquipmentData")
		if isvalid(ds) == false then return -1 end
		for i = 1, ds:GetRowCount() do
			if ds:GetCell(i, "EquipName") == equipName then return i end
		end
		return -1
	end

	method boolean Accepts(string equipName)
		-- equipName이 이 컴포넌트 타입에 속하는지(CSV Category).
		if equipName == "" then return false end
		local row = self:FindRow(equipName)
		if row == -1 then return false end
		return _DataService:GetTable("EquipmentData"):GetCell(row, "Category") == self:EquipCategory()
	end

	method string NameOfInstance(string instanceId)
		-- 인스턴스 ID → equipName(장착품/보유품 모두). 없으면 "".
		if instanceId == "" then return "" end
		if instanceId == self.EquippedId then return self.Equipped end
		local n = self.Owned[instanceId]
		if n == nil then return "" end
		return n
	end

	method boolean OwnsInstance(string instanceId)
		-- 이 컴포넌트가 해당 인스턴스를 보유(장착 포함)하는지.
		if instanceId == "" then return false end
		if instanceId == self.EquippedId then return true end
		return self.Owned[instanceId] ~= nil
	end

	method table ItemModifiers(string equipName)
		-- equipName 1개의 '기본(CSV)' 수치 modifier(없으면 0). 잠재 제외.
		local m = { statFlat = 0, statPct = 0, attackFlat = 0, attackPct = 0, damagePct = 0, bossDamagePct = 0, allStatFlat = 0, allStatPct = 0 }
		if equipName == "" then return m end
		local row = self:FindRow(equipName)
		if row == -1 then return m end
		local ds = _DataService:GetTable("EquipmentData")
		m.statFlat = tonumber(ds:GetCell(row, "MainStat_Flat")) or 0
		m.statPct = tonumber(ds:GetCell(row, "MainStat_Percent")) or 0
		m.attackFlat = tonumber(ds:GetCell(row, "MainAttack_Flat")) or 0
		m.attackPct = tonumber(ds:GetCell(row, "MainAttack_Percent")) or 0
		m.damagePct = tonumber(ds:GetCell(row, "Damage_Percent")) or 0
		m.bossDamagePct = tonumber(ds:GetCell(row, "BossDamage_Percent")) or 0
		return m
	end

	method string GetInstancePotential(string instanceId)
		-- 인스턴스의 잠재 직렬화 문자열("" = 없음).
		local p = self.PotentialById[instanceId]
		if p == nil then return "" end
		return p
	end

	@ExecSpace("ServerOnly")
	method void SetInstancePotential(string instanceId, string potStr)
		-- 인스턴스 잠재 설정/갱신(큐브 결과 적용). potStr=""이면 제거.
		if instanceId == "" then return end
		if potStr == nil or potStr == "" then
			self.PotentialById[instanceId] = nil
		else
			self.PotentialById[instanceId] = potStr
		end
	end

	method table FullModifiersFor(string equipName, string potStr)
		-- 기본(CSV) + 지정 잠재 합산 modifier.
		local m = self:ItemModifiers(equipName)
		local pot = _PotentialManager:ModifiersOf(potStr)
		m.statFlat = m.statFlat + pot.statFlat
		m.statPct = m.statPct + pot.statPct
		m.attackFlat = m.attackFlat + pot.attackFlat
		m.attackPct = m.attackPct + pot.attackPct
		m.damagePct = m.damagePct + pot.damagePct
		m.bossDamagePct = m.bossDamagePct + pot.bossDamagePct
		m.allStatFlat = (m.allStatFlat or 0) + pot.allStatFlat
		m.allStatPct = (m.allStatPct or 0) + pot.allStatPct
		return m
	end

	method table EquippedModifiers()
		-- 현재 장착품의 modifier(기본 + 장착 인스턴스 잠재 + 스타포스 강화).
		local m = self:FullModifiersFor(self.Equipped, self:GetInstancePotential(self.EquippedId))
		local star = self:StarModifiers(self.EquippedId)
		m.statFlat = m.statFlat + star.statFlat
		m.statPct = m.statPct + star.statPct
		m.attackFlat = m.attackFlat + star.attackFlat
		m.attackPct = m.attackPct + star.attackPct
		return m
	end

	method table ModifiersWith(string candidate, string candidatePot)
		-- 이 슬롯에 candidate(+잠재)를 끼웠을 때(미리보기). candidate가 이 타입 아니면 현재 장착값.
		if self:Accepts(candidate) then return self:FullModifiersFor(candidate, candidatePot) end
		return self:EquippedModifiers()
	end

	method string Acquire(string equipName)
		-- 보유함에 새 인스턴스로 추가(미장착). 타입 불일치면 무시하고 "" 반환. 반환값=발급된 인스턴스 ID.
		-- 중복 보유(같은 EquipName)면 새 인스턴스 대신 기존 인스턴스를 스타포스 강화한다(손해 방지).
		if self:Accepts(equipName) == false then
			log_warning("BaseEquipment.Acquire: " .. equipName .. " not " .. self:EquipCategory())
			return ""
		end
		local dupId = self:FindInstanceByName(equipName)
		if dupId ~= "" then
			self:AddStar(dupId, 1)
			log(self:EquipCategory() .. "Eq: [중복→★강화] " .. equipName .. " (" .. dupId .. ") star=" .. tostring(self:GetStar(dupId)))
			return dupId
		end
		local id = self:NewInstanceId()
		self.Owned[id] = equipName
		log(self:EquipCategory() .. "Eq: [보유+] " .. equipName .. " (" .. id .. ")")
		return id
	end

	method string FindInstanceByName(string equipName)
		-- 같은 EquipName의 기존 인스턴스 ID(장착 우선, 없으면 보유 첫 번째). 없으면 "".
		if equipName == "" then return "" end
		if self.EquippedId ~= "" and self.Equipped == equipName then return self.EquippedId end
		for id, nm in pairs(self.Owned) do
			if nm == equipName then return id end
		end
		return ""
	end

	@ExecSpace("ServerOnly")
	method void AddStar(string instanceId, integer n)
		-- 인스턴스 스타포스 강화(중복 장비 흡수). 강화 후 전투력 재계산.
		if instanceId == "" or n == nil or n <= 0 then return end
		local cur = self.StarById[instanceId]
		if cur == nil then cur = 0 end
		self.StarById[instanceId] = cur + n
		self:Recalc()
	end

	method integer GetStar(string instanceId)
		-- 인스턴스의 스타포스 강화 수치(없으면 0).
		if instanceId == "" then return 0 end
		local s = self.StarById[instanceId]
		if s == nil then return 0 end
		return s
	end

	method table StarModifiers(string instanceId)
		-- 스타포스 수치 보정(더미: 별 1개당 주스탯 +5%, 공격/마력 +5%). 기본/잠재와 별개로 합산.
		local m = { statFlat = 0, statPct = 0, attackFlat = 0, attackPct = 0, damagePct = 0, bossDamagePct = 0, allStatFlat = 0, allStatPct = 0 }
		local star = self:GetStar(instanceId)
		if star <= 0 then return m end
		m.statPct = star * 5
		m.attackPct = star * 5
		return m
	end

	@ExecSpace("Server")
	method void RequestEquip(string instanceId)
		-- 보유 인스턴스를 슬롯에 장착(기존 장착품은 보유로 복귀). 인스턴스 소유 검증.
		local name = self.Owned[instanceId]
		if name == nil then return end   -- 보유(미장착) 인스턴스가 아니면 차단
		if self:Accepts(name) == false then return end
		-- 기존 장착품을 보유함으로 되돌린다(그 잠재는 PotentialById[EquippedId]에 그대로 남아 따라간다).
		if self.EquippedId ~= "" then
			self.Owned[self.EquippedId] = self.Equipped
		end
		self.Equipped = name
		self.EquippedId = instanceId
		self.Owned[instanceId] = nil   -- 장착 인스턴스는 보유함에서 제거(잠재는 PotentialById에 유지)
		log(self:EquipCategory() .. "Eq: 장착 " .. name .. " (" .. instanceId .. ")")
		self:Recalc()
		self:ApplyEquipVisual()
	end

	@ExecSpace("Server")
	method void RequestUnequip()
		-- 슬롯→보유, 슬롯 비움.
		if self.EquippedId == "" then return end
		self.Owned[self.EquippedId] = self.Equipped
		log(self:EquipCategory() .. "Eq: 해제 " .. self.Equipped .. " (" .. self.EquippedId .. ")")
		self.Equipped = ""
		self.EquippedId = ""
		self:Recalc()
		self:ApplyEquipVisual()
	end

	method table OwnedInstancesSorted()
		-- 보유(미장착) 인스턴스 {id, name} 배열을 단독 전투력(기본+잠재) 내림차순으로.
		local cp = self.Entity:GetComponent("script.CombatPowerManager")
		local arr = {}
		for id, name in pairs(self.Owned) do
			table.insert(arr, { id = id, name = name })
		end
		local function powerOf(rec)
			if isvalid(cp) then return cp:ItemStandalonePower(self:FullModifiersFor(rec.name, self:GetInstancePotential(rec.id))) end
			return 0
		end
		table.sort(arr, function(a, b) return powerOf(a) > powerOf(b) end)
		return arr
	end

	method void Recalc()
		-- 같은 플레이어 CombatPowerManager 재계산.
		local cp = self.Entity:GetComponent("script.CombatPowerManager")
		if isvalid(cp) then cp:CalculateCurrentCombatPower() end
	end

	@ExecSpace("ServerOnly")
	method void ResetAll()
		-- 슬롯/보유/잠재/시퀀스 비움(게임 종료 초기화). 인스턴스별 잠재도 함께 제거해야 다음 판에 누적되지 않는다.
		-- ⚠ SyncTable에는 :Clear()가 없다(런타임 nil 호출 → 예외). 키를 모아 하나씩 nil로 비운다.
		self.Equipped = ""
		self.EquippedId = ""
		self:ClearSyncTable(self.Owned)
		self:ClearSyncTable(self.PotentialById)
		self:ClearSyncTable(self.StarById)
		self.InstanceSeq = 0
		self:Recalc()
	end

	method void ClearSyncTable(any st)
		-- SyncTable(딕셔너리형)를 비운다: 키를 먼저 수집한 뒤(순회 중 변형 방지) 각 키를 nil 대입.
		if st == nil then return end
		local keys = {}
		for k in pairs(st) do table.insert(keys, k) end
		for _, k in ipairs(keys) do st[k] = nil end
	end

end