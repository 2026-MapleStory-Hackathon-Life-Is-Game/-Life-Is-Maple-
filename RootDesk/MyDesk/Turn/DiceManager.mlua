@Logic
script DiceManager extends Logic

	@Sync
	property integer _dice1 = 0

	@Sync
	property integer _dice2 = 0

	@Sync
	property integer _total = 0

	-- 서버 전용: userId → 다음 이동 주사위에 강제 적용할 고정 합계(1~12). 아이템(주사위 고정 카드)이 예약.
	property any _forced = nil

	-- 서버 전용: userId → 그 고정값이 어떤 카드("low"/"high")에서 왔는지. 굴림 시 해당 카드 1개 소비용(카드 외 예약이면 "").
	property any _forcedCard = nil

	property string one_SFX = "5a0366d5cd2c40d0af999380772e9658"

	property string two_SFX = "bfd2e465bd1642fca3ebc675803c07bb"

	property string three_SFX = "8dea906403d945dba263ec03e4c04052"

	property string four_SFX = "d17ce220ee504ac49380d56ea70321ef"

	property string five_SFX = "f348aeca940f435d8312c4efe0a7a5c2"

	property string six_SFX = "f7ca1a848f9f4d00af731ff58989d39d"

	property string seven_SFX = "1aeced3b1ae648568397fe74b5cc0988"

	property string eight_SFX = "e98fb316b68a4cf0b0933009736ac446"

	property string nine_SFX = "1b9337776d92414f9d34b3795af38ee0"

	property string ten_SFX = "4f734032f9ee4a60b2bf14f4392661ef"

	property string eleven_SFX = "7a701eb3ee254187b50752d69d64385a"

	property string twelve_SFX = "919a0108f61e419d842a54566bb39b7b"

	@ExecSpace("Server")
	method integer Roll(string rollerUserId)
		        -- rollerUserId에 고정값이 예약돼 있으면 그 값으로 확정(1회 소비), 없으면 1~6 두 개 랜덤.
		        if self._forced == nil then self._forced = {} end
		        if self._forcedCard == nil then self._forcedCard = {} end
		        local forced = nil
		        local forcedCard = ""
		        if rollerUserId ~= nil and rollerUserId ~= "" then
		            forced = self._forced[rollerUserId]
		            forcedCard = self._forcedCard[rollerUserId] or ""
		        end

		        local d1 = 0
		        local d2 = 0
		        local total = 0
		        if forced ~= nil then
		            self._forced[rollerUserId] = nil       -- 1회성 소비(다음 굴림엔 영향 없음)
		            self._forcedCard[rollerUserId] = nil
		            -- 카드로 고정된 굴림이면 이 시점(실제 굴림)에 카드 1개를 인벤에서 소비한다.
		            if forcedCard ~= "" then
		                _ItemDiceCardManager:ConsumeCardOnRoll(rollerUserId, forcedCard)
		            end
		            total = forced
		            if total <= 1 then
		                -- 두 주사위로는 1을 만들 수 없어 (1,0)으로 표기. 이동은 total=1로 정상.
		                d1 = 1
		                d2 = 0
		            else
		                local lo = math.max(1, total - 6)
		                local hi = math.min(6, total - 1)
		                d1 = _UtilLogic:RandomIntegerRange(lo, hi)
		                d2 = total - d1
		            end
		        else
		            d1 = _UtilLogic:RandomIntegerRange(1, 6)
		            d2 = _UtilLogic:RandomIntegerRange(1, 6)
		            total = d1 + d2
		        end

				-- 주사위 던진 결과를 출력함
				_TimerService:SetTimerOnce(function()
				    self:PlayTotalDiceSFX(total)
				end, 2.0)

		        self._dice1 = d1
		        self._dice2 = d2
		        self._total = total

-- 		        log("[DiceManager] 주사위: " .. tostring(d1) .. " + " .. tostring(d2) .. " = " .. tostring(total))
		        return total
	end

	@ExecSpace("ServerOnly")
	method void SetForcedTotal(string userId, integer total, string cardKey)
		        -- 지정 유저의 '다음 이동 주사위' 결과를 total(1~12)로 고정 예약. 아이템 효과 진입점.
		        -- cardKey: 이 예약이 어떤 카드에서 왔는지("low"/"high"). 카드 외 예약이면 "" 전달 → 굴림 시 카드 소비 안 함.
		        if self._forced == nil then self._forced = {} end
		        if self._forcedCard == nil then self._forcedCard = {} end
		        if userId == nil or userId == "" then return end
		        local t = total
		        if t < 1 then t = 1 end
		        if t > 12 then t = 12 end
		        self._forced[userId] = t
		        self._forcedCard[userId] = cardKey or ""
	end

	@ExecSpace("ServerOnly")
	method void ClearForced(string userId)
		        -- 예약된 고정값 취소(카드 마커도 함께 제거 → 소비되지 않음).
		        if userId == nil or userId == "" then return end
		        if self._forced ~= nil then self._forced[userId] = nil end
		        if self._forcedCard ~= nil then self._forcedCard[userId] = nil end
	end

	@ExecSpace("ServerOnly")
	method integer PeekForced(string userId)
		        -- 예약된 고정값 조회(없으면 0). 디버그/검증용.
		        if self._forced == nil then return 0 end
		        if userId == nil or userId == "" then return 0 end
		        local v = self._forced[userId]
		        if v == nil then return 0 end
		        return v
	end

	@ExecSpace("Client")
	method void PlayTotalDiceSFX(number total)
		local ruid = ""

		if total == 1 then ruid = self.one_SFX
		elseif total == 2 then ruid = self.two_SFX
		elseif total == 3 then ruid = self.three_SFX
		elseif total == 4 then ruid = self.four_SFX
		elseif total == 5 then ruid = self.five_SFX
		elseif total == 6 then ruid = self.six_SFX
		elseif total == 7 then ruid = self.seven_SFX
		elseif total == 8 then ruid = self.eight_SFX
		elseif total == 9 then ruid = self.nine_SFX
		elseif total == 10 then ruid = self.ten_SFX
		elseif total == 11 then ruid = self.eleven_SFX
		elseif total == 12 then ruid = self.twelve_SFX
		end

		-- 등록된 효과음이 없는 값(예: 고정 아이템의 1)은 소리 없이 넘어감(빈 RUID → LEA-3007 방지).
		if ruid == nil or ruid == "" then return end
		--total 값에 따른 효과음 출력
		_SoundService:PlaySound(ruid, _SFXManager.volume)
		
	end

end