@Logic
script ResultDiceManager extends Logic

	property string two_SFX = "bfd2e465bd1642fca3ebc675803c07bb"

	property string three_SFX = "8dea906403d945dba263ec03e4c04052"

	property string four_SFX = "d17ce220ee504ac49380d56ea70321ef"

	property string five_SFX = "f348aeca940f435d8312c4efe0a7a5c2"

	property string six_SFX = "f7ca1a848f9f4d00af731ff58989d39d"

	property string seven_SFX = "1aeced3b1ae648568397fe74b5cc0988"

	property string eight_SFX = "e98fb316b68a4cf0b0933009736ac446"

	property string nine_SFX = "1b9337776d92414f9d34b3795af38ee0"

	property string ten_SFX = "4f734032f9ee4a60b2bf14f4392661ef"

	property string eleven_SFX = "7a701eb3ee254187b50752d69d64385a"

	property string twelve_SFX = "919a0108f61e419d842a54566bb39b7b"

	-- 동일 전투력(전투력 우위 0)일 때의 기준 확률(%). 합이 100이 되도록 성공은 (100-실패-대성공)으로 자동 산출.
	-- ⚠ 밸런스 잠정값 — 기획 확정 시 인스펙터에서 조정 가능.
	@Sync
	property number BaseFailPct = 40

	@Sync
	property number BaseGreatPct = 20

	@Sync
	property integer _dice1 = 0

	@Sync
	property integer _dice2 = 0

	@Sync
	property integer _total = 0

	@Sync
	property string GameOutcome = ""

	property table _currentResultTable = {}

	@ExecSpace("Server")
	method integer Roll()
		-- 1. 테이블 갱신
				self:CalculateRulletResult(3500, 2000)
				
				-- 2. 주사위 결과 뽑기
				local d1 = _UtilLogic:RandomIntegerRange(1, 6)
				local d2 = _UtilLogic:RandomIntegerRange(1, 6)
				local total = d1 + d2
		
				_TimerService:SetTimerOnce(function()
				    self:PlayTotalResultDiceSFX(total)
				end, 2.0)
				
				-- 3. 최종 결과 판정
				local finalVal = self._currentResultTable[total]
				if finalVal == 2 then self.GameOutcome = "대성공"
				elseif finalVal == 1 then self.GameOutcome = "성공"
				else self.GameOutcome = "실패" end
		
				-- 4. 프로퍼티에 일일이 저장
				self._dice1 = d1
				self._dice2 = d2
				self._total = total
		
				log("[ResultDiceManager] 주사위: " .. tostring(d1) .. " + " .. tostring(d2) .. " = " .. tostring(total) .. " (" .. self.GameOutcome .. ")")
				
				-- 기존 방식대로 total 1개만 리턴
				return total
	end

	@ExecSpace("Server")
	method void CalculateRulletResult(number playerCombatPower, number targetCombatPower)
		-- 기획서(주사위 확률)대로 결과 테이블을 만든다.
		-- ① 전투력으로 실패/성공/대성공 목표 확률(%) 산출(전투력 우위↑ → 대성공↑/실패↓)
		-- ② 10% 단위로 반올림하고 합계 100%로 보정
		-- ③ 주사위합 2~12를 누적 참고확률 기준으로 실패→성공→대성공 순서로 배치
		-- (기존 '12 = 무조건 대성공' 규칙은 폐기)
		local pct = self:DeriveOutcomePercents(playerCombatPower, targetCombatPower)
		pct = self:NormalizePercents(pct)
		self._currentResultTable = self:PlaceOutcomes(pct.fail, pct.success, pct.great)

		log("[ResultDiceManager] 목표확률 실패=" .. tostring(pct.fail) .. "% 성공=" .. tostring(pct.success) .. "% 대성공=" .. tostring(pct.great) .. "%")
	end

	method table DeriveOutcomePercents(number playerCombatPower, number targetCombatPower)
		-- 전투력 우위(shift)에 따라 대성공↑/실패↓. 동일 전투력이면 Base 값을 사용.
		-- shift = (내전투력 - 상대전투력) / 상대전투력, [-1, 1]로 클램프.
		local denom = targetCombatPower
		if denom <= 0 then denom = 1 end
		local shift = (playerCombatPower - targetCombatPower) / denom
		if shift > 1 then shift = 1 elseif shift < -1 then shift = -1 end

		local great = self.BaseGreatPct
		local fail = self.BaseFailPct
		if shift >= 0 then
			-- 유리: 대성공 +최대 30%p, 실패 -최대 30%p
			great = self.BaseGreatPct + 30 * shift
			fail = self.BaseFailPct - 30 * shift
		else
			-- 불리: 대성공 -최대 15%p, 실패 +최대 30%p
			great = self.BaseGreatPct + 15 * shift
			fail = self.BaseFailPct - 30 * shift
		end
		if great < 0 then great = 0 end
		if fail < 0 then fail = 0 end
		if great + fail > 100 then great = 100 - fail end
		local success = 100 - great - fail
		if success < 0 then success = 0 end
		return { fail = fail, success = success, great = great }
	end

	method integer RoundTo10(number x)
		-- 10% 단위 반올림.
		return math.floor(x / 10 + 0.5) * 10
	end

	method table NormalizePercents(table p)
		-- 기획서 반올림 규칙: 각 항목 10% 단위 반올림 후 합계 100% 보정.
		--  - 100% 미만: 부족분을 대성공 → 성공 → 실패 순으로 10%씩 추가
		--  - 100% 초과: 가장 큰 비율 항목에서 10%씩 차감
		local fail = self:RoundTo10(p.fail)
		local success = self:RoundTo10(p.success)
		local great = self:RoundTo10(p.great)

		-- 부족분: 대성공 → 성공 → 실패 순으로 10%씩 추가.
		local guard = 0
		while fail + success + great < 100 and guard < 20 do
			great += 10
			if fail + success + great >= 100 then break end
			success += 10
			if fail + success + great >= 100 then break end
			fail += 10
			guard += 1
		end
		-- 초과분: 가장 큰 항목에서 10%씩 차감.
		guard = 0
		while fail + success + great > 100 and guard < 20 do
			-- 가장 큰 항목에서 10% 차감
			if great >= success and great >= fail then
				great -= 10
			elseif success >= fail then
				success -= 10
			else
				fail -= 10
			end
			guard += 1
		end
		return { fail = fail, success = success, great = great }
	end

	method table PlaceOutcomes(number failPct, number successPct, number greatPct)
		-- 주사위 두 개 합(2~12)의 '누적 참고확률'을 10% 단위로 반올림한 값.
		-- (2d6 누적분포: 2=2.8% 3=8.3% 4=16.7% 5=27.8% 6=41.7% 7=58.3% 8=72.2% 9=83.3% 10=91.7% 11=97.2% 12=100%)
		local cumRef = {}
		cumRef[2] = 0;  cumRef[3] = 10; cumRef[4] = 20; cumRef[5] = 30
		cumRef[6] = 40; cumRef[7] = 60; cumRef[8] = 70; cumRef[9] = 80
		cumRef[10] = 90; cumRef[11] = 100; cumRef[12] = 100

		local failThr = failPct
		local successThr = failPct + successPct

		-- 결과코드: 실패=0, 성공=1, 대성공=2
		local res = {}
		for n = 2, 12 do
			local c = cumRef[n]
			if failPct > 0 and c <= failThr then
				res[n] = 0
			elseif c <= successThr then
				res[n] = 1
			else
				res[n] = 2
			end
		end
		return res
	end

	@ExecSpace("Client")
	method void PlayTotalResultDiceSFX(number total)
		local ruid = ""
		
		if total == 2 then ruid = self.two_SFX
		elseif total == 3 then ruid = self.three_SFX
		elseif total == 4 then ruid = self.four_SFX
		elseif total == 5 then ruid = self.five_SFX
		elseif total == 6 then ruid = self.six_SFX
		elseif total == 7 then ruid = self.seven_SFX
		elseif total == 8 then ruid = self.eight_SFX
		elseif total == 9 then ruid = self.nine_SFX
		elseif total == 10 then ruid = self.ten_SFX
		elseif total == 11 then ruid = self.eleven_SFX
		elseif total == 12 then ruid = self.twelve_SFX
		end
		
		--total 값에 따른 효과음 출력
		_SoundService:PlaySound(ruid, _SFXManager.volume)
		
	end

	@ExecSpace("Server")
	method table GetResultTable()
		return self._currentResultTable
	end

	method table LookupBossPercents(string bossKey, string difficulty, number playerCombatPower)
		-- BossProbability에서 (보스, 난이도) 행을 찾아 현재 전투력 기준 밴드의 확률(%)을 돌려준다.
		-- bossKey는 CSV의 BossName(영문) 또는 BossNameKR(한글) 어느 쪽이든 매칭. 못 찾으면 Base 확률로 폴백.
		local fallback = { fail = self.BaseFailPct, success = 100 - self.BaseFailPct - self.BaseGreatPct, great = self.BaseGreatPct }
		local ds = _DataService:GetTable("BossProbability")
		if isvalid(ds) == false then
			log_warning("[ResultDiceManager] BossProbability 데이터셋 없음 → 기본확률 폴백")
			return fallback
		end
		local diff = string.lower(difficulty)
		for i = 1, ds:GetRowCount() do
			local nameEn = ds:GetCell(i, "BossName")
			local nameKr = ds:GetCell(i, "BossNameKR")
			if (nameEn == bossKey or nameKr == bossKey) and string.lower(ds:GetCell(i, "Difficulty")) == diff then
				local required = tonumber(ds:GetCell(i, "RequiredPower")) or 0
				local prefix = "Below"
				if playerCombatPower >= required then prefix = "Above" end
				return {
					fail = tonumber(ds:GetCell(i, prefix .. "Fail")) or 0,
					success = tonumber(ds:GetCell(i, prefix .. "Success")) or 0,
					great = tonumber(ds:GetCell(i, prefix .. "Great")) or 0,
				}
			end
		end
		log_warning("[ResultDiceManager] BossProbability 행 없음: " .. tostring(bossKey) .. "/" .. tostring(difficulty) .. " → 기본확률 폴백")
		return fallback
	end

	@ExecSpace("Server")
	method integer RollByBossTable(string bossKey, string difficulty, number playerCombatPower)
		-- 보스 표(BossProbability) 기반 판정. 폐기된 전투력 비례식(CalculateRulletResult/하드코딩 3500·2000) 대신,
		-- 현재 전투력을 적정전투력(RequiredPower)과 비교해 미만/이상 밴드의 실패:성공:대성공 확률을 그대로 쓴다.
		-- 그 외 흐름(2d6/효과음/프로퍼티 저장/리턴)은 Roll()과 동일. BossTile 등은 Roll() 대신 이걸 호출하면 된다.
		local pct = self:LookupBossPercents(bossKey, difficulty, playerCombatPower)
		self._currentResultTable = self:PlaceOutcomes(pct.fail, pct.success, pct.great)
		log("[ResultDiceManager] 보스표 확률 실패=" .. tostring(pct.fail) .. "% 성공=" .. tostring(pct.success) .. "% 대성공=" .. tostring(pct.great) .. "% (CP=" .. tostring(playerCombatPower) .. ")")

		local d1 = _UtilLogic:RandomIntegerRange(1, 6)
		local d2 = _UtilLogic:RandomIntegerRange(1, 6)
		local total = d1 + d2
		_TimerService:SetTimerOnce(function()
			self:PlayTotalResultDiceSFX(total)
		end, 2.0)

		local finalVal = self._currentResultTable[total]
		if finalVal == 2 then self.GameOutcome = "대성공"
		elseif finalVal == 1 then self.GameOutcome = "성공"
		else self.GameOutcome = "실패" end

		self._dice1 = d1
		self._dice2 = d2
		self._total = total

		log("[ResultDiceManager] 보스 주사위: " .. tostring(d1) .. " + " .. tostring(d2) .. " = " .. tostring(total) .. " (" .. self.GameOutcome .. ")")
		return total
	end

end