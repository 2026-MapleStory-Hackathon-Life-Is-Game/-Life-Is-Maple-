@Logic
script SingleTurnManager extends Logic

	@Sync
	property string _currentState = "IDLE"

	@Sync
	property boolean _isActive = false

	@Sync
	property integer remainDiceTotal = 0

	@Sync
	property boolean _isRolling = false

	property any _turnButtonHandler = nil

	-- 직전 도착 타일이 사냥(이벤트) 타일이면 true → 결과 주사위(RESULT_DICE)를 건너뛴다. (서버 전용 상태)
	property boolean _skipResultDice = false

	method void OnEndPlay()
		        -- 클라이언트: 턴 버튼 이벤트 핸들러 해제
		        if self:IsClient() then
		            local btn = _EntityService:GetEntityByPath("/ui/DefaultGroup/UnderButton")
		            if isvalid(btn) and self._turnButtonHandler ~= nil then
		                btn:DisconnectEvent(ButtonClickEvent, self._turnButtonHandler)
		                self._turnButtonHandler = nil
		            end
		        end
	end

	@ExecSpace("Server")
	method void Start()
		        self._isActive = true
		        self._currentState = "IDLE"
		        log("[SingleTurnManager] 게임 시작")
		        self:AdvanceState()
	end

	@ExecSpace("Server")
	method void Stop()
		        self._isActive = false
		        self._currentState = "IDLE"
		        self._isRolling = false
		        log("[SingleTurnManager] 턴 강제 종료")
	end

	@ExecSpace("Server")
	method string GetNextState()
		        if self._currentState == "IDLE" then return "TURN_START"
		        elseif self._currentState == "TURN_START" then return "DICE"
		        elseif self._currentState == "DICE" then return "MOVE"
		        elseif self._currentState == "MOVE" then return "TILE"
		        elseif self._currentState == "TILE" then return "RESULT_DICE"
		        elseif self._currentState == "RESULT_DICE" then return "TURN_END"
		        elseif self._currentState == "TURN_END" then return "TURN_START"
		        end
		        return "IDLE"
	end

	@ExecSpace("Server")
	method void AdvanceState()
		        if not self._isActive then return end
		        local nextState = self:GetNextState()
		        self._currentState = nextState
		        log("[SingleTurnManager] 상태 전환 → " .. nextState)
		        self:ExecuteCurrentState()
	end

	@ExecSpace("Server")
	method void ExecuteCurrentState()
		        local s = self._currentState
		        if s == "TURN_START" then self:OnTurnStart()
		        elseif s == "DICE" then self:OnDice()
		        elseif s == "MOVE" then self:OnMove()
		        elseif s == "TILE" then self:OnTileGated()
				elseif s == "RESULT_DICE" then self:OnResultDice()
		        elseif s == "TURN_END" then self:OnTurnEnd()
		        end
	end

	@ExecSpace("Server")
	method void OnTurnStart()
		        log("[SingleTurnManager] 턴 시작")
		        -- 턴 시작 시 플레이어의 데이트 버프 잔여 턴을 1 줄인다(3턴 후 소멸).
		        for _, userEntity in pairs(_UserService.UserEntities) do
		            local rm = userEntity:GetComponent("script.RomanceManager")
		            if isvalid(rm) then rm:OnTurnPassed() end
		            break   -- 싱글이라 플레이어는 한 명
		        end
		        self:AdvanceState()
	end

	@ExecSpace("Server")
	method void OnDice()
		        log("[SingleTurnManager] 주사위 단계 - 입력 대기 중")
	end

	@ExecSpace("Server")
	method void OnMove()
		        log("[SingleTurnManager] 이동 단계, 주사위=" .. tostring(self.remainDiceTotal))
		        self:CloseMapViewOnClient()
		        for _, userEntity in pairs(_UserService.UserEntities) do
		            if userEntity.PlayerMovement ~= nil then
		                userEntity.PlayerMovement:MoveSteps(self.remainDiceTotal)
		            end
		            break   -- 싱글이라 플레이어는 한 명
		        end
	end

	@ExecSpace("Client")
	method void CloseMapViewOnClient()
		_MapViewManager:CloseMapView()
	end

	@ExecSpace("Server")
	method void RequestRollDice()
		if not self._isActive then return end
		        if self._currentState ~= "DICE" then return end
		        -- 이미 굴리는 중이면(연출 재생 중) 무시 — 연출 중 재굴림 방지
		        if self._isRolling then
		            log("[SingleTurnManager] 이미 주사위를 굴리는 중입니다. 요청 무시")
		            return
		        end
		        self._isRolling = true
		
		        local total = _DiceManager:Roll()
		        self.remainDiceTotal = total
		        -- 개별 눈은 DiceManager의 @Sync 프로퍼티에서 읽음
		
		        self:PlayDiceAnimation(_DiceManager._dice1, _DiceManager._dice2, total)
		        -- ※ 여기서 AdvanceState 안 함! 연출 끝난 뒤 OnDiceAnimationEnd에서 진행
				
				-- 주사위 던진 결과를 출력함
						_TimerService:SetTimerOnce(function()
						    self:PlayTotalDiceSFX(total)
						end, 2.0)
	end

	@ExecSpace("Client")
	method void PlayDiceAnimation(integer d1, integer d2, integer total)
		_RollDiceAnimationUI:Show(d1, d2, total, function()
		            -- 연출 끝 → 서버에 이동 진행 요청
		            self:OnDiceAnimationEnd()
		        end)
	end

	@ExecSpace("Client")
	method void PlayTotalDiceSFX(number total)
		_DiceManager:PlayTotalDiceSFX(total)
	end

	@ExecSpace("Server")
	method void OnDiceAnimationEnd()
		if self._currentState ~= "DICE" then return end
		        self._isRolling = false   -- 연출 종료 → 굴림 잠금 해제
		        self:AdvanceState()   -- DICE → MOVE (OnMove가 이동 시작)
	end

	@ExecSpace("Server")
	method void OnMoveComplete()
		        if not self._isActive then return end
		        if self._currentState ~= "MOVE" then return end
		        log("[SingleTurnManager] 이동 완료 수신 → TILE 진행")
		        self:AdvanceState()
	end

	@ExecSpace("Server")
	method void OnTileGated()
	        -- 타일 단계(TILE) 진입점. 도착 타일로 레벨이 오르면 타일 이벤트(OnTile)가 발동하기 '전에'
	        -- 먼저 레벨업 축하 배너를 띄우고, 배너가 닫힌 뒤 OnTile을 실행한다. 레벨업이 없으면 즉시 OnTile.
	        -- (레벨은 배너와 동시에 선적용 → 이후 OnTile→TriggerArrive의 ApplyTileLevel은 단조 증가 가드로 통과.)
	        for _, userEntity in pairs(_UserService.UserEntities) do
	            if userEntity.PlayerMovement ~= nil then
	                local mapName  = userEntity.CurrentMapName
	                local tileName = userEntity.PlayerMovement.currentTile
	                local peek = _TileManager:PeekArrival(mapName, tileName, userEntity)
	                if peek.up then
	                    _TileManager:ApplyArrivalLevel(mapName, tileName, userEntity)
	                    _LevelUpCelebration:Gate(userEntity, true, peek.level, function()
	                        self:OnTile()
	                    end)
	                    return
	                end
	            end
	            break
	        end
	        self:OnTile()
	end

	@ExecSpace("Server")
	method void OnTile()
		        -- 도착한 타일의 OnArrive 호출 (싱글: 플레이어 한 명).
		        -- 이벤트 타일이면 TileEventUI 표시 시간만큼 기다린 뒤 진행한다.
		        -- 단, 사냥(이벤트) 타일이면 결과 주사위(RESULT_DICE)를 건너뛰고 바로 턴 종료로 간다.
		        local startedEvent = false
		        self._skipResultDice = false
		        local interactive = false
		        for _, userEntity in pairs(_UserService.UserEntities) do
					if userEntity.PlayerMovement ~= nil then
						local mapName  = userEntity.CurrentMapName
						local tileName = userEntity.PlayerMovement.currentTile
						startedEvent = _TileManager:TriggerArrive(mapName, tileName, userEntity)
						-- 사냥(이벤트) 타일이면 이후 결과 주사위를 생략한다.
						self._skipResultDice = _TileManager:IsEventArrive(mapName, tileName, userEntity)
						-- 마을 등 인터랙티브 타일이면 5초 대기 대신 완료 신호를 기다린다.
						interactive = _TileManager:IsInteractiveArrive(mapName, tileName, userEntity)
					end
					break
				end

				if startedEvent and interactive then
					-- 인터랙티브 타일(예: 마을): 타일이 _GameModeManager:NotifyTileEventDone()으로
					-- OnTileEventComplete를 호출할 때까지 대기(고정 타이머 없음).
					log("[SingleTurnManager] 인터랙티브 타일 도착 — 완료 신호 대기 (결과주사위 생략=" .. tostring(self._skipResultDice) .. ")")
				elseif startedEvent then
					-- 패널 표시 타일: TileEventUI를 표시 시간만큼 보여준 뒤 OnTileEventComplete에서 다음 단계로.
					-- (보상 스탯은 OnArrive에서 이미 서버에 즉시 적용됨 — 여기서는 UI 표시 시간만 대기.)
					local waitSec = _EventTileUI.AutoHideSeconds
					if waitSec == nil or waitSec <= 0 then waitSec = 5.0 end
					log("[SingleTurnManager] 타일 도착 — " .. tostring(waitSec) .. "초 대기 (결과주사위 생략=" .. tostring(self._skipResultDice) .. ")")
					_TimerService:SetTimerOnce(function()
						self:OnTileEventComplete()
					end, waitSec)
				else
					-- 패널 없는 타일: 기존처럼 즉시 진행.
					self:AdvanceState()
				end
	end

	@ExecSpace("Server")
	method void OnTileEventComplete()
		        -- TileEventUI 표시가 끝난 뒤 호출.
		        --   사냥(이벤트) 타일 → 결과 주사위 생략, 바로 TURN_END.
		        --   그 외(테스트 패널 등) → 기존대로 RESULT_DICE 진행.
		        if not self._isActive then return end
		        if self._currentState ~= "TILE" then return end
		        if self._skipResultDice then
		            log("[SingleTurnManager] 사냥(이벤트) 타일 — 결과 주사위 생략 → 턴 종료")
		            self._currentState = "TURN_END"
		            self:ExecuteCurrentState()
		        else
		            log("[SingleTurnManager] 타일 이벤트 종료 → 결과 주사위 진행")
		            self:AdvanceState()
		        end
	end

	@ExecSpace("Server")
	method void RequestRollResultDice()
		if not self._isActive then return end
				if self._currentState ~= "RESULT_DICE" then return end
		
				-- 1. 주사위를 굴리고 total 값만 받음
				local total = _ResultDiceManager:Roll()
				self.remainDiceTotal = total
		
				-- 2. 매니저에서 필요한 변수들을 하나하나 일일이 가져옴 (기존 방식)
				local d1 = _ResultDiceManager._dice1
				local d2 = _ResultDiceManager._dice2
				local gameOutcome = _ResultDiceManager.GameOutcome
				local resultTable = _ResultDiceManager:GetResultTable()
		
				-- 3. 가져온 값들을 UI 연출 쪽으로 넘김
				self:PlayResultDiceAnimation(d1, d2, total, resultTable, gameOutcome)
				
	end

	@ExecSpace("Server")
	method void OnResultDice()
				log("[SingleTurnManager] 결과 주사위 단계 진입 -> 굴림 요청")
				self:RequestRollResultDice()
	end

	@ExecSpace("Client")
	method void PlayTotalResultDiceSFX(integer total)
		_ResultDiceManager:PlayTotalResultDiceSFX(total)
	end

	@ExecSpace("Client")
	method void PlayResultDiceAnimation(integer d1, integer d2, integer total, table resultTable, string gameOutcome)
		_RollResultDiceAnimationUI:Show(d1, d2, total, resultTable, gameOutcome, function()
					self:OnResultDiceAnimationEnd()
				end)
	end

	@ExecSpace("Server")
	method void OnResultDiceAnimationEnd()
		if self._currentState ~= "RESULT_DICE" then return end
		self:AdvanceState()   -- RESULT_DICE → TURN_END (OnMove가 이동 시작)
	end

	@ExecSpace("Server")
	method void OnTurnEnd()
		        log("[SingleTurnManager] 턴 종료 → 다음 턴 시작")
		        self:AdvanceState()
	end

	method void OnBeginPlay()
		--if self:IsServer() then
		--            -- 클라이언트 UI가 모두 로딩될 때까지 2초 대기 후 강제 실행
		--            _TimerService:SetTimerOnce(function()
		--                -- 게임이 시작되자마자 강제로 상태를 RESULT_DICE로 맞추고 주사위를 굴립니다.
		--                self._isActive = true
		--                self._currentState = "RESULT_DICE"
		--                
		--                log("[Test] RESULT_DICE 강제 테스트 시작!")
		--                self:RequestRollResultDice()
		--            end, 0.01)
		--        end
	end

end