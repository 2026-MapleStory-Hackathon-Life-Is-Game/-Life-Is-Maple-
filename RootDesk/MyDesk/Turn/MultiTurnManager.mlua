@Logic
script MultiTurnManager extends Logic

	@Sync
	property string _currentState = "IDLE"

	@Sync
	property boolean _isActive = false

	@Sync
	property integer _currentPlayerIndex = 0

	@Sync
	property string _currentPlayerUserId = ""

	@Sync
	property integer remainDiceTotal = 0

	@Sync
	property boolean _isRolling = false

	property any _playerUserIds = nil

	property integer _playerCount = 0

	property any _turnButtonHandler = nil

	property any _userLeaveHandler = nil

	property any _finishedUserIds = nil

	property integer _finishedCount = 0

	property string _currentMapName = "Map_01"

	property boolean _skipResultDice = false

	property boolean _isResultRolling = false

	@Sync
	property SyncTable<string, integer> _finishSync

	-- 턴 순서표(_playerUserIds)의 클라이언트 읽기용 @Sync 미러(좌측 '다른 참가자' 패널을 턴 순서로 정렬하려면 필요).
	-- 키=0-based 순번, 값=userId. _playerUserIds가 바뀔 때마다 SyncTurnOrder로 재구성한다.
	@Sync
	property SyncTable<integer, string> _orderSync

	-- 턴 입력 대기 감시(피드백 6): actor가 30초 안에 행동(주사위/타일/결과주사위)하지 않으면 자동 진행.
	property integer _turnTimerId = 0

	property number TurnTimeoutSeconds = 30.0

	property boolean _turnAutoFlagged = false   -- 이번 턴에 이미 AFK 스트라이크를 부여했는지(턴당 1회로 제한)

	property any _afkStrikes = nil              -- userId → 자동이동 누적 횟수

	property integer MaxAfkStrikes = 3          -- 자동이동 '3연속' 누적 시 강제 퇴장(정상 플레이 턴엔 리셋)

	property any _finisherTile = nil            -- 현재 완주자 대기 큐브 롤을 진행 중인 End 타일(AFK 자동 마무리용, 피드백 5)

	-- 현재 턴 actor의 남은 시간(HUD 중앙 상단 표시용). 대기 감시(StartTurnWatch)가 도는 동안만 유효.
	@Sync
	property integer _turnSecondsLeft = 0

	@Sync
	property boolean _turnTimerActive = false

	property integer _turnCountdownId = 0       -- 남은 시간 1초 감소 반복 타이머

	method void OnEndPlay()
		        -- 클라이언트: 턴 버튼 핸들러 해제 / 서버: 퇴장 이벤트 핸들러 해제
		        if self:IsClient() then
		            local btn = _EntityService:GetEntityByPath("/ui/DefaultGroup/UnderButton")
		            if isvalid(btn) and self._turnButtonHandler ~= nil then
		                btn:DisconnectEvent(ButtonClickEvent, self._turnButtonHandler)
		                self._turnButtonHandler = nil
		            end
		        else
		            if self._userLeaveHandler ~= nil then
		                _UserService:DisconnectEvent(UserLeaveEvent, self._userLeaveHandler)
		                self._userLeaveHandler = nil
		            end
		        end
	end

	@ExecSpace("Server")
	method void Start(table userIds)
		        -- 전달받은 매칭 목록을 그대로 0-based 순서표로 등록한다.
		        self._playerUserIds = {}
		        local count = 0
		        for _, userId in ipairs(userIds) do
		            self._playerUserIds[count] = userId
		            count += 1
		        end
		
		        if count == 0 then
-- 		            log_error("[MultiTurnManager] 등록된 플레이어가 없습니다.")
		            return
		        end
		
		        self._playerCount = count
		        self._isActive = true
		        self._currentPlayerIndex = 0
		        self._finishedUserIds = {}
		        self._finishedCount = 0
		        self._currentMapName = "Map_01"
		        self._userLeaveHandler = _UserService:ConnectEvent(UserLeaveEvent, self.OnUserLeave)
		
		        self:ClearFinishSync()
		self:SyncTurnOrder()   -- 턴 순서표를 클라이언트에 노출(다른 참가자 패널 정렬용)
-- 	        log("[MultiTurnManager] " .. tostring(self._playerCount) .. "명으로 멀티플레이 시작")
		        self:SetCurrentPlayer(0)
		        self:AdvanceToState("TURN_START")
	end

	@ExecSpace("Server")
	method void Stop()
		        self._isActive = false
		        self._currentState = "IDLE"
		        self._isRolling = false
		        self._currentPlayerUserId = ""
		        self._playerUserIds = nil
		        self._playerCount = 0
		        self._finishedUserIds = {}
		        self._finishedCount = 0
		        self._skipResultDice = false
		        self._isResultRolling = false
		        self:ClearTurnWatch()          -- 게임 종료 → 대기 감시 정리(피드백 6)
		        self._afkStrikes = {}
		        self._turnAutoFlagged = false
		        if self._userLeaveHandler ~= nil then
		            _UserService:DisconnectEvent(UserLeaveEvent, self._userLeaveHandler)
		            self._userLeaveHandler = nil
		        end
		        self:ClearFinishSync()
		self:ClearOrderSync()   -- 턴 순서 미러도 비운다
-- 	        log("[MultiTurnManager] 게임 종료")
	end

	@ExecSpace("Server")
	method void SetCurrentPlayer(integer idx)
		        self._currentPlayerIndex = idx
		        if self._playerUserIds ~= nil and self._playerUserIds[idx] ~= nil then
		            self._currentPlayerUserId = self._playerUserIds[idx]
-- 		            log("[MultiTurnManager] 현재 플레이어: 인덱스=" .. tostring(idx) .. " userId=" .. self._currentPlayerUserId)
		            self:RefreshActorBuffBar()   -- 턴 전환 → 새 actor의 버프바를 전원(관전자 포함)에 방송(관전 버프 따라가기)
		        else
-- 		            log_warning("[MultiTurnManager] 인덱스 " .. tostring(idx) .. "에 해당하는 플레이어 없음")
		        end
	end

	@ExecSpace("ServerOnly")
	method void RefreshActorBuffBar()
		        -- 현재 턴 actor의 버프바를 전원 클라이언트(관전자 포함)에 방송한다.
		        -- actor의 BuffManager.PushBuffUI가 멀티 활성 시 SetActorBuffs로 전원 방송하도록 되어 있어,
		        -- 여기서 한 번 호출해 주면 턴 시작 시점에 이미 걸려 있던 버프까지 관전자 화면에 즉시 반영된다.
		        if not self._isActive then return end
		        local actor = _UserService:GetUserEntityByUserId(self._currentPlayerUserId)
		        if isvalid(actor) == false then return end
		        local bm = actor:GetComponent("script.BuffManager")
		        if isvalid(bm) then bm:PushBuffUI() end
	end

	@ExecSpace("Server")
	method void OnUserLeave(UserLeaveEvent event)
		        -- 유저 이탈 = 인원 변동 → 순서를 처음부터 리셋한다(피드백 6). 실제 처리는 RemovePlayer로 일원화.
		        -- 자연 이탈(월드에서 나감)은 이미 사라진 유저라 로비 복귀가 필요 없다 → kicked=false.
		        if not self._isActive then return end
		        self:RemovePlayer(event.UserId, false)
	end

	@ExecSpace("Server")
	method void RemovePlayer(string userId, boolean kicked)
		        -- 플레이어를 순서표에서 제거한다(이탈/강퇴 공통 경로, 피드백 6).
		        -- kicked=true(AFK 3회 강제 퇴장)면 해당 플레이어를 로비로 되돌린다.
		        -- 제거 후 남은 인원이 1명 이하면 곧바로 게임 종료(남은 1명도 로비 복귀), 2명 이상이면 순서를 처음부터 리셋한다.
		        local removedIdx = -1
		        for i = 0, self._playerCount - 1 do
		            if self._playerUserIds[i] == userId then removedIdx = i break end
		        end
		        if removedIdx == -1 then return end

		        -- 진행 중이던 관전/이벤트 잔재를 정리(제거 대상이 actor였든 아니든 안전하게).
		        self:ClearTurnWatch()
		        _EventTileUI:SpectatorSceneHide(userId)          -- 관전 초상화/지역배경 마커 잔재 방지(피드백 1)
		        _BranchSelectUI:CloseForAll()                    -- 분기점/관전 알림 잔재 정리(피드백 13)
		        if self._currentState == "RESULT_DICE" then self:BroadcastClose() end

		        -- 강제 퇴장(AFK 3회)인 경우: 제거 대상 플레이어를 즉시 로비(스태틱 룸)로 되돌린다.
		        if kicked then _GameModeManager:KickUserToLobby(userId) end

		        -- 빈 슬롯을 앞으로 당겨 제거.
		        for i = removedIdx, self._playerCount - 2 do
		            self._playerUserIds[i] = self._playerUserIds[i + 1]
		        end
		        self._playerUserIds[self._playerCount - 1] = nil
		        self._playerCount -= 1
		        if self._afkStrikes ~= nil then self._afkStrikes[userId] = nil end
-- 		        log("[MultiTurnManager] 플레이어 제거: userId=" .. userId .. " (남은 인원: " .. tostring(self._playerCount) .. "명)")
		self:SyncTurnOrder()   -- 순서표 변경 → 클라이언트 미러 갱신(다른 참가자 패널 정렬)

		        -- 남은 인원 1명 이하 → 곧바로 게임 종료. 남은 1명에겐 즉시 로비 텔레포트 대신 '게임 오버' 패널을 띄운다(피드백 14).
		        -- (확인을 누르면 그때 로비로 복귀 — ResultUI.HidePanelToLobby → ReturnToLobbyAfterResult.)
		        if self._playerCount <= 1 then
		            if self._playerCount == 1 then
		                local lastUserId = self._playerUserIds[0]
-- 		                log("[MultiTurnManager] 1명만 남음 → 게임 종료, 남은 플레이어에게 게임 오버 패널: " .. tostring(lastUserId))
		                _ResultUI:ShowGameOver("상대방이 게임에서 나가\n게임이 종료되었습니다.", lastUserId)
		            else
-- 		                log("[MultiTurnManager] 남은 플레이어 없음 → 게임 종료")
		            end
		            _GameModeManager:EndGame()
		            return
		        end

		        -- 2명 이상 남음: 굴림/결과 잠금 해제 후 순서를 처음부터 리셋(강퇴된 actor를 제외한 나머지로 재정리).
		        self._isRolling = false
		        self._isResultRolling = false
		        self:ResetTurnOrderFromStart()
	end

	@ExecSpace("Server")
	method void ResetTurnOrderFromStart()
		        -- 0번부터 첫 '미완주' 플레이어를 찾아 그 플레이어의 턴을 새로 시작한다(피드백 6).
		        if not self._isActive then return end
		        for i = 0, self._playerCount - 1 do
		            if not self:IsFinished(self._playerUserIds[i]) then
-- 		                log("[MultiTurnManager] 인원 변동 → 순서 리셋: 인덱스 " .. tostring(i) .. "부터 재시작")
		                self:SetCurrentPlayer(i)
		                self:AdvanceToState("TURN_START")
		                return
		            end
		        end
		        -- 남은 전원이 이미 완주 상태 → 턴 종료 판정(다음 맵/게임 종료).
		        self._currentPlayerIndex = 0
		        self._currentState = "TURN_END"
		        self:OnTurnEnd()
	end

	@ExecSpace("Server")
	method string GetNextState()
		        if self._currentState == "IDLE" then return "TURN_START"
		        elseif self._currentState == "TURN_START" then return "DICE"
		        elseif self._currentState == "DICE" then return "MOVE"
		        elseif self._currentState == "MOVE" then return "TILE"
		        elseif self._currentState == "TILE" then return "RESULT_DICE"
		        elseif self._currentState == "RESULT_DICE" then return "TURN_END"
		        elseif self._currentState == "TURN_END" then return "TURN_START"
		        end
		        return "IDLE"
	end

	method string GetNextMapName(string mapName)
		        -- 다음 스테이지 맵 이름. 마지막(Map_03)이면 "" 반환.
		        if mapName == "Map_01" then return "Map_02"
		        elseif mapName == "Map_02" then return "Map_03" end
		        return ""
	end

	@ExecSpace("Server")
	method void AdvanceToState(string nextState)
		        self._currentState = nextState
-- 		        log("[MultiTurnManager] 상태 전환 → " .. nextState)
		        self:ExecuteCurrentState()
	end

	@ExecSpace("Server")
	method void ExecuteCurrentState()
		        local s = self._currentState
		        if s == "TURN_START" then self:OnTurnStart()
		        elseif s == "DICE" then self:OnDice()
		        elseif s == "MOVE" then self:OnMove()
		        elseif s == "TILE" then self:OnTile()
		        elseif s == "RESULT_DICE" then self:OnResultDice()
		        elseif s == "TURN_END" then self:OnTurnEnd()
		        end
	end

	@ExecSpace("Server")
	method void OnTurnStart()
-- 		        log("[MultiTurnManager] 턴 시작 (플레이어 " .. tostring(self._currentPlayerIndex) .. ")")
		        self._turnAutoFlagged = false   -- 새 턴 시작 → AFK 스트라이크 부여 플래그 리셋(피드백 6)
		        self:ClearTurnWatch()
		        -- 턴 시작 시 현재 턴 플레이어의 데이트 버프 잔여 턴을 1 줄인다(3턴 후 소멸).
		        for userId, userEntity in pairs(_UserService.UserEntities) do
		            if userId == self._currentPlayerUserId then
		                local rm = userEntity:GetComponent("script.RomanceManager")
		                if isvalid(rm) then rm:OnTurnPassed() end
		                break
		            end
		        end
		        -- 완주자(현재 맵 결승 도착)는 이동/일반 주사위 대신 미라클 큐브 결과주사위를 반복 굴린다(피드백 5).
		        if self:IsFinished(self._currentPlayerUserId) then
		            self:StartFinisherCubeRoll()
		            return
		        end
		        self:AdvanceToState("DICE")
	end

	@ExecSpace("Server")
	method void StartFinisherCubeRoll()
		        -- 완주자의 반복 큐브 롤: 그 플레이어가 서 있는 End 타일을 찾아 대기 큐브 롤을 시작한다.
		        -- 굴림/보상/연출은 EndTile이 담당하고, '다음'(또는 AFK)이면 OnWaitingCubeRollDone으로 턴을 진행한다.
		        local piece = nil
		        for userId, ue in pairs(_UserService.UserEntities) do
		            if userId == self._currentPlayerUserId then piece = ue break end
		        end
		        if isvalid(piece) == false or piece.PlayerMovement == nil then
		            self:AdvanceToState("TURN_END")
		            return
		        end
		        local mapName = piece.CurrentMapName
		        local tileName = piece.PlayerMovement.currentTile
		        local tileEnt = _TileManager:GetTileEntity(mapName, tileName)
		        if isvalid(tileEnt) == false then self:AdvanceToState("TURN_END") return end
		        ---@type EndTile
		        local endTile = tileEnt:GetComponent("script.EndTile")
		        if isvalid(endTile) == false then
		            -- 완주자인데 End 타일을 못 찾음(안전) → 그냥 턴 넘김.
		            self:AdvanceToState("TURN_END")
		            return
		        end
		        self._finisherTile = endTile
		        self._currentState = "FINISHER_CUBE"
-- 		        log("[MultiTurnManager] 완주자 대기 큐브 롤 시작 user=" .. self._currentPlayerUserId)
		        endTile:StartWaitingCubeRoll(piece)
		        self:StartTurnWatch()   -- 30초 내 '다음' 미입력 시 자동 마무리(피드백 6, 완주자는 스트라이크 제외)
	end

	@ExecSpace("Server")
	method void OnWaitingCubeRollDone()
		        -- 완주자 대기 큐브 롤 종료(actor '다음' 또는 AFK 자동 마무리) → 다음 턴으로 진행.
		        if not self._isActive then return end
		        self:ClearTurnWatch()
		        self._finisherTile = nil
		        if self._currentState ~= "FINISHER_CUBE" then return end
		        self:AdvanceToState("TURN_END")
	end

	@ExecSpace("Server")
	method void OnDice()
-- 		        log("[MultiTurnManager] 주사위 단계 - 플레이어 " .. tostring(self._currentPlayerIndex) .. " 입력 대기")
		        self:StartTurnWatch()   -- 주사위 입력 30초 대기 감시(초과 시 자동 굴림, 피드백 6)
	end

	@ExecSpace("Server")
	method void OnMove()
-- 		        log("[MultiTurnManager] 이동 단계 (플레이어 " .. tostring(self._currentPlayerIndex) .. "), 주사위=" .. tostring(self.remainDiceTotal))
		        for userId, userEntity in pairs(_UserService.UserEntities) do
		            if userId == self._currentPlayerUserId then
		                if userEntity.PlayerMovement ~= nil then
		                    userEntity.PlayerMovement:MoveSteps(self.remainDiceTotal)
		                end
		                break
		            end
		        end
	end

	@ExecSpace("Server")
	method void OnTile()
		-- 도착 칸에 다른 유저가 있으면 대결을 선행하고, 완료 후 칸 이벤트로 이어간다.
		-- 대결이 없거나 스킵 단계면 즉시 기존 칸 이벤트 흐름.
		local actorE = nil
		for userId, ue in pairs(_UserService.UserEntities) do
			if userId == self._currentPlayerUserId then actorE = ue break end
		end
		if isvalid(actorE) == false or actorE.PlayerMovement == nil then
			self:RunTileArrival() return
		end
		local mapName  = actorE.CurrentMapName
		local tileName = actorE.PlayerMovement.currentTile
		local stage    = _TileManager:GetTileStage(mapName, tileName)
		local N = 0
		if _DuelManager ~= nil then N = _DuelManager:StealAmountForStage(stage) end
		if N <= 0 then
			self:RunTileArrival() return   -- 이 단계는 대결 스킵
		end
		local occ = self:CollectOccupants(self._currentPlayerUserId, mapName, tileName)
		if #occ == 0 then
			self:RunTileArrival() return   -- 점유자 없음
		end
		-- 대결 선행 → 완료 시 OnDuelsComplete가 RunTileArrival을 호출.
		_DuelManager:RunDuels(self._currentPlayerUserId, occ, N)
	end

	method table CollectOccupants(string actorUserId, string mapName, string tileName)
		-- 같은 맵·같은 currentTile에 서 있는 다른 유저(본인/완주자 제외)를 '턴 순서'로 반환.
		-- 강탈량이 패자 잔량에 의존해 순서가 결과에 영향을 주므로, 턴 순서표(_playerUserIds, 0-based)를 그대로 따른다.
		local out = {}
		if self._playerUserIds == nil then return out end
		for i = 0, self._playerCount - 1 do
			local userId = self._playerUserIds[i]
			if userId ~= nil and userId ~= actorUserId then
				local ue = _UserService:GetUserEntityByUserId(userId)
				if isvalid(ue) and ue.PlayerMovement ~= nil
					and ue.CurrentMapName == mapName
					and ue.PlayerMovement.currentTile == tileName
					and self:IsFinished(userId) == false then
					table.insert(out, userId)
				end
			end
		end
		return out
	end

	@ExecSpace("Server")
	method void OnDuelsComplete()
		-- 대결 시퀀스 종료 → 그 칸의 원래 이벤트 진행. (상태가 아직 TILE일 때만)
		if not self._isActive then return end
		if self._currentState ~= "TILE" then return end
		self:RunTileArrival()
	end

	@ExecSpace("Server")
	method void RunTileArrival()
		-- (기존 OnTile 본문) 도착 타일 분류 + TriggerArrive + 대기/전이.
		local startedEvent = false
		local interactive = false
		self._skipResultDice = false
		for userId, userEntity in pairs(_UserService.UserEntities) do
			if userId == self._currentPlayerUserId then
				if userEntity.PlayerMovement ~= nil then
					local mapName = userEntity.CurrentMapName
					local tileName = userEntity.PlayerMovement.currentTile
					interactive = _TileManager:IsInteractiveArrive(mapName, tileName, userEntity)
					self._skipResultDice = _TileManager:IsEventArrive(mapName, tileName, userEntity)
					startedEvent = _TileManager:TriggerArrive(mapName, tileName, userEntity)
				end
				break
			end
		end

		if self._currentState ~= "TILE" then return end

		if startedEvent and interactive then
			self:StartTurnWatch()
		elseif startedEvent then
			local waitSec = _EventTileUI.AutoHideSeconds
			if waitSec == nil or waitSec <= 0 then waitSec = 5.0 end
			_TimerService:SetTimerOnce(function()
				self:OnTileEventComplete()
			end, waitSec)
		else
			self:AdvanceToState("RESULT_DICE")
		end
	end

	@ExecSpace("Server")
	method void OnTileEventComplete()
		        if not self._isActive then return end
		        if self._currentState ~= "TILE" then return end
		        self:ClearTurnWatch()   -- 타일 이벤트 완료 → 대기 감시 해제(피드백 6)
		        if self._skipResultDice then
-- 		            log("[MultiTurnManager] 이벤트 타일 — 결과 주사위 생략 → 턴 종료")
		            self:AdvanceToState("TURN_END")
		        else
-- 		            log("[MultiTurnManager] 타일 이벤트 종료 → 결과 주사위 진행")
		            self:AdvanceToState("RESULT_DICE")
		        end
	end

	@ExecSpace("Server")
	method void OnResultDice()
		        -- 결과 주사위 단계 진입. 서버가 즉시 굴림을 요청한다.
-- 		        log("[MultiTurnManager] 결과 주사위 단계 진입 → 굴림 요청")
		        self:RequestRollResultDice()
	end

	@ExecSpace("Server")
	method void RequestRollResultDice()
		        -- 서버에서 결과 주사위를 굴려 값을 계산하고 전원에게 보드를 방송한다.
		        if not self._isActive then return end
		        if self._currentState ~= "RESULT_DICE" then return end
		        local total = _ResultDiceManager:Roll()
		        self.remainDiceTotal = total
		        local d1 = _ResultDiceManager._dice1
		        local d2 = _ResultDiceManager._dice2
		        local gameOutcome = _ResultDiceManager.GameOutcome
		        local resultTable = _ResultDiceManager:GetResultTable()
		        self._isResultRolling = false
-- 		        log("[MultiTurnManager] 결과주사위 계산: " .. tostring(d1) .. "+" .. tostring(d2) .. "=" .. tostring(total) .. " (" .. gameOutcome .. ")")
		        self:PlayResultDiceBoard(d1, d2, total, resultTable, gameOutcome, self._currentPlayerUserId)
		        self:StartTurnWatch()   -- 결과주사위 공개/다음 입력 30초 대기 감시(초과 시 자동 마무리, 피드백 6)
	end

	@ExecSpace("Client")
	method void PlayResultDiceBoard(integer d1, integer d2, integer total, table resultTable, string gameOutcome, string actorUserId)
		        -- 전원 클라에 결과 보드 표시(ShowMulti). actor만 굴리기 버튼이 뜬다.
		        _RollResultDiceAnimationUI:ShowMulti(d1, d2, total, resultTable, gameOutcome, actorUserId)
	end

	@ExecSpace("Server")
	method void RequestRevealResultDice()
		        -- actor의 '굴리기' 요청을 검증한 뒤 전원에게 공개 연출을 방송한다.
		        if not self._isActive then return end
		        if self._currentState ~= "RESULT_DICE" then return end
		        if senderUserId ~= self._currentPlayerUserId then
-- 		            log_warning("[MultiTurnManager] 잘못된 결과주사위 공개 요청 발신자: " .. senderUserId)
		            return
		        end
		        if self._isResultRolling then return end
		        self._isResultRolling = true
-- 		        log("[MultiTurnManager] 결과주사위 공개 방송")
		        self:BroadcastReveal()
	end

	@ExecSpace("Client")
	method void BroadcastReveal()
		        -- 전원 클라에서 결과 주사위 공개 연출을 재생한다.
		        _RollResultDiceAnimationUI:RevealMulti()
	end

	@ExecSpace("Server")
	method void RequestFinishResultDice()
		        -- actor의 '다음' 요청을 검증한 뒤 전원 닫기 방송 + 턴을 진행한다.
		        if not self._isActive then return end
		        if self._currentState ~= "RESULT_DICE" then return end
		        if senderUserId ~= self._currentPlayerUserId then
-- 		            log_warning("[MultiTurnManager] 잘못된 결과주사위 종료 요청 발신자: " .. senderUserId)
		            return
		        end
		        self:ClearTurnWatch()   -- actor가 직접 마무리 → 대기 감시 해제(피드백 6)
		        self:BroadcastClose()
		        self._isResultRolling = false
		        self:OnResultDiceAnimationEnd()
	end

	@ExecSpace("Client")
	method void BroadcastClose()
		        -- 전원 클라에서 결과 주사위 패널을 닫는다.
		        _RollResultDiceAnimationUI:CloseMulti()
	end

	@ExecSpace("Server")
	method void OnResultDiceAnimationEnd()
		        -- 결과 주사위 종료 → 턴 종료 단계로 진행한다.
		        if not self._isActive then return end
		        if self._currentState ~= "RESULT_DICE" then return end
		        self:AdvanceToState("TURN_END")
	end

	@ExecSpace("Server")
	method void OnTurnEnd()
		        if not self._isActive then return end
		        -- '3연속' 판정: 방금 턴을 마친 actor가 이번 턴에 AFK 자동진행을 겪지 않았다면(정상 플레이) 누적 스트라이크를 리셋한다.
		        -- (여기서 _currentPlayerUserId는 아직 '방금 끝낸 actor' — 다음 플레이어 지정은 아래에서 이뤄진다.)
		        if self._turnAutoFlagged == false then
		            self:ResetAfkStrike(self._currentPlayerUserId)
		        end
		        -- 전원 완주(현재 맵 결승 도착) 판정 우선.
		        local anyUnfinished = false
		        for i = 0, self._playerCount - 1 do
		            if not self:IsFinished(self._playerUserIds[i]) then anyUnfinished = true break end
		        end
		        if anyUnfinished then
		            -- 미완주자가 남아 있음 → 다음 순번 플레이어에게 턴을 넘긴다.
		            -- 완주자도 스킵하지 않고 턴을 받되, OnTurnStart에서 이동 대신 미라클 큐브 롤을 반복한다(피드백 5).
		            -- (마지막 완주자는 완주하는 순간 전원 완주가 되어 여기서 바로 맵 이동 → 대기 롤을 받지 않음 = 피드백 6과 정합.)
		            local idx = (self._currentPlayerIndex + 1) % self._playerCount
-- 		            log("[MultiTurnManager] 턴 종료 → 다음 플레이어 인덱스=" .. tostring(idx))
		            self:SetCurrentPlayer(idx)
		            self:AdvanceToState("TURN_START")
		            return
		        end
		        -- 미완주 플레이어 없음 = 전원 현재 맵 완주.
		        local ids = {}
		        for i = 0, self._playerCount - 1 do
		            table.insert(ids, self._playerUserIds[i])
		        end
		        local nextMap = self:GetNextMapName(self._currentMapName)
		        if nextMap ~= "" then
-- 		            log("[MultiTurnManager] 전원 " .. self._currentMapName .. " 완주 → " .. nextMap .. " 이동")
		            self._currentState = "IDLE"
		            _GameModeManager:MoveMultiToNextMap(ids, nextMap)
		        else
-- 		            log("[MultiTurnManager] 전원 최종 완주 → 게임 종료")
		            _GameModeManager:FinishMulti(ids)
		        end
	end

	@ExecSpace("Server")
	method void ResumeOnMap(string mapName)
		        -- 도착 게이트 통과 후 다음 맵에서 턴 재개. per-map 완주셋을 비우고 0번 플레이어부터.
		        if not self._isActive then return end
		        self._currentMapName = mapName
		        self._finishedUserIds = {}
		        self._finishedCount = 0
		        self._skipResultDice = false
		        self._isResultRolling = false
		        self:ClearFinishSync()
-- 	        log("[MultiTurnManager] " .. mapName .. " 전원 도착 → 턴 재개")
		        self:SetCurrentPlayer(0)
		        self:AdvanceToState("TURN_START")
	end

	@ExecSpace("Server")
	method void MarkPlayerFinished(string userId)
		        if not self._isActive then return end
		        if self._finishedUserIds == nil then self._finishedUserIds = {} end
		        -- 이미 완주한 경우 순위 유지(중복 호출 방어).
		        if self._finishedUserIds[userId] == nil then
		            self._finishedCount += 1
		            self._finishedUserIds[userId] = self._finishedCount
			self._finishSync[userId] = self._finishedCount   -- 클라(다른 유저 패널 완주 뱃지)에서 읽도록 미러
-- 		            log("[MultiTurnManager] 완주: " .. userId .. " (" .. tostring(self._finishedCount) .. "위)")
		        end
	end

	method void ClearFinishSync()
		-- @Sync SyncTable엔 :Clear()가 없으므로 pairs+nil로 비운다(신규 판/맵 재개 시 이전 완주 뱃지 잔재 제거).
		for k, _ in pairs(self._finishSync) do
			self._finishSync[k] = nil
		end
	end

	method void SyncTurnOrder()
		-- 서버의 턴 순서표(_playerUserIds, 0-based)를 클라이언트가 읽는 @Sync 미러(_orderSync)로 복사한다.
		-- '다른 참가자' 패널이 현재 턴 플레이어 다음부터 턴 순서대로 나열할 때 사용한다.
		self:ClearOrderSync()
		if self._playerUserIds == nil then return end
		for i = 0, self._playerCount - 1 do
			if self._playerUserIds[i] ~= nil then
				self._orderSync[i] = self._playerUserIds[i]
			end
		end
	end

	method void ClearOrderSync()
		-- @Sync SyncTable엔 :Clear()가 없으므로 pairs+nil로 비운다.
		for k, _ in pairs(self._orderSync) do
			self._orderSync[k] = nil
		end
	end

	method boolean IsFinished(string userId)
		        if self._finishedUserIds == nil then return false end
		        return self._finishedUserIds[userId] ~= nil
	end

	method integer GetFinishRank(string userId)
		        if self._finishedUserIds == nil then return 999999 end
		        local r = self._finishedUserIds[userId]
		        if r == nil then return 999999 end
		        return r
	end

	@ExecSpace("Server")
	method void RequestRollDice()
		        if not self._isActive then return end
		        if self._currentState ~= "DICE" then
-- 		            log("[MultiTurnManager] 지금은 주사위 단계가 아님: " .. self._currentState)
		            return
		        end
		        if senderUserId ~= self._currentPlayerUserId then
-- 		            log_warning("[MultiTurnManager] 잘못된 주사위 요청 발신자: " .. senderUserId)
		            return
		        end
		        -- 이미 굴리는 중이면(연출 재생 중) 무시 — 연출 중 재굴림 방지
		        if self._isRolling then
-- 		            log("[MultiTurnManager] 이미 주사위를 굴리는 중입니다. 요청 무시")
		            return
		        end
		        self:ClearTurnWatch()   -- actor가 직접 굴림 → 대기 감시 해제(피드백 6)
		        self._isRolling = true
		
		        local total = _DiceManager:Roll(self._currentPlayerUserId)
		        self.remainDiceTotal = total
-- 		        log("[MultiTurnManager] 주사위 결과: " .. tostring(total))
		
		        self:PlayDiceAnimation(_DiceManager._dice1, _DiceManager._dice2, total)
		        -- ※ 여기서 MOVE로 넘기지 않음. 연출이 끝난 뒤 OnDiceAnimationEnd에서 진행.
	end

	@ExecSpace("Client")
	method void PlayDiceAnimation(integer d1, integer d2, integer total)
		        _RollDiceAnimationUI:Show(d1, d2, total, function()
		            self:OnDiceAnimationEnd()
		        end)
	end

	@ExecSpace("Server")
	method void OnDiceAnimationEnd()
		        if not self._isActive then return end
		        if self._currentState ~= "DICE" then return end
		        self._isRolling = false   -- 연출 종료 → 굴림 잠금 해제
		        self:AdvanceToState("MOVE")
	end

	@ExecSpace("Server")
	method void OnMoveComplete()
		        if not self._isActive then return end
		        if self._currentState ~= "MOVE" then return end
-- 		        log("[MultiTurnManager] 이동 완료 수신 → TILE 진행")
		        self:AdvanceToState("TILE")
	end

	@ExecSpace("ClientOnly")
	method void OnTurnButtonClicked(ButtonClickEvent event)
		        if not self._isActive then return end
		        local myUserId = _UserService.LocalPlayer.PlayerComponent.UserId
		        if myUserId ~= self._currentPlayerUserId then
-- 		            log("[MultiTurnManager] 내 턴이 아닙니다. (현재: " .. self._currentPlayerUserId .. ")")
		            return
		        end
		        self:RequestAdvanceTurn()
	end

	@ExecSpace("Server")
	method void RequestAdvanceTurn()
		        if not self._isActive then return end
		        if senderUserId ~= self._currentPlayerUserId then
-- 		            log_warning("[MultiTurnManager] 잘못된 턴 진행 요청 발신자: " .. senderUserId)
		            return
		        end
		        -- 완주자 큐브 롤(FINISHER_CUBE)은 상태머신 밖 흐름 → HUD 턴 버튼으로 진행시키지 않는다(큐브 롤 '다음'이 담당).
		        if self._currentState == "FINISHER_CUBE" then
-- 		            log("[MultiTurnManager] 완주자 큐브 롤 중 — 턴 진행 버튼 무시")
		            return
		        end
-- 		        log("[MultiTurnManager] 턴 진행 (플레이어 " .. tostring(self._currentPlayerIndex) .. ")")
		        self:AdvanceToState(self:GetNextState())
	end

	method void StartTurnWatch()
		        -- 현재 턴 actor의 '입력 대기' 감시 타이머 시작(30초). 상태/actor를 캡처해 그새 바뀌면 무시한다.
		        if not self._isActive then return end
		        self:ClearTurnWatch()
		        local watchedUser = self._currentPlayerUserId
		        local watchedState = self._currentState
		        self._turnTimerId = _TimerService:SetTimerOnce(function()
		            self:OnTurnTimeout(watchedUser, watchedState)
		        end, self.TurnTimeoutSeconds)
		        -- HUD 남은 시간 카운트다운(@Sync): 1초마다 감소. actor 클라만 UnderButton에서 표시한다.
		        self._turnSecondsLeft = math.floor(self.TurnTimeoutSeconds + 0.5)
		        self._turnTimerActive = true
		        self._turnCountdownId = _TimerService:SetTimerRepeat(function()
		            self:TickTurnCountdown()
		        end, 1.0)
	end

	method void TickTurnCountdown()
		        -- 남은 시간 1초 감소(표시 전용). 실제 타임아웃 처리는 _turnTimerId(SetTimerOnce)가 담당한다.
		        if self._turnSecondsLeft > 0 then
		            self._turnSecondsLeft -= 1
		        end
		        if self._turnSecondsLeft <= 0 and self._turnCountdownId ~= 0 then
		            _TimerService:ClearTimer(self._turnCountdownId)
		            self._turnCountdownId = 0
		        end
	end

	method void ClearTurnWatch()
		        -- 입력 대기 감시 타이머 해제(actor가 정상 행동했거나 상태가 넘어갈 때).
		        if self._turnTimerId ~= 0 then
		            _TimerService:ClearTimer(self._turnTimerId)
		            self._turnTimerId = 0
		        end
		        if self._turnCountdownId ~= 0 then
		            _TimerService:ClearTimer(self._turnCountdownId)
		            self._turnCountdownId = 0
		        end
		        self._turnTimerActive = false
		        self._turnSecondsLeft = 0
	end

	@ExecSpace("ServerOnly")
	method void NotifyTileInteraction()
		        -- 인터랙티브 타일에서 actor가 진행 입력(페이지 넘김/다음/선택)을 할 때마다 호출 → 30초 입력대기 감시를 재무장.
		        -- (정상 플레이 중인 actor가 여러 페이지를 천천히 읽어도 자동진행/AFK로 잘리지 않게. 트롤 방지 30초는 유지.)
		        if not self._isActive then return end
		        if self._currentState ~= "TILE" then return end
		        self:StartTurnWatch()
	end

	@ExecSpace("Multicast")
	method void ForceCloseTileUI()
		        -- AFK로 인터랙티브 타일이 강제 완료될 때, 열려 있던 이벤트/선택 UI를 전 클라(actor+관전자)에서 닫는다.
		        -- (기존엔 타일 finisher를 건너뛰어 UI가 잔류하고 actor의 늦은 클릭이 다음 턴에 씬을 주입할 수 있었다.)
		        _EventTileUI:ForceHideAllEventUI()
		        _RomanceGuildSelectUI:Hide()   -- actor/관전자가 같은 Group을 공유 → Hide 하나로 양쪽 닫힘.
	end

	@ExecSpace("Server")
	method void OnTurnTimeout(string watchedUser, string watchedState)
		        -- 입력 대기 30초 초과 → 자동 진행. actor/상태가 그새 바뀌었으면 오작동 방지로 무시.
		        if not self._isActive then return end
		        self._turnTimerId = 0
		        if self._currentPlayerUserId ~= watchedUser then return end
		        if self._currentState ~= watchedState then return end
-- 		        log("[MultiTurnManager] 턴 시간 초과(" .. tostring(self.TurnTimeoutSeconds) .. "초) 자동 진행 user=" .. watchedUser .. " state=" .. watchedState)
		        -- 이번 턴에 대해 스트라이크는 1회만 부여(같은 턴에 여러 대기 지점이 초과돼도 중복 금지).
		        -- 단, 완주자 대기 큐브 롤(FINISHER_CUBE)은 이미 완주한 플레이어의 보너스라 AFK 스트라이크를 부여하지 않는다(피드백 5).
		        if watchedState ~= "FINISHER_CUBE" and self._turnAutoFlagged == false then
		            self._turnAutoFlagged = true
		            self:AddAfkStrike(watchedUser)
		            -- 강퇴로 이미 순서가 리셋됐다면 자동 진행을 멈춘다.
		            if self._currentPlayerUserId ~= watchedUser or self._currentState ~= watchedState then return end
		        end
		        if watchedState == "DICE" then
		            self:AutoRollDice()
		        elseif watchedState == "TILE" then
		            self:ForceCloseTileUI()      -- 열려 있던 이벤트/선택 UI를 전원(actor+관전자) 닫는다(스테일 UI/늦은 클릭 방지).
		            self:OnTileEventComplete()   -- 인터랙티브 타일 대기 → 강제 완료로 턴 진행(선택은 생략)
		        elseif watchedState == "RESULT_DICE" then
		            self:AutoFinishResultDice()
		        elseif watchedState == "FINISHER_CUBE" then
		            -- 완주자가 큐브 롤 '다음'을 안 누름 → 연출 닫고 턴 진행(보상은 이미 지급됨).
		            if isvalid(self._finisherTile) then
		                self._finisherTile:ForceFinishWaitingRoll()
		            else
		                self:OnWaitingCubeRollDone()
		            end
		        end
	end

	@ExecSpace("Server")
	method void AutoRollDice()
		        -- 자동 주사위(RequestRollDice의 발신자 검증 없는 버전). DICE 단계에서만.
		        if not self._isActive then return end
		        if self._currentState ~= "DICE" then return end
		        if self._isRolling then return end
		        self._isRolling = true
		        local total = _DiceManager:Roll(self._currentPlayerUserId)
		        self.remainDiceTotal = total
-- 		        log("[MultiTurnManager] 자동 주사위 결과: " .. tostring(total))
		        self:PlayDiceAnimation(_DiceManager._dice1, _DiceManager._dice2, total)
	end

	@ExecSpace("Server")
	method void AutoFinishResultDice()
		        -- 자동 결과주사위 마무리(공개→잠깐 표시→닫기→턴 종료). RESULT_DICE 단계에서만.
		        -- AFK 자동 마무리여도 결과 주사위를 잠깐(2초) 보여준 뒤 닫는다(기존엔 공개 즉시 닫혀 아무도 못 읽었다).
		        if not self._isActive then return end
		        if self._currentState ~= "RESULT_DICE" then return end
		        self:BroadcastReveal()
		        _TimerService:SetTimerOnce(function()
		            -- 2초 사이 상태가 바뀌었으면(예: 강퇴/재개) 무시.
		            if not self._isActive then return end
		            if self._currentState ~= "RESULT_DICE" then return end
		            self:BroadcastClose()
		            self._isResultRolling = false
		            self:OnResultDiceAnimationEnd()
		        end, 2.0)
	end

	@ExecSpace("Server")
	method void AddAfkStrike(string userId)
		        -- 자동이동 누적 +1. MaxAfkStrikes(3) 도달 시 강제 퇴장.
		        if self._afkStrikes == nil then self._afkStrikes = {} end
		        local c = self._afkStrikes[userId]
		        if c == nil then c = 0 end
		        c += 1
		        self._afkStrikes[userId] = c
-- 		        log("[MultiTurnManager] AFK 자동이동 누적: " .. userId .. " = " .. tostring(c) .. "/" .. tostring(self.MaxAfkStrikes))
		        if c >= self.MaxAfkStrikes then
-- 		            log("[MultiTurnManager] AFK " .. tostring(self.MaxAfkStrikes) .. "회 누적 → 강제 퇴장: " .. userId)
		            self:RemovePlayer(userId, true)   -- 강퇴: 순서표 제거 + 로비 복귀 + (남은 인원에 따라) 종료/순서 리셋
		        else
		            self:PushAfkWarnUI(userId, c)   -- 왼쪽 버프칸에 경고 스택 표시(피드백 6)
		        end
	end

	@ExecSpace("Server")
	method void ResetAfkStrike(string userId)
		        -- 정상 플레이(턴 내 자동진행 없음) → 해당 유저의 AFK 누적을 0으로. '3연속'만 강퇴로 이어지게 한다.
		        if self._afkStrikes == nil then return end
		        if self._afkStrikes[userId] ~= nil then
		            self._afkStrikes[userId] = nil
-- 		            log("[MultiTurnManager] 정상 플레이 → AFK 누적 리셋: " .. userId)
		            self:PushAfkWarnUI(userId, 0)   -- 경고 버프 제거(피드백 6)
		        end
	end

	@ExecSpace("ServerOnly")
	method void PushAfkWarnUI(string userId, integer count)
		-- 해당 유저 플레이어 엔티티의 BuffManager에 AFK 경고 스택을 반영한다(버프칸 표시/제거).
		local pe = _UserService:GetUserEntityByUserId(userId)
		if isvalid(pe) == false then return end
		local bm = pe:GetComponent("script.BuffManager")
		if isvalid(bm) then bm:SetAfkWarning(count) end
	end

	@ExecSpace("Server")
	method void NotifyAutoBranch(string userId)
		        -- 분기점 자동 선택(PlayerMovement)이 발생했음을 알림 → 자동이동 스트라이크(턴당 1회).
		        if not self._isActive then return end
		        if userId ~= self._currentPlayerUserId then return end
		        if self._turnAutoFlagged then return end
		        self._turnAutoFlagged = true
		        self:AddAfkStrike(userId)
	end

end