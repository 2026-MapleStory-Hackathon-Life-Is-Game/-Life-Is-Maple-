@Logic
script GameModeManager extends Logic

	@Sync
	property string _activeMode = "SINGLE"

	@Sync
	property boolean _isGameActive = false

	method void OnBeginPlay()
		        log("[GameModeManager] OnBeginPlay: 모드 선택 대기 중")
		        -- 모드는 ModeSelectUI(클라)의 버튼에서 StartSinglePlayer / StartMultiPlayer 호출로 결정된다.
	end

	method void OnEndPlay()
		        log("[GameModeManager] OnEndPlay")
	end

	@ExecSpace("Server")
	method void StartSinglePlayer()
		        if self._isGameActive then
		            log_warning("[GameModeManager] 이미 게임이 진행 중입니다.")
		            return
		        end
		        log("[GameModeManager] 싱글플레이 모드 시작")
		        self._activeMode = "SINGLE"
		        self._isGameActive = true
		        -- 본인만 게임 맵으로 텔레포트 (MatchManager의 전환 로직 재사용)
		        local ids = {}
		        table.insert(ids, senderUserId)
		        _MatchManager:TeleportPlayersToGame(ids)
		        _VillageEventFlowManager:ResetStage1Lock()
		        _SingleTurnManager:Start()
	end

	@ExecSpace("Server")
	method void StartMultiPlayer(table userIds)
		        if self._isGameActive then
		            log_warning("[GameModeManager] 이미 게임이 진행 중입니다.")
		            return
		        end
		        if #userIds < 2 then
		            log_error("[GameModeManager] 멀티플레이 인원은 2명 이상이어야 합니다: " .. tostring(#userIds))
		            return
		        end
		        log("[GameModeManager] 멀티플레이 모드 시작 (" .. tostring(#userIds) .. "명)")
		        self._activeMode = "MULTI"
		        self._isGameActive = true
		        _VillageEventFlowManager:ResetStage1Lock()
		        _MultiTurnManager:Start(userIds)
	end

	@ExecSpace("Server")
	method void NotifyTileEventDone()
		        -- 인터랙티브 타일(예: 마을)이 이벤트 연출을 끝냈을 때 호출 → 활성 턴 매니저로 라우팅해 다음 단계 진행.
		        if self._activeMode == "SINGLE" then
		            _SingleTurnManager:OnTileEventComplete()
		        elseif self._activeMode == "MULTI" then
		            _MultiTurnManager:OnTileEventComplete()
		        end
	end

	@ExecSpace("Server")
	method void EndGame()
		        if not self._isGameActive then return end
		        log("[GameModeManager] 게임 종료 (모드: " .. self._activeMode .. ")")
		        if self._activeMode == "SINGLE" then
		            _SingleTurnManager:Stop()
		        elseif self._activeMode == "MULTI" then
		            _MultiTurnManager:Stop()
		        end
		        self._activeMode = "NONE"
		        self._isGameActive = false
	end

	@ExecSpace("Server")
	method void OnPlayerReachedEnd(Entity piece)
		        if not self._isGameActive then return end
		
				-- 플레이어의 현재 맵 이름 확인
				local currentMap = piece.CurrentMapName
		
				if currentMap == "Map_01" then
					log("[GameModeManager] Map_01 완주 -> Map_02 이동")
			
					if self._activeMode == "SINGLE" then
						self:MoveToNextMap(piece, "Map_02")
					elseif self._activeMode == "MULTI" then
						-- 멀티: 해당 플레이어 완주 처리. 전원 완주 시 MultiTurnManager가 FinishMulti를 호출한다. [cite: 69]
						if isvalid(piece) and piece.PlayerComponent ~= nil then
							_MultiTurnManager:MarkPlayerFinished(piece.PlayerComponent.UserId)
						end
					end
			
				elseif currentMap == "Map_02" then
					log("[GameModeManager] Map_02 완주 -> Map_03 이동")
					if self._activeMode == "SINGLE" then
					self:MoveToNextMap(piece, "Map_03")
					elseif self._activeMode == "MULTI" then
						-- 멀티: 해당 플레이어 완주 처리. 전원 완주 시 MultiTurnManager가 FinishMulti를 호출한다. [cite: 69]
						if isvalid(piece) and piece.PlayerComponent ~= nil then
							_MultiTurnManager:MarkPlayerFinished(piece.PlayerComponent.UserId)
						end
					end
			
			
				else
					-- Map_03 도착 시 최종 완주 처리
					if self._activeMode == "SINGLE" then
						self:FinishGame(piece)
					elseif self._activeMode == "MULTI" then
						-- 멀티: 해당 플레이어 완주 처리. 전원 완주 시 MultiTurnManager가 FinishMulti를 호출한다. [cite: 69]
						if isvalid(piece) and piece.PlayerComponent ~= nil then
							_MultiTurnManager:MarkPlayerFinished(piece.PlayerComponent.UserId)
						end
					end
				end
	end

	@ExecSpace("Server")
	method void FinishGame(Entity piece)
		        if not self._isGameActive then return end
		
		        local finalPower = 0
		        if isvalid(piece) then
		            local cp = piece:GetComponent("script.CombatPowerManager")
		            if isvalid(cp) then finalPower = cp.CombatPower end
		        end
		        log("[GameModeManager] 싱글 클리어 — 전투력=" .. tostring(finalPower))
		
		        _SingleTurnManager:Stop()
		        -- 게임 활성 플래그는 여기서 먼저 내린다. 아래 랭킹/결과UI/스탯초기화 중 하나가 예외를 던져도
		        -- 게임이 "진행 중"으로 고착돼 다음 판 시작이 영구 차단되는 것을 막는다(복구 불가한 락 방지).
		        self._activeMode = "NONE"
		        self._isGameActive = false
		        local singleIds = {}
		        if isvalid(piece) and piece.PlayerComponent ~= nil then table.insert(singleIds, piece.PlayerComponent.UserId) end
		        -- 결과 표시는 기록 제출 후 순위/신기록 계산과 함께 아래에서 처리(ShowSingle).
		
		        -- 랭킹 기록 제출(전투력 초기화 전, 플레이어별 최고 기록만 유지).
		        if isvalid(piece) and piece.PlayerComponent ~= nil then
		            local uid = piece.PlayerComponent.UserId
		            local pname = self:GetPlayerName(piece)
		            local pjob = self:GetPlayerJob(piece)
		            local pcamp = self:GetPlayerCamp(piece)
		            local ipower = math.floor(finalPower)
		            -- 리셋/제출 전에 신기록 판정 + 코디 캡처(리셋되면 코디가 사라짐).
		            local prevBest = _RankingManager:GetPlayerBest(uid)
		            local avatar = _RankingManager:CaptureCostume(uid)
		            local isNew = (prevBest < 0) or (ipower > prevBest)
		            -- 제출(플레이어별 최고만 유지) 후 전체 순위 계산 → 완주자 클라에 리치 결과 카드.
		            _RankingManager:SubmitRecord(uid, pname, pjob, pcamp, ipower)
		            local rank = _RankingManager:GetRankOf(uid)
		            _ResultUI:ShowSingle(pname, ipower, pjob, pcamp, rank, isNew, avatar, uid)
		        end
		
		        local ids = {}
		        if isvalid(piece) and piece.PlayerComponent ~= nil then
		            table.insert(ids, piece.PlayerComponent.UserId)
		        end
		        _MatchManager:TeleportPlayersToLobby(ids)
		        self:ResetPlayerStats(piece)
		        -- (게임 활성 플래그는 위 Stop 직후 이미 내렸다.)
	end

	@ExecSpace("Server")
	method void DebugFinishGame()
		        -- [임시/디버그] 요청 클라이언트 기준으로 싱글 게임 종료 흐름(결과 패널)을 강제 실행한다.
		        -- 결과 패널/랭킹/초기화 검증용. 싱글 게임 진행 중이 아니면 무시(먼저 싱글 게임을 시작해야 함).
		        local player = _UserService:GetUserEntityByUserId(senderUserId)
		        if isvalid(player) == false then return end
		        if self._activeMode ~= "SINGLE" then
		            log_warning("[GameModeManager] DebugFinishGame 무시: 싱글 게임이 아님(mode=" .. tostring(self._activeMode) .. ")")
		            return
		        end
		        log("[GameModeManager] (디버그) 강제 게임 종료 요청")
		        self:FinishGame(player)
	end

	@ExecSpace("Server")
	method void DebugNextStage()
		        -- [임시/디버그] 요청 클라이언트를 현재 스테이지 완주 없이 곧바로 다음 스테이지(맵)로 이동시킨다.
		        -- Map_01→Map_02, Map_02→Map_03, Map_03(마지막)→게임 종료(FinishGame). 싱글 게임 진행 중에만 동작.
		        local player = _UserService:GetUserEntityByUserId(senderUserId)
		        if isvalid(player) == false then return end
		        if self._activeMode ~= "SINGLE" then
		            log_warning("[GameModeManager] DebugNextStage 무시: 싱글 게임이 아님(mode=" .. tostring(self._activeMode) .. ")")
		            return
		        end
		        if not self._isGameActive then
		            log_warning("[GameModeManager] DebugNextStage 무시: 게임이 진행 중이 아님")
		            return
		        end
		        local currentMap = player.CurrentMapName
		        log("[GameModeManager] (디버그) 다음 스테이지 이동 요청 (현재=" .. tostring(currentMap) .. ")")
		        if currentMap == "Map_01" then
		            self:MoveToNextMap(player, "Map_02")
		        elseif currentMap == "Map_02" then
		            self:MoveToNextMap(player, "Map_03")
		        else
		            -- 마지막 스테이지(Map_03) → 최종 완주 처리.
		            log("[GameModeManager] (디버그) 마지막 스테이지 → 게임 종료 처리")
		            self:FinishGame(player)
		        end
	end

	@ExecSpace("Server")
	method void FinishMulti(table userIds)
		        if not self._isGameActive then return end
		
		        -- 순위표는 (1) MultiTurnManager:Stop()이 완주 순위를 비우기 전, (2) ResetPlayerStats가
		        -- 전투력을 초기화하기 전에 만들어야 한다. 따라서 Stop보다 먼저 빌드한다.
		        local ranking = self:BuildRankingText(userIds)
		        log("[GameModeManager] 멀티 클리어 — 최종 순위\n" .. ranking)
		
		        _MultiTurnManager:Stop()
		        -- 활성 플래그를 먼저 내린다(아래 랭킹/텔레포트/초기화 예외로 게임이 고착되지 않도록).
		        self._activeMode = "NONE"
		        self._isGameActive = false
		        self:ShowResult(ranking)
		
		        -- 랭킹 기록 제출(각 플레이어, 전투력 초기화 전).
		        for _, uid in ipairs(userIds) do
		            local ue = _UserService:GetUserEntityByUserId(uid)
		            if isvalid(ue) then
		                local rp = 0
		                local rcp = ue:GetComponent("script.CombatPowerManager")
		                if isvalid(rcp) then rp = rcp.CombatPower end
		                _RankingManager:SubmitRecord(uid, self:GetPlayerName(ue), self:GetPlayerJob(ue), self:GetPlayerCamp(ue), math.floor(rp))
		            end
		        end
		        _MatchManager:TeleportPlayersToLobby(userIds)
		        for _, uid in ipairs(userIds) do
		            local ue = _UserService:GetUserEntityByUserId(uid)
		            if isvalid(ue) then self:ResetPlayerStats(ue) end
		        end
		        -- (게임 활성 플래그는 위 Stop 직후 이미 내렸다.)
	end

	@ExecSpace("ServerOnly")
	method string BuildRankingText(table userIds)
		        -- 랭킹 행 수집: {name, power, job, camp}. 기준은 전투력, 나머지는 부가 정보. finishRank는 동점 타이브레이크용.
		        local rows = {}
		        for _, uid in ipairs(userIds) do
		            local ue = _UserService:GetUserEntityByUserId(uid)
		            if isvalid(ue) then
		                local power = 0
		                local cp = ue:GetComponent("script.CombatPowerManager")
		                if isvalid(cp) then power = cp.CombatPower end
		                table.insert(rows, {
		                    name = self:GetPlayerName(ue),
		                    power = power,
		                    job = self:GetPlayerJob(ue),
		                    camp = self:GetPlayerCamp(ue),
		                    finishRank = _MultiTurnManager:GetFinishRank(uid),  -- 1=가장 먼저 완주, 미완주=거대값
		                })
		            end
		        end
		
		        -- 정렬 기준 = 전투력 내림차순. 동점이면 먼저 완주한 순 → 그래도 같으면 이름.
		        table.sort(rows, function(a, b)
		            if a.power ~= b.power then return a.power > b.power end
		            if a.finishRank ~= b.finishRank then return a.finishRank < b.finishRank end
		            return a.name < b.name
		        end)
		
		        -- 헤더 + 행 조립. 열 순서: 순위 - 이름 - 전투력 - 직업 - 진영 (1위에는 우승 표시).
		        local lines = {}
		        table.insert(lines, "순위   이름   전투력   직업   진영")
		        for i, r in ipairs(rows) do
		            local line = tostring(i) .. "위   " .. r.name .. "   전투력 " .. self:FormatPower(r.power) .. "   " .. r.job .. "   " .. r.camp
		            if i == 1 then line = line .. "   우승!" end
		            table.insert(lines, line)
		        end
		        return table.concat(lines, "\n")
	end

	method string FormatPower(number value)
		        local n = math.floor(value)
		        if n >= 10000 then
		            local man = math.floor(n / 10000)
		            local rest = n % 10000
		            return tostring(man) .. "만 " .. string.format("%04d", rest)
		        end
		        return tostring(n)
	end

	@ExecSpace("ServerOnly")
	method void ResetPlayerStats(Entity entity)
		        if isvalid(entity) == false then return end
		        local buff = entity:GetComponent("script.BuffManager")
		        if isvalid(buff) then buff:ResetAll() end
		        local guild = entity:GetComponent("script.GuildManager")
		        if isvalid(guild) then guild:ResetAll() end
		        local romance = entity:GetComponent("script.RomanceManager")
		        if isvalid(romance) then romance:ResetAll() end
		        local lifepath = entity:GetComponent("script.LifePathManager")
		        if isvalid(lifepath) then lifepath:ResetAll() end
		        for _, t in ipairs({ "script.WeaponEquipment", "script.ArmorEquipment", "script.AccessoryEquipment" }) do
		            local m = entity:GetComponent(t)
		            if isvalid(m) then m:ResetAll() end
		        end
		        -- 미라클 큐브 인벤토리 + 미확정 잠재 후보 초기화.
		        local bag = entity:GetComponent("script.CubeInventory")
		        if isvalid(bag) then bag:ResetAll() end
		        if entity.PlayerComponent ~= nil then
		            _PotentialManager:ClearPendingFor(entity.PlayerComponent.UserId)
		        end
		        -- 직업 초기화(Beginner) + 기본 무기 재적용. currentJob이 전역 단일값이라 여기서 되돌린다.
		        _JobWeaponManager:ResetJob(entity)
		        local cp = entity:GetComponent("script.CombatPowerManager")
		        if isvalid(cp) then cp:ResetAll() end
		        -- 초기화 후 빈 장비 기준 전투력 재계산.
		        if isvalid(cp) then cp:CalculateCurrentCombatPower() end
	end

	method string GetPlayerJob(Entity entity)
		        -- 직업: JobWeaponManager(전역 Logic)의 currentJob. 현 설계상 직업은 플레이어별이 아닌 전역 단일값(싱글 기준 정확).
		        if isvalid(entity) then
		            local job = _JobWeaponManager
		            if isvalid(job) and job.currentJob ~= nil and job.currentJob ~= "" then return job.currentJob end
		        end
		        return "--"
	end

	method string GetPlayerCamp(Entity entity)
		        -- 진영: BuffManager.CampName(미선택/미부착 시 '--').
		        if isvalid(entity) then
		            local buff = entity:GetComponent("script.BuffManager")
		            if isvalid(buff) and buff.CampName ~= nil and buff.CampName ~= "" then return buff.CampName end
		        end
		        return "--"
	end

	method string GetPlayerName(Entity entity)
		        if isvalid(entity) and entity.PlayerComponent ~= nil then
		            local nick = entity.PlayerComponent.Nickname
		            if nick ~= nil and nick ~= "" then return nick end
		            return entity.PlayerComponent.UserId
		        end
		        return "?"
	end

	@ExecSpace("Client")
	method void ShowResult(string message)
		        _ResultUI:Show(message)
	end

	@ExecSpace("Server")
	method void MoveToNextMap(Entity piece, string nextMapName)
		if not isvalid(piece) then return end
		
				-- 1. 다음 맵 엔티티 찾기
				local nextMapEntity = _EntityService:GetEntityByPath("/maps/" .. nextMapName)
				if not isvalid(nextMapEntity) then
					log_error("[GameModeManager] 다음 맵을 찾을 수 없습니다: " .. nextMapName)
					return
				end
		
				-- 2. 해당 맵으로 텔레포트
				-- (Tile_1의 위치를 잡기 전이므로 임시 좌표(0,0)로 이동시킵니다)
				_TeleportService:TeleportToMapPosition(piece, Vector3(0,0,0), nextMapEntity.Name)
		
				-- 다른 맵 도착 연출: '점프'하는 느낌(공중 포즈 + 수직 홉). 텔레포트 동기화 여유로 약간 지연.
				local jumpUid = ""
				if piece.PlayerComponent ~= nil then jumpUid = piece.PlayerComponent.UserId end
				_TimerService:SetTimerOnce(function()
					self:PlayMapJumpFor(piece, jumpUid)
				end, 0.3)
		
				-- 3. 이동력 및 위치 변수 초기화
				local pm = piece:GetComponent("script.PlayerMovement")
				if isvalid(pm) then
					pm.currentTile = "Tile_1"
					pm.remainingSteps = 0
					pm:ChangePlayerState("IDLE")
				end
		
				-- 만약 바로 시작하면 TileManager의 타일 수집이 덜 끝날 수 있으므로 타이머 사용 권장
				    _TimerService:SetTimerOnce(function()
				        _SingleTurnManager:Start() -- 여기서 Start()가 호출되면 다시 TURN_START 단계부터 시작함
				    end, 1.0)
	end

	@ExecSpace("Client")
	method void PlayMapJumpFor(Entity piece)
		-- 다른 맵으로 이동 시 '점프' 느낌: 공중 포즈 + 위로 떴다 착지하는 홉.
		if isvalid(piece) == false then return end
		local pos = piece.TransformComponent.WorldPosition
		local ground = Vector2(pos.x, pos.y)
		local apex = Vector2(pos.x, pos.y + 1.2)
		
		-- 공중(낙하) 포즈
		local fall = BodyActionStateChangeEvent()
		fall.ActionState = MapleAvatarBodyActionState.Fall
		fall.needResetAction = true
		piece:SendEvent(fall)
		_SFXManager:PlayJump()   -- 점프 효과음
		
		-- 위로 떴다(감속) → 내려오며(가속) 착지 → 착지 시 Stand 복귀
		local up = _TweenLogic:MoveTo(piece, apex, 0.22, EaseType.QuadEaseOut)
		up:SetOnEndCallback(function()
			local down = _TweenLogic:MoveTo(piece, ground, 0.22, EaseType.QuadEaseIn)
			down:SetOnEndCallback(function()
				local land = BodyActionStateChangeEvent()
				land.ActionState = MapleAvatarBodyActionState.Stand
				land.needResetAction = true
				piece:SendEvent(land)
			end)
		end)
		log("[GameModeManager] 맵 이동 점프 연출 재생")
	end

end