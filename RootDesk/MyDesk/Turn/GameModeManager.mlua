@Logic
script GameModeManager extends Logic

	@Sync
	property string _activeMode = "SINGLE"

	@Sync
	property boolean _isGameActive = false

	property integer _roomSeq = 0

	property integer _multiExpected = 0

	property any _multiArrived = nil

	property integer _multiArrivedCount = 0

	property boolean _multiGateOpen = false

	property string _multiAwaitingMap = ""

	property integer _multiGraceTimer = 0

	method void OnBeginPlay()
-- 		        log("[GameModeManager] OnBeginPlay: 모드 선택 대기 중")
		        -- 모드는 ModeSelectUI(클라)의 버튼에서 StartSinglePlayer / StartMultiPlayer 호출로 결정된다.
	end

	method void OnEndPlay()
-- 		        log("[GameModeManager] OnEndPlay")
	end

	@ExecSpace("Server")
	method void StartSinglePlayer()
		        -- [룸 분리] 로비(스태틱 룸)에서 호출된다. 여기서는 '이 요청자만을 위한 고유 인스턴스 룸'을
		        -- 생성하고 본인만 그 룸의 Map_01로 이동시킨다. 실제 게임 시작(무기/게이트/턴)은
		        -- 인스턴스 룸의 Map_01에 도착한 뒤 BeginSingleRoomGame에서 수행한다.
		        -- 이렇게 해야 로비에 여러 명이 있어도 각자 독립된 룸/GameModeManager로 충돌 없이 플레이한다.
		        -- ※ CreateInstanceRoom은 스태틱 룸에서만 동작한다(인스턴스 룸에선 nil 반환).
		        if _RoomService:IsInstanceRoom() then
-- 		            log_warning("[GameModeManager] StartSinglePlayer는 스태틱 룸(로비)에서만 호출해야 합니다.")
		            return
		        end
		        local uid = senderUserId
		        self._roomSeq = self._roomSeq + 1
		        local roomKey = "Single_" .. uid .. "_" .. tostring(self._roomSeq)
		        -- Map_01/02/03은 InstanceMap=true 이어야 한다(이 룸에 세 맵을 함께 싣는다).
		        local room = _RoomService:CreateInstanceRoom(roomKey, { "Map_01", "Map_02", "Map_03" })
		        if room == nil then
-- 		            log_error("[GameModeManager] 싱글 인스턴스 룸 생성 실패: " .. roomKey)
		            return
		        end
-- 		        log("[GameModeManager] 싱글 인스턴스 룸 생성: " .. roomKey .. " → 이동 uid=" .. tostring(uid))
		        _RoomService:MoveUserToInstanceRoom(roomKey, uid, "Map_01")
	end

	@ExecSpace("Server")
	method void BeginSingleRoomGame()
		        -- [룸 분리] 플레이어가 자기 인스턴스 룸의 Map_01에 도착했을 때 클라(Single_FirstMapManagement)가 호출한다.
		        -- 이 룸의 GameModeManager는 이 플레이어 전용이므로 _isGameActive/턴 상태가 다른 플레이어와 섞이지 않는다.
		        if _RoomService:IsInstanceRoom() == false then
-- 		            log_warning("[GameModeManager] BeginSingleRoomGame은 인스턴스 룸에서만 유효합니다.")
		            return
		        end
		        if self._isGameActive then return end   -- 중복 진입(재-OnMapEnter) 방지
-- 		        log("[GameModeManager] 싱글플레이 게임 시작(인스턴스 룸)")
		        self._activeMode = "SINGLE"
		        self._isGameActive = true
		        -- 도착 플레이어(요청 클라). 인스턴스 룸엔 이 한 명뿐이다.
		        local starter = _UserService:GetUserEntityByUserId(senderUserId)
		        -- 게임 시작 시 기본 무기 '몽둥이(Cudgel)'를 지급+장착한다(아직 직업 선택 전의 시작 무기).
		        if isvalid(starter) then _JobWeaponManager:EquipStarterCudgel(starter) end
		        -- 엔딩 정리용 런 기록 초기화(baseline 시각 + 턴/방문 카운터).
		        if isvalid(starter) then
		            local rsInit = starter:GetComponent("script.RunStatsManager")
		            if isvalid(rsInit) then rsInit:BeginRun() end
		        end
		        _VillageEventFlowManager:ResetStage1Lock()
		        -- 오프닝: 첫 턴 '전에' Lv.10 축하 배너 + LevelDialogue(10) 내레이션을 보여주고, 배너를 닫으면 첫 턴 시작.
		        -- (시작 레벨이 10이라 자연 레벨업이 없어 게이트가 안 걸리므로 여기서 직접 게이트한다. 레벨업 배너 UI/흐름 재사용.)
		        if isvalid(starter) then
		            local openUid = ""
		            if starter.PlayerComponent ~= nil and starter.PlayerComponent.UserId ~= nil then
		                openUid = starter.PlayerComponent.UserId
		            end
		            _LevelUpCelebration:Gate(starter, true, 10, function()
		                -- Lv.10 인트로 배너 닫힘 → 이제 진영 선택을 연 뒤 첫 턴 시작.
		                self:ShowMapSelectionFor("Map_01", openUid)
		                _SingleTurnManager:Start()
		            end)
		        else
		            _SingleTurnManager:Start()
		        end
	end

	@ExecSpace("Server")
	method void RegisterMultiArrival()
		        -- 인스턴스 룸: 매칭 플레이어가 대기 맵에 도착했음을 등록. 전원 도착(또는 grace timeout)에 게이트 오픈.
		        if _RoomService:IsInstanceRoom() == false then return end
		        if self._multiGateOpen then return end
		        if self._multiArrived == nil then
		            self._multiArrived = {}
		            self._multiArrivedCount = 0
		            -- expected 결정: 첫 맵이면 공유메모리 count, 이후 맵이면 MoveMultiToNextMap이 미리 세팅.
		            if self._multiExpected <= 0 then
		                local rc, mem = _RoomService:GetSharedMemory(_RoomService.RoomKey)
		                local n = 0
		                if mem ~= nil then
		                    local v = mem:GetVariableAndWait("count")
		                    if v ~= nil and v.Info ~= nil and v.Info.Value ~= nil then n = tonumber(v.Info.Value) or 0 end
		                end
		                self._multiExpected = n
		            end
		            self._multiGraceTimer = _TimerService:SetTimerOnce(function() self:OpenMultiGate() end, 15)
		        end
		        if self._multiArrived[senderUserId] == nil then
		            self._multiArrived[senderUserId] = true
		            self._multiArrivedCount += 1
-- 		            log("[GameModeManager] 멀티 도착 등록: " .. senderUserId .. " (" .. tostring(self._multiArrivedCount) .. "/" .. tostring(self._multiExpected) .. ")")
		        end
		        if self._multiExpected > 0 and self._multiArrivedCount >= self._multiExpected then
		            self:OpenMultiGate()
		        end
	end

	@ExecSpace("ServerOnly")
	method void OpenMultiGate()
		        -- 배리어 오픈: 첫 맵이면 게임 시작(StartMultiPlayer), 이후 맵이면 턴 재개(ResumeOnMap). 1회만.
		        if self._multiGateOpen then return end
		        self._multiGateOpen = true
		        if self._multiGraceTimer ~= 0 then _TimerService:ClearTimer(self._multiGraceTimer) self._multiGraceTimer = 0 end
		        local ids = {}
		        if self._multiArrived ~= nil then
		            for uid, _ in pairs(self._multiArrived) do table.insert(ids, uid) end
		        end
		        local awaiting = self._multiAwaitingMap
-- 		        log("[GameModeManager] 멀티 게이트 오픈: " .. tostring(#ids) .. "명, awaiting=" .. awaiting)
		        -- 배리어 리셋(다음 맵 대비). expected는 MoveMultiToNextMap이 다음 맵에서 다시 세팅.
		        self._multiArrived = nil
		        self._multiArrivedCount = 0
		        -- [멀티 선택창] 도착 맵에 맞는 선택창(진영/직업/인생분기)을 각 플레이어에게 타깃 표시(싱글과 동일).
		        -- 이게 없으면 아무도 직업을 못 골라 전원 Cudgel(Class=Common) 고정 → 직업별(weapon:) 보상이 무지급된다.
		        local selMap = awaiting
		        if selMap == "" then selMap = "Map_01" end
		        for _, uid in ipairs(ids) do
		            self:ShowMapSelectionFor(selMap, uid)
		        end
		        if awaiting == "" or awaiting == "Map_01" then
		            self:StartMultiPlayer(ids)
		        else
		            _MultiTurnManager:ResumeOnMap(awaiting)
		        end
	end

	@ExecSpace("Server")
	method void MoveMultiToNextMap(table userIds, string nextMapName)
		        -- 전원을 같은 인스턴스 룸의 다음 맵으로 텔레포트. 턴은 재시작하지 않고 도착 배리어를 다음 맵 대기로 세팅.
-- 		        log("[GameModeManager] 멀티 다음 맵 이동: " .. nextMapName .. " (" .. tostring(#userIds) .. "명)")
		        self._multiGateOpen = false
		        self._multiArrived = nil
		        self._multiArrivedCount = 0
		        self._multiAwaitingMap = nextMapName
		        self._multiExpected = #userIds
		        if self._multiGraceTimer ~= 0 then _TimerService:ClearTimer(self._multiGraceTimer) self._multiGraceTimer = 0 end
		        local destPos = self:GetMultiSpawnPosition(nextMapName)
		        local nextMapEntity = _EntityService:GetEntityByPath("/maps/" .. nextMapName)
		        for _, uid in ipairs(userIds) do
		            local ue = _UserService:GetUserEntityByUserId(uid)
		            if isvalid(ue) then
		                if ue.PlayerComponent ~= nil then _LoadingManager:ShowLoadingAndPreload(ue.PlayerComponent.UserId) end
		                if isvalid(nextMapEntity) then
		                    _TeleportService:TeleportToMapPosition(ue, destPos, nextMapEntity.Name)
		                end
		                local pm = ue:GetComponent("script.PlayerMovement")
		                if isvalid(pm) then
		                    pm.currentTile = "Tile_1"
		                    pm.remainingSteps = 0
		                    pm:ChangePlayerState("IDLE")
		                end
		                _TileManager:ApplyStartTileLevel(ue, nextMapName)
-- 		                log("[GameModeManager] 멀티 맵 전환: " .. uid .. " → " .. nextMapName)
		            else
-- 		                log_warning("[GameModeManager] 멀티 이동 대상 무효: " .. tostring(uid))
		            end
		        end
	end

	method Vector3 GetMultiSpawnPosition(string mapName)
		        -- 해당 맵의 시작 타일(Tile_1) 월드좌표. 미발견 시 (0,0,0) 폴백.
		        local startTile = _TileManager:GetTileEntity(mapName, "Tile_1")
		        if isvalid(startTile) then
		            return startTile.TransformComponent.WorldPosition
		        end
-- 		        log_warning("[GameModeManager] 멀티 시작 타일 미발견 → (0,0,0) 폴백: " .. mapName)
		        return Vector3(0, 0, 0)
	end

	@ExecSpace("Server")
	method void StartMultiPlayer(table userIds)
		        if self._isGameActive then
-- 		            log_warning("[GameModeManager] 이미 게임이 진행 중입니다.")
		            return
		        end
		        if #userIds < 2 then
-- 		            log_error("[GameModeManager] 멀티플레이 인원은 2명 이상이어야 합니다: " .. tostring(#userIds))
		            return
		        end
-- 		        log("[GameModeManager] 멀티플레이 모드 시작 (" .. tostring(#userIds) .. "명)")
		        self._activeMode = "MULTI"
		        self._isGameActive = true
		        _VillageEventFlowManager:ResetStage1Lock()
		        -- 게임 시작 시 각 플레이어에게 기본 무기 '몽둥이(Cudgel)'를 지급+장착한다.
		        for _, uid in ipairs(userIds) do
		        	local pe = _UserService:GetUserEntityByUserId(uid)
		        	if isvalid(pe) then _JobWeaponManager:EquipStarterCudgel(pe) end
		        end
		        _MultiTurnManager:Start(userIds)
	end

	@ExecSpace("Server")
	method void NotifyTileEventDone()
		        -- 인터랙티브 타일(예: 마을)이 이벤트 연출을 끝냈을 때 호출 → 활성 턴 매니저로 라우팅해 다음 단계 진행.
		        if self._activeMode == "SINGLE" then
		            _SingleTurnManager:OnTileEventComplete()
		        elseif self._activeMode == "MULTI" then
		            _MultiTurnManager:OnTileEventComplete()
		        end
	end

	@ExecSpace("Server")
	method void EndGame()
		        if not self._isGameActive then return end
-- 		        log("[GameModeManager] 게임 종료 (모드: " .. self._activeMode .. ")")
		        if self._activeMode == "SINGLE" then
		            _SingleTurnManager:Stop()
		        elseif self._activeMode == "MULTI" then
		            _MultiTurnManager:Stop()
		        end
		        self._activeMode = "NONE"
		        self._isGameActive = false
	end

	@ExecSpace("ServerOnly")
	method table CollectRunSummary(Entity piece)
		-- 결과 카드에 합칠 엔딩 요약 지표(플레이시간/턴/최다방문/인생분기)를 모아 반환한다.
		-- (기존 엔딩 정리 표를 결과창과 통합 → 별도 요약 화면/‘다음’ 단계 제거.)
		local out = { minutes = 0, turns = 0, titleType = "", visits = 0, lifeInfo = "" }
		if isvalid(piece) == false then return out end
		local rs = piece:GetComponent("script.RunStatsManager")
		if isvalid(rs) then
			out.minutes = rs:PlayMinutes()
			out.turns = rs.TurnCount
			out.titleType = rs:MostVisitedType()
			out.visits = rs:VisitCount(out.titleType)
		end
		-- 인생 분기(길드/애인) + 인원 수.
		local lp = piece:GetComponent("script.LifePathManager")
		local path = ""
		if isvalid(lp) then path = lp.LifePath end
		if path == "Guild" then
			local g = piece:GetComponent("script.GuildManager")
			local gn = 0
			if isvalid(g) then
				gn = g.GeneralMembers
				if g.Stage >= 2 then gn = gn + 1 end   -- 부길마 포함
			end
			out.lifeInfo = "길드 (길드원 " .. tostring(gn) .. "명)"
		elseif path == "Romance" then
			local r = piece:GetComponent("script.RomanceManager")
			local rn = 0
			if isvalid(r) then rn = r.FamilyMembers end
			out.lifeInfo = "애인 (유니온 " .. tostring(rn) .. "명)"
		end
		return out
	end

	@ExecSpace("Server")
	method void OnPlayerReachedEnd(Entity piece)
		        if not self._isGameActive then return end
		
				-- 플레이어의 현재 맵 이름 확인
				local currentMap = piece.CurrentMapName
		
				if currentMap == "Map_01" then
-- 					log("[GameModeManager] Map_01 완주 -> Map_02 이동")
			
					if self._activeMode == "SINGLE" then
						self:MoveToNextMap(piece, "Map_02")
					elseif self._activeMode == "MULTI" then
						-- 멀티: 해당 플레이어 완주 처리. 전원 완주 시 MultiTurnManager가 FinishMulti를 호출한다. [cite: 69]
						if isvalid(piece) and piece.PlayerComponent ~= nil then
							_MultiTurnManager:MarkPlayerFinished(piece.PlayerComponent.UserId)
						end
					end
			
				elseif currentMap == "Map_02" then
-- 					log("[GameModeManager] Map_02 완주 -> Map_03 이동")
					if self._activeMode == "SINGLE" then
					self:MoveToNextMap(piece, "Map_03")
					elseif self._activeMode == "MULTI" then
						-- 멀티: 해당 플레이어 완주 처리. 전원 완주 시 MultiTurnManager가 FinishMulti를 호출한다. [cite: 69]
						if isvalid(piece) and piece.PlayerComponent ~= nil then
							_MultiTurnManager:MarkPlayerFinished(piece.PlayerComponent.UserId)
						end
					end
			
			
				else
					-- Map_03 도착 시 최종 완주 처리
					if self._activeMode == "SINGLE" then
						self:FinishGame(piece)
					elseif self._activeMode == "MULTI" then
						-- 멀티: 해당 플레이어 완주 처리. 전원 완주 시 MultiTurnManager가 FinishMulti를 호출한다. [cite: 69]
						if isvalid(piece) and piece.PlayerComponent ~= nil then
							_MultiTurnManager:MarkPlayerFinished(piece.PlayerComponent.UserId)
						end
					end
				end
	end

	@ExecSpace("Server")
	method void FinishGame(Entity piece)
		        if not self._isGameActive then return end
		
		        local finalPower = 0
		        if isvalid(piece) then
		            local cp = piece:GetComponent("script.CombatPowerManager")
		            if isvalid(cp) then finalPower = cp.CombatPower end
		        end
-- 		        log("[GameModeManager] 싱글 클리어 — 전투력=" .. tostring(finalPower))
		
		        _SingleTurnManager:Stop()
		        -- 게임 활성 플래그는 여기서 먼저 내린다. 아래 랭킹/결과UI/스탯초기화 중 하나가 예외를 던져도
		        -- 게임이 "진행 중"으로 고착돼 다음 판 시작이 영구 차단되는 것을 막는다(복구 불가한 락 방지).
		        self._activeMode = "NONE"
		        self._isGameActive = false
		        -- 결과 표시는 기록 제출 후 순위/신기록 계산과 함께 아래에서 처리(ShowSingle).
		
		        -- 랭킹 기록 제출(전투력 초기화 전, 플레이어별 최고 기록만 유지).
		        if isvalid(piece) and piece.PlayerComponent ~= nil then
		            local uid = piece.PlayerComponent.UserId
		            local pname = self:GetPlayerName(piece)
		            local pjob = self:GetPlayerJob(piece)
		            local pcamp = self:GetPlayerCamp(piece)
		            local ipower = math.floor(finalPower)
		            -- 리셋/제출 전에 신기록 판정 + 코디 캡처(리셋되면 코디가 사라짐).
		            local prevBest = _RankingManager:GetPlayerBest(uid)
		            local avatar = _RankingManager:CaptureCostume(uid)
		            local isNew = (prevBest < 0) or (ipower > prevBest)
		            -- 제출(플레이어별 최고만 유지) 후 전체 순위 계산 → 완주자 클라에 리치 결과 카드.
		            _RankingManager:SubmitRecord(uid, pname, pjob, pcamp, ipower)
		            local rank = _RankingManager:GetRankOf(uid)
		            -- 엔딩 요약 지표(플레이시간/턴/최다방문/인생분기)를 모아 결과 카드에 함께 표시(통합본).
		            local sm = self:CollectRunSummary(piece)
		            _ResultUI:ShowSingle(pname, ipower, pjob, pcamp, rank, isNew, avatar,
		                sm.minutes, sm.lifeInfo, sm.titleType, sm.turns, sm.visits, uid)
			            -- 잠재 코인 적립: 싱글 완주 기본 40 + 신기록 시 +30.
			            local coin = 40
			            if isNew then coin = coin + 30 end
			            _MetaProgressionManager:AwardCoins(uid, coin)
		        end
		
		        -- 로비 복귀 + 스탯 초기화는 결과 카드를 '닫을 때'로 미룬다(ResultUI.HideCard → ReturnToLobbyAfterResult).
		        -- 그래야 카드 닫는 순간 로딩 오버레이가 Map_03→로비 전환을 가릴 수 있다. 여기선 결과 카드만 띄운 상태로 대기.
		        -- (게임 활성 플래그는 위 Stop 직후 이미 내렸다.)
	end

	@ExecSpace("Server")
	method void ReturnToLobbyAfterResult()
		        -- 결과 카드 닫힘(클라)에서 호출. 로딩 오버레이는 클라가 먼저 띄운 상태.
		        -- [룸 분리] 인스턴스 룸 → 스태틱 룸(로비)로 복귀. 스탯 초기화는 이동 '전에' 수행한다
		        -- (이동 후에는 이 인스턴스 룸/GameModeManager가 곧 파기되므로).
		        local uid = senderUserId
		        local ue = _UserService:GetUserEntityByUserId(uid)
		        if isvalid(ue) then self:ResetPlayerStats(ue) end
		        _RoomService:MoveUsersToStaticRoom({ uid }, "Lobby")
-- 		        log("[GameModeManager] 결과 확인 후 로비 복귀(룸): " .. tostring(uid))
	end

	@ExecSpace("ServerOnly")
	method void KickUserToLobby(string userId)
		        -- 강제 퇴장(AFK 3회) / 인원 부족 게임 종료로 인해 한 플레이어를 즉시 로비로 되돌린다.
		        -- 스탯 초기화를 룸 이동 '전에' 수행(이동 후엔 이 인스턴스 룸/컴포넌트가 파기될 수 있음).
		        local ue = _UserService:GetUserEntityByUserId(userId)
		        if isvalid(ue) then self:ResetPlayerStats(ue) end
		        _RoomService:MoveUsersToStaticRoom({ userId }, "Lobby")
-- 		        log("[GameModeManager] 강제/종료 로비 복귀(룸): " .. tostring(userId))
	end

	@ExecSpace("Server")
	method void RequestLeaveToLobby()
		        -- 게임 중 자발적 '로비로 돌아가기'(우상단 버튼 → 확인 팝업 → 이 RPC).
		        -- 멀티: 이탈(RemovePlayer, kicked=true)로 처리 → 순서표 제거 + 본인 로비 복귀 + 남은 1명 게임오버까지 재사용.
		        -- 싱글: 내 전용 인스턴스 룸이므로 게임 종료 후 로비 복귀.
		        local uid = senderUserId
		        if self._isGameActive and self._activeMode == "MULTI" then
		            if _MultiTurnManager ~= nil and _MultiTurnManager._isActive then
		                _MultiTurnManager:RemovePlayer(uid, true)   -- 내부에서 KickUserToLobby(uid)까지 수행
		                return
		            end
		        end
		        if self._isGameActive and self._activeMode == "SINGLE" then
		            self:EndGame()
		        end
		        self:KickUserToLobby(uid)
	end

	@ExecSpace("Server")
	method void DebugFinishGame()
		        -- [임시/디버그] 요청 클라이언트 기준으로 싱글 게임 종료 흐름(결과 패널)을 강제 실행한다.
		        -- 결과 패널/랭킹/초기화 검증용. 싱글 게임 진행 중이 아니면 무시(먼저 싱글 게임을 시작해야 함).
		        local player = _UserService:GetUserEntityByUserId(senderUserId)
		        if isvalid(player) == false then return end
		        if self._activeMode ~= "SINGLE" then
-- 		            log_warning("[GameModeManager] DebugFinishGame 무시: 싱글 게임이 아님(mode=" .. tostring(self._activeMode) .. ")")
		            return
		        end
-- 		        log("[GameModeManager] (디버그) 강제 게임 종료 요청")
		        self:FinishGame(player)
	end

	@ExecSpace("Server")
	method void DebugShowEndingSummary()
		        -- [임시/디버그] 요청 클라 기준으로 통합 결과 카드(엔딩 요약 포함)를 바로 띄운다(검은마법사 전투 없이 검증용).
		        -- 엔딩 정리 표가 결과창과 통합되어, 이 버튼도 이제 통합 결과 카드를 강제 표시한다. 싱글 게임 진행 중에만 동작.
		        local player = _UserService:GetUserEntityByUserId(senderUserId)
		        if isvalid(player) == false then return end
		        if self._activeMode ~= "SINGLE" then
-- 		            log_warning("[GameModeManager] DebugShowEndingSummary 무시: 싱글 게임이 아님(mode=" .. tostring(self._activeMode) .. ")")
		            return
		        end
-- 		        log("[GameModeManager] (디버그) 통합 결과 카드 강제 표시")
		        self:FinishGame(player)
	end

	@ExecSpace("Server")
	method void DebugNextStage()
		        -- [임시/디버그] 요청 클라이언트를 현재 스테이지 완주 없이 곧바로 다음 스테이지(맵)로 이동시킨다.
		        -- Map_01→Map_02, Map_02→Map_03, Map_03(마지막)→게임 종료(FinishGame). 싱글 게임 진행 중에만 동작.
		        local player = _UserService:GetUserEntityByUserId(senderUserId)
		        if isvalid(player) == false then return end
		        if self._activeMode ~= "SINGLE" then
-- 		            log_warning("[GameModeManager] DebugNextStage 무시: 싱글 게임이 아님(mode=" .. tostring(self._activeMode) .. ")")
		            return
		        end
		        if not self._isGameActive then
-- 		            log_warning("[GameModeManager] DebugNextStage 무시: 게임이 진행 중이 아님")
		            return
		        end
		        local currentMap = player.CurrentMapName
-- 		        log("[GameModeManager] (디버그) 다음 스테이지 이동 요청 (현재=" .. tostring(currentMap) .. ")")
		        if currentMap == "Map_01" then
		            self:MoveToNextMap(player, "Map_02")
		        elseif currentMap == "Map_02" then
		            self:MoveToNextMap(player, "Map_03")
		        else
		            -- 마지막 스테이지(Map_03) → 최종 완주 처리.
-- 		            log("[GameModeManager] (디버그) 마지막 스테이지 → 게임 종료 처리")
		            self:FinishGame(player)
		        end
	end

	@ExecSpace("Server")
	method void FinishMulti(table userIds)
		        if not self._isGameActive then return end

		        -- 순위 데이터는 리셋(전투력 0)·룸이동 전에 캡처해야 한다.
		        local rows = {}
		        for _, uid in ipairs(userIds) do
		            local ue = _UserService:GetUserEntityByUserId(uid)
		            if isvalid(ue) then
		                local power = 0
		                local cp = ue:GetComponent("script.CombatPowerManager")
		                if isvalid(cp) then power = cp.CombatPower end
		                table.insert(rows, {
		                    userId = uid,
		                    name = self:GetPlayerName(ue),
		                    power = power,
		                    job = self:GetPlayerJob(ue),
		                    camp = self:GetPlayerCamp(ue),
		                    avatar = _RankingManager:CaptureCostume(uid),
		                    finishRank = _MultiTurnManager:GetFinishRank(uid),
		                })
		            end
		        end
		        table.sort(rows, function(a, b)
		            if a.power ~= b.power then return a.power > b.power end
		            if a.finishRank ~= b.finishRank then return a.finishRank < b.finishRank end
		            return a.name < b.name
		        end)

		        -- 랭킹 레코드 제출(리셋 전).
		        for _, r in ipairs(rows) do
		            _RankingManager:SubmitRecord(r.userId, r.name, r.job, r.camp, math.floor(r.power))
		        end

		        -- 병렬 배열로 평탄화 후 전원 방송(중첩 테이블 RPC 회피).
		        local names = {}
		        local powers = {}
		        local jobs = {}
		        local camps = {}
		        local avatars = {}
		        local uids = {}
		        for i, r in ipairs(rows) do
		            names[i] = r.name
		            powers[i] = math.floor(r.power)
		            jobs[i] = r.job
		            camps[i] = r.camp
		            avatars[i] = r.avatar
		            uids[i] = r.userId
		            -- 잠재 코인 적립: 결과 카드에 보이는 순위(전투력 내림차순 i)로 지급.
		            _MetaProgressionManager:AwardByMultiRank(r.userId, i)
		        end
		        _ResultUI:ShowMulti(names, powers, jobs, camps, avatars, uids, 1)

		        _MultiTurnManager:Stop()
		        self._activeMode = "NONE"
		        self._isGameActive = false
		        -- 로비 복귀·스탯 초기화는 각 플레이어가 결과 카드를 '닫을 때'로 미룬다
		        -- (ResultUI.HideMulti → ReturnToLobbyAfterResult, senderUserId per-user). 여기선 즉시 이동/리셋하지 않는다.
-- 		        log("[GameModeManager] 멀티 클리어 — 리치 순위표 표시(" .. tostring(#rows) .. "명)")
	end

	method string FormatPower(number value)
		        local n = math.floor(value)
		        if n >= 10000 then
		            local man = math.floor(n / 10000)
		            local rest = n % 10000
		            return tostring(man) .. "만 " .. string.format("%04d", rest)
		        end
		        return tostring(n)
	end

	@ExecSpace("ServerOnly")
	method void ResetPlayerStats(Entity entity)
		        if isvalid(entity) == false then return end
		        local buff = entity:GetComponent("script.BuffManager")
		        if isvalid(buff) then buff:ResetAll() end
		        local guild = entity:GetComponent("script.GuildManager")
		        if isvalid(guild) then guild:ResetAll() end
		        local romance = entity:GetComponent("script.RomanceManager")
		        if isvalid(romance) then romance:ResetAll() end
		        local lifepath = entity:GetComponent("script.LifePathManager")
		        if isvalid(lifepath) then lifepath:ResetAll() end
		        for _, t in ipairs({ "script.WeaponEquipment", "script.ArmorEquipment", "script.AccessoryEquipment" }) do
		            local m = entity:GetComponent(t)
		            if isvalid(m) then m:ResetAll() end
		        end
		        -- 미라클 큐브 인벤토리 + 미확정 잠재 후보 초기화.
		        local bag = entity:GetComponent("script.CubeInventory")
		        if isvalid(bag) then bag:ResetAll() end
		        -- 주사위 고정 카드 인벤토리 초기화.
		        local dcards = entity:GetComponent("script.DiceCardInventory")
		        if isvalid(dcards) then dcards:ResetAll() end
		        local runstats = entity:GetComponent("script.RunStatsManager")
		        if isvalid(runstats) then runstats:ResetAll() end
		        if entity.PlayerComponent ~= nil then
		            _PotentialManager:ClearPendingFor(entity.PlayerComponent.UserId)
		        end
		        -- 직업 초기화(Beginner) + 기본 무기 재적용. currentJob이 전역 단일값이라 여기서 되돌린다.
		        _JobWeaponManager:ResetJob(entity)
		        local cp = entity:GetComponent("script.CombatPowerManager")
		        if isvalid(cp) then cp:ResetAll() end
		        -- 초기화 후 빈 장비 기준 전투력 재계산.
		        if isvalid(cp) then cp:CalculateCurrentCombatPower() end
	end

	method string GetPlayerJob(Entity entity)
		        -- 직업: 플레이어별 CombatPowerManager.CurrentJob(@Sync). 전역 currentJob은 마지막 선택자 값이라
		        --   멀티 랭킹/결과카드가 전원 같은 직업으로 오표시됐다 → per-piece 값으로 교체.
		        if isvalid(entity) then
		            local cp = entity:GetComponent("script.CombatPowerManager")
		            if isvalid(cp) and cp.CurrentJob ~= nil and cp.CurrentJob ~= "" then return cp.CurrentJob end
		        end
		        return "--"
	end

	method string GetPlayerCamp(Entity entity)
		        -- 진영: BuffManager.CampName(미선택/미부착 시 '--').
		        if isvalid(entity) then
		            local buff = entity:GetComponent("script.BuffManager")
		            if isvalid(buff) and buff.CampName ~= nil and buff.CampName ~= "" then return buff.CampName end
		        end
		        return "--"
	end

	method string GetPlayerName(Entity entity)
		        if isvalid(entity) and entity.PlayerComponent ~= nil then
		            local nick = entity.PlayerComponent.Nickname
		            if nick ~= nil and nick ~= "" then return nick end
		            return entity.PlayerComponent.UserId
		        end
		        return "?"
	end

	@ExecSpace("Server")
	method void MoveToNextMap(Entity piece, string nextMapName)
		if not isvalid(piece) then return end
		
				-- 1. 다음 맵 엔티티 찾기
				local nextMapEntity = _EntityService:GetEntityByPath("/maps/" .. nextMapName)
				if not isvalid(nextMapEntity) then
-- 					log_error("[GameModeManager] 다음 맵을 찾을 수 없습니다: " .. nextMapName)
					return
				end
		
				-- 2. 해당 맵으로 텔레포트 (전환 직전 로딩 오버레이로 새 맵 pop-in을 가린다)
				if piece.PlayerComponent ~= nil then
					_LoadingManager:ShowLoadingAndPreload(piece.PlayerComponent.UserId)
				end
				local spawnPos = Vector3(0, 0, 0)
		
				local startTile = _TileManager:GetTileEntity(nextMapName, "Tile_1")
				
				if isvalid(startTile) then
					spawnPos = startTile.TransformComponent.WorldPosition
				else
-- 					log_warning("[GameModeManager] 시작 타일 미발견 → (0,0,0) 폴백: " .. nextMapName .. "_Tile_1")
				end
		
				_TeleportService:TeleportToMapPosition(piece, spawnPos, nextMapEntity.Name)
				
				-- 다른 맵 도착 연출: '점프'하는 느낌(공중 포즈 + 수직 홉). 텔레포트 동기화 여유로 약간 지연.
				local jumpUid = ""
				if piece.PlayerComponent ~= nil then jumpUid = piece.PlayerComponent.UserId end
				_TimerService:SetTimerOnce(function()
					self:PlayMapJumpFor(piece, jumpUid)
				end, 0.3)
		
				-- 3. 이동력 및 위치 변수 초기화
				local pm = piece:GetComponent("script.PlayerMovement")
				if isvalid(pm) then
					pm.currentTile = "Tile_1"
					pm.remainingSteps = 0
					pm:ChangePlayerState("IDLE")
				end
		
				-- 새 맵(스테이지) 시작 시 서 있는 시작 타일의 레벨을 즉시 적용(진입 즉시 반영, 이동 불필요).
				-- nextMapName을 명시 전달: 텔레포트 직후 piece.CurrentMapName은 아직 이전 맵일 수 있음.
				-- ★ 레벨업 게이트: 시작 타일로 레벨이 오르면(맵 진입은 상위 스테이지라 보통 상승),
				--   직업(Map_02)/인생분기(Map_03) 선택창보다 '먼저' 레벨업 배너를 띄우고, 배너가 닫힌 뒤 선택창을 연다.
				--   (Map_02/03 선택창 트리거는 PlayerMovement.UpdateMapUI에서 이 게이트로 이관됨. Map_01 진영은 레벨업이 없어 UpdateMapUI가 그대로 담당.)
				local ownerUid = ""
				if piece.PlayerComponent ~= nil and piece.PlayerComponent.UserId ~= nil then
					ownerUid = piece.PlayerComponent.UserId
				end
				local lvPeek = _TileManager:PeekStartTile(piece, nextMapName)
				_TileManager:ApplyStartTileLevel(piece, nextMapName)
				if ownerUid ~= "" then
					_LevelUpCelebration:Gate(piece, lvPeek.up, lvPeek.level, function()
						self:ShowMapSelectionFor(nextMapName, ownerUid)
						-- 레벨업 배너가 닫힌 뒤에 턴을 시작한다(배너가 열려 있는 동안 주사위 단계가 시작되는 레이스 방지).
						-- 타일 수집 여유를 위해 소폭 지연(기존 타이머 목적 유지).
						_TimerService:SetTimerOnce(function()
							_SingleTurnManager:Start()
						end, 1.0)
					end)
				else
					-- 소유자 없는 예외(게이트를 못 탐): 기존처럼 지연 후 시작.
					_TimerService:SetTimerOnce(function()
						_SingleTurnManager:Start()
					end, 1.0)
				end
		
				-- (턴 시작은 위 레벨업 게이트 콜백/소유자없음 분기에서 처리 — 여기서 중복 시작하지 않는다.)
	end

	@ExecSpace("Client")
	method void ShowMapSelectionFor(string mapName)
		-- 맵 진입 선택창을 소유 플레이어 클라에 표시(레벨업 배너가 닫힌 뒤 게이트에서 호출됨).
		-- Map_01(진영)은 싱글 오프닝 Lv.10 배너 뒤에 열도록 여기서 처리(억제 플래그 해제 후 표시).
		-- Map_02(직업)/Map_03(인생분기)는 맵 전환 레벨업 배너 뒤에 열린다.
		if mapName == "Map_01" then
			_LevelUpCelebration:ClearOpeningCampPending()
			_CampSelectUI:ShowSelectPanel()
		elseif mapName == "Map_02" then
			_JobWeaponManager:ShowJobSelect()
		elseif mapName == "Map_03" then
			_LifePathSelectUI:ShowSelectPanel()
		end
	end

	@ExecSpace("Client")
	method void PlayMapJumpFor(Entity piece)
		-- 다른 맵으로 이동 시 '점프' 느낌: 공중 포즈 + 위로 떴다 착지하는 홉.
		if isvalid(piece) == false then return end
		local pos = piece.TransformComponent.WorldPosition
		local ground = Vector2(pos.x, pos.y)
		local apex = Vector2(pos.x, pos.y + 1.2)
		
		-- 공중(낙하) 포즈
		local fall = BodyActionStateChangeEvent()
		fall.ActionState = MapleAvatarBodyActionState.Fall
		fall.needResetAction = true
		piece:SendEvent(fall)
		_SFXManager:PlayJump()   -- 점프 효과음
		
		-- 위로 떴다(감속) → 내려오며(가속) 착지 → 착지 시 Stand 복귀
		local up = _TweenLogic:MoveTo(piece, apex, 0.22, EaseType.QuadEaseOut)
		up:SetOnEndCallback(function()
			local down = _TweenLogic:MoveTo(piece, ground, 0.22, EaseType.QuadEaseIn)
			down:SetOnEndCallback(function()
				local land = BodyActionStateChangeEvent()
				land.ActionState = MapleAvatarBodyActionState.Stand
				land.needResetAction = true
				piece:SendEvent(land)
			end)
		end)
-- 		log("[GameModeManager] 맵 이동 점프 연출 재생")
	end

end