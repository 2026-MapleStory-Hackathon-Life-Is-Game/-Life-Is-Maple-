@Logic
script VillageEventFlowManager extends Logic

	-- 스테이지1 '첫 마을 이벤트(첫 인사)' 고정 소진 여부를 '플레이어별'로 추적한다(userId → true).
	-- @Logic은 월드 전역 싱글턴이라, 예전처럼 단일 boolean이면 한 플레이어가 소진하면 나머지 전원이 잠겨
	-- 다른 플레이어는 첫 인사가 건너뛰어졌다(멀티 버그). 서버 전용 판정이라 동기화 없는 일반 테이블로 둔다.
	property any _stage1FirstDone = nil

	method string DecodeText(string raw)
		-- CSV에 '\n' 리터럴로 저장한 줄바꿈을 실제 개행으로 복원한다(셀을 한 물리 행으로 유지하기 위함).
		if raw == nil then return "" end
		local s = raw
		-- CSV 라운드트립으로 셀 양끝에 따옴표가 남는 경우가 있어, 통째로 감싼 따옴표 1쌍만 제거한다.
		if #s >= 2 and string.sub(s, 1, 1) == "\"" and string.sub(s, #s, #s) == "\"" then
			s = string.sub(s, 2, #s - 1)
		end
		local out, _cnt = string.gsub(s, "\\n", "\n")
		return out
	end

	method string RollEvent(integer stage, string region, boolean isLastVillage)
		-- VillageEventFlow에서 (Stage,Region) + 배치조건 일치 행을 Weight 가중치로 1개 추첨 → EventId. 없으면 "".
		-- 같은 (Stage,Region) 이벤트가 여러 개면 가중치에 따라 그중 하나가 랜덤 선택된다.
		-- Placement 컬럼: ""=항상 / "last"=마지막 마을칸에만 / "notlast"=마지막 마을칸 제외.
		local ds = _DataService:GetTable("VillageEventFlow")
		if isvalid(ds) == false then return "" end
		local rows = ds:GetRowCount()
		local function match(i)
			if (tonumber(ds:GetCell(i, "Stage")) or 0) ~= stage then return false end
			if ds:GetCell(i, "Region") ~= region then return false end
			local pl = ds:GetCell(i, "Placement")
			if pl == "last" and isLastVillage == false then return false end
			if pl == "notlast" and isLastVillage == true then return false end
			return true
		end
		local total = 0
		for i = 1, rows do
			if match(i) then total += (tonumber(ds:GetCell(i, "Weight")) or 0) end
		end
		if total <= 0 then return "" end
		local roll = _UtilLogic:RandomIntegerRange(1, total)
		local acc = 0
		for i = 1, rows do
			if match(i) then
				acc += (tonumber(ds:GetCell(i, "Weight")) or 0)
				if roll <= acc then return ds:GetCell(i, "EventId") end
			end
		end
		return ""
	end

	@ExecSpace("ServerOnly")
	method void ResetStage1Lock()
		-- 새 게임 시작 시 호출 → 스테이지1 첫 마을 이벤트 강제 잠금을 전 플레이어에 대해 푼다.
		self._stage1FirstDone = {}
	end

	method string FirstFlowEvent(integer stage, string region)
		-- VillageEventFlow에서 (Stage,Region) 일치 '첫 행'의 EventId(표 순서상 1번 플로우). 없으면 "".
		local ds = _DataService:GetTable("VillageEventFlow")
		if isvalid(ds) == false then return "" end
		for i = 1, ds:GetRowCount() do
			if (tonumber(ds:GetCell(i, "Stage")) or 0) == stage and ds:GetCell(i, "Region") == region then
				return ds:GetCell(i, "EventId")
			end
		end
		return ""
	end

	@ExecSpace("ServerOnly")
	method string RollEventForArrival(integer stage, string region, boolean isLastVillage, string userId)
		-- 마을 타일 도착 시 호출. 스테이지1의 '첫' 마을 이벤트는 1번 플로우로 고정, 그 외엔 가중치 추첨.
		-- isLastVillage: 이 타일이 해당 지역의 마지막 마을칸인지(리멘 최종칸 고정/제외 배치용).
		-- userId: 도착 플레이어. 스테이지1 첫 인사 고정은 '플레이어별'로 1회만 적용한다(멀티에서 각자 첫 인사를 보게).
		if self._stage1FirstDone == nil then self._stage1FirstDone = {} end
		if stage == 1 and userId ~= "" and self._stage1FirstDone[userId] ~= true then
			local forced = self:FirstFlowEvent(1, region)
			if forced ~= "" then
				self._stage1FirstDone[userId] = true
-- 				log("[VillageEventFlow] 스테이지1 첫 마을 이벤트 고정 user=" .. userId .. " → " .. forced)
				return forced
			end
		end
		-- 골드리치 특별 이벤트: 스테이지2의 '모든 마을칸'에서 지역 무관 0.6% 확률로 등장(지역 추첨보다 우선).
		--   ALL_GOLDRICH_01 은 Region="All"(실제 타일 지역과 겹치지 않음) + Weight=0 이라 일반 지역 추첨엔 절대 안 뽑힌다.
		if stage == 2 and _UtilLogic:RandomDouble() < 0.006 then
-- 			log("[VillageEventFlow] 골드리치 특별 이벤트 발생(0.6%) region=" .. tostring(region))
			return "ALL_GOLDRICH_01"
		end
		return self:RollEvent(stage, region, isLastVillage)
	end

	method integer FirstScene(string eventId)
		-- 해당 이벤트의 시작 씬 Seq. 없으면 0.
		local ds = _DataService:GetTable("VillageEventFlow")
		if isvalid(ds) == false then return 0 end
		for i = 1, ds:GetRowCount() do
			if ds:GetCell(i, "EventId") == eventId then
				return tonumber(ds:GetCell(i, "FirstScene")) or 0
			end
		end
		return 0
	end

	method string EventNPC(string eventId)
		-- 해당 이벤트의 등장 NPC 키. 없으면 "".
		local ds = _DataService:GetTable("VillageEventFlow")
		if isvalid(ds) == false then return "" end
		for i = 1, ds:GetRowCount() do
			if ds:GetCell(i, "EventId") == eventId then
				return ds:GetCell(i, "NPC")
			end
		end
		return ""
	end

	method table GetScene(string eventId, integer seq)
		-- 씬 1행을 table로 반환. 없으면 nil.
		--   { anim, nodeType("text"/"choice"/"roll"), nextSeq, branchGroup, reward, text }
		local ds = _DataService:GetTable("VillageEventFlowScene")
		if isvalid(ds) == false then return nil end
		for i = 1, ds:GetRowCount() do
			if ds:GetCell(i, "EventId") == eventId and (tonumber(ds:GetCell(i, "Seq")) or -1) == seq then
				return {
					anim        = ds:GetCell(i, "PlayerAnim"),
					nodeType    = ds:GetCell(i, "NodeType"),
					nextSeq     = ds:GetCell(i, "Next"),
					branchGroup = ds:GetCell(i, "BranchGroup"),
					reward      = ds:GetCell(i, "Reward"),
					npcKey      = ds:GetCell(i, "NpcKey"),
					text        = self:DecodeText(ds:GetCell(i, "Text")),
				}
			end
		end
		return nil
	end

	method table GetRollProbabilities(string branchGroup)
		-- 확률게임 분기 그룹별 대성공/성공/실패 확률(%) 테이블. 없으면 nil(→ 분기 Weight 폴백).
		-- 합이 100이 아니어도 RollResultDiceUI.NormalizeProbabilities가 실패를 조정해 100에 맞춘다.
		local t = {
			SUGAR01_TRAIN  = { great = 30, success = 70, fail = 0 },   -- 맵1 슈가: 성공70 / 대성공30
			HELENA01_TRAIN = { great = 20, success = 70, fail = 10 },  -- 맵2 헬레나: 대성공20 / 성공70 / 실패10
			-- 스테이지2 마을 확률게임(기획: 실패20 / 성공60 / 대성공20).
			IPHIA01_HELP      = { great = 20, success = 60, fail = 20 },  -- 사자왕성 이피아 호위
			ALISIA01_GUARDIAN = { great = 20, success = 60, fail = 20 },  -- 루타비스 봉인의 수호자
		}
		return t[branchGroup]
	end

	method string RollBranch(string branchGroup)
		-- VillageEventFlowBranch에서 BranchGroup 일치 행을 Weight 가중치로 추첨 → BranchKey.
		-- (선택지 행은 Weight=0 으로 두어 확률 추첨에서 제외된다.) 없으면 "".
		local ds = _DataService:GetTable("VillageEventFlowBranch")
		if isvalid(ds) == false then return "" end
		local rows = ds:GetRowCount()
		local total = 0
		for i = 1, rows do
			if ds:GetCell(i, "BranchGroup") == branchGroup then
				total += (tonumber(ds:GetCell(i, "Weight")) or 0)
			end
		end
		if total <= 0 then return "" end
		local roll = _UtilLogic:RandomIntegerRange(1, total)
		local acc = 0
		for i = 1, rows do
			if ds:GetCell(i, "BranchGroup") == branchGroup then
				acc += (tonumber(ds:GetCell(i, "Weight")) or 0)
				if roll <= acc then return ds:GetCell(i, "BranchKey") end
			end
		end
		return ""
	end

	method table GetBranch(string branchGroup, string branchKey)
		-- 분기 1행을 table로 반환. 없으면 nil.
		--   { weight, label, nextScene, reward, resultText }
		local ds = _DataService:GetTable("VillageEventFlowBranch")
		if isvalid(ds) == false then return nil end
		for i = 1, ds:GetRowCount() do
			if ds:GetCell(i, "BranchGroup") == branchGroup and ds:GetCell(i, "BranchKey") == branchKey then
				return {
					weight     = tonumber(ds:GetCell(i, "Weight")) or 0,
					label      = self:DecodeText(ds:GetCell(i, "Label")),
					nextScene  = ds:GetCell(i, "NextScene"),
					reward     = ds:GetCell(i, "Reward"),
					resultText = self:DecodeText(ds:GetCell(i, "ResultText")),
				}
			end
		end
		return nil
	end

	method table GetChoices(string branchGroup)
		-- 선택지(choice) 노드용: BranchGroup 일치 행 전체를 { key, label, nextScene } 목록으로 반환.
		local list = {}
		local ds = _DataService:GetTable("VillageEventFlowBranch")
		if isvalid(ds) == false then return list end
		for i = 1, ds:GetRowCount() do
			if ds:GetCell(i, "BranchGroup") == branchGroup then
				table.insert(list, {
					key       = ds:GetCell(i, "BranchKey"),
					label     = self:DecodeText(ds:GetCell(i, "Label")),
					nextScene = ds:GetCell(i, "NextScene"),
				})
			end
		end
		return list
	end

	method table GetRollBranches(string branchGroup)
		-- 확률게임(roll) 분기들을 '표 순서대로' 전체 반환: { {key, weight, nextScene, reward, resultText}, ... }
		-- 표 순서가 곧 결과 등급(첫 분기=성공, 둘째=대성공). 확률은 Weight에서 파생한다.
		local list = {}
		local ds = _DataService:GetTable("VillageEventFlowBranch")
		if isvalid(ds) == false then return list end
		for i = 1, ds:GetRowCount() do
			if ds:GetCell(i, "BranchGroup") == branchGroup then
				table.insert(list, {
					key        = ds:GetCell(i, "BranchKey"),
					weight     = tonumber(ds:GetCell(i, "Weight")) or 0,
					nextScene  = ds:GetCell(i, "NextScene"),
					reward     = ds:GetCell(i, "Reward"),
					resultText = self:DecodeText(ds:GetCell(i, "ResultText")),
				})
			end
		end
		return list
	end

	method table ParseReward(string rewardStr)
		-- 보상 인코딩 "all:10;attack:10" → { {kind="all", mode="flat", value=10, raw="10"}, ... }.
		-- 빈 문자열이면 빈 목록. kind 는 main/all/attack/damage/crit/boss/str/dex/int/luk (EventTileBase.ApplyReward 와 동일).
		-- 퍼센트 보상은 kind 뒤에 '%'를 붙인다: "attack%:5" → mode="percent"(공격력 5% 증가), "main%:5;attack%:5" 등.
		--   (main/all/attack 만 percent 모드를 실제 지원 — BaseTile.AddMainStat/AddAllStat/AddMainAttack.)
		-- 아이템 지급: "item:EquipName"(정해진 장비) / "weapon:Family"(직업별 무기, 예 weapon:Fafnir). 이때 raw에 문자열이 담긴다.
		local list = {}
		if rewardStr == nil or rewardStr == "" then return list end
		for pair in string.gmatch(rewardStr, "[^;]+") do
			local sep, _e = string.find(pair, ":")
			if sep ~= nil then
				local kind = string.sub(pair, 1, sep - 1)
				local val = string.sub(pair, sep + 1)
				local mode = "flat"
				-- kind 끝의 '%' → 퍼센트 모드(그리고 '%' 제거해 순수 kind로).
				if #kind > 0 and string.sub(kind, #kind, #kind) == "%" then
					mode = "percent"
					kind = string.sub(kind, 1, #kind - 1)
				end
				-- raw = 콜론 뒤 원문(아이템/무기 지급용 문자열). 스탯 보상은 value(number)를 쓴다.
				table.insert(list, { kind = kind, mode = mode, value = tonumber(val) or 0, raw = val })
			end
		end
		return list
	end

end