@Component
script RomanceTile extends BaseTile

	property any _piece = nil

	property string _eventId = ""

	property integer _seq = 0

	property integer _pendingNext = 0

	property string _selectMode = ""

	property string _selectedPartnerKey = ""

	property string _selectedDateKey = ""

	property table _partnerKeys = {}

	property table _dateKeys = {}

	method boolean IsEventTile()
		-- 이벤트 팝업 UI를 띄우는 타일 → 턴 매니저가 완료 신호를 기다린다.
		return true
	end

	method boolean IsInteractiveTile()
		-- '다음'/선택 클릭으로 완료되는 인터랙티브 타일 → 5초 고정 대기 대신 완료 신호를 기다린다.
		return true
	end

	method any Romance(Entity piece)
		-- 말(piece)의 RomanceManager 컴포넌트를 반환한다.
		return piece:GetComponent("script.RomanceManager")
	end

	method string OwnerUserId(Entity piece)
		-- 말(piece)의 소유 유저 ID를 반환한다. 플레이어 엔티티가 아니면 "".
		if isvalid(piece.PlayerComponent) == false then return "" end
		local uid = piece.PlayerComponent.UserId
		if uid == nil then return "" end
		return uid
	end

	method string DecodeText(string raw)
		-- CSV에 '\n' 리터럴로 저장한 줄바꿈을 실제 개행으로 복원한다(셀 양끝 감싼 따옴표 1쌍도 제거).
		if raw == nil then return "" end
		local s = raw
		if #s >= 2 and string.sub(s, 1, 1) == "\"" and string.sub(s, #s, #s) == "\"" then
			s = string.sub(s, 2, #s - 1)
		end
		local out, _cnt = string.gsub(s, "\\n", "\n")
		return out
	end

	method string GetText(string key)
		-- RomanceDialogue에서 Key 일치 행의 Text를 개행 복원해 반환. 없으면 "".
		if key == nil or key == "" then return "" end
		local ds = _DataService:GetTable("RomanceDialogue")
		if isvalid(ds) == false then return "" end
		for i = 1, ds:GetRowCount() do
			if ds:GetCell(i, "Key") == key then
				return self:DecodeText(ds:GetCell(i, "Text"))
			end
		end
		log_warning("[RomanceTile] 대사 키 없음: " .. tostring(key))
		return ""
	end

	method string PartnerName(string key)
		-- RomancePartner에서 Key 일치 행의 DisplayName을 반환. 없으면 key 원문.
		if key == nil or key == "" then return "" end
		local ds = _DataService:GetTable("RomancePartner")
		if isvalid(ds) == false then return key end
		for i = 1, ds:GetRowCount() do
			if ds:GetCell(i, "Key") == key then
				local disp = ds:GetCell(i, "DisplayName")
				if disp == nil or disp == "" then return key end
				return disp
			end
		end
		return key
	end

	method string PartnerBossKey(any rm)
		-- 선택한 연애 상대(rm.Partner)의 BossImage 키(BossName)를 RomancePartner.BossKey에서 조회한다.
		-- 이 키를 NpcInfoManager:GetNpcRUID에 넘기면 BossImage.IngameStandRUID로 해석돼 NPCImage에 상대 보스 스프라이트가 뜬다.
		local key = ""
		if isvalid(rm) then key = rm.Partner end
		if self._selectedPartnerKey ~= "" then key = self._selectedPartnerKey end
		if key == nil or key == "" then return "" end
		local ds = _DataService:GetTable("RomancePartner")
		if isvalid(ds) == false then return "" end
		for i = 1, ds:GetRowCount() do
			if ds:GetCell(i, "Key") == key then
				local bk = ds:GetCell(i, "BossKey")
				if bk == nil then return "" end
				return bk
			end
		end
		return ""
	end

	method string DateCell(string key, string column)
		-- RomanceDate에서 Key 일치 행의 지정 컬럼 값을 반환. 없으면 "".
		local ds = _DataService:GetTable("RomanceDate")
		if isvalid(ds) == false then return "" end
		for i = 1, ds:GetRowCount() do
			if ds:GetCell(i, "Key") == key then
				return ds:GetCell(i, column)
			end
		end
		return ""
	end

	method string Fill(string text, any rm)
		-- {partner}/{place} 치환. ({placedesc}는 등급 확정 후 FillPlaceDesc에서 별도 처리)
		local s = text or ""
		local partner = ""
		if isvalid(rm) then partner = self:PartnerName(rm.Partner) end
		if self._selectedPartnerKey ~= "" then partner = self:PartnerName(self._selectedPartnerKey) end
		-- ⚠ 치환 문자열에 '%'가 있으면(버프 설명 "20%" 등) string.gsub 문자열-치환이 에러난다.
		--   → 함수형 치환(반환값을 리터럴로 사용)으로 '%'를 안전하게 처리한다.
		local o1, _c1 = string.gsub(s, "{partner}", function() return partner end)
		local place = ""
		if self._selectedDateKey ~= "" then place = self:DateCell(self._selectedDateKey, "DisplayName") end
		local o2, _c2 = string.gsub(o1, "{place}", function() return place end)
		return o2
	end

	method string FillPlaceDesc(string text, integer tier)
		-- {placedesc}를 데이트 장소·등급별 버프 설명으로 치환한다(대성공=Great / 성공=Success).
		if string.find(text, "{placedesc}", 1, true) == nil then return text end
		local desc = ""
		if self._selectedDateKey ~= "" then
			if tier == 2 then desc = self:DateCell(self._selectedDateKey, "GreatDesc")
			else desc = self:DateCell(self._selectedDateKey, "SuccessDesc") end
		end
		local out, _c = string.gsub(text, "{placedesc}", function() return desc end)
		return out
	end

	method table Step(string eventId, integer seq)
		-- (eventId, seq) → 씬 정의 { node, next, key, group }. 없으면 nil.
		--   node : "text"/"partnerselect"/"dateselect"/"roll"
		--   next : 다음 seq(0=종료) / key : 대사 키 / group : roll 씬의 확률 그룹("SELECT"/"DATE")
		if eventId == "SELECT" then
			if seq == 1 then return { node = "text",          next = 2, key = "SELECT_1" } end
			if seq == 2 then return { node = "text",          next = 3, key = "SELECT_2" } end
			if seq == 3 then return { node = "partnerselect", next = 4, key = "SELECT_PICK" } end
			if seq == 4 then return { node = "text",          next = 5, key = "SELECT_3" } end
			if seq == 5 then return { node = "roll",          next = 0, key = "SELECT_LEAD", group = "SELECT" } end
		elseif eventId == "MARRY" then
			if seq == 1 then return { node = "text", next = 2, key = "MARRY_1" } end
			if seq == 2 then return { node = "text", next = 3, key = "MARRY_2" } end
			if seq == 3 then return { node = "text", next = 0, key = "MARRY_3" } end
		elseif eventId == "DATE" then
			if seq == 1 then return { node = "dateselect", next = 2, key = "DATE_1" } end
			if seq == 2 then return { node = "roll",       next = 0, key = "DATE_LEAD", group = "DATE" } end
		elseif eventId == "UNION" then
			if seq == 1 then return { node = "text", next = 2, key = "UNION_1" } end
			if seq == 2 then return { node = "text", next = 3, key = "UNION_2" } end
			if seq == 3 then return { node = "text", next = 0, key = "UNION_3" } end
		end
		return nil
	end

	@ExecSpace("ServerOnly")
	method void OnArrive(Entity piece)
		-- 연애 타일 도착: RomanceManager 스테이지로 이벤트를 골라 첫 씬부터 재생한다.
		self._piece = piece
		self._selectedPartnerKey = ""
		self._selectedDateKey = ""
		self._selectMode = ""
		local ownerId = self:OwnerUserId(piece)
		local rm = self:Romance(piece)
		if ownerId == "" or isvalid(rm) == false then
			log_warning("[RomanceTile] 소유자/RomanceManager 없음 → 즉시 종료")
			self:FinishEvent()
			return
		end
		
		local eventId = "DATE"
		if rm.Stage == 0 then
			eventId = "SELECT"
		elseif rm.Stage == 1 then
			eventId = "MARRY"
		elseif rm.FamilyMembers >= 2 and rm.UnionCreated == false then
			eventId = "UNION"
		end
		
		-- 텍스트 전용 이벤트(결혼/유니온)의 기계 처리는 진입 시 적용(대사는 결과를 서술만 한다).
		if eventId == "MARRY" then
			local buff = self:Buff(piece)
			if isvalid(buff) then buff:SetBuff("Wedding_Fanfare") end
			if isvalid(rm) then rm:CompleteMarry() end
		elseif eventId == "UNION" then
			local buff = self:Buff(piece)
			if isvalid(buff) then buff:SetBuff("Union_Power") end
			if isvalid(rm) then rm:CreateUnion() end
		end
		
		self._eventId = eventId
		self._seq = 1
		log("[RomanceTile] 연애 이벤트 시작 event=" .. eventId .. " stage=" .. tostring(rm.Stage))
		self:PlayScene()
	end

	@ExecSpace("ServerOnly")
	method void PlayScene()
		-- 현재 _seq 씬을 해석해 종류별로 클라에 표시를 지시한다(text/partnerselect/dateselect/roll).
		local piece = self._piece
		if isvalid(piece) == false then self:FinishEvent() return end
		if self._seq <= 0 then self:FinishEvent() return end
		
		local rm = self:Romance(piece)
		local step = self:Step(self._eventId, self._seq)
		if step == nil then
			log_warning("[RomanceTile] 씬 없음 event=" .. self._eventId .. " seq=" .. tostring(self._seq))
			self:FinishEvent()
			return
		end
		
		local ownerId = self:OwnerUserId(piece)
		local text = self:Fill(self:GetText(step.key), rm)
		-- 등장 NPC 키. GetNpcRUID가 NpcInfo → BossImage 순으로 RUID를 찾는다.
		--   SELECT/UNION → 용잡이 Ms.어카운트(NpcInfo 키 = "MsAccount")
		--   MARRY/DATE(연인 이벤트) → 선택한 연애 상대의 BossImage 키(BossName) → 그 보스의 인게임 stand 스프라이트.
		local npcKey = "MsAccount"
		if self._eventId == "MARRY" or self._eventId == "DATE" then
			npcKey = self:PartnerBossKey(rm)
			if npcKey == "" then npcKey = "Romance" end   -- 매핑 없으면 기본 이미지 유지
		end
		
		if step.node == "partnerselect" then
			-- 상대 카드 선택창(연애/길드 공용 UI): RomancePartner 전체 행을 슬롯에 채운다.
			self._selectMode = "partner"
			self._pendingNext = step.next
			local ds = _DataService:GetTable("RomancePartner")
			local names = {}
			local ruids = {}
			self._partnerKeys = {}
			if isvalid(ds) then
				for i = 1, ds:GetRowCount() do
					self._partnerKeys[i] = ds:GetCell(i, "Key")
					names[i] = ds:GetCell(i, "DisplayName")
					ruids[i] = ds:GetCell(i, "ImageRUID")
				end
			end
			self:ClientShowSelect(text, names, ruids, ownerId)
			_RomanceGuildSelectUI:SpectatorShow(text, names, ruids, ownerId)
		
		elseif step.node == "dateselect" then
			-- 데이트 장소 선택(EventTileUI 다지선다): RomanceDate 전체 행을 버튼 라벨로 채운다.
			self._selectMode = "date"
			self._pendingNext = step.next
			local ds = _DataService:GetTable("RomanceDate")
			local labels = {}
			self._dateKeys = {}
			if isvalid(ds) then
				for i = 1, ds:GetRowCount() do
					self._dateKeys[i] = ds:GetCell(i, "Key")
					labels[i] = ds:GetCell(i, "DisplayName")
				end
			end
			self:ClientShowDateChoices(text, "idle", labels, npcKey, ownerId)
			_EventTileUI:SpectatorSceneChoices(text, "idle", labels, npcKey, ownerId)
		
		elseif step.node == "roll" then
			self:PlayRoll(piece, rm, step, ownerId, npcKey, text)
		
		else
			-- text
			self._pendingNext = step.next
			self:ClientShowText(text, "idle", npcKey, ownerId)
			_EventTileUI:SpectatorSceneText(text, "idle", npcKey, ownerId)
		end
	end

	method table RollProb(string group)
		-- 확률게임 그룹별 대성공/성공/실패 확률(%). 연애는 고정 밸런스라 코드 상수로 둔다.
		if group == "SELECT" then return { great = 30, success = 70, fail = 0 } end
		-- DATE
		return { great = 20, success = 60, fail = 20 }
	end

	@ExecSpace("ServerOnly")
	method void PlayRoll(Entity piece, any rm, table step, string ownerId, string npcKey, string leadText)
		-- 확률게임: 그룹별 고정 확률로 결과판 판정 → 이벤트별 보상 적용 → 결과 문구 표시.
		local prob = self:RollProb(step.group)
		local greatPct = prob.great
		local successPct = prob.success
		local failPct = prob.fail
		
		local board = _ResultDiceManager:PlaceOutcomes(failPct, successPct, greatPct)
		local d1 = _UtilLogic:RandomIntegerRange(1, 6)
		local d2 = _UtilLogic:RandomIntegerRange(1, 6)
		local sum = d1 + d2
		local tier = board[sum] or 1
		
		-- tier: 0=실패 / 1=성공 / 2=대성공 → 결과 대사 키 + 라벨.
		local outcomeLabel = "성공"
		local resultKey = step.group .. "_SUCCESS"
		if tier == 0 then
			outcomeLabel = "실패"
			resultKey = step.group .. "_FAIL"
		elseif tier == 2 then
			outcomeLabel = "대성공"
			resultKey = step.group .. "_GREAT"
		end
		
		-- 이벤트별 기계 처리(스탯/버프/스테이지/가족).
		self:ApplyRollMechanics(piece, rm, step.group, tier)
		
		local resultText = self:Fill(self:GetText(resultKey), rm)
		resultText = self:FillPlaceDesc(resultText, tier)
		self._pendingNext = step.next
		log("[RomanceTile] 확률게임 group=" .. step.group
			.. " 확률(대/성/실)=" .. tostring(greatPct) .. "/" .. tostring(successPct) .. "/" .. tostring(failPct)
			.. " 주사위=" .. tostring(d1) .. "+" .. tostring(d2) .. "=" .. tostring(sum) .. " → " .. outcomeLabel)
		self:ClientShowRoll(leadText, "idle", resultText, d1, d2, sum, greatPct, successPct, failPct, outcomeLabel, npcKey, ownerId)
			-- 주사위 보드는 actor가 리드를 넘겨 보드가 뜨는 순간(OnRollLeadDone)에 방송된다. 여기선 씬 리드 미러만.
		_EventTileUI:SpectatorSceneRoll(leadText, resultText, "idle", npcKey, ownerId)
	end

	@ExecSpace("ServerOnly")
	method void ApplyRollMechanics(Entity piece, any rm, string group, integer tier)
		-- 롤 등급(0실패/1성공/2대성공)에 따른 이벤트별 스탯·버프·스테이지 처리.
		if group == "SELECT" then
			-- 성공/대성공 공통 기본 보상: 주스탯 +30, 공/마 +10.
			self:AddMainStat(piece, "flat", 30)
			self:AddMainAttack(piece, "flat", 10)
			local buff = self:Buff(piece)
			if tier == 2 then
				-- 대성공: 즉시 결혼 + 웨딩 팡파르.
				if isvalid(rm) then rm:MarryNow() end
				if isvalid(buff) then buff:SetBuff("Wedding_Fanfare") end
			else
				-- 성공: 다음 연애 칸에서 자동 결혼 대기.
				if isvalid(rm) then rm:SetPendingMarry() end
			end
		elseif group == "DATE" then
			if tier <= 0 then return end
			local buff = self:Buff(piece)
			if tier == 2 then
				-- 대성공: 장소별 대성공 버프(3턴) + 가족 +1 + 주스탯 +30%.
				local gb = self:DateCell(self._selectedDateKey, "GreatBuff")
				if isvalid(buff) then buff:SetBuff(gb) end
				if isvalid(rm) then rm:SetDateBuff(gb, 3) rm:AddFamilyMember() end
				self:AddMainStat(piece, "percent", 30)
			else
				-- 성공: 장소별 성공 버프(3턴).
				local sb = self:DateCell(self._selectedDateKey, "SuccessBuff")
				if isvalid(buff) then buff:SetBuff(sb) end
				if isvalid(rm) then rm:SetDateBuff(sb, 3) end
			end
		end
	end

	@ExecSpace("Server")
	method void RequestAdvance()
		-- text/roll 씬 '다음' → 예약된 다음 씬으로 이동. 도착 플레이어만 허용.
		local piece = self._piece
		if isvalid(piece) == false then return end
		if senderUserId ~= self:OwnerUserId(piece) then return end
		self._seq = self._pendingNext
		if self._seq <= 0 then self:FinishEvent() else self:PlayScene() end
	end

	@ExecSpace("Server")
	method void RequestChoice(integer index)
		-- 선택 콜백. _selectMode 로 상대 카드선택 / 데이트 장소선택을 분기한다. 도착 플레이어만 허용.
		local piece = self._piece
		if isvalid(piece) == false then return end
		if senderUserId ~= self:OwnerUserId(piece) then return end
		local rm = self:Romance(piece)
		
		if self._selectMode == "partner" then
			local key = ""
			if self._partnerKeys ~= nil and index >= 1 and index <= #self._partnerKeys then
				key = self._partnerKeys[index]
			end
			if key == "" then
				log_warning("[RomanceTile] 상대 선택 인덱스 무효(index=" .. tostring(index) .. ") → 종료")
				self:FinishEvent()
				return
			end
			self._selectedPartnerKey = key
			if isvalid(rm) then rm:SelectPartner(key) end
			self:ClientHideSelect(self:OwnerUserId(piece))
			_RomanceGuildSelectUI:SpectatorHide(self:OwnerUserId(piece))
			self._selectMode = ""
			self._seq = self._pendingNext
			if self._seq <= 0 then self:FinishEvent() else self:PlayScene() end
		
		elseif self._selectMode == "date" then
			local key = ""
			if self._dateKeys ~= nil and index >= 1 and index <= #self._dateKeys then
				key = self._dateKeys[index]
			end
			if key == "" then
				log_warning("[RomanceTile] 데이트 장소 인덱스 무효(index=" .. tostring(index) .. ") → 종료")
				self:FinishEvent()
				return
			end
			self._selectedDateKey = key
			self._selectMode = ""
			self._seq = self._pendingNext
			if self._seq <= 0 then self:FinishEvent() else self:PlayScene() end
		end
	end

	@ExecSpace("ServerOnly")
	method void FinishEvent()
		-- 이벤트 종료: 도착 플레이어 클라 UI 닫기 + 상태 초기화 + 턴 진행 신호.
		local ownerId = ""
		if isvalid(self._piece) then ownerId = self:OwnerUserId(self._piece) end
		self._piece = nil
		self._eventId = ""
		self._seq = 0
		self._pendingNext = 0
		self._selectMode = ""
		if ownerId ~= "" then self:ClientHide(ownerId) end
		if ownerId ~= "" then _EventTileUI:SpectatorSceneHide(ownerId) end
		_GameModeManager:NotifyTileEventDone()
		log("[RomanceTile] 연애 이벤트 종료")
	end

	@ExecSpace("Client")
	method void ClientShowSelect(string title, table names, table ruids)
		-- 연애 상대 선택창(연애/길드 공용 UI) 표시. 카드 클릭 → self:RequestChoice(index).
		_RomanceGuildSelectUI:Show(title, names, ruids, self)
	end

	@ExecSpace("Client")
	method void ClientHideSelect()
		-- 연애 상대 선택창 닫기.
		_RomanceGuildSelectUI:Hide()
	end

	@ExecSpace("Client")
	method void ClientShowDateChoices(string text, string anim, table labels, string npcKey)
		-- 데이트 장소 선택창(EventTileUI 다지선다) 표시. 버튼 클릭 → self:RequestChoice(index).
		_EventTileUI:SceneChoices(text, anim, labels, npcKey, self)
	end

	@ExecSpace("Client")
	method void ClientShowText(string text, string anim, string npcKey)
		-- 텍스트 씬 표시(콜백용 self 전달). '다음' → self:RequestAdvance().
		_EventTileUI:SceneText(text, anim, npcKey, self)
	end

	@ExecSpace("Client")
	method void ClientShowRoll(string leadText, string anim, string resultText, integer d1, integer d2, integer diceTotal, number greatPct, number successPct, number failPct, string outcomeLabel, string npcKey)
		-- roll 씬: 리드텍스트 → 주사위 연출 → 결과텍스트 → '다음'(RequestAdvance).
		_EventTileUI:SceneRoll(leadText, anim, resultText, d1, d2, diceTotal, greatPct, successPct, failPct, outcomeLabel, npcKey, self)
	end

	@ExecSpace("Client")
	method void ClientHide()
		-- 도착 플레이어 클라: 이벤트 UI 그룹을 닫는다.
