@Component
script RomanceTile extends BaseTile

	-- 연애 이벤트 타일. 지역과 무관하게 플레이어별로 연애상대선택 → 결혼 → (데이트/유니온창설 반복) 순으로 진행한다.
	-- per-player 진행 상태는 말(piece)의 RomanceManager가 보유하고, 이 타일은 상태에 따라 UI/보상만 구동한다.
	--   상대선택 : 길드와 같은 5지선다 선택창(RomanceGuildSelectUI) → 상대 확정 후
	--              dicepanel 룰렛(실패:성공:대성공 = 0:30:70). 기본 보상 주스탯+30·공/마+10은 성공/대성공 공통.
	--              대성공 → 즉시 결혼 + '웨딩 팡파르'(공/마+30). 성공 → 다음 연애 칸에서 자동 결혼.
	--   결혼     : (성공 경로) 자동 결혼 텍스트 + '웨딩 팡파르'(공/마+30 동일).
	--   데이트   : 장소 3택(펫 산책로/심신 수련관/라무라무 온천) → 판정(실패:성공:대성공=20:60:20).
	--              성공/대성공 시 장소별 3턴 지속 버프 획득(RomanceManager가 턴 카운트→소멸). 신규 데이트 시 교체.
	--              대성공 → 가족 구성원 +1, 주스탯 +10(영구 누적). 가족 2명 이상 → 다음 방문 시 유니온 창설.
	--   유니온창설 : 현재 자동진행 텍스트 스텁(보상 추후 상세).
	-- 인터랙티브 타일: 상대선택/데이트는 선택창→SceneRoll(주사위), 결혼/유니온은 ShowEventText(텍스트)를 재사용하고,
	-- '다음' 클릭(RequestAdvance/RequestDone)에서 _GameModeManager:NotifyTileEventDone()로 턴 진행을 신호한다.

	-- 진행 중인 도착 플레이어(서버 상태). 턴제라 동시 1명.
	property any _piece = nil
	-- 이번 상대 선택창의 슬롯별 후보 Key(RomancePartner 행 순서). 선택 인덱스 → Key 매핑용.
	property table _partnerKeys = {}
	-- 이번 데이트 장소 선택창의 슬롯별 장소 Key(RomanceDate 행 순서). 선택 인덱스 → Key 매핑용.
	property table _dateKeys = {}

	method boolean IsEventTile()
		-- 이벤트 팝업 UI를 띄우는 타일 → 턴 매니저가 완료 신호를 기다린다.
		return true
	end

	method boolean IsInteractiveTile()
		-- '다음' 클릭으로 완료되는 인터랙티브 타일 → 5초 고정 대기 대신 완료 신호를 기다린다.
		return true
	end

	method any Romance(Entity piece)
		-- 말(piece)의 RomanceManager 컴포넌트를 반환한다.
		return piece:GetComponent("script.RomanceManager")
	end

	method string OwnerUserId(Entity piece)
		-- 말(piece)의 소유 유저 ID를 반환한다. 플레이어 엔티티가 아니면 "".
		if isvalid(piece.PlayerComponent) == false then return "" end
		local uid = piece.PlayerComponent.UserId
		if uid == nil then return "" end
		return uid
	end

	method number RomancePct(string outcome)
		-- RomanceProbability에서 Outcome 행의 Weight를 % 확률로 읽는다(합 100 전제). 없으면 0.
		local ds = _DataService:GetTable("RomanceProbability")
		if isvalid(ds) == false then return 0 end
		for i = 1, ds:GetRowCount() do
			if ds:GetCell(i, "Outcome") == outcome then
				return tonumber(ds:GetCell(i, "Weight")) or 0
			end
		end
		return 0
	end

	method string PartnerName(string key)
		-- RomancePartner에서 Key 일치 행의 DisplayName을 반환. 없으면 key 원문.
		if key == nil or key == "" then return "" end
		local ds = _DataService:GetTable("RomancePartner")
		if isvalid(ds) == false then return key end
		for i = 1, ds:GetRowCount() do
			if ds:GetCell(i, "Key") == key then
				local disp = ds:GetCell(i, "DisplayName")
				if disp == nil or disp == "" then return key end
				return disp
			end
		end
		return key
	end

	@ExecSpace("ServerOnly")
	method void OnArrive(Entity piece)
		-- 연애 타일 도착: 플레이어의 RomanceManager 단계로 분기해 해당 이벤트를 구동한다.
		self._piece = piece
		local ownerId = self:OwnerUserId(piece)
		local rm = self:Romance(piece)
		if ownerId == "" or isvalid(rm) == false then
			log_warning("[RomanceTile] 소유자/RomanceManager 없음 → 즉시 종료")
			self:FinishEvent()
			return
		end

		if rm.Stage == 0 then
			self:DoSelect(piece, rm, ownerId)
		elseif rm.Stage == 1 then
			self:DoMarry(piece, rm, ownerId)
		elseif rm.FamilyMembers >= 2 and rm.UnionCreated == false then
			-- 데이트 대성공으로 가족 2명 이상 → 유니온 창설(1회).
			self:DoUnion(piece, rm, ownerId)
		else
			self:DoDate(piece, rm, ownerId)
		end
	end

	@ExecSpace("ServerOnly")
	method void DoSelect(Entity piece, any rm, string ownerId)
		-- 연애상대선택: RomancePartner 전체 행을 5지선다 선택창(연애/길드 공용 UI)에 채워 표시한다.
		-- 실제 진행/보상은 선택(RequestChoice)에서 슬롯 Key로 룰렛을 굴려 확정한다.
		local ds = _DataService:GetTable("RomancePartner")
		if isvalid(ds) == false then
			log_error("[RomanceTile] RomancePartner 데이터셋 없음 → 상대선택 스킵")
			self:FinishEvent()
			return
		end
		local names = {}
		local ruids = {}
		self._partnerKeys = {}
		local rows = ds:GetRowCount()
		for i = 1, rows do
			self._partnerKeys[i] = ds:GetCell(i, "Key")
			names[i] = ds:GetCell(i, "DisplayName")
			ruids[i] = ds:GetCell(i, "ImageRUID")
		end
		log("[RomanceTile] 연애 상대 선택창 표시 (후보 " .. tostring(rows) .. "명)")
		self:ClientShowSelect("연애 상대를 선택하세요", names, ruids, ownerId)
	end

	@ExecSpace("Server")
	method void RequestChoice(integer index)
		-- 선택 콜백. 스테이지로 분기: 0 → 연애상대 선택(RomanceGuildSelectUI), 2+ → 데이트 장소 선택(EventTileUI).
		local piece = self._piece
		if isvalid(piece) == false then return end
		if senderUserId ~= self:OwnerUserId(piece) then return end

		local rm = self:Romance(piece)
		if isvalid(rm) and rm.Stage >= 2 then
			-- 데이트 장소 선택 → 판정/버프 처리.
			self:HandleDateChoice(piece, rm, index)
			return
		end

		-- 이하 연애상대 선택(Stage 0): 슬롯 index → 상대 확정 후 룰렛(0:30:70).
		local key = ""
		if self._partnerKeys ~= nil and index >= 1 and index <= #self._partnerKeys then
			key = self._partnerKeys[index]
		end
		if key == "" then
			log_warning("[RomanceTile] 상대 선택 인덱스 무효(index=" .. tostring(index) .. ") → 종료")
			self:FinishEvent()
			return
		end
		if isvalid(rm) then rm:SelectPartner(key) end
		local partnerName = self:PartnerName(key)

		local ownerId = self:OwnerUserId(piece)
		-- 선택창을 닫고 룰렛(주사위) 연출로 전환한다.
		self:ClientHideSelect(ownerId)

		-- 확률 → 2d6 결과판(실패0/성공1/대성공2) + 실제 주사위 롤.
		local failPct = self:RomancePct("Fail")
		local successPct = self:RomancePct("Success")
		local greatPct = self:RomancePct("Great")
		local board = _ResultDiceManager:PlaceOutcomes(failPct, successPct, greatPct)
		local d1 = _UtilLogic:RandomIntegerRange(1, 6)
		local d2 = _UtilLogic:RandomIntegerRange(1, 6)
		local total = d1 + d2
		local tier = board[total] or 1

		-- 기본 보상(성공/대성공 공통): 주스탯+30, 공/마+10 (영구 동적 수치).
		self:AddMainStat(piece, "flat", 30)
		self:AddMainAttack(piece, "flat", 10)

		local buff = self:Buff(piece)
		local lead = partnerName .. "에게 마음을 전하기 위해 주사위를 굴린다!"
		local resultText = ""
		local outcomeLabel = "성공"
		if tier == 2 then
			outcomeLabel = "대성공"
			if isvalid(rm) then rm:MarryNow() end
			if isvalid(buff) then buff:SetBuff("Wedding_Fanfare") end
			resultText = "대성공! " .. partnerName .. "와(과) 곧바로 결혼했다.\n"
				.. "웨딩 팡파르가 울려퍼져 공격력/마력이 크게 올랐다!\n"
				.. "(기본 보상: 주스탯 +30, 공격력/마력 +10)"
		else
			outcomeLabel = "성공"
			if isvalid(rm) then rm:SetPendingMarry() end
			resultText = "성공! " .. partnerName .. "와(과) 연인이 되었다.\n"
				.. "다음 연애 칸에 도착하면 결혼식이 열린다.\n"
				.. "(기본 보상: 주스탯 +30, 공격력/마력 +10)"
		end
		log("[RomanceTile] 상대선택 롤 " .. tostring(d1) .. "+" .. tostring(d2) .. "=" .. tostring(total) .. " → " .. outcomeLabel)
		self:ClientShowRoll(lead, "idle", resultText, d1, d2, total, greatPct, successPct, failPct, outcomeLabel, "Romance", ownerId)
	end

	@ExecSpace("ServerOnly")
	method void DoMarry(Entity piece, any rm, string ownerId)
		-- 결혼(성공 경로): 자동으로 결혼하고 '웨딩 팡파르'(공/마+30)를 획득한다.
		local partnerName = self:PartnerName(rm.Partner)
		local buff = self:Buff(piece)
		if isvalid(buff) then buff:SetBuff("Wedding_Fanfare") end
		if isvalid(rm) then rm:CompleteMarry() end
		log("[RomanceTile] 결혼 이벤트 진행 (상대=" .. tostring(rm.Partner) .. ")")
		local msg = "드디어 " .. partnerName .. "와(과)의 결혼식 날이다!\n"
			.. "웨딩 팡파르가 울려퍼져 공격력/마력이 크게 올랐다!"
		self:ClientShowText(msg, ownerId)
	end

	@ExecSpace("ServerOnly")
	method void DoDate(Entity piece, any rm, string ownerId)
		-- 데이트: 장소 3택 선택창을 띄운다. 실제 판정/버프는 선택(RequestChoice→HandleDateChoice)에서 처리한다.
		local ds = _DataService:GetTable("RomanceDate")
		if isvalid(ds) == false then
			log_error("[RomanceTile] RomanceDate 데이터셋 없음 → 데이트 스킵")
			self:FinishEvent()
			return
		end
		local labels = {}
		self._dateKeys = {}
		local rows = ds:GetRowCount()
		for i = 1, rows do
			self._dateKeys[i] = ds:GetCell(i, "Key")
			labels[i] = ds:GetCell(i, "DisplayName")
		end
		log("[RomanceTile] 데이트 장소 선택창 표시 (" .. tostring(rows) .. "곳)")
		self:ClientShowDateChoices("데이트 장소를 선택하세요", labels, ownerId)
	end

	method number DatePct(string outcome)
		-- DateProbability에서 Outcome 행의 Weight를 % 확률로 읽는다(합 100 전제). 없으면 0.
		local ds = _DataService:GetTable("DateProbability")
		if isvalid(ds) == false then return 0 end
		for i = 1, ds:GetRowCount() do
			if ds:GetCell(i, "Outcome") == outcome then
				return tonumber(ds:GetCell(i, "Weight")) or 0
			end
		end
		return 0
	end

	method string DateCell(string key, string column)
		-- RomanceDate에서 Key 일치 행의 지정 컬럼 값을 반환. 없으면 "".
		local ds = _DataService:GetTable("RomanceDate")
		if isvalid(ds) == false then return "" end
		for i = 1, ds:GetRowCount() do
			if ds:GetCell(i, "Key") == key then
				return ds:GetCell(i, column)
			end
		end
		return ""
	end

	@ExecSpace("ServerOnly")
	method void HandleDateChoice(Entity piece, any rm, integer index)
		-- 데이트 장소 선택 콜백. index → 장소 확정 → 판정(20:60:20) → 장소·등급별 3턴 버프 부여.
		local key = ""
		if self._dateKeys ~= nil and index >= 1 and index <= #self._dateKeys then
			key = self._dateKeys[index]
		end
		if key == "" then
			log_warning("[RomanceTile] 데이트 장소 인덱스 무효(index=" .. tostring(index) .. ") → 종료")
			self:FinishEvent()
			return
		end
		local ownerId = self:OwnerUserId(piece)
		local placeName = self:DateCell(key, "DisplayName")
		local successBuff = self:DateCell(key, "SuccessBuff")
		local greatBuff = self:DateCell(key, "GreatBuff")

		-- 판정(실패:성공:대성공 = 20:60:20) → 2d6 결과판.
		local failPct = self:DatePct("Fail")
		local successPct = self:DatePct("Success")
		local greatPct = self:DatePct("Great")
		local board = _ResultDiceManager:PlaceOutcomes(failPct, successPct, greatPct)
		local d1 = _UtilLogic:RandomIntegerRange(1, 6)
		local d2 = _UtilLogic:RandomIntegerRange(1, 6)
		local total = d1 + d2
		local tier = board[total] or 0

		local buff = self:Buff(piece)
		local lead = placeName .. "에서 데이트를 시작한다!\n주사위를 굴려 데이트의 성패가 갈린다."
		local resultText = ""
		local outcomeLabel = "실패"
		if tier == 2 then
			outcomeLabel = "대성공"
			-- 3턴 버프(대성공) + 신규 데이트 시 기존 버프 교체(Date 슬롯, 같은 Tier).
			if isvalid(buff) then buff:SetBuff(greatBuff) end
			if isvalid(rm) then rm:SetDateBuff(greatBuff, 3) end
			-- 대성공 추가 보상: 가족 +1, 주스탯 +10(영구 누적).
			if isvalid(rm) then rm:AddFamilyMember() end
			self:AddMainStat(piece, "flat", 10)
			resultText = "대성공! " .. placeName .. " 데이트가 완벽했다.\n"
				.. "3턴 동안 지속되는 데이트 버프를 얻었다!\n"
				.. "가족 구성원이 늘고, 주스탯이 +10 올랐다."
			if isvalid(rm) and rm.FamilyMembers >= 2 and rm.UnionCreated == false then
				resultText = resultText .. "\n가족이 " .. tostring(rm.FamilyMembers)
					.. "명! 다음 연애 칸에서 메이플 유니온을 창설한다."
			end
		elseif tier == 1 then
			outcomeLabel = "성공"
			if isvalid(buff) then buff:SetBuff(successBuff) end
			if isvalid(rm) then rm:SetDateBuff(successBuff, 3) end
			resultText = "성공! " .. placeName .. " 데이트가 즐거웠다.\n"
				.. "3턴 동안 지속되는 데이트 버프를 얻었다!"
		else
			outcomeLabel = "실패"
			resultText = placeName .. " 데이트가 아쉽게 끝났다...\n이번엔 버프를 얻지 못했다."
		end
		log("[RomanceTile] 데이트(" .. placeName .. ") 롤 " .. tostring(d1) .. "+" .. tostring(d2)
			.. "=" .. tostring(total) .. " → " .. outcomeLabel)
		self:ClientShowRoll(lead, "idle", resultText, d1, d2, total, greatPct, successPct, failPct, outcomeLabel, "Romance", ownerId)
	end

	@ExecSpace("ServerOnly")
	method void DoUnion(Entity piece, any rm, string ownerId)
		-- 유니온 창설: 가족 2명 이상일 때 1회 발생. '유니온의 힘' 버프(공/마+30, 웨딩과 별도 중첩) 획득.
		if isvalid(rm) then rm:CreateUnion() end
		local buff = self:Buff(piece)
		if isvalid(buff) then buff:SetBuff("Union_Power") end
		local fam = 0
		if isvalid(rm) then fam = rm.FamilyMembers end
		log("[RomanceTile] 유니온 창설 (가족 " .. tostring(fam) .. "명) → 유니온의 힘 획득")
		local msg = "가족과 함께 메이플 유니온을 창설했다!\n"
			.. "'유니온의 힘'을 얻어 공격력/마력이 +30 올랐다!\n"
			.. "(이후 데이트가 계속된다)"
		self:ClientShowText(msg, ownerId)
	end

	@ExecSpace("Client")
	method void ClientShowSelect(string title, table names, table ruids)
		-- 연애 상대 선택창(연애/길드 공용 UI) 표시. 카드 클릭 → self:RequestChoice(index).
		_RomanceGuildSelectUI:Show(title, names, ruids, self)
	end

	@ExecSpace("Client")
	method void ClientHideSelect()
		-- 연애 상대 선택창 닫기.
		_RomanceGuildSelectUI:Hide()
	end

	@ExecSpace("Client")
	method void ClientShowDateChoices(string title, table labels)
		-- 데이트 장소 선택창(EventTileUI 다지선다) 표시. 버튼 클릭 → self:RequestChoice(index).
		_EventTileUI:SceneChoices(title, "idle", labels, "Romance", self)
	end

	@ExecSpace("Client")
	method void ClientShowRoll(string leadText, string anim, string resultText, integer d1, integer d2, integer diceTotal, number greatPct, number successPct, number failPct, string outcomeLabel, string npcKey)
		-- 상대선택 dicepanel: 리드텍스트 → 주사위 연출 → 결과텍스트 → '다음'(RequestAdvance). (GuildTile 롤 흐름 재사용)
		_EventTileUI:SceneRoll(leadText, anim, resultText, d1, d2, diceTotal, greatPct, successPct, failPct, outcomeLabel, npcKey, self)
	end

	@ExecSpace("Client")
	method void ClientShowText(string message)
		-- 결혼/데이트: 이미지 없는 텍스트 팝업 + '다음'(RequestDone).
		_EventTileUI:ShowEventText(message, "idle", "", "", "", self)
	end

	@ExecSpace("Client")
	method void ClientHide()
		-- 도착 플레이어 클라: 이벤트 UI 그룹을 닫는다.
		_EventTileUI:SceneHide()
	end

	@ExecSpace("Server")
	method void RequestAdvance()
		-- 상대선택 dicepanel '다음' → 이벤트 종료. 도착 플레이어만 허용.
		local piece = self._piece
		if isvalid(piece) and senderUserId ~= self:OwnerUserId(piece) then return end
		self:FinishEvent()
	end

	@ExecSpace("Server")
	method void RequestDone()
		-- 결혼/데이트 텍스트 '다음' → 이벤트 종료. 도착 플레이어만 허용.
		local piece = self._piece
		if isvalid(piece) and senderUserId ~= self:OwnerUserId(piece) then return end
		self:FinishEvent()
	end

	@ExecSpace("ServerOnly")
	method void FinishEvent()
		-- 이벤트 종료: 도착 플레이어 클라 UI 닫기 + 상태 정리 + 턴 진행 신호.
		local ownerId = ""
		if isvalid(self._piece) then ownerId = self:OwnerUserId(self._piece) end
		self._piece = nil
		if ownerId ~= "" then self:ClientHide(ownerId) end
		_GameModeManager:NotifyTileEventDone()
		log("[RomanceTile] 이벤트 종료")
	end

end
