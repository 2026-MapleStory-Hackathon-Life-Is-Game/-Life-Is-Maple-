@Component
script HuntTile extends EventTileBase

	-- 사냥터 이름. 이후 테이블 연동 시 교체. 지금은 임시값.
	@Sync
	property string HuntingGround = "헤네시스 사냥터1"

	method table RollEvent(Entity piece)
		-- 사냥 이벤트를 서버에서 굴린다.
		--   {n}분(10~120) 동안 사냥 → 주스탯/올스탯 +{gain}(1~10).
		-- 문구에 쓴 gain/statName을 그대로 보상 필드로 반환해, 화면 문구와 실제 적용 스탯이 일치하게 한다.
		local minutes = _UtilLogic:RandomIntegerRange(10, 120)
		local gain    = _UtilLogic:RandomIntegerRange(1, 10)

		-- 올스탯(true) / 주스탯(false) 중 하나.
		local isAllStat = (_UtilLogic:RandomIntegerRange(1, 2) == 2)
		local statName  = "주스탯"
		if isAllStat then
			statName = "올스탯"
		end

		local line1 = self.HuntingGround .. "에서 " .. tostring(minutes) .. "분동안 몬스터를 사냥했다!"
		local line2 = statName .. "이 " .. tostring(gain) .. "만큼 올랐다!"

		local statKind = "main"
		if isAllStat then
			statKind = "all"
		end

		return {
			eventType = "Hunt",
			message   = line1 .. "\n" .. line2,
			statKind  = statKind,   -- "main"=주스탯 / "all"=올스탯
			statMode  = "flat",     -- 고정 수치 증가
			statValue = gain,       -- 문구에 표시한 상승치와 동일
		}
	end

end
