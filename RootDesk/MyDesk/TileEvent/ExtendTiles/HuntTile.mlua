@Component
script HuntTile extends BaseTile

	@ExecSpace("ServerOnly")
	method void OnArrive(Entity piece)
		-- ⚠️ base 직접 수정(영구): cp:HuntStat() → AddMainStat(base). 동적 버프(self:Add~) 아님.
		local cp = self:CP(piece)
		if isvalid(cp) then cp:HuntStat() end
		log("[HuntTile] 사냥 칸 효과 적용 tile=" .. self.Entity.Name)
	end

end