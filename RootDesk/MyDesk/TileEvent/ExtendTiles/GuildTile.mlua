@Component
script GuildTile extends EventTileBase

	property any _piece = nil

	property string _event = ""

	property integer _seq = 0

	property integer _pendingNext = 0

	property string _curNodeType = ""

	property table _viceChoices = {}

	property table _viceNames = {}

	property table _viceRuids = {}

	method boolean IsInteractiveTile()
		-- 버튼/진행 입력으로 완료되는 인터랙티브 타일 → 턴 매니저가 완료 신호를 기다린다.
		return true
	end

	method any Guild(Entity piece)
		-- 말(piece)의 GuildManager 컴포넌트를 반환한다.
		return piece:GetComponent("script.GuildManager")
	end

	method integer GuildFirstSeq(string event)
		-- 해당 Event의 최소 Seq(진행 시작점). 없으면 0.
		local ds = _DataService:GetTable("GuildDialog")
		if isvalid(ds) == false then return 0 end
		local best = 0
		for i = 1, ds:GetRowCount() do
			if ds:GetCell(i, "Event") == event then
				local s = tonumber(ds:GetCell(i, "Seq")) or 0
				if s > 0 and (best == 0 or s < best) then best = s end
			end
		end
		return best
	end

	method table GuildNode(string event, integer seq)
		-- text/roll/vice 노드 행(결과 행 제외) 1개 → table. 없으면 nil.
		--   { type, nextSeq, npcKey, reward, text }
		local ds = _DataService:GetTable("GuildDialog")
		if isvalid(ds) == false then return nil end
		for i = 1, ds:GetRowCount() do
			if ds:GetCell(i, "Event") == event and (tonumber(ds:GetCell(i, "Seq")) or -1) == seq then
				local t = ds:GetCell(i, "Type")
				if t == "text" or t == "roll" or t == "vice" then
					return {
						type    = t,
						nextSeq = ds:GetCell(i, "Next"),
						npcKey  = ds:GetCell(i, "Npc"),
						reward  = ds:GetCell(i, "Reward"),
						text    = _VillageEventFlowManager:DecodeText(ds:GetCell(i, "Text")),
					}
				end
			end
		end
		return nil
	end

	method table GuildOutcomes(string event, integer seq)
		-- 같은 Event+Seq를 공유하는 롤 결과 행들: { {key(success/great/fail), weight, nextSeq, reward, resultText}, ... }
		local list = {}
		local ds = _DataService:GetTable("GuildDialog")
		if isvalid(ds) == false then return list end
		for i = 1, ds:GetRowCount() do
			if ds:GetCell(i, "Event") == event and (tonumber(ds:GetCell(i, "Seq")) or -1) == seq then
				local t = ds:GetCell(i, "Type")
				if t == "success" or t == "great" or t == "fail" then
					table.insert(list, {
						key        = t,
						weight     = tonumber(ds:GetCell(i, "Weight")) or 0,
						nextSeq    = ds:GetCell(i, "Next"),
						reward     = ds:GetCell(i, "Reward"),
						resultText = _VillageEventFlowManager:DecodeText(ds:GetCell(i, "Text")),
					})
				end
			end
		end
		return list
	end

	@ExecSpace("ServerOnly")
	method void ApplyGuildReward(Entity piece, string rewardStr)
		-- 보상 문자열을 파싱해 길드 상태변경/버프 토큰은 직접 처리하고, 스탯/아이템/큐브는 베이스에 위임한다.
		if rewardStr == nil or rewardStr == "" then return end
		local rewards = _VillageEventFlowManager:ParseReward(rewardStr)
		local gm = self:Guild(piece)
		for i = 1, #rewards do
			local r = rewards[i]
			if r.kind == "guildcreate" then
				if isvalid(gm) then gm:CreateGuild(r.value) end
			elseif r.kind == "guildvice" then
				if isvalid(gm) then gm:CompleteVice() end
			elseif r.kind == "guildmember" then
				if isvalid(gm) then gm:AddMember() end
			elseif r.kind == "guildpromote" then
				if isvalid(gm) then gm:Promote() end
			elseif r.kind == "buff" then
				local buff = self:Buff(piece)
				if isvalid(buff) then buff:SetBuff(r.raw) end
			elseif r.kind == "item" then
				self:GrantItem(piece, r.raw)
			elseif r.kind == "weapon" then
				self:GrantClassWeapon(piece, r.raw)
			elseif r.kind == "cube" then
				self:GrantCube(piece, r.value)
			else
				self:ApplyReward(piece, { statKind = r.kind, statMode = r.mode or "flat", statValue = r.value })
			end
		end
	end

	@ExecSpace("ServerOnly")
	method void OnArrive(Entity piece)
		-- 길드 타일 도착: GuildManager 상태 → Event로 라우팅해 첫 씬부터 재생한다.
		self._piece = piece
		self._curNodeType = ""
		self._viceChoices = {}
		local ownerId = self:OwnerUserId(piece)
		local gm = self:Guild(piece)
		if ownerId == "" or isvalid(gm) == false then
			log_warning("[GuildTile] 소유자/GuildManager 없음 → 즉시 종료")
			self:FinishEvent()
			return
		end
		
		local event = "member"
		if gm.Stage == 0 then
			event = "create"
		elseif gm.Stage == 1 then
			event = "vice"
		elseif gm.PromotionPending then
			event = "promote"
		end
		self._event = event
		self._seq = self:GuildFirstSeq(event)
		if self._seq <= 0 then
			log_warning("[GuildTile] 길드 이벤트 씬 없음 event=" .. event)
			self:FinishEvent()
			return
		end
		log("[GuildTile] 길드 이벤트 시작 event=" .. event .. " firstSeq=" .. tostring(self._seq))
		self:PlayScene()
	end

	@ExecSpace("ServerOnly")
	method void PlayScene()
		-- 현재 _seq 노드를 해석해 종류별로 클라에 표시를 지시한다(text/roll/vice).
		local piece = self._piece
		if isvalid(piece) == false then self:FinishEvent() return end
		if self._seq <= 0 then self:FinishEvent() return end
		
		local node = self:GuildNode(self._event, self._seq)
		if node == nil then
			log_warning("[GuildTile] 노드 없음 event=" .. self._event .. " seq=" .. tostring(self._seq))
			self:FinishEvent()
			return
		end
		
		-- 노드 자체 보상(예: 승급 노드의 guildpromote + 축복 강화).
		if node.reward ~= nil and node.reward ~= "" then
			self:ApplyGuildReward(piece, node.reward)
		end
		
		local ownerId = self:OwnerUserId(piece)
		-- 길드 이벤트의 등장 NPC는 항상 관리자 레아(NpcInfo 키 "Lea"). GuildDialog.Npc가 비어 있으면
		-- 이전/다음 씬 이미지를 그대로 따라가므로, 빈 값은 "Lea"로 기본 지정해 전부 레아가 뜨게 한다.
		local npcKey = node.npcKey
		if npcKey == nil or npcKey == "" then npcKey = "Lea" end
		self._curNodeType = node.type
		
		if node.type == "vice" then
			-- 부길마 선택 노드: 직업군별 랜덤 후보로 5칸 카드 선택창 표시 → RequestChoice(index).
			self:PrepareVice()
			self:ClientShowViceSelect("부길드마스터를 영입하세요", self._viceNames, self._viceRuids, ownerId)
		
		elseif node.type == "roll" then
			-- 확률게임: 같은 Event+Seq의 결과 행(success/great/fail)에서 확률(Weight)·보상·결과문을 읽는다.
			local outcomes = self:GuildOutcomes(self._event, self._seq)
			local byKey = {}
			local greatPct = 0
			local successPct = 0
			local failPct = 0
			for i = 1, #outcomes do
				byKey[outcomes[i].key] = outcomes[i]
				if outcomes[i].key == "great" then greatPct = outcomes[i].weight
				elseif outcomes[i].key == "success" then successPct = outcomes[i].weight
				elseif outcomes[i].key == "fail" then failPct = outcomes[i].weight end
			end
			-- 서버 판정과 클라 결과판을 일치시키기 위해 동일 규칙으로 실패 보정(합계 100).
			local np = _RollResultDiceAnimationUI:NormalizeProbabilities(greatPct, successPct, failPct)
			greatPct = np.great
			successPct = np.success
			failPct = np.fail
		
			local board = _ResultDiceManager:PlaceOutcomes(failPct, successPct, greatPct)
			local d1 = _UtilLogic:RandomIntegerRange(1, 6)
			local d2 = _UtilLogic:RandomIntegerRange(1, 6)
			local sum = d1 + d2
			local tier = board[sum] or 1
		
			local outcomeLabel = "성공"
			local chosen = byKey["success"]
			if tier == 0 then
				outcomeLabel = "실패"
				chosen = byKey["fail"]
			elseif tier == 2 then
				outcomeLabel = "대성공"
				chosen = byKey["great"]
			end
			if chosen == nil then chosen = byKey["success"] end
			if chosen == nil and #outcomes > 0 then chosen = outcomes[1] end
		
			local resultText = ""
			if chosen ~= nil then
				if chosen.reward ~= nil and chosen.reward ~= "" then
					self:ApplyGuildReward(piece, chosen.reward)
				end
				resultText = chosen.resultText
				self._pendingNext = tonumber(chosen.nextSeq) or 0
			else
				self._pendingNext = 0
			end
			log("[GuildTile] 확률게임 event=" .. self._event .. " seq=" .. tostring(self._seq)
				.. " 주사위=" .. tostring(d1) .. "+" .. tostring(d2) .. "=" .. tostring(sum) .. " → " .. outcomeLabel)
			-- 길드 롤(창설/신규 길드원 가입)은 outcome 기반: 성공/대성공=웃음, 실패=울음.
			self:ClientShowRoll(node.text, "idle", resultText, d1, d2, sum, greatPct, successPct, failPct, outcomeLabel, npcKey, ownerId)
		
		else
			-- text
			self._pendingNext = tonumber(node.nextSeq) or 0
			self:ClientShowText(node.text, "idle", npcKey, ownerId)
		end
	end

	@ExecSpace("ServerOnly")
	method void PrepareVice()
		-- 부길마 후보 준비: 직업군(전사/마법사/궁수/도적/해적)당 1명 랜덤 → 슬롯 Key/이름/사진 보관.
		self._viceChoices = {}
		self._viceNames = {}
		self._viceRuids = {}
		local ds = _DataService:GetTable("ViceMaster")
		if isvalid(ds) == false then return end
		local groups = { "전사", "마법사", "궁수", "도적", "해적" }
		for gi = 1, #groups do
			local pool = {}
			for i = 1, ds:GetRowCount() do
				if ds:GetCell(i, "JobGroup") == groups[gi] then table.insert(pool, i) end
			end
			if #pool > 0 then
				local pick = pool[_UtilLogic:RandomIntegerRange(1, #pool)]
				self._viceChoices[gi] = ds:GetCell(pick, "Key")
				self._viceNames[gi] = ds:GetCell(pick, "DisplayName")
				self._viceRuids[gi] = ds:GetCell(pick, "ImageRUID")
			else
				self._viceChoices[gi] = ""
				self._viceNames[gi] = ""
				self._viceRuids[gi] = ""
			end
		end
	end

	@ExecSpace("Server")
	method void RequestAdvance()
		-- text/roll 씬 '다음' → 예약된 다음 씬으로 이동(0이면 종료). 도착 플레이어만 허용.
		local piece = self._piece
		if isvalid(piece) == false then return end
		if senderUserId ~= self:OwnerUserId(piece) then return end
		self._seq = self._pendingNext
		if self._seq <= 0 then self:FinishEvent() else self:PlayScene() end
	end

	@ExecSpace("Server")
	method void RequestChoice(integer index)
		-- 부길마 선택 콜백(RomanceGuildSelectUI). 슬롯 index → 확정 Key로 스탯 적용 + 부길마 완료 + 결과 문구.
		local piece = self._piece
		if isvalid(piece) == false then return end
		if senderUserId ~= self:OwnerUserId(piece) then return end
		if self._curNodeType ~= "vice" then return end
		
		local key = ""
		if self._viceChoices ~= nil and index >= 1 and index <= #self._viceChoices then
			key = self._viceChoices[index]
		end
		local row = self:FindViceRow(key)
		if row == 0 then
			log_warning("[GuildTile] 부길마 선택 인덱스 무효(index=" .. tostring(index) .. ") → 종료")
			self:FinishEvent()
			return
		end
		local ds = _DataService:GetTable("ViceMaster")
		local displayName = ds:GetCell(row, "DisplayName")
		local statKind = ds:GetCell(row, "StatKind")
		local statGain = tonumber(ds:GetCell(row, "StatGain")) or 0
		local attackGain = tonumber(ds:GetCell(row, "AttackGain")) or 0
		local flavor = ds:GetCell(row, "Flavor")
		
		if statKind ~= "" and statGain ~= 0 then self:AddSpecificStat(piece, statKind, statGain) end
		if attackGain ~= 0 then self:AddMainAttack(piece, "flat", attackGain) end
		local gm = self:Guild(piece)
		if isvalid(gm) then gm:CompleteVice() end
		log("[GuildTile] 부길마 영입 = " .. tostring(displayName)
			.. " (" .. tostring(statKind) .. "+" .. tostring(statGain) .. ", 공/마+" .. tostring(attackGain) .. ")")
		
		local ownerId = self:OwnerUserId(piece)
		self._curNodeType = ""
		self._pendingNext = 0
		self:ClientHideViceSelect(ownerId)
		-- 결과 문구: 데이터(ViceMaster.Flavor + 스탯)로 구성. '다음'(RequestAdvance) → 종료.
		local msg = "이 사람으로 결정했다!\n" .. tostring(flavor)
			.. "\n\n앞으로 길드 운영이 더 단단해질 것 같다!\n"
			.. self:StatLabel(statKind) .. "이 " .. tostring(statGain) .. "만큼 오르고 공격력/마력이 " .. tostring(attackGain) .. "만큼 올랐다."
		-- 부길마 선택 결과도 길드 이벤트이므로 등장 NPC는 레아로 고정. 길드원 영입 → 울음 표정.
		self:ClientViceResult(msg, ownerId)
	end

	@ExecSpace("ServerOnly")
	method void FinishEvent()
		-- 이벤트 종료: 클라 UI 닫기 + 상태 초기화 + 턴 진행 신호.
		local ownerId = ""
		if isvalid(self._piece) then ownerId = self:OwnerUserId(self._piece) end
		self._piece = nil
		self._event = ""
		self._seq = 0
		self._pendingNext = 0
		self._curNodeType = ""
		if ownerId ~= "" then self:ClientHide(ownerId) end
		_GameModeManager:NotifyTileEventDone()
		log("[GuildTile] 길드 이벤트 종료")
	end

	method string StatLabel(string kind)
		-- 스탯 키 → 표시용 라벨(결과 문구용).
		if kind == "str" then return "STR"
		elseif kind == "dex" then return "DEX"
		elseif kind == "int" then return "INT"
		elseif kind == "luk" then return "LUK"
		end
		return kind
	end

	method integer FindViceRow(string key)
		-- ViceMaster에서 Key 일치 행 인덱스. 없으면 0.
		local ds = _DataService:GetTable("ViceMaster")
		if isvalid(ds) == false or key == nil or key == "" then return 0 end
		for i = 1, ds:GetRowCount() do
			if ds:GetCell(i, "Key") == key then return i end
		end
		return 0
	end

	@ExecSpace("Client")
	method void ClientShowText(string text, string anim, string npcKey)
		-- 텍스트 씬 표시(콜백용 self 전달). '다음' → RequestAdvance. npcKey = 등장 NPC 이름 키(없으면 "").
		_EventTileUI:SceneText(text, anim, npcKey, self)
	end

	@ExecSpace("Client")
	method void ClientShowRoll(string leadText, string anim, string resultText, integer d1, integer d2, integer diceTotal, number greatPct, number successPct, number failPct, string outcomeLabel, string npcKey)
		-- roll 씬(리드 텍스트 → 주사위 연출 → 결과 문구) 표시. '다음' → RequestAdvance.
		_EventTileUI:SceneRoll(leadText, anim, resultText, d1, d2, diceTotal, greatPct, successPct, failPct, outcomeLabel, npcKey, self)
	end

	@ExecSpace("Client")
	method void ClientViceResult(string text)
		-- 부길마(길드원) 영입 결과: 텍스트 표시 + 웃음 표정(영입 성공 → 웃음).
		_EventTileUI:SceneText(text, "idle", "Lea", self)
		_EventTileUI:PortraitEmoteKind("happy")
	end

	@ExecSpace("Client")
	method void ClientShowViceSelect(string title, table names, table ruids)
		-- 부길마 선택 창(연애/길드 공용 UI) 표시. 카드 클릭 → self:RequestChoice(index).
		_RomanceGuildSelectUI:Show(title, names, ruids, self)
	end

	@ExecSpace("Client")
	method void ClientHideViceSelect()
		-- 부길마 선택 창 닫기.
		_RomanceGuildSelectUI:Hide()
	end

	@ExecSpace("Client")
	method void ClientHide()
		-- 이벤트 UI 그룹 닫기.
		_EventTileUI:SceneHide()
	end

end