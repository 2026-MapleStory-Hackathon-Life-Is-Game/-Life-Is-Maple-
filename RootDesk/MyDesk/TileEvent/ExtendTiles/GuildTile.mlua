@Component
script GuildTile extends BaseTile

	-- 길드 이벤트 타일. 지역과 무관하게 플레이어별로 진행:
	--   길드창설 → 부길마영입 → 길드원영입(반복) → (승급 조건 충족 시) 길드승급.
	-- per-player 진행 상태는 말(piece)의 GuildManager가 보유하고, 이 타일은 상태에 따라 UI/보상만 구동한다.
	--   창설    : 도입 2씬 + dicepanel(성공70/대성공30, 실패0). 레아 등장. 성공→초보 길드+축복, 대성공→마스터 길드+큰 축복.
	--   부길마영입: 도입 텍스트 → 5칸 선택창(직업군별 1명) → 선택 결과(스탯/성격 문구).
	--   길드원영입(반복): 도입 1씬 + dicepanel(실패20/성공60/대성공20). 성공/대성공 시 길드원+1 & 주스탯·공/마 % 영구 증가.
	--   길드승급 : 초보 길드가 2명 도달 시 다음 방문에서 승급 이벤트(레아 등장 3씬). Tier 상승 + 축복 강화는 여기서 적용.
	-- 인터랙티브 타일: 롤은 SceneRoll(주사위, 리드 텍스트 페이지 분할), 텍스트는 SceneText/ShowEventText 재사용.
	-- '다음' 클릭(RequestAdvance/RequestDone)에서 _GameModeManager:NotifyTileEventDone()로 턴 진행을 신호한다.

	-- 진행 중인 도착 플레이어(서버 상태). 턴제라 동시 1명.
	property any _piece = nil
	-- 이번 부길마 선택 창의 슬롯별 확정 후보 Key(직업군당 1명을 랜덤 선택해 채운다). 선택 인덱스 → Key 매핑용.
	property table _viceChoices = {}
	-- 진행 분기용 상태. "vice_intro"면 도입 텍스트 '다음' → 부길마 카드 선택창으로 이어진다(그 외 "" → 종료).
	property string _phase = ""

	method boolean IsEventTile()
		-- 이벤트 팝업 UI를 띄우는 타일 → 턴 매니저가 완료 신호를 기다린다.
		return true
	end

	method boolean IsInteractiveTile()
		-- '다음' 클릭으로 완료되는 인터랙티브 타일 → 5초 고정 대기 대신 완료 신호를 기다린다.
		return true
	end

	method any Guild(Entity piece)
		-- 말(piece)의 GuildManager 컴포넌트를 반환한다.
		return piece:GetComponent("script.GuildManager")
	end

	method string OwnerUserId(Entity piece)
		-- 말(piece)의 소유 유저 ID를 반환한다. 플레이어 엔티티가 아니면 "".
		if isvalid(piece.PlayerComponent) == false then return "" end
		local uid = piece.PlayerComponent.UserId
		if uid == nil then return "" end
		return uid
	end

	method number GuildPct(string outcome)
		-- GuildProbability에서 Outcome 행의 Weight를 % 확률로 읽는다(합 100 전제). 없으면 0.
		local ds = _DataService:GetTable("GuildProbability")
		if isvalid(ds) == false then return 0 end
		for i = 1, ds:GetRowCount() do
			if ds:GetCell(i, "Outcome") == outcome then
				return tonumber(ds:GetCell(i, "Weight")) or 0
			end
		end
		return 0
	end

	@ExecSpace("ServerOnly")
	method void OnArrive(Entity piece)
		-- 길드 타일 도착: 플레이어의 GuildManager 단계로 분기해 해당 이벤트를 구동한다.
		self._piece = piece
		self._phase = ""
		local ownerId = self:OwnerUserId(piece)
		local gm = self:Guild(piece)
		if ownerId == "" or isvalid(gm) == false then
			log_warning("[GuildTile] 소유자/GuildManager 없음 → 즉시 종료")
			self:FinishEvent()
			return
		end

		if gm.Stage == 0 then
			self:DoCreation(piece, gm, ownerId)
		elseif gm.Stage == 1 then
			self:DoVice(piece, gm, ownerId)
		elseif gm.PromotionPending then
			self:DoPromotion(piece, gm, ownerId)
		else
			self:DoMember(piece, gm, ownerId)
		end
	end

	@ExecSpace("ServerOnly")
	method void DoCreation(Entity piece, any gm, string ownerId)
		-- 길드창설: 도입 2씬 + dicepanel 롤(0:70:30)로 초보/마스터를 결정하고 그에 맞는 축복을 부여한다.
		local failPct = self:GuildPct("Fail")
		local successPct = self:GuildPct("Success")
		local greatPct = self:GuildPct("Great")
		local board = _ResultDiceManager:PlaceOutcomes(failPct, successPct, greatPct)
		local d1 = _UtilLogic:RandomIntegerRange(1, 6)
		local d2 = _UtilLogic:RandomIntegerRange(1, 6)
		local total = d1 + d2
		local tier = board[total] or 1

		local buff = self:Buff(piece)
		-- 리드(도입 2씬 + 주사위 프롬프트) — SceneRoll의 리드 텍스트가 '\n\n' 단위로 페이지 분할된다.
		local lead = "지금까지는 나혼자서 강해져왔지만,\n이제 강력한 동료를 모아 같이 강해지고 싶다!"
			.. "\n\n나만의 길드를 만들어, 훌륭한 동료들을 모을 것이다!\n나는 길드를 창설하기위해, 관리자 레아를 찾아갔다!"
			.. "\n\n길드를 창설하기 위해 주사위를 굴린다!"
		local resultText = ""
		local outcomeLabel = "성공"
		if tier == 2 then
			outcomeLabel = "대성공"
			gm:CreateGuild(2)
			if isvalid(buff) then buff:SetBuff("The_Guild's_Greater_Blessing") end
			resultText = "레아가 검토를 해보더니, 내 실력으로는\n더 높은 단계의 길드로 창설이 가능하다고 하였다!\n\n나는 단숨에 마스터 길드를 창설하였다!\n[버프] 더 큰 길드의 축복을 얻었다!"
		elseif tier == 1 then
			outcomeLabel = "성공"
			gm:CreateGuild(1)
			if isvalid(buff) then buff:SetBuff("The_Guild's_Blessing") end
			resultText = "레아가 검토를 해보더니, 나에게 길드를 창설할 수 있는\n자격이 충분하다고 하였다!\n\n드디어 나만의 길드를 창설하였다!\n[버프] 길드의 축복을 얻었다!"
		else
			outcomeLabel = "실패"
			resultText = "아쉽게도 길드 창설에 실패했다...\n다음 기회에 다시 도전하자."
		end
		log("[GuildTile] 창설 롤 " .. tostring(d1) .. "+" .. tostring(d2) .. "=" .. tostring(total) .. " → " .. outcomeLabel)
		self:ClientShowRoll(lead, "idle", resultText, d1, d2, total, greatPct, successPct, failPct, outcomeLabel, "Lea", ownerId)
	end

	@ExecSpace("ServerOnly")
	method void DoVice(Entity piece, any gm, string ownerId)
		-- 부길마영입: 직업군당 1명을 랜덤 선택해 슬롯 Key만 보관 → 도입 텍스트 → '다음' → 카드 선택창(DoViceCards).
		local ds = _DataService:GetTable("ViceMaster")
		if isvalid(ds) == false then
			log_error("[GuildTile] ViceMaster 데이터셋 없음 → 부길마 스킵")
			gm:CompleteVice()
			self:FinishEvent()
			return
		end
		-- 고정 직업군 5개(표시 순서). ViceMaster.JobGroup 값과 일치해야 한다.
		local groups = { "전사", "마법사", "궁수", "도적", "해적" }
		self._viceChoices = {}
		for gi = 1, #groups do
			local pool = {}
			for i = 1, ds:GetRowCount() do
				if ds:GetCell(i, "JobGroup") == groups[gi] then table.insert(pool, i) end
			end
			if #pool > 0 then
				local pick = pool[_UtilLogic:RandomIntegerRange(1, #pool)]
				self._viceChoices[gi] = ds:GetCell(pick, "Key")
			else
				self._viceChoices[gi] = ""
			end
		end
		-- 도입 2씬 → '다음' 끝에서 카드 선택창으로. (RequestAdvance가 _phase로 분기)
		self._phase = "vice_intro"
		local intro = "길드를 운영해보니, 나혼자 운영하기에는 너무 일이 많았다!\n나를 도와줄 부길드마스터를 영입해야겠다!"
			.. "\n\n레아를 통해 다양한 후보를 추천받았다.\n이중에서 나와 같이 일할 사람은..."
		self:ClientShowSceneText(intro, "", ownerId)
	end

	@ExecSpace("ServerOnly")
	method void DoViceCards()
		-- 부길마 도입 '다음' 후: 보관한 슬롯 Key로 이름/사진을 조회해 5칸 선택창을 띄운다.
		local piece = self._piece
		if isvalid(piece) == false then return end
		local ownerId = self:OwnerUserId(piece)
		local ds = _DataService:GetTable("ViceMaster")
		local names = {}
		local ruids = {}
		for gi = 1, #self._viceChoices do
			local row = self:FindViceRow(self._viceChoices[gi])
			if row > 0 and isvalid(ds) then
				names[gi] = ds:GetCell(row, "DisplayName")
				ruids[gi] = ds:GetCell(row, "ImageRUID")
			else
				names[gi] = ""
				ruids[gi] = ""
			end
		end
		log("[GuildTile] 부길마 선택 창 표시 (직업군별 1명)")
		self:ClientShowViceSelect("부길드마스터를 영입하세요", names, ruids, ownerId)
	end

	method string GuildMemberCell(string outcome, string column)
		-- GuildMemberProbability에서 Outcome 행의 지정 컬럼 값을 반환. 없으면 "".
		local ds = _DataService:GetTable("GuildMemberProbability")
		if isvalid(ds) == false then return "" end
		for i = 1, ds:GetRowCount() do
			if ds:GetCell(i, "Outcome") == outcome then
				return ds:GetCell(i, column)
			end
		end
		return ""
	end

	@ExecSpace("ServerOnly")
	method void DoMember(Entity piece, any gm, string ownerId)
		-- 길드원영입(반복): 도입 1씬 + 영입시험(dicepanel 20:60:20). 성공/대성공 시 길드원+1 & 주스탯·공/마 % 영구 증가.
		-- 승급 조건 충족(초보 2명)은 AddMember가 PromotionPending으로만 표시하고, 실제 승급은 다음 방문의 승급 이벤트에서 처리.
		local failPct = tonumber(self:GuildMemberCell("Fail", "Weight")) or 0
		local successPct = tonumber(self:GuildMemberCell("Success", "Weight")) or 0
		local greatPct = tonumber(self:GuildMemberCell("Great", "Weight")) or 0
		local board = _ResultDiceManager:PlaceOutcomes(failPct, successPct, greatPct)
		local d1 = _UtilLogic:RandomIntegerRange(1, 6)
		local d2 = _UtilLogic:RandomIntegerRange(1, 6)
		local total = d1 + d2
		local tier = board[total] or 0

		local lead = "길드에는 인재가 많아야지!\n부길드마스터와 논의하여, 인재를 영입할 준비를 했다."
			.. "\n\n길드에 신규 인원이 가입을 신청했다!\n가입 시험을 진행한 결과..."
		local resultText = ""
		local outcomeLabel = "실패"
		if tier >= 1 then
			local key = "Success"
			outcomeLabel = "성공"
			local lead2 = "길드에 가입할 자격이 충분한 것 같다!\n길드에 신규 인원이 추가되었다!"
			if tier == 2 then
				key = "Great"
				outcomeLabel = "대성공"
				lead2 = "시험 결과, 아주 훌륭한 인재였다!\n길드에 유능한 신규 인원이 추가되었다!"
			end
			local atkPct = tonumber(self:GuildMemberCell(key, "AttackPct")) or 0
			local statPct = tonumber(self:GuildMemberCell(key, "StatPct")) or 0
			gm:AddMember()
			-- 주스탯/공·마 % 영구 증가(동적 수치).
			if statPct ~= 0 then self:AddMainStat(piece, "percent", statPct) end
			if atkPct ~= 0 then self:AddMainAttack(piece, "percent", atkPct) end
			resultText = lead2 .. "\n\n길드원의 수가 1만큼 증가하고,\n공격력/마력이 " .. tostring(atkPct) .. "%만큼 증가하고 주스탯이 " .. tostring(statPct) .. "%만큼 증가하였다!"
		else
			outcomeLabel = "실패"
			resultText = "우리 길드와는 맞지 않은 사람인 것 같다...\n아쉽게도 신규 지원자를 돌려보냈다."
		end
		log("[GuildTile] 영입시험 " .. tostring(d1) .. "+" .. tostring(d2) .. "=" .. tostring(total) .. " → " .. outcomeLabel)
		self:ClientShowRoll(lead, "idle", resultText, d1, d2, total, greatPct, successPct, failPct, outcomeLabel, "", ownerId)
	end

	@ExecSpace("ServerOnly")
	method void DoPromotion(Entity piece, any gm, string ownerId)
		-- 길드 승급 이벤트: 초보→마스터 Tier 상승 + 축복 강화 후, 레아 등장 3씬 텍스트를 표시한다.
		gm:Promote()
		local buff = self:Buff(piece)
		if isvalid(buff) then buff:SetBuff("The_Guild's_Greater_Blessing") end
		local msg = "어느덧 길드의 인원이 많이 늘어났다!\n더 높은 단계의 길드로 인정받아, 인원수를 늘릴 것이다!"
			.. "\n\n레아에게 검토를 받은 결과,\n길드가 무사히 승급되었다!"
			.. "\n\n앞으로도 많은 길드원을 영입하여 길드를 성장시켜 나가야겠다!\n[버프] 더 큰 길드의 축복을 얻었다!"
		log("[GuildTile] 길드 승급 이벤트")
		self:ClientShowSceneText(msg, "Lea", ownerId)
	end

	@ExecSpace("Client")
	method void ClientShowRoll(string leadText, string anim, string resultText, integer d1, integer d2, integer diceTotal, number greatPct, number successPct, number failPct, string outcomeLabel, string npcKey)
		-- dicepanel: 리드텍스트(페이지) → 주사위 연출 → 결과텍스트 → '다음'(RequestAdvance). (VillageTile 롤 흐름 재사용)
		_EventTileUI:SceneRoll(leadText, anim, resultText, d1, d2, diceTotal, greatPct, successPct, failPct, outcomeLabel, npcKey, self)
	end

	@ExecSpace("Client")
	method void ClientShowSceneText(string message, string npcKey)
		-- 페이지 텍스트(+선택 NPC 이미지). '다음' 끝 → RequestAdvance (부길마 도입 → 카드 / 승급 → 종료).
		_EventTileUI:SceneText(message, "idle", npcKey, self)
	end

	@ExecSpace("Client")
	method void ClientShowText(string message)
		-- 부길마 선택 결과: 이미지 없는 텍스트 팝업 + '다음'(RequestDone).
		_EventTileUI:ShowEventText(message, "idle", "", "", "", 0, "", self)
	end

	@ExecSpace("Client")
	method void ClientHide()
		-- 도착 플레이어 클라: 이벤트 UI 그룹을 닫는다.
		_EventTileUI:SceneHide()
	end

	@ExecSpace("Client")
	method void ClientShowViceSelect(string title, table names, table ruids)
		-- 부길마 선택 창(연애/길드 공용 UI) 표시. 카드 클릭 → self:RequestChoice(index).
		_RomanceGuildSelectUI:Show(title, names, ruids, self)
	end

	@ExecSpace("Client")
	method void ClientHideViceSelect()
		-- 부길마 선택 창 닫기.
		_RomanceGuildSelectUI:Hide()
	end

	@ExecSpace("Server")
	method void RequestAdvance()
		-- 롤 결과/텍스트 '다음' → 분기: 부길마 도입이면 카드 선택창으로, 그 외엔 이벤트 종료. 도착 플레이어만 허용.
		local piece = self._piece
		if isvalid(piece) and senderUserId ~= self:OwnerUserId(piece) then return end
		if self._phase == "vice_intro" then
			self._phase = ""
			self:DoViceCards()
			return
		end
		self:FinishEvent()
	end

	@ExecSpace("Server")
	method void RequestDone()
		-- 부길마 선택 결과 텍스트 '다음' → 이벤트 종료. 도착 플레이어만 허용.
		local piece = self._piece
		if isvalid(piece) and senderUserId ~= self:OwnerUserId(piece) then return end
		self:FinishEvent()
	end

	method string StatLabel(string kind)
		-- 스탯 키 → 표시용 라벨(결과 문구용).
		if kind == "str" then return "STR"
		elseif kind == "dex" then return "DEX"
		elseif kind == "int" then return "INT"
		elseif kind == "luk" then return "LUK"
		end
		return kind
	end

	method integer FindViceRow(string key)
		-- ViceMaster에서 Key 일치 행 인덱스를 반환한다. 없으면 0.
		local ds = _DataService:GetTable("ViceMaster")
		if isvalid(ds) == false or key == nil or key == "" then return 0 end
		for i = 1, ds:GetRowCount() do
			if ds:GetCell(i, "Key") == key then return i end
		end
		return 0
	end

	@ExecSpace("Server")
	method void RequestChoice(integer index)
		-- 부길마 선택 콜백(RomanceGuildSelectUI에서 호출). 슬롯 index → 확정 후보 Key로 스탯 적용 + 진행 + 결과 안내.
		local piece = self._piece
		if isvalid(piece) == false then return end
		if senderUserId ~= self:OwnerUserId(piece) then return end

		-- 슬롯 index에 이번에 뽑힌 후보 Key(직업군당 랜덤 선택 결과)로 실제 행을 찾는다.
		local key = ""
		if self._viceChoices ~= nil and index >= 1 and index <= #self._viceChoices then
			key = self._viceChoices[index]
		end
		local row = self:FindViceRow(key)
		if row == 0 then
			log_warning("[GuildTile] 부길마 선택 인덱스 무효(index=" .. tostring(index) .. ") → 종료")
			self:FinishEvent()
			return
		end
		local ds = _DataService:GetTable("ViceMaster")

		local displayName = ds:GetCell(row, "DisplayName")
		local statKind = ds:GetCell(row, "StatKind")
		local statGain = tonumber(ds:GetCell(row, "StatGain")) or 0
		local attackGain = tonumber(ds:GetCell(row, "AttackGain")) or 0
		local flavor = ds:GetCell(row, "Flavor")

		-- 스탯 적용: str/dex/int/luk → CombatPowerManager(BaseTile.AddSpecificStat가 대문자화),
		--            공/마 → BuffManager 동적 수치(BaseTile.AddMainAttack). 게임종료 시 기존 ResetAll로 초기화됨.
		if statKind ~= "" and statGain ~= 0 then
			self:AddSpecificStat(piece, statKind, statGain)
		end
		if attackGain ~= 0 then
			self:AddMainAttack(piece, "flat", attackGain)
		end

		local gm = self:Guild(piece)
		if isvalid(gm) then gm:CompleteVice() end
		log("[GuildTile] 부길마 영입 = " .. tostring(displayName)
			.. " (" .. tostring(statKind) .. "+" .. tostring(statGain) .. ", 공/마+" .. tostring(attackGain) .. ")")

		local ownerId = self:OwnerUserId(piece)
		self:ClientHideViceSelect(ownerId)
		-- 결과 문구: "이 사람으로 결정했다! {성격문구} ... {STAT}이 30만큼 오르고 공격력/마력이 10만큼 올랐다."
		local msg = "이 사람으로 결정했다!\n" .. flavor
			.. "\n\n앞으로 길드 운영이 더 단단해질 것 같다!\n"
			.. self:StatLabel(statKind) .. "이 " .. tostring(statGain) .. "만큼 오르고 공격력/마력이 " .. tostring(attackGain) .. "만큼 올랐다."
		self:ClientShowText(msg, ownerId)
	end

	@ExecSpace("ServerOnly")
	method void FinishEvent()
		-- 이벤트 종료: 도착 플레이어 클라 UI 닫기 + 상태 정리 + 턴 진행 신호.
		local ownerId = ""
		if isvalid(self._piece) then ownerId = self:OwnerUserId(self._piece) end
		self._piece = nil
		self._phase = ""
		if ownerId ~= "" then self:ClientHide(ownerId) end
		_GameModeManager:NotifyTileEventDone()
		log("[GuildTile] 이벤트 종료")
	end

end
