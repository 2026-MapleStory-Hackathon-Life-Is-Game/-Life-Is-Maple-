@Component
script UnluckyTile extends EventTileBase

	@ExecSpace("ServerOnly")
	method void OnArrive(Entity piece)
		-- 불행 이벤트: (Stage,Region) 가중 추첨 → 보상 적용(RollEvent) → 씬(페이지)별 NPC로 표시.
		-- (베이스 OnArrive의 단일-이미지 흐름 대신, 페이지별 NPC 교체를 위해 재정의한다.)
		self._eventPiece = piece
		local ev = self:RollEvent(piece)   -- 내부에서 ApplyRewardString로 보상 적용
		if ev == nil then
			self:FinishEventTile()
			return
		end
		local ownerId = self:OwnerUserId(piece)
		if ownerId == "" then
			self:FinishEventTile()
			return
		end
		-- NPC 이름 키 목록(';' 구분)을 페이지별 RUID 목록으로 해석해 클라에 전달한다.
		local npcCsv = self:ResolvePageNpcRUIDs(ev.npcKey)
		self:ClientShowUnlucky(ev.message, ev.anim or "idle", npcCsv, ownerId)
		log("[UnluckyTile] 불행 이벤트 발생 tile=" .. self.Entity.Name)
	end

	method table RollEvent(Entity piece)
		-- 도착 타일의 (Stage,Region)으로 UnluckyEvent에서 가중 추첨해 이벤트를 반환한다.
		local map = self.Entity.CurrentMapName
		local tile = self.Entity.Name
		local region = _TileManager:GetTileRegion(map, tile)
		local stage = _TileManager:GetTileStage(map, tile)
		
		local ds = _DataService:GetTable("UnluckyEvent")
		if isvalid(ds) == false then
			log_error("[UnluckyTile] UnluckyEvent 데이터셋 없음")
			return nil
		end
		local rows = ds:GetRowCount()
		local function match(i)
			return (tonumber(ds:GetCell(i, "Stage")) or 0) == stage
				and ds:GetCell(i, "Region") == region
		end
		
		-- (Stage,Region) 일치 행 가중치 합.
		local total = 0
		for i = 1, rows do
			if match(i) then total += (tonumber(ds:GetCell(i, "Weight")) or 0) end
		end
		if total <= 0 then
			log_warning("[UnluckyTile] 해당 (Stage,Region) 불행 이벤트 없음 stage=" .. tostring(stage) .. " region=" .. tostring(region))
			return nil
		end
		
		-- 가중 추첨.
		local roll = _UtilLogic:RandomIntegerRange(1, total)
		local acc = 0
		local pick = 0
		for i = 1, rows do
			if match(i) then
				acc += (tonumber(ds:GetCell(i, "Weight")) or 0)
				if roll <= acc then
					pick = i
					break
				end
			end
		end
		if pick == 0 then return nil end
		
		local anim = ds:GetCell(pick, "PlayerAnim")
		if anim == "" then anim = "idle" end
		-- 보상 적용: Reward 문자열('main:-10;attack:-5;cube:3' 등)을 이 자리에서 직접 적용하고,
		-- 반환 table의 statKind는 비워 OnArrive의 ApplyReward가 중복 적용하지 않도록 한다(다중 보상/큐브 지원).
		self:ApplyRewardString(piece, ds:GetCell(pick, "Reward"))
		return {
			eventType = "Unlucky",
			message   = self:DecodeText(ds:GetCell(pick, "Text")),
			statKind  = "",                                     -- 보상은 위 ApplyRewardString에서 이미 적용(중복 방지)
			imageKind = "npc",                                  -- 불행 이벤트: NPC 이미지 표시
			npcKey    = ds:GetCell(pick, "NPC"),                -- 등장 NPC 이름 키 → NpcInfo에서 RUID 조회
			anim      = anim,
		}
	end

	method string DecodeText(string raw)
		-- CSV에 '\n' 리터럴로 저장한 줄바꿈을 실제 개행으로 복원한다(셀을 한 물리 행으로 유지하기 위함).
		-- 셀 양끝을 통째로 감싼 따옴표 1쌍이 남아있으면 제거한다.
		if raw == nil then return "" end
		local s = raw
		if #s >= 2 and string.sub(s, 1, 1) == "\"" and string.sub(s, #s, #s) == "\"" then
			s = string.sub(s, 2, #s - 1)
		end
		local out, _cnt = string.gsub(s, "\\n", "\n")
		return out
	end

	@ExecSpace("Server")
	method void RequestDone()
		-- '다음' 클릭 시 이벤트 종료 RPC. (베이스 상속 RPC가 서브클래스에서 라우팅 안 되므로 리프에 재정의)
		local piece = self._eventPiece
		if isvalid(piece) and senderUserId ~= self:OwnerUserId(piece) then return end
		self:FinishEventTile()
	end

	@ExecSpace("Client")
	method void ClientShowUnlucky(string message, string anim, string npcRuidsCsv)
		-- 도착 플레이어 클라: 씬(페이지)별 NPC 교체 불행 이벤트 표시.
		-- 울음은 '시작'이 아니라 스탯 감소 문구가 나오는 '마지막 페이지'에 도달했을 때 재생하도록 예약한다.
		-- (초상화는 SetPortrait(anim)로 idle에서 시작 → 마지막 페이지에서 울음 포즈로 전환.)
		_EventTileUI:ShowPagedNpcEvent(message, anim, npcRuidsCsv, self)
		_EventTileUI:ArmPageEndEmote("cry")
	end

	method string ResolvePageNpcRUIDs(string npcList)
		-- "Helena;Helena;Nineheart" → "ruid1;ruid2;ruid3" (각 키를 NpcInfo에서 RUID로 해석). 빈 키/목록이면 "".
		if npcList == nil or npcList == "" then return "" end
		local out = ""
		local started = false
		for key in string.gmatch(npcList, "[^;]+") do
			local ruid = _NpcInfoManager:GetNpcRUID(key)
			if started then
				out = out .. ";" .. ruid
			else
				out = ruid
				started = true
			end
		end
		return out
	end

end