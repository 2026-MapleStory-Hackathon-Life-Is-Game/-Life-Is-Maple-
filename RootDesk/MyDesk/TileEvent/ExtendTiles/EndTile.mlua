@Component
script EndTile extends BaseTile

	property any _piece = nil

	property integer _step = 0

	property boolean _won = false

	-- 검은 마법사 선택 난이도("Hard"/"Extreme"). RequestSelect에서 저장, 적정 전투력·익스트림 보상 판정에 사용.
	property string _diffKey = "Hard"

	-- 익스트림 처치 업적 뱃지는 '이름'으로 조회한다. 뱃지 ID는 월드마다 따로 발급되므로(그룹판 TRETAWVY8 /
	-- 개인판 6D6WYZ09M) ID를 박아두면 한쪽에서만 동작한다. 세미콜론(;)으로 구분한 후보 이름을 앞에서부터
	-- 훑어, 현재 월드에 실제로 등록된 첫 이름의 ID를 쓴다.
	property string BlackMageExtremeBadgeNames = "창세의 뱃지;익스트림 검은 마법사 토벌"

	-- 이름 조회가 모두 실패했을 때만 쓰는 최후 폴백 ID. 빈 문자열이면 뱃지 미지급(코인만).
	property string BlackMageExtremeBadgeId = ""

	-- 이름→ID 해석 결과 캐시. BadgeService 조회는 스크립트를 멈추는(blocking) 호출이라 1회만 하고 재사용한다.
	property string _badgeIdCache = ""

	property boolean _badgeLookupDone = false

	property boolean _cubeRolling = false

	property boolean _waitingRoll = false   -- 완주 후 대기 중 반복 큐브 롤인지(도착 롤과 구분, 피드백 5)

	method boolean IsFinalBattle()
		-- 이 종료칸이 스테이지3(마지막) End 인지 → 검은 마법사 최종 결전. (Stage 1·2 End은 false)
		if isvalid(self.Entity) == false then return false end
		-- [테스트] TileEventTester로 BlackMage를 강제하면 어느 칸이든 검은 마법사 결전으로 취급.
		if isvalid(_TileEventTester) and _TileEventTester.ForceEvent == "BlackMage" then return true end
		local stage = _TileManager:GetTileStage(self.Entity.CurrentMapName, self.Entity.Name)
		return stage == 3
	end

	method boolean IsEventTile()
		-- 모든 종료칸을 이벤트로 취급 → 턴 매니저가 완료 신호까지 대기(결과주사위 생략).
		-- Stage 1·2 = 큐브 획득 주사위(보너스), Stage 3 = 검은 마법사 결전. 둘 다 '다음'까지 대기가 필요.
		return true
	end

	method boolean IsInteractiveTile()
		-- 모든 종료칸을 인터랙티브로 취급 → 5초 자동대기 대신 완료(FinishEndTile) 신호까지 대기.
		return true
	end

	method string OwnerUserId(Entity piece)
		-- 말(piece)의 소유 유저 ID. 플레이어가 아니면 "".
		if isvalid(piece.PlayerComponent) == false then return "" end
		local uid = piece.PlayerComponent.UserId
		if uid == nil then return "" end
		return uid
	end

	@ExecSpace("ServerOnly")
	method void OnArrive(Entity piece)
		-- 일반 종료칸(Stage 1·2): 큐브 획득 주사위(보너스) → 완주 처리. 최종 결전 칸(Stage 3): 검은 마법사 선택 화면.
		if self:IsFinalBattle() == false then
			self._piece = piece
			self._cubeRolling = false
			local endOwnerId = self:OwnerUserId(piece)
			-- 큐브 롤 대상: 싱글은 굴리지 않음. 멀티는 '마지막 완주자(꼴찌)'만 제외하고 나머지 완주자가 굴린다.
			-- 이 시점은 MarkPlayerFinished 전이라, 이미 완주한 인원수(_finishedCount)가 (총원-1)이면 이번 도착이 꼴찌다.
			local doRoll = false
			if endOwnerId ~= "" and _GameModeManager._activeMode == "MULTI"
				and _MultiTurnManager ~= nil and _MultiTurnManager._isActive then
				if _MultiTurnManager._finishedCount < (_MultiTurnManager._playerCount - 1) then
					doRoll = true
				end
			end
			if doRoll then
-- 				log("[EndTile] 종료 칸 도착 → 큐브 획득 주사위 tile=" .. self.Entity.Name)
				self:StartCubeRoll(piece, endOwnerId, false)   -- 도착 보너스 롤: 넘기기 없음
				return
			end
			-- 롤 없이 바로 완주 처리(싱글 전체 / 멀티 꼴찌 / 소유자 없음).
-- 			log("[EndTile] 종료 칸 도착 → 큐브 롤 없이 완주 tile=" .. self.Entity.Name)
			self:FinishEndTile(piece)
			return
		end

		self._piece = piece
		local ownerId = self:OwnerUserId(piece)
		if ownerId == "" then
			-- 소유자 없는 말이면 결전 없이 즉시 종료.
			self:FinishEndTile(piece)
			return
		end
		self._step = 0
-- 		log("[EndTile] 검은 마법사 결전 — 보스 선택 표시 tile=" .. self.Entity.Name)
		self:ClientShowBossSelect(self:Dlg("intro"), ownerId)
		-- 관전자: 검은 마법사 선택 화면을 읽기전용 로스터(단일 보스)로 방송(피드백 12).
		_BossUI:SpectatorShowRoster(self:Dlg("intro"), { "Black_Mage" }, { "Hard" }, ownerId)
	end

	@ExecSpace("Server")
	method void RequestSelect(string bossKey, string diffKey)
		-- BossUI 단일 선택 콜백(검은 마법사/하드). 도전 문구로 진행.
		local piece = self._piece
		if isvalid(piece) == false then return end
		if senderUserId ~= self:OwnerUserId(piece) then return end
		self._step = 2
		self._diffKey = diffKey   -- 선택 난이도 저장(Hard/Extreme) → 적정 전투력·익스트림 보상 판정에 사용
-- 		log("[EndTile] 검은 마법사 선택 (" .. tostring(bossKey) .. "/" .. tostring(diffKey) .. ") → 도전")
		local ownerId = self:OwnerUserId(piece)
		self:ClientStartChallenge(self:Dlg("challenge"), ownerId)
		-- 관전자: 로스터 닫고 도전 문구 + 검은 마법사 이미지 미러(피드백 12).
		_BossUI:SpectatorHide(ownerId)
		_EventTileUI:SpectatorBossFightText(self:Dlg("challenge"), self:BlackMageStandRUID(), ownerId)
	end

	@ExecSpace("Server")
	method void RequestAdvance()
		-- 결전 대사 '다음': challenge → (CP 판정) win/lose → 게임 종료.
		local piece = self._piece
		if isvalid(piece) == false then return end
		if senderUserId ~= self:OwnerUserId(piece) then return end
		local ownerId = self:OwnerUserId(piece)

		if self._cubeRolling then
			-- 큐브 롤 결과 '다음' → 연출 닫기(보상은 StartCubeRoll에서 이미 지급됨).
			self._cubeRolling = false
			if ownerId ~= "" then
				self:ClientHide(ownerId)
				_EventTileUI:SpectatorSceneHide(ownerId)
			end
			if self._waitingRoll then
				-- 완주 후 대기 반복 롤(피드백 5): 완주 처리 없이 턴만 진행한다(이미 완주 상태).
				self._waitingRoll = false
				_MultiTurnManager:OnWaitingCubeRollDone()
			else
				-- 도착 보너스 롤: 완주 처리로 진행.
				self:FinishEndTile(piece)
			end
			return
		end

		if self._step == 2 then
			-- CP 판정: 현재 전투력이 하드 검은 마법사 적정 전투력 이상이면 승리.
			local cp = 0
			local cpm = piece:GetComponent("script.CombatPowerManager")
			if isvalid(cpm) then cp = cpm.CombatPower end
			local req = self:BlackMageRequiredPower()
			self._won = cp >= req
			self._step = 3
			local key = "lose"
			if self._won then key = "win" end
-- 			log("[EndTile] 검은 마법사 판정 CP=" .. tostring(cp) .. " / 적정=" .. tostring(req) .. " → " .. key)
			self:ClientShowText(self:Dlg(key), "BlackMage", self._won, ownerId)
			-- 관전자: 승/패 결과 문구 미러(승리=환호/패배=울음). PortraitEmote는 win/lose를 모르므로 대성공/실패로 매핑, die 이미지 없음("").
			_EventTileUI:SpectatorBossFollow(self._won, (self._won and "대성공" or "실패"), self:Dlg(key), "", ownerId)
		else
			self:EndBattle()
		end
	end

	@ExecSpace("Server")
	method void RequestQuestRoll()
		-- 검은 마법사 결과 주사위(다른 보스와 동일: RollByBossTable로 전투력 밴드 확률 적용).
		-- 적정 전투력 이상(Above) = 실패 없음(2~9 성공/10~12 대성공). 미달(Below) = 확률 판정.
		local piece = self._piece
		if isvalid(piece) == false then return end
		if senderUserId ~= self:OwnerUserId(piece) then return end
		local ownerId = self:OwnerUserId(piece)
		local cp = 0
		local cpm = piece:GetComponent("script.CombatPowerManager")
		if isvalid(cpm) then cp = cpm.CombatPower end
		local req = self:BlackMageRequiredPower()
		local total = _ResultDiceManager:RollByBossTable("Black_Mage", self._diffKey, cp)
		local d1 = _ResultDiceManager._dice1
		local d2 = _ResultDiceManager._dice2
		local outcome = _ResultDiceManager.GameOutcome
		local resultTable = _ResultDiceManager:GetResultTable()
		self._won = (outcome == "성공" or outcome == "대성공")
		-- 보상(등급별 코인 + 익스트림&전투력충족 뱃지)은 서버에서 즉시 지급(연출 중 이탈해도 보장).
		self:AwardBlackMageRewards(ownerId, outcome, cp >= req)
		local key = "lose"
		if self._won then key = "win" end
		local outcomeText = self:Dlg(key)
		self:ClientShowBossDice(d1, d2, total, resultTable, outcome, outcomeText, ownerId)
		-- 관전자: 주사위 결과 후속(승패 문구 + die)을 actor가 굴린 순간에 공개(조기 스포일 방지, 다른 보스와 동일).
		_EventTileUI:SpectatorBossFollowDeferred(self._won, outcome, outcomeText, self:BlackMageDieRUID(), ownerId)
	end

	@ExecSpace("Client")
	method void ClientShowBossDice(integer d1, integer d2, integer total, table resultTable, string outcome, string outcomeText)
		-- (콜백용 self.) 보스 전투 결과 주사위 연출 → 결과 문구 → '다음' → RequestFinish.
		_EventTileUI:BossFightDice(d1, d2, total, resultTable, outcome, outcomeText, self:BlackMageDieRUID(), self)
	end

	@ExecSpace("Server")
	method void RequestFinish()
		-- 보스 결과 연출 '다음' → 순위보상 + 종료(EndBattle 재사용).
		local piece = self._piece
		if isvalid(piece) == false then return end
		if senderUserId ~= self:OwnerUserId(piece) then return end
		self:EndBattle()
	end

	method string BlackMageDieRUID()
		-- 검은 마법사 die 애니메이션 RUID(BossImage.DieAnimRUID). 없으면 "".
		local ds = _DataService:GetTable("BossImage")
		if isvalid(ds) == false then return "" end
		for i = 1, ds:GetRowCount() do
			if ds:GetCell(i, "BossName") == "Black_Mage" then
				local d = ds:GetCell(i, "DieAnimRUID")
				if d ~= nil then return d end
				return ""
			end
		end
		return ""
	end

	@ExecSpace("ServerOnly")
	method void StartCubeRoll(Entity piece, string ownerId, boolean allowSkip)
		-- 종료칸 도착 보너스: 주사위를 굴려 미라클 큐브를 획득한다. allowSkip=완주자 대기 롤이면 '넘기기' 노출.
		-- 실패=0개 / 성공=1개 / 대성공=3개, 확률 20/50/30. (마을 확률게임과 동일 롤 머신 재사용.)
		-- 보상은 여기서 서버에 즉시 지급하고(연출 중 이탈해도 보장), 결과는 롤 UI로 연출한다.
		self._cubeRolling = true
		local greatPct = 30
		local successPct = 50
		local failPct = 20
		local np = _RollResultDiceAnimationUI:NormalizeProbabilities(greatPct, successPct, failPct)
		greatPct = np.great
		successPct = np.success
		failPct = np.fail
		-- 결과판(주사위합 2~12 → 0실패/1성공/2대성공). 서버 권위 판정.
		local board = _ResultDiceManager:PlaceOutcomes(failPct, successPct, greatPct)
		local d1 = _UtilLogic:RandomIntegerRange(1, 6)
		local d2 = _UtilLogic:RandomIntegerRange(1, 6)
		local sum = d1 + d2
		local tier = board[sum] or 1
		-- tier: 0=실패(0개) / 1=성공(1개) / 2=대성공(3개)
		local outcomeLabel = "성공"
		local cubes = 1
		if tier == 0 then
			outcomeLabel = "실패"
			cubes = 0
		elseif tier == 2 then
			outcomeLabel = "대성공"
			cubes = 3
		end
		-- 보상 즉시 지급(cubes=0이면 GrantCube 내부에서 무시).
		self:GrantCube(piece, cubes)
-- 		log("[EndTile] 큐브 롤 owner=" .. ownerId .. " 주사위=" .. tostring(d1) .. "+" .. tostring(d2) .. "=" .. tostring(sum) .. " → " .. outcomeLabel .. " (큐브 " .. tostring(cubes) .. "개)")

		local leadText = "결승선에 도착했다!\n주사위를 굴려 미라클 큐브를 획득하자!"
		local resultText = "아쉽지만 이번엔 큐브를 얻지 못했다..."
		if cubes > 0 then
			resultText = "미라클 큐브 " .. tostring(cubes) .. "개를 획득했다!"
		end
		-- actor: 굴림 연출. 멀티 관전자: 씬 미러(리드)만 지금 방송하고, 주사위 보드는 actor가 리드를 넘겨 보드가 뜨는 순간(OnRollLeadDone)에 방송된다.
		self:ClientShowCubeRoll(leadText, resultText, d1, d2, sum, greatPct, successPct, failPct, outcomeLabel, allowSkip, ownerId)
		_EventTileUI:SpectatorSceneRoll(leadText, resultText, "idle", "", ownerId)
	end

	@ExecSpace("ServerOnly")
	method void StartWaitingCubeRoll(Entity piece)
		-- 완주 후 대기 중인 플레이어의 반복 큐브 롤(피드백 5). 굴림/보상/연출은 도착 롤과 동일(StartCubeRoll 재사용)하되,
		-- '다음' 시 완주 처리 대신 턴만 진행(RequestAdvance의 _waitingRoll 분기). MultiTurnManager가 완주자 턴에 호출한다.
		self._piece = piece
		self._waitingRoll = true
		self._cubeRolling = false
		local ownerId = self:OwnerUserId(piece)
		if ownerId == "" then
			self._waitingRoll = false
			_MultiTurnManager:OnWaitingCubeRollDone()
			return
		end
-- 		log("[EndTile] 완주자 대기 큐브 롤 owner=" .. ownerId)
		self:StartCubeRoll(piece, ownerId, true)   -- 완주자 대기 롤: '넘기기' 노출(30초 동안 배낭 열 시간 확보)
	end

	@ExecSpace("ServerOnly")
	method void ForceFinishWaitingRoll()
		-- AFK 자동 마무리: 대기 큐브 롤 연출을 닫고 턴을 진행한다(보상은 StartCubeRoll에서 이미 지급됨).
		if self._waitingRoll == false then return end
		self._waitingRoll = false
		self._cubeRolling = false
		local piece = self._piece
		if isvalid(piece) then
			local ownerId = self:OwnerUserId(piece)
			if ownerId ~= "" then
				self:ClientHide(ownerId)
				_EventTileUI:SpectatorSceneHide(ownerId)
			end
		end
		_MultiTurnManager:OnWaitingCubeRollDone()
	end

	@ExecSpace("Client")
	method void ClientShowCubeRoll(string leadText, string resultText, integer d1, integer d2, integer total, number greatPct, number successPct, number failPct, string outcomeLabel, boolean allowSkip)
		-- 도착 플레이어 클라: 큐브 롤 연출(리드텍스트 → 주사위 → 결과문구 → '다음' → RequestAdvance).
		-- allowSkip=완주자 대기 롤이면 '넘기기' 노출(주사위 UI가 SetAllowSkip 값을 읽어 Show 시 버튼을 켠다).
		_RollResultDiceAnimationUI:SetAllowSkip(allowSkip)
		_EventTileUI:SceneRoll(leadText, "idle", resultText, d1, d2, total, greatPct, successPct, failPct, outcomeLabel, "", self)
	end

	@ExecSpace("ServerOnly")
	method void FinishEndTile(Entity piece)
		-- 종료칸 완주 처리: 완주 기록(OnPlayerReachedEnd) 후 모드별로 턴을 진행/정지시킨다.
		-- 싱글=턴 루프 정지(게임 종료→결과 카드). 멀티=완료 신호로 턴 진행(다른 플레이어 계속, 전원 완주 시 FinishMulti).
		-- ⚠ 멀티에서 _SingleTurnManager:Stop()만 부르면(과거 버그) MultiTurnManager가 완료 신호를 못 받아 TILE 상태에 영구 정지한다.
		if isvalid(piece) then _GameModeManager:OnPlayerReachedEnd(piece) end
		if _GameModeManager._activeMode == "MULTI" then
			_GameModeManager:NotifyTileEventDone()
		else
			_SingleTurnManager:Stop()
		end
	end

	@ExecSpace("ServerOnly")
	method void EndBattle()
		-- 결전 종료: 승/패 무관 게임 종료(기존 종료 경로 재사용). UI 닫고 상태 정리.
		local piece = self._piece
		local ownerId = ""
		if isvalid(piece) then ownerId = self:OwnerUserId(piece) end
		self._piece = nil
		self._step = 0
		if ownerId ~= "" then
			self:ClientHide(ownerId)
			_EventTileUI:SpectatorSceneHide(ownerId)   -- 관전자 결전 UI도 닫기(피드백 12).
		end
		-- 검은 마법사 클리어 선착순 보상: 완주 순위별 주스탯/공격력 % 버프(FinishEndTile 전 = MarkPlayerFinished 전이라 rank=_finishedCount+1).
		-- (등급별 코인/익스트림 뱃지는 주사위 판정 시점 AwardBlackMageRewards에서 이미 지급됨.)
		self:ApplyClearRankReward(piece)
		-- 엔딩 요약을 결과창과 통합 → 별도 정리 표/'다음' 없이 바로 종료 흐름(FinishEndTile→통합 결과 카드/멀티 순위표)으로 진행.
		self:FinishEndTile(piece)
-- 		log("[EndTile] 검은 마법사 결전 종료(won=" .. tostring(self._won) .. ") → 통합 결과 카드")
	end

	@ExecSpace("ServerOnly")
	method void ApplyClearRankReward(Entity piece)
		-- 검은 마법사(최종) 클리어 선착순 보상(더미데이터): 완주 순위별 주스탯/공격력 % 버프.
		-- 1등 주30/공30, 2등 주20/공30, 3등 주10/공10, 그 외/꼴찌 주5/공5. (싱글은 1등 취급.)
		-- 이 시점은 MarkPlayerFinished 전이므로 이번 완주로 매겨질 순위 = _finishedCount + 1.
		if isvalid(piece) == false then return end
		local rank = 1
		local total = 1
		if _GameModeManager._activeMode == "MULTI" and _MultiTurnManager ~= nil then
			rank = _MultiTurnManager._finishedCount + 1
			total = _MultiTurnManager._playerCount
		end
		local mainPct = 5
		local attackPct = 5
		if total >= 2 and rank >= total then
			mainPct = 5
			attackPct = 5   -- 꼴찌(마지막 완주자)
		elseif rank == 1 then
			mainPct = 30
			attackPct = 30
		elseif rank == 2 then
			mainPct = 20
			attackPct = 30
		elseif rank == 3 then
			mainPct = 10
			attackPct = 10
		end
		self:AddMainStat(piece, "percent", mainPct)
		self:AddMainAttack(piece, "percent", attackPct)
-- 		log("[EndTile] 검은마법사 클리어 순위보상 rank=" .. tostring(rank) .. "/" .. tostring(total)
-- 			.. " → 주스탯+" .. tostring(mainPct) .. "% 공격+" .. tostring(attackPct) .. "%")
	end

	-- 검은 마법사 결과 주사위 등급별 코인(튜닝 지점). 실패=0.
	property integer HardSuccessCoin = 50

	property integer HardGreatCoin = 100

	property integer ExtremeSuccessCoin = 100

	property integer ExtremeGreatCoin = 200

	method integer BlackMageCoin(string outcome)
		-- 결과 등급(성공/대성공) + 난이도(하드/익스트림)별 지급 코인. 실패는 0.
		local great = self.HardGreatCoin
		local succ = self.HardSuccessCoin
		if self._diffKey == "Extreme" then
			great = self.ExtremeGreatCoin
			succ = self.ExtremeSuccessCoin
		end
		if outcome == "대성공" then return great end
		if outcome == "성공" then return succ end
		return 0
	end

	@ExecSpace("ServerOnly")
	method void AwardBlackMageRewards(string ownerId, string outcome, boolean statCleared)
		-- 검은 마법사 결과 보상: 등급별 코인 + (익스트림 & 적정전투력 이상=전투력으로 넘겼을 때만) 업적 뱃지.
		-- statCleared = (현재 전투력 >= 적정 전투력). 주사위 운으로 성공한 미달자는 코인만 받고 뱃지는 못 받는다.
		if ownerId == nil or ownerId == "" then return end
		local coin = self:BlackMageCoin(outcome)
		if coin > 0 and _MetaProgressionManager ~= nil then
			_MetaProgressionManager:AwardCoins(ownerId, coin)
		end
		if self._diffKey == "Extreme" and statCleared then
			local badgeId = self:ResolveExtremeBadgeId()
			if badgeId ~= "" then
				local granted = _BadgeService:AwardBadgeAndWait(ownerId, badgeId)
				log("[EndTile] 익스트림 뱃지 지급 user=" .. ownerId .. " id=" .. badgeId .. " ok=" .. tostring(granted))
			end
		end
		log("[EndTile] 검은마법사 보상 user=" .. ownerId .. " diff=" .. self._diffKey
			.. " outcome=" .. outcome .. " coin=" .. tostring(coin) .. " statClear=" .. tostring(statCleared))
	end

	method void CollectBadgeIds(table found, any pages)
		-- 검색 결과 페이지(BadgeInfoPages)를 끝까지 넘기며 (뱃지 이름 → 뱃지 ID)를 found 테이블에 모은다.
		-- 파라미터 타입이 any인 이유: BadgeInfoPages는 사용자 메서드 시그니처에 쓸 수 없는 내부 타입.
		-- 먼저 담긴 값을 우선(같은 이름이 여러 상태에 있으면 앞 상태의 것 유지). 페이지 상한은 무한루프 방어.
		if pages == nil then return end
		local guard = 0
		while guard < 40 do
			guard = guard + 1
			local infos = pages:GetCurrentPageDatas()
			if infos ~= nil then
				for _, info in ipairs(infos) do
					if info ~= nil and found[info.Name] == nil then
						found[info.Name] = info.Id
					end
				end
			end
			if pages.IsLastPage then return end
			pages:MoveToNextPageAndWait()
		end
	end

	method string ResolveExtremeBadgeId()
		-- 익스트림 뱃지 ID를 '이름'으로 해석한다. 그룹판/개인판이 서로 다른 ID를 발급받아도, 같은 이름의
		-- 뱃지만 등록돼 있으면 코드 수정 없이 양쪽에서 동일하게 동작한다. BadgeService 조회는 blocking이라
		-- 최초 1회만 하고 캐시한다. 이름을 못 찾으면 폴백 ID(BlackMageExtremeBadgeId)를 쓴다.
		if self._badgeLookupDone then return self._badgeIdCache end
		self._badgeLookupDone = true
		self._badgeIdCache = self.BlackMageExtremeBadgeId

		local wantedNames = {}
		for token in string.gmatch(self.BlackMageExtremeBadgeNames, "[^;]+") do
			table.insert(wantedNames, token)
		end
		if #wantedNames == 0 then return self._badgeIdCache end

		-- 등급은 전부 훑고, 상태는 '획득 가능 → 등록 진행 중 → 획득 대기' 순(END/DELETED는 지급 불가라 제외).
		local grades = { BadgeGrade.Normal, BadgeGrade.Rare, BadgeGrade.Epic }
		local found = {}
		self:CollectBadgeIds(found, _BadgeService:GetBadgeInfosAndWait(grades, BadgeStatus.Ing))
		self:CollectBadgeIds(found, _BadgeService:GetBadgeInfosAndWait(grades, BadgeStatus.Register))
		self:CollectBadgeIds(found, _BadgeService:GetBadgeInfosAndWait(grades, BadgeStatus.Waiting))

		for _, wanted in ipairs(wantedNames) do
			if found[wanted] ~= nil then
				self._badgeIdCache = found[wanted]
				log("[EndTile] 익스트림 뱃지 이름 해석 '" .. wanted .. "' → id=" .. self._badgeIdCache)
				return self._badgeIdCache
			end
		end
		log_warning("[EndTile] 익스트림 뱃지 이름(" .. self.BlackMageExtremeBadgeNames
			.. ")을 이 월드에서 못 찾음 → 폴백 id='" .. self._badgeIdCache .. "'")
		return self._badgeIdCache
	end

	method integer BlackMageRequiredPower()
		-- BossProbability의 (Black_Mage, 선택 난이도) 적정 전투력. Hard=45만 / Extreme=135만. 없으면 20000.
		local diff = self._diffKey
		if diff == nil or diff == "" then diff = "Hard" end
		local ds = _DataService:GetTable("BossProbability")
		if isvalid(ds) == false then return 20000 end
		for i = 1, ds:GetRowCount() do
			if ds:GetCell(i, "BossName") == "Black_Mage" and ds:GetCell(i, "Difficulty") == diff then
				return tonumber(ds:GetCell(i, "RequiredPower")) or 20000
			end
		end
		return 20000
	end

	method string Dlg(string key)
		-- BossDialog(Group=blackmage)의 대사 문구. 없으면 "".
		local ds = _DataService:GetTable("BossDialog")
		if isvalid(ds) == false then return "" end
		for i = 1, ds:GetRowCount() do
			if ds:GetCell(i, "Group") == "blackmage" and ds:GetCell(i, "Key") == key then
				return _VillageEventFlowManager:DecodeText(ds:GetCell(i, "Text"))
			end
		end
		return ""
	end

	@ExecSpace("Client")
	method void ClientShowBossSelect(string introText)
		-- 검은 마법사 단일 보스 선택 화면(선택지 1개). 카드 클릭 → 하드 → self:RequestSelect(...).
		_BossUI:ShowSingle(self, "Black_Mage", "검은 마법사", introText)
	end

	method string BlackMageStandRUID()
		-- 검은 마법사 인게임 stand 스프라이트(BossImage.IngameStandRUID). 최종전 이미지는 다른 보스처럼 BossImage에서 가져와 크게 표시.
		local ds = _DataService:GetTable("BossImage")
		if isvalid(ds) == false then return "" end
		for i = 1, ds:GetRowCount() do
			if ds:GetCell(i, "BossName") == "Black_Mage" then
				local st = ds:GetCell(i, "IngameStandRUID")
				if st ~= nil then return st end
				return ""
			end
		end
		return ""
	end

	@ExecSpace("Client")
	method void ClientStartChallenge(string text)
		-- BossUI 닫고 보스 전투 연출 시작(다른 보스와 동일: BossFightText). 마지막 장 '다음' → RequestQuestRoll.
		_BossUI:Hide()
		_EventTileUI:BossFightText(text, self:BlackMageStandRUID(), self)
	end

	@ExecSpace("Client")
	method void ClientShowText(string text, string npcKey, boolean win)
		-- 결과 문구 표시(콜백용 self). '다음' → RequestAdvance. 검은 마법사 결과 → 승리=웃음 / 패배=울음.
		_EventTileUI:BossSceneText(text, "idle", self:BlackMageStandRUID(), self)
		if win then _EventTileUI:PortraitEmoteKind("happy") else _EventTileUI:PortraitEmoteKind("cry") end
	end

	@ExecSpace("Client")
	method void ClientHide()
		-- 결전 UI 그룹 닫기.
		_EventTileUI:SceneHide()
	end

end