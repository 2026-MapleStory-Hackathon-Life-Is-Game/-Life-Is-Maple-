@Component
script EndTile extends BaseTile

	property any _piece = nil

	property integer _step = 0

	property boolean _won = false

	property boolean _cubeRolling = false

	method boolean IsFinalBattle()
		-- 이 종료칸이 스테이지3(마지막) End 인지 → 검은 마법사 최종 결전. (Stage 1·2 End은 false)
		if isvalid(self.Entity) == false then return false end
		-- [테스트] TileEventTester로 BlackMage를 강제하면 어느 칸이든 검은 마법사 결전으로 취급.
		if isvalid(_TileEventTester) and _TileEventTester.ForceEvent == "BlackMage" then return true end
		local stage = _TileManager:GetTileStage(self.Entity.CurrentMapName, self.Entity.Name)
		return stage == 3
	end

	method boolean IsEventTile()
		-- 모든 종료칸을 이벤트로 취급 → 턴 매니저가 완료 신호까지 대기(결과주사위 생략).
		-- Stage 1·2 = 큐브 획득 주사위(보너스), Stage 3 = 검은 마법사 결전. 둘 다 '다음'까지 대기가 필요.
		return true
	end

	method boolean IsInteractiveTile()
		-- 모든 종료칸을 인터랙티브로 취급 → 5초 자동대기 대신 완료(FinishEndTile) 신호까지 대기.
		return true
	end

	method string OwnerUserId(Entity piece)
		-- 말(piece)의 소유 유저 ID. 플레이어가 아니면 "".
		if isvalid(piece.PlayerComponent) == false then return "" end
		local uid = piece.PlayerComponent.UserId
		if uid == nil then return "" end
		return uid
	end

	@ExecSpace("ServerOnly")
	method void OnArrive(Entity piece)
		-- 일반 종료칸(Stage 1·2): 큐브 획득 주사위(보너스) → 완주 처리. 최종 결전 칸(Stage 3): 검은 마법사 선택 화면.
		if self:IsFinalBattle() == false then
			self._piece = piece
			self._cubeRolling = false
			local endOwnerId = self:OwnerUserId(piece)
			-- 큐브 롤 대상: 싱글은 굴리지 않음. 멀티는 '마지막 완주자(꼴찌)'만 제외하고 나머지 완주자가 굴린다.
			-- 이 시점은 MarkPlayerFinished 전이라, 이미 완주한 인원수(_finishedCount)가 (총원-1)이면 이번 도착이 꼴찌다.
			local doRoll = false
			if endOwnerId ~= "" and _GameModeManager._activeMode == "MULTI"
				and _MultiTurnManager ~= nil and _MultiTurnManager._isActive then
				if _MultiTurnManager._finishedCount < (_MultiTurnManager._playerCount - 1) then
					doRoll = true
				end
			end
			if doRoll then
				log("[EndTile] 종료 칸 도착 → 큐브 획득 주사위 tile=" .. self.Entity.Name)
				self:StartCubeRoll(piece, endOwnerId)
				return
			end
			-- 롤 없이 바로 완주 처리(싱글 전체 / 멀티 꼴찌 / 소유자 없음).
			log("[EndTile] 종료 칸 도착 → 큐브 롤 없이 완주 tile=" .. self.Entity.Name)
			self:FinishEndTile(piece)
			return
		end

		self._piece = piece
		local ownerId = self:OwnerUserId(piece)
		if ownerId == "" then
			-- 소유자 없는 말이면 결전 없이 즉시 종료.
			self:FinishEndTile(piece)
			return
		end
		self._step = 0
		log("[EndTile] 검은 마법사 결전 — 보스 선택 표시 tile=" .. self.Entity.Name)
		self:ClientShowBossSelect(self:Dlg("intro"), ownerId)
	end

	@ExecSpace("Server")
	method void RequestSelect(string bossKey, string diffKey)
		-- BossUI 단일 선택 콜백(검은 마법사/하드). 도전 문구로 진행.
		local piece = self._piece
		if isvalid(piece) == false then return end
		if senderUserId ~= self:OwnerUserId(piece) then return end
		self._step = 2
		log("[EndTile] 검은 마법사 선택 (" .. tostring(bossKey) .. "/" .. tostring(diffKey) .. ") → 도전")
		self:ClientStartChallenge(self:Dlg("challenge"), self:OwnerUserId(piece))
	end

	@ExecSpace("Server")
	method void RequestAdvance()
		-- 결전 대사 '다음': challenge → (CP 판정) win/lose → 게임 종료.
		local piece = self._piece
		if isvalid(piece) == false then return end
		if senderUserId ~= self:OwnerUserId(piece) then return end
		local ownerId = self:OwnerUserId(piece)

		if self._cubeRolling then
			-- 큐브 롤 결과 '다음' → 연출 닫고 완주 처리(보상은 StartCubeRoll에서 이미 지급됨).
			self._cubeRolling = false
			if ownerId ~= "" then
				self:ClientHide(ownerId)
				_EventTileUI:SpectatorSceneHide(ownerId)
			end
			self:FinishEndTile(piece)
			return
		end

		if self._step == 2 then
			-- CP 판정: 현재 전투력이 하드 검은 마법사 적정 전투력 이상이면 승리.
			local cp = 0
			local cpm = piece:GetComponent("script.CombatPowerManager")
			if isvalid(cpm) then cp = cpm.CombatPower end
			local req = self:BlackMageRequiredPower()
			self._won = cp >= req
			self._step = 3
			local key = "lose"
			if self._won then key = "win" end
			log("[EndTile] 검은 마법사 판정 CP=" .. tostring(cp) .. " / 적정=" .. tostring(req) .. " → " .. key)
			self:ClientShowText(self:Dlg(key), "BlackMage", self._won, ownerId)
		else
			self:EndBattle()
		end
	end

	@ExecSpace("ServerOnly")
	method void StartCubeRoll(Entity piece, string ownerId)
		-- 종료칸 도착 보너스: 주사위를 굴려 미라클 큐브를 획득한다.
		-- 실패=0개 / 성공=1개 / 대성공=3개, 확률 20/50/30. (마을 확률게임과 동일 롤 머신 재사용.)
		-- 보상은 여기서 서버에 즉시 지급하고(연출 중 이탈해도 보장), 결과는 롤 UI로 연출한다.
		self._cubeRolling = true
		local greatPct = 30
		local successPct = 50
		local failPct = 20
		local np = _RollResultDiceAnimationUI:NormalizeProbabilities(greatPct, successPct, failPct)
		greatPct = np.great
		successPct = np.success
		failPct = np.fail
		-- 결과판(주사위합 2~12 → 0실패/1성공/2대성공). 서버 권위 판정.
		local board = _ResultDiceManager:PlaceOutcomes(failPct, successPct, greatPct)
		local d1 = _UtilLogic:RandomIntegerRange(1, 6)
		local d2 = _UtilLogic:RandomIntegerRange(1, 6)
		local sum = d1 + d2
		local tier = board[sum] or 1
		-- tier: 0=실패(0개) / 1=성공(1개) / 2=대성공(3개)
		local outcomeLabel = "성공"
		local cubes = 1
		if tier == 0 then
			outcomeLabel = "실패"
			cubes = 0
		elseif tier == 2 then
			outcomeLabel = "대성공"
			cubes = 3
		end
		-- 보상 즉시 지급(cubes=0이면 GrantCube 내부에서 무시).
		self:GrantCube(piece, cubes)
		log("[EndTile] 큐브 롤 owner=" .. ownerId .. " 주사위=" .. tostring(d1) .. "+" .. tostring(d2) .. "=" .. tostring(sum) .. " → " .. outcomeLabel .. " (큐브 " .. tostring(cubes) .. "개)")

		local leadText = "결승선에 도착했다!\n주사위를 굴려 미라클 큐브를 획득하자!"
		local resultText = "아쉽지만 이번엔 큐브를 얻지 못했다..."
		if cubes > 0 then
			resultText = "미라클 큐브 " .. tostring(cubes) .. "개를 획득했다!"
		end
		-- actor: 굴림 연출. 멀티 관전자: 주사위 방송 + 씬 미러(마을 확률게임과 동일).
		self:ClientShowCubeRoll(leadText, resultText, d1, d2, sum, greatPct, successPct, failPct, outcomeLabel, ownerId)
		_RollResultDiceAnimationUI:SpectatorDiceBroadcast(d1, d2, sum, board, outcomeLabel, ownerId)
		_EventTileUI:SpectatorSceneRoll(leadText, resultText, "idle", "", ownerId)
	end

	@ExecSpace("Client")
	method void ClientShowCubeRoll(string leadText, string resultText, integer d1, integer d2, integer total, number greatPct, number successPct, number failPct, string outcomeLabel)
		-- 도착 플레이어 클라: 큐브 롤 연출(리드텍스트 → 주사위 → 결과문구 → '다음' → RequestAdvance).
		_EventTileUI:SceneRoll(leadText, "idle", resultText, d1, d2, total, greatPct, successPct, failPct, outcomeLabel, "", self)
	end

	@ExecSpace("ServerOnly")
	method void FinishEndTile(Entity piece)
		-- 종료칸 완주 처리: 완주 기록(OnPlayerReachedEnd) 후 모드별로 턴을 진행/정지시킨다.
		-- 싱글=턴 루프 정지(게임 종료→결과 카드). 멀티=완료 신호로 턴 진행(다른 플레이어 계속, 전원 완주 시 FinishMulti).
		-- ⚠ 멀티에서 _SingleTurnManager:Stop()만 부르면(과거 버그) MultiTurnManager가 완료 신호를 못 받아 TILE 상태에 영구 정지한다.
		if isvalid(piece) then _GameModeManager:OnPlayerReachedEnd(piece) end
		if _GameModeManager._activeMode == "MULTI" then
			_GameModeManager:NotifyTileEventDone()
		else
			_SingleTurnManager:Stop()
		end
	end

	@ExecSpace("ServerOnly")
	method void EndBattle()
		-- 결전 종료: 승/패 무관 게임 종료(기존 종료 경로 재사용). UI 닫고 상태 정리.
		local piece = self._piece
		local ownerId = ""
		if isvalid(piece) then ownerId = self:OwnerUserId(piece) end
		self._piece = nil
		self._step = 0
		if ownerId ~= "" then self:ClientHide(ownerId) end
		-- 검은 마법사 클리어 선착순 보상: 완주 순위별 주스탯/공격력 % 버프(FinishEndTile 전 = MarkPlayerFinished 전이라 rank=_finishedCount+1).
		self:ApplyClearRankReward(piece)
		-- 엔딩 요약을 결과창과 통합 → 별도 정리 표/'다음' 없이 바로 종료 흐름(FinishEndTile→통합 결과 카드/멀티 순위표)으로 진행.
		self:FinishEndTile(piece)
		log("[EndTile] 검은 마법사 결전 종료(won=" .. tostring(self._won) .. ") → 통합 결과 카드")
	end

	@ExecSpace("ServerOnly")
	method void ApplyClearRankReward(Entity piece)
		-- 검은 마법사(최종) 클리어 선착순 보상(더미데이터): 완주 순위별 주스탯/공격력 % 버프.
		-- 1등 주30/공30, 2등 주20/공30, 3등 주10/공10, 그 외/꼴찌 주5/공5. (싱글은 1등 취급.)
		-- 이 시점은 MarkPlayerFinished 전이므로 이번 완주로 매겨질 순위 = _finishedCount + 1.
		if isvalid(piece) == false then return end
		local rank = 1
		local total = 1
		if _GameModeManager._activeMode == "MULTI" and _MultiTurnManager ~= nil then
			rank = _MultiTurnManager._finishedCount + 1
			total = _MultiTurnManager._playerCount
		end
		local mainPct = 5
		local attackPct = 5
		if total >= 2 and rank >= total then
			mainPct = 5
			attackPct = 5   -- 꼴찌(마지막 완주자)
		elseif rank == 1 then
			mainPct = 30
			attackPct = 30
		elseif rank == 2 then
			mainPct = 20
			attackPct = 30
		elseif rank == 3 then
			mainPct = 10
			attackPct = 10
		end
		self:AddMainStat(piece, "percent", mainPct)
		self:AddMainAttack(piece, "percent", attackPct)
		log("[EndTile] 검은마법사 클리어 순위보상 rank=" .. tostring(rank) .. "/" .. tostring(total)
			.. " → 주스탯+" .. tostring(mainPct) .. "% 공격+" .. tostring(attackPct) .. "%")
	end

	method integer BlackMageRequiredPower()
		-- BossProbability의 (Black_Mage, Hard) 적정 전투력. 없으면 20000.
		local ds = _DataService:GetTable("BossProbability")
		if isvalid(ds) == false then return 20000 end
		for i = 1, ds:GetRowCount() do
			if ds:GetCell(i, "BossName") == "Black_Mage" and ds:GetCell(i, "Difficulty") == "Hard" then
				return tonumber(ds:GetCell(i, "RequiredPower")) or 20000
			end
		end
		return 20000
	end

	method string Dlg(string key)
		-- BossDialog(Group=blackmage)의 대사 문구. 없으면 "".
		local ds = _DataService:GetTable("BossDialog")
		if isvalid(ds) == false then return "" end
		for i = 1, ds:GetRowCount() do
			if ds:GetCell(i, "Group") == "blackmage" and ds:GetCell(i, "Key") == key then
				return _VillageEventFlowManager:DecodeText(ds:GetCell(i, "Text"))
			end
		end
		return ""
	end

	@ExecSpace("Client")
	method void ClientShowBossSelect(string introText)
		-- 검은 마법사 단일 보스 선택 화면(선택지 1개). 카드 클릭 → 하드 → self:RequestSelect(...).
		_BossUI:ShowSingle(self, "Black_Mage", "검은 마법사", introText)
	end

	method string BlackMageStandRUID()
		-- 검은 마법사 인게임 stand 스프라이트(BossImage.IngameStandRUID). 최종전 이미지는 다른 보스처럼 BossImage에서 가져와 크게 표시.
		local ds = _DataService:GetTable("BossImage")
		if isvalid(ds) == false then return "" end
		for i = 1, ds:GetRowCount() do
			if ds:GetCell(i, "BossName") == "Black_Mage" then
				local st = ds:GetCell(i, "IngameStandRUID")
				if st ~= nil then return st end
				return ""
			end
		end
		return ""
	end

	@ExecSpace("Client")
	method void ClientStartChallenge(string text)
		-- BossUI 닫고 도전 문구 표시(콜백용 self). '다음' → RequestAdvance.
		-- 검은 마법사는 다른 보스와 동일하게 원본 크기 × 전역 배율(BossImage 설정)로 크게 표시한다.
		_BossUI:Hide()
		_EventTileUI:BossSceneText(text, "idle", self:BlackMageStandRUID(), self)
	end

	@ExecSpace("Client")
	method void ClientShowText(string text, string npcKey, boolean win)
		-- 결과 문구 표시(콜백용 self). '다음' → RequestAdvance. 검은 마법사 결과 → 승리=웃음 / 패배=울음.
		_EventTileUI:BossSceneText(text, "idle", self:BlackMageStandRUID(), self)
		if win then _EventTileUI:PortraitEmoteKind("happy") else _EventTileUI:PortraitEmoteKind("cry") end
	end

	@ExecSpace("Client")
	method void ClientHide()
		-- 결전 UI 그룹 닫기.
		_EventTileUI:SceneHide()
	end

end