@Component
script BossTile extends EventTileBase

	@Sync
	property string introText = "신규 장비를 모아 더 강해지고 싶다! \n 어떤 보스를 처치하러 갈까?"

	property any _currentPiece = nil

	property string _selectedBossName = "노말스우"

	property string _selectedBossKey = "Lotus"

	property string _selectedDiff = "Normal"

	method boolean IsInteractiveTile()
		-- 선택/연출이 완료될 때까지 턴 매니저가 대기하도록 인터랙티브로 표시.
		return true
	end

	@ExecSpace("ServerOnly")
	method void OnArrive(Entity piece)
		-- 보스 이벤트 시작: EventTileGroup 안내 문구 + BossUI 선택 화면 표시.
		-- 등장 보스는 이 타일의 (Stage,Region)으로 BossSpawn 데이터셋에서 조회한다(지역별 상이).
		self._currentPiece = piece
		local ownerId = self:OwnerUserId(piece)
		if ownerId == "" then
			_GameModeManager:NotifyTileEventDone()
			return
		end
		local mapName = self.Entity.CurrentMapName
		local stage = _TileManager:GetTileStage(mapName, self.Entity.Name)
		local region = _TileManager:GetTileRegion(mapName, self.Entity.Name)
		local roster = self:BuildBossRoster(stage, region)
		if #roster.keys == 0 then
			-- 이 지역엔 등장 보스가 없다(BossSpawn 미등록). 이벤트 없이 턴만 진행.
			log_warning("[BossTile] 등장 보스 없음 stage=" .. tostring(stage) .. " region=" .. tostring(region) .. " — 이벤트 스킵")
			self._currentPiece = nil
			_GameModeManager:NotifyTileEventDone()
			return
		end
		local intro = self:BossText("all", "intro", "", "")
		if intro == "" then intro = self.introText end
		self:OpenBossSelection(intro, roster.keys, roster.diffs, ownerId)
		log("[BossTile] 보스 선택 표시 tile=" .. self.Entity.Name
			.. " region=" .. tostring(region) .. " 보스수=" .. tostring(#roster.keys))
	end

	method table BuildBossRoster(integer stage, string region)
		-- BossSpawn에서 (Stage,Region) 일치 행을 표 순서대로 모아 { keys={...}, diffs={...} } 반환.
		--   keys[i]  = 보스 키(BossProbability.BossName 영문키)
		--   diffs[i] = 이 지역에서 허용하는 난이도 CSV("Normal/Chaos"). 카드 표시/난이도 제한에 사용.
		local keys = {}
		local diffs = {}
		local ds = _DataService:GetTable("BossSpawn")
		if isvalid(ds) == false then return { keys = keys, diffs = diffs } end
		for i = 1, ds:GetRowCount() do
			if (tonumber(ds:GetCell(i, "Stage")) or 0) == stage and ds:GetCell(i, "Region") == region then
				table.insert(keys, ds:GetCell(i, "BossName"))
				table.insert(diffs, ds:GetCell(i, "Difficulties"))
			end
		end
		return { keys = keys, diffs = diffs }
	end

	@ExecSpace("Client")
	method void OpenBossSelection(string introMessage, table bossKeys, table bossDiffs)
		-- 도착 플레이어 클라: 보스 선택 중에는 BossUI 그룹만 사용(EventTileGroup은 꺼둔다).
		-- 지역 로스터(bossKeys/bossDiffs)를 넘겨 카드/난이도를 구성한다. 안내 문구는 BossUI 자체 UIText로 표시.
		_BossUI:ShowRoster(self, introMessage, bossKeys, bossDiffs)
	end

	@ExecSpace("Server")
	method void RequestSelect(string bossKey, string diffKey)
		-- BossUI에서 보스+난이도 최종 선택 → BossUI 닫고 도전 연출 시작.
		local piece = self._currentPiece
		if isvalid(piece) == false then return end
		if senderUserId ~= self:OwnerUserId(piece) then return end
		self._selectedBossKey = bossKey
		self._selectedDiff = diffKey
		self._selectedBossName = self:DiffLabel(diffKey) .. self:BossName(bossKey)
		local ownerId = self:OwnerUserId(piece)
		local challengeText = self:BossText("all", "challenge", self._selectedBossName, "")
		if challengeText == "" then challengeText = self._selectedBossName .. " 처치에 도전하였다!\n각오해라!" end
		self:StartChallenge(challengeText, bossKey, ownerId)
		_EventTileUI:SpectatorBossFightText(challengeText, self:BossStandRUID(bossKey), ownerId)
		log("[BossTile] 선택: " .. self._selectedBossName)
	end

	@ExecSpace("Client")
	method void StartChallenge(string challengeText, string bossKey)
		-- 도착 플레이어 클라: BossUI 닫고 EventTileGroup에서 보스 전투 연출 시작.
		-- 플레이어 공격 모션 + 상대 NPCImage에 보스 stand 스프라이트 + 도전 문구.
		_BossUI:Hide()
		_EventTileUI:BossFightText(challengeText, self:BossStandRUID(bossKey), self)
	end

	@ExecSpace("Server")
	method void RequestQuestRoll()
		-- 도전 문구 표시가 끝난 뒤 클라가 호출 → 지금 결과를 굴려 효과음을 패널과 맞추고 보상 적용.
		local piece = self._currentPiece
		if isvalid(piece) == false then return end
		if senderUserId ~= self:OwnerUserId(piece) then return end
		
		-- 결과 주사위: 보스 표(BossProbability) 기반 판정. 현재 전투력을 적정전투력(RequiredPower)과 비교해
		-- 미만/이상 밴드의 실패:성공:대성공 확률을 적용한다(폐기된 CP 비례식 대신).
		local cp = 0
		local cpm = self:CP(piece)
		if isvalid(cpm) then cp = cpm.CombatPower end
		local total = _ResultDiceManager:RollByBossTable(self._selectedBossKey, self._selectedDiff, cp)
		local d1 = _ResultDiceManager._dice1
		local d2 = _ResultDiceManager._dice2
		local outcome = _ResultDiceManager.GameOutcome
		local resultTable = _ResultDiceManager:GetResultTable()
		
		-- 결과 등급 → BossDialog(all) 키. 등급별 보상 토큰 적용 + 대성공은 드랍 장비 지급.
		local key = "fail"
		if outcome == "성공" then key = "success"
		elseif outcome == "대성공" then key = "great" end
		local line = self:BossLine("all", key)
		if line ~= nil and line.reward ~= "" then self:ApplyBossReward(piece, line.reward) end
		-- 장비 드랍은 대성공(great)에서만. 드랍 후보(DropReward)가 여러 종류면 그중 한 종류만 랜덤 지급한다.
		local drop = ""
		if key == "great" then
			local one = self:PickOneDrop(self:DropRewardTokens(self._selectedBossKey, self._selectedDiff))
			if one ~= "" then
				self:ApplyRewardString(piece, one)          -- item:EquipName / weapon:Family 한 종류만 지급
				drop = self:ResolveDropName(piece, one)      -- 결과 문구 {drop}에 실제 지급 장비명 표시
			end
		end
		local outcomeText = self:BossText("all", key, self._selectedBossName, drop)
		log("[BossTile] 도전 " .. outcome .. " → " .. key)
		
		local ownerId = self:OwnerUserId(piece)
		self:ShowChallengeDice(d1, d2, total, resultTable, outcome, outcomeText, self._selectedBossKey, ownerId)
		_RollResultDiceAnimationUI:SpectatorDiceBroadcast(d1, d2, total, resultTable, outcome, ownerId)
		_EventTileUI:SpectatorBossFollow((outcome == "성공" or outcome == "대성공"), outcome, outcomeText, self:BossDieRUID(self._selectedBossKey), ownerId)
	end

	@ExecSpace("Client")
	method void ShowChallengeDice(integer d1, integer d2, integer total, table resultTable, string outcome, string outcomeText, string bossKey)
		-- 도착 플레이어 클라: 결과 주사위 연출 → 성공 시 보스 die 애니 / 실패 시 기본 유지 + 플레이어 idle → 결과 문구.
		_EventTileUI:BossFightDice(d1, d2, total, resultTable, outcome, outcomeText, self:BossDieRUID(bossKey), self)
	end

	@ExecSpace("Server")
	method void RequestFinish()
		-- 클라가 도전 연출(결과 문구 표시까지)을 끝냈음을 알림 → 턴 진행 신호.
		log("[BossTile] 도전 연출 종료 — 이벤트 종료")
		local ownerId = ""
		if isvalid(self._currentPiece) then ownerId = self:OwnerUserId(self._currentPiece) end
		if ownerId ~= "" then _EventTileUI:SpectatorSceneHide(ownerId) end
		self._currentPiece = nil
		_GameModeManager:NotifyTileEventDone()
	end

	method string BossName(string key)
		-- 보스 키 → 표시명(BossProbability.BossNameKR). 없으면 키 그대로.
		local bp = _DataService:GetTable("BossProbability")
		if isvalid(bp) then
			for i = 1, bp:GetRowCount() do
				if bp:GetCell(i, "BossName") == key then
					local nm = bp:GetCell(i, "BossNameKR")
					if nm ~= nil and nm ~= "" then return nm end
				end
			end
		end
		return key
	end

	method string BossStandRUID(string key)
		-- 보스 전투 연출용 stand 스프라이트. 우선순위: BossFightStandRUID(보스 전투 전용) → IngameStandRUID → DetailPanelRUID.
		-- (연애 등 다른 이벤트는 IngameStandRUID를 쓰므로, 보스 전투에서만 다른 스프라이트를 쓰고 싶으면 BossFightStandRUID로 분리한다. 예: 루시드)
		local ds = _DataService:GetTable("BossImage")
		if isvalid(ds) == false then return "" end
		for i = 1, ds:GetRowCount() do
			if ds:GetCell(i, "BossName") == key then
				local bf = ds:GetCell(i, "BossFightStandRUID")
				if bf ~= nil and bf ~= "" then return bf end
				local st = ds:GetCell(i, "IngameStandRUID")
				if st ~= nil and st ~= "" then return st end
				local dp = ds:GetCell(i, "DetailPanelRUID")
				if dp ~= nil then return dp end
				return ""
			end
		end
		return ""
	end

	method string BossDieRUID(string key)
		-- 보스 처치 시 재생할 die 애니메이션 RUID(BossImage.DieAnimRUID). 없으면 "".
		local ds = _DataService:GetTable("BossImage")
		if isvalid(ds) == false then return "" end
		for i = 1, ds:GetRowCount() do
			if ds:GetCell(i, "BossName") == key then
				local d = ds:GetCell(i, "DieAnimRUID")
				if d ~= nil then return d end
				return ""
			end
		end
		return ""
	end

	method string DiffLabel(string diff)
		-- 난이도 키 → 표시 라벨.
		if diff == "Easy" then return "이지" end
		if diff == "Hard" then return "하드" end
		if diff == "Chaos" then return "카오스" end
		return "노말"
	end

	method string PickOneDrop(string dropReward)
		-- DropReward의 ';'로 구분된 장비 토큰 중 한 종류만 랜덤 선택해 반환. 비었으면 "".
		if dropReward == nil or dropReward == "" then return "" end
		local tokens = {}
		for part in string.gmatch(dropReward, "[^;]+") do
			table.insert(tokens, part)
		end
		if #tokens == 0 then return "" end
		if #tokens == 1 then return tokens[1] end
		return tokens[_UtilLogic:RandomIntegerRange(1, #tokens)]
	end

	method string ResolveDropName(Entity piece, string token)
		-- 지급된 보상 토큰 1개("item:EquipName" / "weapon:Family")를 실제 지급 장비의 표시명(EquipmentData.Name)으로 변환.
		-- weapon은 도착 플레이어 직업에 맞는 실제 무기로 해석한다.
		if token == nil or token == "" then return "" end
		local colon, _e = string.find(token, ":", 1, true)
		if colon == nil then return token end
		local kind = string.sub(token, 1, colon - 1)
		local equipName = string.sub(token, colon + 1)
		if kind == "weapon" then
			local cls = self:ClassOfPiece(piece)
			if cls == "" or cls == "Common" then cls = _JobWeaponManager.currentJob end
			local w = self:ClassWeaponFor(equipName, cls)
			if w ~= "" then equipName = w end
		end
		local ds = _DataService:GetTable("EquipmentData")
		if isvalid(ds) then
			for i = 1, ds:GetRowCount() do
				if ds:GetCell(i, "EquipName") == equipName then
					local nm = ds:GetCell(i, "Name")
					if nm ~= nil and nm ~= "" then return nm end
				end
			end
		end
		return equipName
	end

	method string DropRewardTokens(string bossKey, string diff)
		-- BossProbability에서 (보스, 난이도)의 실제 지급용 보상 토큰(DropReward). 없으면 "".
		-- 예: "item:Highness_Warrior_Helm;weapon:Fafnir;item:Dominator_Pendant".
		local ds = _DataService:GetTable("BossProbability")
		if isvalid(ds) == false then return "" end
		for i = 1, ds:GetRowCount() do
			if ds:GetCell(i, "BossName") == bossKey and ds:GetCell(i, "Difficulty") == diff then
				return ds:GetCell(i, "DropReward")
			end
		end
		return ""
	end

	method table BossLine(string group, string key)
		-- BossDialog에서 (Group,Key) 행 → { reward, text }. 없으면 nil.
		local ds = _DataService:GetTable("BossDialog")
		if isvalid(ds) == false then return nil end
		for i = 1, ds:GetRowCount() do
			if ds:GetCell(i, "Group") == group and ds:GetCell(i, "Key") == key then
				return {
					reward = ds:GetCell(i, "Reward"),
					text   = _VillageEventFlowManager:DecodeText(ds:GetCell(i, "Text")),
				}
			end
		end
		return nil
	end

	method string BossText(string group, string key, string bossName, string drop)
		-- BossDialog 문구 + 치환자({boss}=보스명, {drop}=드랍 장비명) 적용. 없으면 "".
		local line = self:BossLine(group, key)
		if line == nil then return "" end
		local t = line.text
		local _c1
		t, _c1 = string.gsub(t, "{boss}", bossName)
		t, _c1 = string.gsub(t, "{drop}", drop)
		return t
	end

	@ExecSpace("ServerOnly")
	method void ApplyBossReward(Entity piece, string rewardStr)
		-- 보상 토큰(main%/attack%/cube 등) 파싱·적용. 스탯은 베이스 ApplyReward, 큐브는 GrantCube.
		if rewardStr == nil or rewardStr == "" then return end
		local rewards = _VillageEventFlowManager:ParseReward(rewardStr)
		for i = 1, #rewards do
			local r = rewards[i]
			if r.kind == "cube" then
				self:GrantCube(piece, r.value)
			else
				self:ApplyReward(piece, { statKind = r.kind, statMode = r.mode or "flat", statValue = r.value })
			end
		end
	end

end