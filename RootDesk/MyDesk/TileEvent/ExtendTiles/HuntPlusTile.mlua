@Component
script HuntPlusTile extends HuntTile

	-- 사냥+ 타일 — '기본 사냥'을 먼저 하고, '이어서' 사냥+ 고유 이벤트가 발생하는 인터랙티브 이벤트 타일.
	--   1) 기본 사냥: HuntTile과 동일하게 HuntEvent 데이터셋으로 사냥 결과를 굴려 보상(주스탯/올스탯 등).
	--   2) 이어서(둘 중 하나):
	--      · 이벤트1(Elite): {마을 사냥터}에서 엘리트 몬스터와 조우 → 처치 → 공격력/마력 상승.
	--      · 이벤트2(Cheer): {마을 사냥터}에서 사냥 중 지나가던 모험가가 응원
	--                        → (다음 씬) 붕어빵 버프 획득 → 주스탯 상승.
	-- 두 문구는 '\n\n'(빈 줄=팝업 페이지 경계)으로 이어 붙여 '다음' 클릭으로 한 장씩 넘긴다.
	--   보상은 '기본 사냥 보상 + 사냥+ 보상'을 모두 적용한다(둘 다 RollEvent에서 직접 적용).
	-- HuntTile을 상속하므로 기본 사냥 롤(RollHuntEvent)/SplitPipe/StatDisplayName/FallbackEvent를 재사용한다.
	-- 흐름은 EventTileBase와 동일: 도착 → RollEvent → 보상 적용 → 도착 플레이어 클라에 팝업 → '다음'으로 종료.
	-- '마을 사냥터' 이름은 HuntTile과 동일하게 현재 타일 지역(마을)의 한글명 + " 사냥터"로 합성한다.
	--
	-- 이벤트 값(발생 가중치/스탯 종류·증가량/표시 이름/몬스터 RUID)은 스크립트 밖 데이터셋
	--   'HuntPlusEvent'(HuntPlusEvent.userdataset + .csv)에서 관리한다. 값 조정은 CSV만 수정하면 되고,
	--   엘리트 몬스터 스프라이트 RUID도 CSV의 MonsterRUID 칸을 나중에 채우기만 하면 적용된다.
	--   CSV 컬럼: EventKey / Weight / StatKind / StatGain / DisplayName / StatName / PortraitAnim / MonsterRUID
	--     · EventKey    : "Elite"(엘리트) / "Cheer"(응원) — 문구 구성 분기 키
	--     · Weight      : 선택적 발생 가중치(둘 다 1이면 50:50)
	--     · StatKind    : 보상 종류 — "attack"(공/마) / "main"(주스탯) (EventTileBase.ApplyReward 키와 동일)
	--     · StatGain    : 증가량(임시 고정값, 기획 조정)
	--     · DisplayName : 문구에 넣을 이름(Elite=몬스터 이름 / Cheer='붕어빵' — 문구용 이름일 뿐, 스탯창/버프바엔 안 뜸)
	--     · StatName    : 문구에 넣을 스탯 이름("공격력/마력" / "주스탯")
	--     · PortraitAnim: 초상화 애니("attack" / "idle")
	--     · MonsterRUID : 팝업에 띄울 몬스터 STAND 스프라이트 RUID(없으면 "" → 이미지 숨김)

	method table RollEvent(Entity piece)
		-- 사냥+ 타일: 기본 사냥 결과를 먼저 굴리고, 이어서 사냥+ 고유 이벤트(Elite/Cheer)를 이어붙인다.
		local huntEv = self:RollHuntEvent(piece)   -- 1) 기본 사냥(HuntTile 로직 상속)
		local plusEv = self:RollPlusEvent(piece)   -- 2) 사냥+ 고유 이벤트(엘리트/응원)

		-- 폴백: 사냥+ 데이터셋이 없으면 기본 사냥 결과만 표시(OnArrive가 사냥 보상 적용).
		if plusEv == nil then
			log_warning("[HuntPlusTile] 사냥+ 이벤트 nil — 기본 사냥만 표시")
			return huntEv
		end
		-- (희박) 기본 사냥이 nil이면 사냥+ 이벤트만 표시.
		if huntEv == nil then
			return plusEv
		end

		-- 두 보상('기본 사냥' + '사냥+')을 이 자리에서 모두 적용하고,
		-- 반환 table의 statKind는 비워 OnArrive의 ApplyReward가 중복 적용하지 않도록 한다.
		self:ApplyReward(piece, huntEv)
		self:ApplyReward(piece, plusEv)

		-- 문구 결합: [기본 사냥 씬(1장)] → '\n\n'(페이지 경계) → [사냥+ 씬(Elite 1장 / Cheer 2장)].
		-- 이미지: 페이지1(기본 사냥)은 사냥 몬스터 이미지, 페이지2(사냥+ 씬)부터 NPC 이미지로 전환(npcFromPage=2).
		--   → EventTileUI가 '다음'으로 페이지2에 도달하는 순간 몬스터→NPC로 교체한다.
		-- (기본 사냥 문구는 항상 1페이지 = '\n' 한 줄뿐이라 사냥+ 씬은 반드시 페이지2에서 시작한다.)
		return {
			eventType   = plusEv.eventType,
			message     = huntEv.message .. "\n\n" .. plusEv.message,
			statKind    = "",                          -- 보상은 위에서 이미 적용(중복 방지)
			statMode    = "flat",
			statValue   = 0,
			monsterRUID = huntEv.monsterRUID or "",     -- 페이지1: 기본 사냥 몬스터 이미지
			imageKind   = "monster",                    -- 시작 이미지 = 몬스터
			npcKey      = plusEv.npcKey,                 -- 페이지2+: 사냥+ NPC 이미지
			npcFromPage = 2,                            -- 2번째 페이지부터 NPC로 전환
			anim        = plusEv.anim or "idle",
		}
	end

	method table RollPlusEvent(Entity piece)
		-- 서버에서 HuntPlusEvent 데이터셋을 읽어 두 이벤트 중 하나를 가중치로 고르고,
		-- 문구/애니/보상/몬스터RUID를 담은 table을 반환한다(보상 적용은 호출부 RollEvent가 담당).
		local ds = _DataService:GetTable("HuntPlusEvent")
		if isvalid(ds) == false then
			log_error("[HuntPlusTile] HuntPlusEvent 데이터셋 없음")
			return nil
		end
		local rows = ds:GetRowCount()
		if rows <= 0 then
			log_warning("[HuntPlusTile] HuntPlusEvent 행 없음")
			return nil
		end

		-- '마을 사냥터' = 현재 타일 지역(마을)의 한글명 + " 사냥터" (예: 헤네시스 사냥터).
		local map = self.Entity.CurrentMapName
		local tile = self.Entity.Name
		local region = _TileManager:GetTileRegion(map, tile)
		local huntingGround = _TileManager:RegionDisplayName(region) .. " 사냥터"

		-- 가중치 롤로 이벤트 행 하나 선택.
		local total = 0
		for i = 1, rows do total += (tonumber(ds:GetCell(i, "Weight")) or 0) end
		if total <= 0 then
			log_warning("[HuntPlusTile] HuntPlusEvent 가중치 합 0")
			return nil
		end
		local roll = _UtilLogic:RandomIntegerRange(1, total)
		local acc = 0
		local pick = rows
		for i = 1, rows do
			acc += (tonumber(ds:GetCell(i, "Weight")) or 0)
			if roll <= acc then
				pick = i
				break
			end
		end

		-- 선택된 행의 값 읽기.
		local eventKey    = ds:GetCell(pick, "EventKey")
		local statKind    = ds:GetCell(pick, "StatKind")
		local statGain    = tonumber(ds:GetCell(pick, "StatGain")) or 0
		local displayName = ds:GetCell(pick, "DisplayName")
		local statName    = ds:GetCell(pick, "StatName")
		local anim        = ds:GetCell(pick, "PortraitAnim")
		local monsterRUID = ds:GetCell(pick, "MonsterRUID")
		if anim == "" then anim = "idle" end

		if eventKey == "Cheer" then
			-- ── 이벤트2: 모험가 응원 → (다음 씬) '붕어빵 버프' 획득 → 주스탯 +N ──
			-- 두 '씬'은 '\n\n'(빈 줄)으로 구분한다 → 클라 팝업이 페이지로 나눠 '다음' 클릭으로 넘어간다.
			--   씬1: 응원받음 → '다음' → 씬2: 붕어빵 버프 획득/주스탯 상승 → '다음' → 종료.
			-- '붕어빵'은 문구용 이름일 뿐이라 버프바/스탯창엔 뜨지 않는다. 실제 효과인 주스탯 +N만
			--   statKind="main"(주스탯 증가)으로 적용한다.
			local scene1 = huntingGround .. "에서 몬스터를 사냥하던 중 지나가던 모험가가 나를 응원해주었다!"
			local scene2 = "모험가의 응원에 힘을 얻었다!\n" .. displayName .. "버프를 얻었다.\n"
				.. statName .. "이 " .. tostring(statGain) .. "만큼 올랐다."
			return {
				eventType   = "HuntPlusCheer",
				message     = scene1 .. "\n\n" .. scene2,
				statKind    = statKind,       -- "main" → 주스탯 증가
				statMode    = "flat",
				statValue   = statGain,
				monsterRUID = "",              -- 응원 이벤트는 몬스터 이미지 없음
				imageKind   = "npc",           -- 사냥+ 타일 → NPC 이미지 표시
				anim        = anim,
			}
		end

		-- ── 이벤트1(기본, Elite): 엘리트 몬스터 조우 → 처치 → 공격력/마력 +N ──
		local line1 = huntingGround .. "에서 " .. displayName .. "와 조우했다!"
		local line2 = displayName .. "를 처치하여 " .. statName .. "이 " .. tostring(statGain) .. "만큼 올랐다!"
		return {
			eventType   = "HuntPlusElite",
			message     = line1 .. "\n" .. line2,
			statKind    = statKind,       -- "attack" → 공/마 증가
			statMode    = "flat",
			statValue   = statGain,
			monsterRUID = monsterRUID,    -- (미사용) 엘리트 몬스터 RUID — 사냥+는 NPC 이미지를 쓴다
			imageKind   = "npc",           -- 사냥+ 타일 → NPC 이미지 표시
			anim        = anim,
		}
	end

	@ExecSpace("Server")
	method void RequestDone()
		-- '다음' 클릭 시 이벤트 종료 RPC. (베이스 상속 RPC가 서브클래스에서 라우팅 안 되므로 리프에 재정의)
		local piece = self._eventPiece
		if isvalid(piece) and senderUserId ~= self:OwnerUserId(piece) then return end
		self:FinishEventTile()
	end

end
