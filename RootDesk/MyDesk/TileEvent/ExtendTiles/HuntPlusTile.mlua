@Component
script HuntPlusTile extends HuntTile

	-- 사냥+ 타일 — '기본 사냥'을 먼저 하고, '이어서' 사냥+ 고유 이벤트가 발생하는 인터랙티브 이벤트 타일.
	--   1) 기본 사냥: HuntTile과 동일하게 HuntEvent 데이터셋으로 사냥 결과를 굴려 보상(주스탯/올스탯 등).
	--   2) 이어서(둘 중 하나, 지역별 데이터로 결정):
	--      · 몬스터 조우(monster): {마을 사냥터}에서 강력한 몬스터 조우 → 처치 → 스탯 상승.
	--      · NPC 조우(npc): {마을 사냥터}에서 사냥 중 NPC를 만남(응원/축복 등) → 스탯 상승.
	-- 두 문구는 '\n\n'(빈 줄=팝업 페이지 경계)으로 이어 붙여 '다음' 클릭으로 한 장씩 넘긴다.
	--   보상은 '기본 사냥 보상 + 사냥+ 보상'을 모두 적용한다(둘 다 RollEvent에서 직접 적용).
	-- HuntTile을 상속하므로 기본 사냥 롤(RollHuntEvent)/SplitPipe/StatDisplayName/FallbackEvent를 재사용한다.
	-- 흐름은 EventTileBase와 동일: 도착 → RollEvent → 보상 적용 → 도착 플레이어 클라에 팝업 → '다음'으로 종료.
	-- '마을 사냥터' 이름은 HuntTile과 동일하게 현재 타일 지역(마을)의 한글명 + " 사냥터"로 합성한다.
	--
	-- 이벤트 값(지역/가중치/이미지/스탯/문구)은 스크립트 밖 데이터셋
	--   'HuntPlusEvent'(HuntPlusEvent.userdataset + .csv)에서 관리한다. 도착 타일의 (Stage,Region)과
	--   일치하는 행 중 Weight 가중치로 하나를 뽑는다. 일치 행이 없으면 FallbackPlusEvent로 대체.
	--   CSV 컬럼: Stage / Region / Weight / ImageKind / NpcKey / StatKind / StatMode / StatGain / Text
	--     · Stage/Region: 이 이벤트가 붙는 타일의 단계/지역(HuntEvent와 동일 키)
	--     · Weight      : (Stage,Region) 내 가중치(같은 지역에 여러 개면 가중 추첨)
	--     · ImageKind   : "monster"(엘리트 몬스터 조우) / "npc"(NPC 조우) — 초상화 애니 결정용
	--     · NpcKey      : 페이지2 이미지로 띄울 대상의 NpcInfo 이름 키(몬스터/NPC 공용, NpcInfo에서 RUID 조회)
	--     · StatKind    : 보상 종류 — "main"(주스탯) / "attack"(공/마) 등 (EventTileBase.ApplyReward 키와 동일)
	--     · StatMode    : "flat"(고정) / "percent"(%)
	--     · StatGain    : 증가량(문구에 표시한 값과 동일)
	--     · Text        : 사냥+ 씬 문구(줄바꿈은 '\n' 리터럴, 페이지2에 표시)

	method table RollEvent(Entity piece)
		-- 사냥+ 타일: 기본 사냥 결과를 먼저 굴리고, 이어서 사냥+ 고유 이벤트(몬스터/NPC)를 이어붙인다.
		local huntEv = self:RollHuntEvent(piece)   -- 1) 기본 사냥(HuntTile 로직 상속)
		local plusEv = self:RollPlusEvent(piece)   -- 2) 사냥+ 고유 이벤트(지역별 몬스터/NPC)

		-- 폴백: 사냥+ 데이터셋이 없으면 기본 사냥 결과만 표시(OnArrive가 사냥 보상 적용).
		if plusEv == nil then
			log_warning("[HuntPlusTile] 사냥+ 이벤트 nil — 기본 사냥만 표시")
			return huntEv
		end
		-- (희박) 기본 사냥이 nil이면 사냥+ 이벤트만 표시.
		if huntEv == nil then
			return plusEv
		end

		-- 두 보상('기본 사냥' + '사냥+')을 이 자리에서 모두 적용하고,
		-- 반환 table의 statKind는 비워 OnArrive의 ApplyReward가 중복 적용하지 않도록 한다.
		self:ApplyReward(piece, huntEv)
		self:ApplyReward(piece, plusEv)

		-- 문구 결합: [기본 사냥 씬(1장)] → '\n\n'(페이지 경계) → [사냥+ 씬(1장)].
		-- 이미지: 페이지1(기본 사냥)은 사냥 몬스터 이미지, 페이지2(사냥+ 씬)부터 사냥+ 이미지로 전환(npcFromPage=2).
		--   → EventTileUI가 '다음'으로 페이지2에 도달하는 순간 몬스터→사냥+ 이미지(엘리트 몬스터/NPC)로 교체한다.
		-- (기본 사냥 문구는 항상 1페이지 = '\n' 한 줄뿐이라 사냥+ 씬은 반드시 페이지2에서 시작한다.)
		return {
			eventType   = plusEv.eventType,
			message     = huntEv.message .. "\n\n" .. plusEv.message,
			statKind    = "",                          -- 보상은 위에서 이미 적용(중복 방지)
			statMode    = "flat",
			statValue   = 0,
			monsterRUID = huntEv.monsterRUID or "",     -- 페이지1: 기본 사냥 몬스터 이미지
			imageKind   = "monster",                    -- 시작 이미지 = 몬스터
			npcKey      = plusEv.npcKey or "",          -- 페이지2+: 사냥+ 이미지(엘리트 몬스터/NPC) — NpcInfo 조회 키
			npcFromPage = 2,                            -- 2번째 페이지부터 사냥+ 이미지로 전환
			anim        = plusEv.anim or "idle",
		}
	end

	method table RollPlusEvent(Entity piece)
		-- 서버에서 HuntPlusEvent(지역별) 데이터셋을 읽어 도착 타일의 (Stage,Region) 일치 행 중
		-- Weight 가중치로 하나를 골라, 커스텀 문구/보상/페이지2 이미지를 담은 table을 반환한다.
		-- (Stage,Region) 일치 행이 없으면 FallbackPlusEvent(범용 엘리트 몬스터)로 대체한다.
		local map = self.Entity.CurrentMapName
		local tile = self.Entity.Name
		local region = _TileManager:GetTileRegion(map, tile)
		local stage = _TileManager:GetTileStage(map, tile)
		local huntingGround = _TileManager:RegionDisplayName(region) .. " 사냥터"

		local ds = _DataService:GetTable("HuntPlusEvent")
		if isvalid(ds) == false then
			log_warning("[HuntPlusTile] HuntPlusEvent 데이터셋 없음 → 폴백")
			return self:FallbackPlusEvent(huntingGround)
		end
		local rows = ds:GetRowCount()
		local function match(i)
			return (tonumber(ds:GetCell(i, "Stage")) or 0) == stage
				and ds:GetCell(i, "Region") == region
		end

		-- (Stage,Region) 일치 행 가중 추첨.
		local total = 0
		for i = 1, rows do
			if match(i) then total += (tonumber(ds:GetCell(i, "Weight")) or 0) end
		end
		if total <= 0 then
			return self:FallbackPlusEvent(huntingGround)
		end
		local roll = _UtilLogic:RandomIntegerRange(1, total)
		local acc = 0
		local pick = 0
		for i = 1, rows do
			if match(i) then
				acc += (tonumber(ds:GetCell(i, "Weight")) or 0)
				if roll <= acc then
					pick = i
					break
				end
			end
		end
		if pick == 0 then return self:FallbackPlusEvent(huntingGround) end

		-- 선택된 행의 값 읽기.
		local imageKind = ds:GetCell(pick, "ImageKind")
		local npcKey    = ds:GetCell(pick, "NpcKey")
		local statKind  = ds:GetCell(pick, "StatKind")
		local statMode  = ds:GetCell(pick, "StatMode")
		local statGain  = tonumber(ds:GetCell(pick, "StatGain")) or 0
		local text      = self:DecodeText(ds:GetCell(pick, "Text"))
		if statMode == "" then statMode = "flat" end
		-- 초상화 애니: 몬스터 조우=attack / NPC 조우=idle.
		local anim = "idle"
		if imageKind == "monster" then anim = "attack" end

		return {
			eventType  = "HuntPlus",
			message    = text,
			statKind   = statKind,       -- "main"/"attack" 등
			statMode   = statMode,       -- "flat"/"percent"
			statValue  = statGain,
			npcKey     = npcKey,         -- 페이지2 이미지 = NpcInfo에서 조회할 이름 키(몬스터/NPC 공용)
			anim       = anim,
		}
	end

	method table FallbackPlusEvent(string huntingGround)
		-- HuntPlusEvent에 (Stage,Region) 행이 없을 때(예: 스테이지3, 데이터 미입력)의 범용 사냥+ 이벤트.
		-- 강력한 몬스터 조우 → 처치 → 공격력/마력 +10(이미지 없음).
		return {
			eventType     = "HuntPlus",
			message       = huntingGround .. "에서 어두운 기운과 함께 강력한 몬스터가 출현했다!\n강력한 몬스터를 처치하여 공격력/마력이 10만큼 올랐다.",
			statKind   = "attack",
			statMode   = "flat",
			statValue  = 10,
			npcKey     = "",
			anim       = "attack",
		}
	end

	method string DecodeText(string raw)
		-- CSV에 '\n' 리터럴로 저장한 줄바꿈을 실제 개행으로 복원한다(셀 양끝 따옴표 1쌍도 제거).
		if raw == nil then return "" end
		local s = raw
		if #s >= 2 and string.sub(s, 1, 1) == "\"" and string.sub(s, #s, #s) == "\"" then
			s = string.sub(s, 2, #s - 1)
		end
		local out, _cnt = string.gsub(s, "\\n", "\n")
		return out
	end

	@ExecSpace("Server")
	method void RequestDone()
		-- '다음' 클릭 시 이벤트 종료 RPC. (베이스 상속 RPC가 서브클래스에서 라우팅 안 되므로 리프에 재정의)
		local piece = self._eventPiece
		if isvalid(piece) and senderUserId ~= self:OwnerUserId(piece) then return end
		self:FinishEventTile()
	end

end
