@Component
script BaseTile extends Component

	@Sync
	property string tileType = ""

	@ExecSpace("ServerOnly")
	method void OnBeginPlay()
		-- 자신을 TileManager에 이름으로 등록한다.
		-- (서브클래스는 OnBeginPlay를 따로 정의하지 않으면 이 base 등록을 그대로 상속한다.)
		_TileManager:RegisterTile(self.Entity.Name, self)
	end

	@ExecSpace("ServerOnly")
	method void OnArrive(Entity piece)
		-- 기본 동작 없음 (서브클래스에서 구현). override 안 됐을 때만 찍힘.
		log("[BaseTile] OnArrive (미구현 base) tile=" .. self.Entity.Name)
	end

	method any CP(Entity piece)
		return piece:GetComponent("script.CombatPowerManager")
	end

	method any Buff(Entity piece)
		return piece:GetComponent("script.BuffManager")
	end

	method any EquipManagerFor(Entity piece, string equipName)
		-- equipName 타입의 장비 컴포넌트를 반환한다.
		return _EquipmentRouter:ManagerForItem(piece, equipName)
	end

	@ExecSpace("ServerOnly")
	method void AddMainStat(Entity piece, string kind, number value)
		-- 주스탯 동적 증감. 직업 주스탯 1개에만 적용.
		local buff = self:Buff(piece)
		if isvalid(buff) == false then return end
		if kind == "percent" then
			buff:AddRawModifier({ statPct = value })
		else
			buff:AddRawModifier({ statFlat = value })
		end
	end

	@ExecSpace("ServerOnly")
	method void AddAllStat(Entity piece, string kind, number value)
		-- 올스탯 동적 증감. STR/DEX/INT/LUK 4스탯 모두에 적용(부스탯은 메이플식 가중).
		local buff = self:Buff(piece)
		if isvalid(buff) == false then return end
		if kind == "percent" then
			buff:AddRawModifier({ allStatPct = value })
		else
			buff:AddRawModifier({ allStatFlat = value })
		end
	end

	@ExecSpace("ServerOnly")
	method void AddMainAttack(Entity piece, string kind, number value)
		-- 공격력/마력 동적 증감.
		local buff = self:Buff(piece)
		if isvalid(buff) == false then return end
		if kind == "percent" then
			buff:AddRawModifier({ attackPct = value })
		else
			buff:AddRawModifier({ attackFlat = value })
		end
	end

	@ExecSpace("ServerOnly")
	method void AddDamage(Entity piece, number value)
		-- 추가 대미지% 동적 증감.
		local buff = self:Buff(piece)
		if isvalid(buff) == false then return end
		buff:AddRawModifier({ damagePct = value })
	end

	@ExecSpace("ServerOnly")
	method void AddCritical(Entity piece, number value)
		-- 크리티컬 대미지% 동적 증감.
		local buff = self:Buff(piece)
		if isvalid(buff) == false then return end
		buff:AddRawModifier({ critPct = value })
	end

	method string RollOutcome(string tableName)
		-- Weight 합으로 1~합 정수를 굴려 누적 가중치 구간에 해당하는 Outcome을 반환한다.
		local ds = _DataService:GetTable(tableName)
		if isvalid(ds) == false then
			log_error("[BaseTile] 확률 테이블 없음: " .. tableName)
			return ""
		end
		local rows = ds:GetRowCount()
		local total = 0
		for i = 1, rows do
			total += (tonumber(ds:GetCell(i, "Weight")) or 0)
		end
		if total <= 0 then
			log_warning("[BaseTile] 확률 테이블 가중치 합 0: " .. tableName)
			return ""
		end
		local roll = _UtilLogic:RandomIntegerRange(1, total)
		local acc = 0
		for i = 1, rows do
			acc += (tonumber(ds:GetCell(i, "Weight")) or 0)
			if roll <= acc then
				return ds:GetCell(i, "Outcome")
			end
		end
		return ds:GetCell(rows, "Outcome")
	end

	@ExecSpace("ServerOnly")
	method void AddItems(Entity piece, string category, string source, string rarity)
		-- 타일 제작 부원용: (category, source, rarity) 드롭 풀에서 확률로 1개를 뽑아
		-- 해당 타입 인벤토리에 보유시킨다. 전투력이 현재 장착보다 높으면 빠른장착 팝업.
		local picked = self:RollItem(category, source, rarity)
		if picked == "" then return end
		_EquipmentRouter:Acquire(piece, picked)
		local cp = self:CP(piece)
		if isvalid(cp) then
			local delta = cp:PreviewPowerWithSwap(picked) - cp.CombatPower
			if delta > 0 then
				_QuickEquipPopup:Show(picked, piece.PlayerComponent.UserId)
			end
		end
	end

	method string RollItem(string category, string source, string rarity)
		-- ItemDropTable에서 (Category,Source,Rarity) 일치 행을 Weight 가중 롤로 1개 뽑는다.
		local ds = _DataService:GetTable("ItemDropTable")
		if isvalid(ds) == false then
			log_error("[BaseTile] ItemDropTable 없음")
			return ""
		end
		local rows = ds:GetRowCount()
		local function match(i)
			return ds:GetCell(i, "Category") == category
				and ds:GetCell(i, "Source") == source
				and ds:GetCell(i, "Rarity") == rarity
		end
		local total = 0
		for i = 1, rows do
			if match(i) then total += (tonumber(ds:GetCell(i, "Weight")) or 0) end
		end
		if total <= 0 then
			log_warning("[BaseTile] 드롭 풀 비어있음: " .. category .. "/" .. source .. "/" .. rarity)
			return ""
		end
		local roll = _UtilLogic:RandomIntegerRange(1, total)
		local acc = 0
		for i = 1, rows do
			if match(i) then
				acc += (tonumber(ds:GetCell(i, "Weight")) or 0)
				if roll <= acc then return ds:GetCell(i, "EquipName") end
			end
		end
		return ""
	end

end
