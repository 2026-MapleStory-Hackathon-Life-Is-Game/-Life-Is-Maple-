@Component
script BaseTile extends Component

	@Sync
	property string tileType = ""

	@ExecSpace("ServerOnly")
	method void OnBeginPlay()
		-- 자신을 TileManager에 이름으로 등록한다.
		-- (서브클래스는 OnBeginPlay를 따로 정의하지 않으면 이 base 등록을 그대로 상속한다.)
		_TileManager:RegisterTile(self.Entity.Name, self)
	end

	@ExecSpace("ServerOnly")
	method void OnArrive(Entity piece)
		-- 기본 동작 없음 (서브클래스에서 구현). override 안 됐을 때만 찍힘.
		log("[BaseTile] OnArrive (미구현 base) tile=" .. self.Entity.Name)
	end

	method boolean IsEventTile()
		-- 이벤트 팝업 UI(EventTileGroup)를 띄우는 타일인지 여부. 기본 false.
		-- EventTileBase 계열에서 true로 재정의 → 턴 매니저가 UI 표시 시간만큼 기다린 뒤 다음 단계로 진행한다.
		return false
	end

	method boolean IsInteractiveTile()
		-- 버튼 입력 등으로 완료가 '이벤트 구동'되는 인터랙티브 타일인지. 기본 false.
		-- true면 턴 매니저가 5초 고정 대기 대신 타일의 완료 신호(_GameModeManager:NotifyTileEventDone)를 기다린다.
		return false
	end

	method any CP(Entity piece)
		return piece:GetComponent("script.CombatPowerManager")
	end

	method any Buff(Entity piece)
		return piece:GetComponent("script.BuffManager")
	end

	method any EquipManagerFor(Entity piece, string equipName)
		-- equipName 타입의 장비 컴포넌트를 반환한다.
		return _EquipmentRouter:ManagerForItem(piece, equipName)
	end

	@ExecSpace("ServerOnly")
	method void AddMainStat(Entity piece, string kind, number value)
		-- 주스탯 동적 증감. 직업 주스탯 1개에만 적용.
		local buff = self:Buff(piece)
		if isvalid(buff) == false then return end
		if kind == "percent" then
			buff:AddRawModifier({ statPct = value })
		else
			buff:AddRawModifier({ statFlat = value })
		end
	end

	@ExecSpace("ServerOnly")
	method void AddAllStat(Entity piece, string kind, number value)
		-- 올스탯 동적 증감. STR/DEX/INT/LUK 4스탯 모두에 적용(부스탯은 메이플식 가중).
		local buff = self:Buff(piece)
		if isvalid(buff) == false then return end
		if kind == "percent" then
			buff:AddRawModifier({ allStatPct = value })
		else
			buff:AddRawModifier({ allStatFlat = value })
		end
	end

	@ExecSpace("ServerOnly")
	method void AddMainAttack(Entity piece, string kind, number value)
		-- 공격력/마력 동적 증감.
		local buff = self:Buff(piece)
		if isvalid(buff) == false then return end
		if kind == "percent" then
			buff:AddRawModifier({ attackPct = value })
		else
			buff:AddRawModifier({ attackFlat = value })
		end
	end

	@ExecSpace("ServerOnly")
	method void AddDamage(Entity piece, number value)
		-- 추가 대미지% 동적 증감.
		local buff = self:Buff(piece)
		if isvalid(buff) == false then return end
		buff:AddRawModifier({ damagePct = value })
	end

	@ExecSpace("ServerOnly")
	method void AddCritical(Entity piece, number value)
		-- 크리티컬 대미지% 동적 증감.
		local buff = self:Buff(piece)
		if isvalid(buff) == false then return end
		buff:AddRawModifier({ critPct = value })
	end

	@ExecSpace("ServerOnly")
	method void AddBossDamage(Entity piece, number value)
		-- 보스 공격력(보스 대미지%) 동적 증감. (BuffManager.bossDamagePct 누적)
		local buff = self:Buff(piece)
		if isvalid(buff) == false then return end
		buff:AddRawModifier({ bossDamagePct = value })
	end

	@ExecSpace("ServerOnly")
	method void AddSpecificStat(Entity piece, string statName, number value)
		-- 지정 스탯(str/dex/int/luk) 보상 → CombatPowerManager의 해당 스탯 필드에 직접 가산.
		-- (모든 이벤트 타일이 공유하도록 BaseTile에 둔다. statName은 소문자로 넘겨도 내부에서 대문자화.)
		local cp = self:CP(piece)
		if isvalid(cp) == false then return end
		cp:AddSpecificStat(string.upper(statName), value)
	end

	method string RollOutcome(string tableName)
		-- Weight 합으로 1~합 정수를 굴려 누적 가중치 구간에 해당하는 Outcome을 반환한다.
		local ds = _DataService:GetTable(tableName)
		if isvalid(ds) == false then
			log_error("[BaseTile] 확률 테이블 없음: " .. tableName)
			return ""
		end
		local rows = ds:GetRowCount()
		local total = 0
		for i = 1, rows do
			total += (tonumber(ds:GetCell(i, "Weight")) or 0)
		end
		if total <= 0 then
			log_warning("[BaseTile] 확률 테이블 가중치 합 0: " .. tableName)
			return ""
		end
		local roll = _UtilLogic:RandomIntegerRange(1, total)
		local acc = 0
		for i = 1, rows do
			acc += (tonumber(ds:GetCell(i, "Weight")) or 0)
			if roll <= acc then
				return ds:GetCell(i, "Outcome")
			end
		end
		return ds:GetCell(rows, "Outcome")
	end

	@ExecSpace("ServerOnly")
	method void GrantItem(Entity piece, string equipName)
		-- 특정 장비(EquipName)를 도착 플레이어에게 지급(보유). 전투력이 오르면 빠른장착 팝업.
		-- (마을 이벤트·보스 드랍 보상처럼 '정해진 아이템(EquipName)'을 바로 줄 때 쓴다.)
		if equipName == nil or equipName == "" then return end
		if isvalid(piece) == false then return end
		local id = _EquipmentRouter:Acquire(piece, equipName)
		local cp = self:CP(piece)
		if isvalid(cp) and isvalid(piece.PlayerComponent) and id ~= "" then
			-- 새로 얻은 인스턴스는 잠재가 없으므로 미리보기 잠재는 ""(기본 CSV 기준).
			local delta = cp:PreviewPowerWithSwap(equipName, "") - cp.CombatPower
			if delta > 0 then
				_QuickEquipPopup:Show(id, piece.PlayerComponent.UserId)
			end
		end
		log("[BaseTile] 아이템 지급 → " .. equipName)
	end

	@ExecSpace("ServerOnly")
	method void GrantClassWeapon(Entity piece, string family)
		-- 도착 플레이어의 '직업 클래스'에 맞는 무기(family = "Fafnir"/"Challenger" 등)를 지급한다.
		-- 클래스는 현재 장착 무기(WeaponEquipment.Equipped)의 EquipmentData.Class로 판별한다(per-piece).
		local cls = self:ClassOfPiece(piece)
		if cls == "" or cls == "Common" then
			-- 폴백: 무기 미착용/공용 무기 상태면 전역 현재 직업으로 보정.
			cls = _JobWeaponManager.currentJob
		end
		local equipName = self:ClassWeaponFor(family, cls)
		if equipName == "" then
			log_warning("[BaseTile] 직업 무기 없음 family=" .. tostring(family) .. " class=" .. tostring(cls))
			return
		end
		self:GrantItem(piece, equipName)
	end

	@ExecSpace("ServerOnly")
	method void GrantCube(Entity piece, integer count)
		-- 도착 플레이어에게 미라클 큐브 count개를 지급한다(마을 이벤트 보상 "cube:N").
		if count == nil or count <= 0 then return end
		if isvalid(piece) == false then return end
		local bag = piece:GetComponent("script.CubeInventory")
		if isvalid(bag) then
			bag:AddMiracleCube(count)
			log("[BaseTile] 미라클 큐브 지급 → " .. tostring(count))
		else
			log_warning("[BaseTile] CubeInventory 없음 → 큐브 지급 스킵")
		end
	end

	method string ClassOfPiece(Entity piece)
		-- 도착 플레이어의 직업 클래스(Warrior/Mage/Archer/Thief/Pirate)를 현재 장착 무기로 판별. 없으면 "".
		if isvalid(piece) == false then return "" end
		---@type WeaponEquipment
		local we = piece:GetComponent("script.WeaponEquipment")
		if isvalid(we) == false then return "" end
		local equipped = we.Equipped
		if equipped == nil or equipped == "" then return "" end
		local ds = _DataService:GetTable("EquipmentData")
		if isvalid(ds) == false then return "" end
		for i = 1, ds:GetRowCount() do
			if ds:GetCell(i, "EquipName") == equipped then
				return ds:GetCell(i, "Class")
			end
		end
		return ""
	end

	method string ClassWeaponFor(string family, string class)
		-- EquipmentData에서 (Category=Weapon, Class 일치, EquipName이 family로 시작) 무기 1개의 EquipName.
		-- 예: family="Fafnir", class="Archer" → "Fafnir_Wind_Chaser". 없으면 "".
		if family == nil or family == "" or class == nil or class == "" then return "" end
		local ds = _DataService:GetTable("EquipmentData")
		if isvalid(ds) == false then return "" end
		for i = 1, ds:GetRowCount() do
			if ds:GetCell(i, "Category") == "Weapon" and ds:GetCell(i, "Class") == class then
				local en = ds:GetCell(i, "EquipName")
				if #en >= #family and string.sub(en, 1, #family) == family then return en end
			end
		end
		return ""
	end

end