@Logic
script TileManager extends Logic

	@DisplayName("tileGraph")
	@Description("타일들이 어떻게 연결돼있는지를 나타내는 리스트입니다.")
	property table tileGraph = {}

	@DisplayName("tileEntities")
	@Description("실제 타일들의 엔티티입니다.")
	property table tileEntities = {}

	property table tileComponents = {}

	property table variant = {}

	property integer _collectRetries = 0

	property integer _visualRetries = 0

	-- 사냥 타일 몬스터: 서버가 맵 시작 시 (Region,Tier) 가중 롤로 1회 결정 → 클라가 동기화 받아 타일 위 스프라이트 적용.
	@Sync
	property SyncTable<string, string> TileMonster

	property integer _monsterRetries = 0

	method void CollectTiles()
		self.tileEntities = {}
				local entities = _EntityService:GetEntitiesByTag("HexaTile")
				local count = 0
				for _, entity in pairs(entities) do
					local key = entity.CurrentMapName .. "_" .. entity.Name
					self.tileEntities[key] = entity
					count += 1
				end
				log("[TileManager] 타일 수집: " .. tostring(count) .. "개")
				
				if self:IsServer() then
					self:BuildVariants()
					
					for key, entity in pairs(self.tileEntities) do
						if self.variant[key] == nil then
							-- 이중 구조가 아닌 key(Map_Tile) 검색용 예외 처리
							local mapName = entity.CurrentMapName
							local tileName = entity.Name
							local data = self.tileGraph[mapName .. "_" .. tileName]
		
							if data ~= nil then
								local compName = self:TypeToComponent(data.type)
								if compName ~= "" and self.tileComponents[key] == nil then
									entity:AddComponent(compName)
									self.tileComponents[key] = entity:GetComponent("script." .. compName)
								end
							end
						end
					end
				end
	end

	method boolean IsVariantTile(string tileName)
		return self.variant[tileName] ~= nil
	end

	@ExecSpace("ServerOnly")
	method void BuildVariants()
		local ds = _DataService:GetTable("TileVariant")
				if not isvalid(ds) then return end
				for i = 1, ds:GetRowCount() do
					local tileName = ds:GetCell(i, "TileName")
					local camp     = ds:GetCell(i, "Camp")
					local typ      = ds:GetCell(i, "Type")
					
					for key, entity in pairs(self.tileEntities) do
						if entity.Name == tileName and typ ~= "" and camp ~= "" then
							local compName = self:TypeToComponent(typ)
							if compName ~= "" then
								local comp = entity:GetComponent("script." .. compName)
								if comp == nil then
									entity:AddComponent(compName)
									comp = entity:GetComponent("script." .. compName)
								end
								if self.variant[key] == nil then self.variant[key] = {} end
								self.variant[key][camp] = comp
							end
						end
					end
				end
	end

	method void EnsureTilesCollected()
		if self:IsServer() then
					self:CollectTiles()
				else
					_TimerService:SetTimerOnce(function()
						log("[TileManager] 클라이언트 타일 수집 지연 실행")
						if next(self.tileGraph) == nil then
							self:BuildTileGraph()
						end
						self:CollectTiles()
						-- 수집 완료 후 '현재 맵' 기준으로 진영/몬스터 비주얼을 재적용한다.
						-- (맵 전환 시 ApplyPhysicsForMap의 즉시 호출은 이 지연 수집보다 빨라서
						--  이전 맵 타일에 적용하고 끝나버려 새 맵 사냥타일이 빈 채로 남는 버그가 있었음.)
						self:RequestCampVisuals()
					end, 0.5)
				end
	end

	method integer CountTiles()
		local c = 0
				for _, e in pairs(self.tileEntities) do c += 1 end
				return c
	end

	method string TypeToComponent(string tileType)
		if tileType == "Start" then return "StartTile"
				elseif tileType == "Hunt" then return "HuntTile"
				elseif tileType == "HuntPlus" then return "HuntPlusTile"
				elseif tileType == "Unlucky" then return "UnluckyTile"
				elseif tileType == "Boss" then return "BossTile"
				elseif tileType == "Village" then return "VillageTile"
				elseif tileType == "Guild" then return "GuildTile"
				elseif tileType == "Union" then return "RomanceTile"
				elseif tileType == "End" then return "EndTile"
				end
				return ""
	end

	method table GetNextTiles(string mapName, string tileName)
		local key = mapName .. "_" .. tileName
		    if self.tileGraph[key] then 
		        return self.tileGraph[key].nexts 
		    end
		    return {}
	end

	method Entity GetTileEntity(string mapName, string tileName)
		return self.tileEntities[mapName .. "_" .. tileName]
	end

	method string GetTileBranch(string mapName, string tileName)
		local key = mapName .. "_" .. tileName
		    if self.tileGraph[key] then
		        return self.tileGraph[key].branch or ""
		    end
		    return ""
	end

	method string RegionDisplayName(string region)
		-- Region(영문 데이터값) → 분기 버튼/안내용 한글 마을 이름. 미등록이면 원문 그대로.
		if region == "Henesys" then return "헤네시스" end
		if region == "Perion" then return "페리온" end
		if region == "Orbis" then return "오르비스" end
		if region == "Sahel_Desert" then return "사헬 사막" end
		if region == "Magatia" then return "마가티아" end
		if region == "Ludibrium" then return "루디브리엄" end
		if region == "Leafre" then return "리프레" end
		if region == "Lion_Kings_Castle" then return "사자왕성" end
		if region == "Rootabyss" then return "루타비스" end
		if region == "Temple_of_Time" then return "시간의 신전" end
		if region == "Ruined_Henesys" then return "폐허가 된 헤네시스" end
		if region == "Vanishing_Journey" then return "베니싱 저니" end
		if region == "Reverse_City" then return "리버스 시티" end
		if region == "ChuChu_Island" then return "츄츄 아일랜드" end
		if region == "YumYum_Island" then return "얌얌 아일랜드" end
		if region == "Lachelein" then return "라헬른" end
		if region == "Arcana" then return "아르카나" end
		if region == "Morass" then return "모라스" end
		if region == "Esfera" then return "에스페라" end
		if region == "Sellas" then return "셀라스" end
		if region == "Moonbridge" then return "문브릿지" end
		if region == "Labyrinth_Of_Suffering" then return "고통의 미궁" end
		if region == "Limina" then return "리미나" end
		return region
	end

	method string GetTileRegion(string mapName, string tileName)
		-- 해당 타일의 Region(영문 데이터값) 반환(없으면 "").
		local data = self.tileGraph[mapName .. "_" .. tileName]
		if data ~= nil and data.region ~= nil then return data.region end
		return ""
	end

	method integer GetTileStage(string mapName, string tileName)
		-- 해당 타일의 Stage(맵 단계, 1/2/3) 반환(없으면 0).
		local data = self.tileGraph[mapName .. "_" .. tileName]
		if data ~= nil and data.stage ~= nil then return data.stage end
		return 0
	end

	method string GetTileBranchText(string mapName, string tileName)
		-- 해당 타일의 BranchText(기획자 지정 분기 문자열) 반환(없으면 "").
		local data = self.tileGraph[mapName .. "_" .. tileName]
		if data ~= nil and data.branchText ~= nil then return data.branchText end
		return ""
	end

	method table GetBranchLabels(string mapName, table tileNames)
		-- 분기 선택지 라벨 묶음.
		--   선택지들의 도착 Region이 서로 다르면 → '다른 마을'로 갈 수 있는 분기 → 각 선택지의 한글 마을 이름.
		--   선택지들의 도착 Region이 모두 같으면 → 마을 변화 없음 → 기획자 지정 BranchText(없으면 "N번 분기점").
		local regions = {}
		local allSame = true
		local first = nil
		for i = 1, #tileNames do
			local r = self:GetTileRegion(mapName, tileNames[i])
			regions[i] = r
			if first == nil then
				first = r
			elseif r ~= first then
				allSame = false
			end
		end

		local labels = {}
		for i = 1, #tileNames do
			if allSame then
				local bt = self:GetTileBranchText(mapName, tileNames[i])
				if bt == nil or bt == "" then bt = tostring(i) .. "번 분기점" end
				labels[i] = bt
			else
				labels[i] = self:RegionDisplayName(regions[i])
			end
		end
		return labels
	end

	@ExecSpace("ServerOnly")
	method void RegisterTile(string tileName, BaseTile tile)
		self.tileComponents[tileName] = tile
	end

	method BaseTile GetTileComponent(string tileName)
		return self.tileComponents[tileName]
	end

	@ExecSpace("ServerOnly")
	method any LifePathComp(string key, Entity piece, any defaultComp)
		-- 인생 분기(Stage3): 'Guild' 타입 타일을 도착 플레이어의 LifePath에 따라 교체한다.
		--   Guild/미선택 → 기존 GuildTile(defaultComp) / Romance → 이 엔티티의 RomanceTile을 보장해 반환.
		-- (Guild 타입이 아니면 그대로 defaultComp. Stage1~2엔 Guild 타일이 없어 영향 없음.)
		local data = self.tileGraph[key]
		if data == nil or data.type ~= "Guild" then return defaultComp end
		local lp = piece:GetComponent("script.LifePathManager")
		local path = ""
		if isvalid(lp) then path = lp.LifePath end
		if path ~= "Romance" then return defaultComp end
		local entity = self.tileEntities[key]
		if isvalid(entity) == false then return defaultComp end
		local rt = entity:GetComponent("script.RomanceTile")
		if isvalid(rt) == false then
			entity:AddComponent("RomanceTile")
			rt = entity:GetComponent("script.RomanceTile")
		end
		if isvalid(rt) == false then return defaultComp end
		return rt
	end

	@ExecSpace("ServerOnly")
	method boolean TriggerArrive(string mapName, string tileName, Entity piece)
		-- 도착 타일 효과를 실행하고 '이벤트 UI를 띄우는 타일이었는지'를 반환한다.
		-- 반환 true면 호출측(턴 매니저)이 UI 표시 시간만큼 대기한 뒤 다음 단계로 진행한다.
		local key = mapName .. "_" .. tileName

		-- [테스트] 강제 이벤트 오버라이드(_TileEventTester.ForceEvent). None이면 nil → 정상 동작.
		local ov = _TileEventTester:OverrideFor(self.tileEntities[key])
		if isvalid(ov) then
			self:ApplyTileLevel(key, piece)
			ov:OnArrive(piece)
			return ov:IsEventTile()
		end

		-- 레벨: 도착 타일의 (Stage,Tier)로 단조 증가 설정. 타일 효과(OnArrive)보다 먼저 → 효과가 갱신된 레벨 참조 가능.
		self:ApplyTileLevel(key, piece)

		-- 도착 타일 컴포넌트 해석(진영 변형 타일이면 진영별 컴포넌트).
		---@type BaseTile
		local comp = nil
		if self:IsVariantTile(key) then
			local campKey = ""
			local buff = piece:GetComponent("script.BuffManager")
			if isvalid(buff) then campKey = buff.CampName end
			comp = self.variant[key][campKey]
		else
			comp = self.tileComponents[key]
		end

		-- 인생 분기: Stage3 'Guild' 타일은 플레이어 LifePath로 GuildTile↔RomanceTile 교체.
		comp = self:LifePathComp(key, piece, comp)
		if comp == nil then return false end
		comp:OnArrive(piece)
		return comp:IsEventTile()
	end

	@ExecSpace("ServerOnly")
	method boolean IsEventArrive(string mapName, string tileName, Entity piece)
		-- 도착 타일이 이벤트(사냥 등) UI를 띄우는 타일인지 판정한다(부수효과 없음).
		-- 변형(진영) 타일은 piece의 진영별 컴포넌트로 판정한다.
		local key = mapName .. "_" .. tileName
		local ovE = _TileEventTester:OverrideFor(self.tileEntities[key])   -- [테스트] 강제 이벤트
		if isvalid(ovE) then return ovE:IsEventTile() end
		---@type BaseTile
		local comp = nil
		if self:IsVariantTile(key) then
			local campKey = ""
			local buff = piece:GetComponent("script.BuffManager")
			if isvalid(buff) then campKey = buff.CampName end
			comp = self.variant[key][campKey]
		else
			comp = self.tileComponents[key]
		end
		comp = self:LifePathComp(key, piece, comp)
		if comp == nil then return false end
		return comp:IsEventTile()
	end

	@ExecSpace("ServerOnly")
	method boolean IsInteractiveArrive(string mapName, string tileName, Entity piece)
		-- 도착 타일이 인터랙티브(완료를 직접 신호하는) 타일인지 판정(부수효과 없음).
		-- 변형(진영) 타일은 piece의 진영별 컴포넌트로 판정한다.
		local key = mapName .. "_" .. tileName
		local ovI = _TileEventTester:OverrideFor(self.tileEntities[key])   -- [테스트] 강제 이벤트
		if isvalid(ovI) then return ovI:IsInteractiveTile() end
		---@type BaseTile
		local comp = nil
		if self:IsVariantTile(key) then
			local campKey = ""
			local buff = piece:GetComponent("script.BuffManager")
			if isvalid(buff) then campKey = buff.CampName end
			comp = self.variant[key][campKey]
		else
			comp = self.tileComponents[key]
		end
		comp = self:LifePathComp(key, piece, comp)
		if comp == nil then return false end
		return comp:IsInteractiveTile()
	end

	@ExecSpace("ServerOnly")
	method void ApplyTileLevel(string key, Entity piece)
		-- 도착 타일의 (Stage,Tier)에 맞는 레벨로 단조 증가 설정(낮아지지 않음).
		if isvalid(piece) == false then return end
		local data = self.tileGraph[key]
		if data == nil or data.stage == nil or data.tier == nil then return end
		local cp = piece:GetComponent("script.CombatPowerManager")
		if isvalid(cp) == false then return end
		local lv = self:LevelForStageTier(data.stage, data.tier)
		if lv > cp.Level then
			cp:SetLevel(lv)
			log("[TileManager] 레벨 적용: " .. key .. " (Stage=" .. tostring(data.stage) .. " Tier=" .. tostring(data.tier) .. ") → Lv." .. tostring(lv))
		end
	end

	method integer LevelForStageTier(integer stage, integer tier)
		-- (Stage,Tier)→Level. Stage 1은 Tier 무관 Lv.10. 미일치 시 10 폴백.
		if stage == 1 then return 10 end
		local ds = _DataService:GetTable("TierLevel")
		if isvalid(ds) == false then return 10 end
		for i = 1, ds:GetRowCount() do
			if tonumber(ds:GetCell(i, "Stage")) == stage and tonumber(ds:GetCell(i, "Tier")) == tier then
				return tonumber(ds:GetCell(i, "Level"))
			end
		end
		return 10
	end

	-- ===== 사냥 타일 몬스터 스폰 (서버 1회 롤 → @Sync → 클라 적용) =====

	@ExecSpace("ServerOnly")
	method void RollAllTileMonsters()
		-- 맵 시작 시 사냥 타일마다 (Region,Tier) 가중 롤로 몬스터 1종 결정 → 동기화 테이블에 저장.
		local count = 0
		for key, data in pairs(self.tileGraph) do
			if data.type == "Hunt" or data.type == "HuntPlus" then
				local mn = self:RollMonster(data.stage or 0, data.region or "", data.tier or 0, data.type)
				if mn ~= "" then
					self.TileMonster[key] = mn
					count += 1
				end
			end
		end
		log("[TileManager] 사냥 타일 몬스터 롤 완료: " .. tostring(count) .. "개")
	end

	method string RollMonster(integer stage, string region, integer tier, string tileType)
		-- MonsterSpawn에서 (Stage,Region,Tier,Type) 일치 행을 Weight 가중 롤로 1종 뽑는다.
		-- Stage로 맵별 풀을 분리(같은 지역이 여러 스테이지에 등장해도 스테이지별로 다른 몬스터).
		-- tileType은 "Hunt"/"HuntPlus" — Hunt와 HuntPlus가 서로 다른 몬스터 풀을 갖도록 분리.
		local ds = _DataService:GetTable("MonsterSpawn")
		if isvalid(ds) == false then return "" end
		local rows = ds:GetRowCount()
		local function match(i)
			return tonumber(ds:GetCell(i, "Stage")) == stage
				and ds:GetCell(i, "Region") == region
				and tonumber(ds:GetCell(i, "Tier")) == tier
				and ds:GetCell(i, "Type") == tileType
		end
		local total = 0
		for i = 1, rows do
			if match(i) then total += (tonumber(ds:GetCell(i, "Weight")) or 0) end
		end
		if total <= 0 then return "" end
		local roll = _UtilLogic:RandomIntegerRange(1, total)
		local acc = 0
		for i = 1, rows do
			if match(i) then
				acc += (tonumber(ds:GetCell(i, "Weight")) or 0)
				if roll <= acc then return ds:GetCell(i, "MonsterName") end
			end
		end
		return ""
	end

	@ExecSpace("ClientOnly")
	method void RequestTileMonsters()
		-- 맵 진입 시 클라가 호출. 타일 수집 + 서버 동기화 도착까지 재시도하며 적용.
		self._monsterRetries = 0
		self:TryApplyTileMonsters()
	end

	@ExecSpace("ClientOnly")
	method void TryApplyTileMonsters()
		if self:ApplyTileArtLocal() then return end
		self._monsterRetries += 1
		if self._monsterRetries <= 25 then
			_TimerService:SetTimerOnce(function() self:TryApplyTileMonsters() end, 0.2)
		end
	end

	@ExecSpace("ClientOnly")
	method boolean ApplyTileArtLocal()
		-- 각 타일의 'TileType_TileSprite' 자식(y+0.5)에 Type별 스프라이트 적용.
		--   Hunt/HuntPlus → 서버가 롤한 몬스터 STAND(@Sync TileMonster) — 동기화 도착 전이면 false 반환(재시도).
		--   그 외(Start/End/Village/Guild/Union/Unlucky) → TileArt.csv의 Type별 고정 스프라이트(이정표/제단/NPC, 로컬 조회).
		if self:CountTiles() == 0 then return false end
		local pendingHunt = false
		for key, entity in pairs(self.tileEntities) do
			if isvalid(entity) then
				local data = self.tileGraph[key]
				if data ~= nil then
					local ruid = ""
					if data.type == "Hunt" or data.type == "HuntPlus" then
						local mn = self.TileMonster[key]
						if mn ~= nil and mn ~= "" then
							ruid = self:MonsterStandRUID(mn)
						else
							-- 이 맵의 사냥타일 몬스터가 아직 @Sync 도착 전 → 재시도 필요.
							pendingHunt = true
						end
					else
						ruid = self:LifePathTileArt(data.type)
					end
					if ruid ~= "" then
						local child = self:FindChild(entity, "TileType_TileSprite")
						if isvalid(child) and isvalid(child.SpriteRendererComponent) then
							child.SpriteRendererComponent.SpriteRUID = ruid
							-- 정렬 강제: .map에 박제된 OrderInLayer=10은 플레이어(=3)보다 위라 몬스터가 앞을 가린다.
							-- 플레이어와 같은 SortingLayer("Default")에서 OrderInLayer=2로 낮춰 항상 플레이어 아래로.
							child.SpriteRendererComponent.SortingLayer = "Default"
							child.SpriteRendererComponent.OrderInLayer = 2
						end
					end
				end
			end
		end
		-- 완료 판정은 '현재 맵' 기준. 전역 next(self.TileMonster)는 이전 스테이지 키 때문에
		-- 맵 전환 직후에도 항상 non-nil이라, Map_02 몬스터가 동기화되기 전에 조기 완료로 판정돼
		-- 재시도 루프가 멈추고 사냥타일이 빈 채 남는 버그가 있었다. → 현재 맵의 사냥타일이
		-- 하나라도 몬스터 미동기화면 재시도(false), 전부 적용됐을 때만 완료(true).
		if pendingHunt then return false end
		return true
	end

	method string LocalLifePathArtType()
		-- 내(LocalPlayer) 인생 분기에 따라 'Guild' 타일의 표시 타입을 결정한다. Romance면 "Union", 아니면 "Guild".
		local me = _UserService.LocalPlayer
		if isvalid(me) == false then return "Guild" end
		local lp = me:GetComponent("script.LifePathManager")
		if isvalid(lp) and lp.LifePath == "Romance" then return "Union" end
		return "Guild"
	end

	method string LifePathTileArt(string tileType)
		-- 'Guild' 타일은 내 LifePath에 맞춰 Guild/Union 스프라이트로(per-player), 그 외는 타입 스프라이트 그대로.
		if tileType == "Guild" then
			return self:TileArtRUID(self:LocalLifePathArtType())
		end
		return self:TileArtRUID(tileType)
	end

	method string TileArtRUID(string tileType)
		-- TileTypeSprite에서 Type 일치 행의 SpriteRUID 반환(이정표/제단/NPC 등 고정 표현). 아트가 채우기 전엔 "".
		local ds = _DataService:GetTable("TileTypeSprite")
		if isvalid(ds) == false then return "" end
		for i = 1, ds:GetRowCount() do
			if ds:GetCell(i, "Type") == tileType then
				return ds:GetCell(i, "SpriteRUID")
			end
		end
		return ""
	end

	method Entity FindChild(Entity parent, string childName)
		-- parent의 직계 자식 중 이름 일치 엔티티 반환(없으면 nil).
		local children = parent.Children
		if children == nil then return nil end
		for i = 1, #children do
			if children[i].Name == childName then return children[i] end
		end
		return nil
	end

	method string MonsterStandRUID(string monsterName)
		-- TierMonster에서 MonsterName 일치 행의 STAND(애니클립 RUID) 반환. (아트가 채우기 전엔 "")
		local ds = _DataService:GetTable("TierMonster")
		if isvalid(ds) == false then return "" end
		for i = 1, ds:GetRowCount() do
			if ds:GetCell(i, "MonsterName") == monsterName then
				return ds:GetCell(i, "STAND")
			end
		end
		return ""
	end

	method string GetTileMonsterRUID(string mapName, string tileName)
		-- 해당 사냥 타일에 (맵 시작 시) 정해진 몬스터의 STAND RUID. 없으면 "".
		-- TileMonster(@Sync, 지역 가중 추첨 결과) + TierMonster(RUID 데이터)를 재사용한다.
		local key = mapName .. "_" .. tileName
		local mn = self.TileMonster[key]
		if mn == nil or mn == "" then return "" end
		return self:MonsterStandRUID(mn)
	end

	@ExecSpace("ClientOnly")
	method void RequestCampVisuals()
		self._visualRetries = 0
				self:TryApplyCampVisuals()
				self:RequestTileMonsters()
	end

	@ExecSpace("ClientOnly")
	method void TryApplyCampVisuals()
		if self:ApplyCampVisualsLocal() then return end
				self._visualRetries += 1
				if self._visualRetries <= 25 then
					_TimerService:SetTimerOnce(function() self:TryApplyCampVisuals() end, 0.2)
				end
	end

	@ExecSpace("ClientOnly")
	method boolean ApplyCampVisualsLocal()
		if self:CountTiles() == 0 then return false end
				local me = _UserService.LocalPlayer
				if not isvalid(me) then return false end
				local buff = me:GetComponent("script.BuffManager")
				if not isvalid(buff) then return false end
				local myCamp = buff.CampName
				if myCamp == "" then return false end
		
				local ds = _DataService:GetTable("TileVariant")
				if not isvalid(ds) then return true end
				for i = 1, ds:GetRowCount() do
					if ds:GetCell(i, "Camp") == myCamp then
						local tileName = ds:GetCell(i, "TileName")
						local ruid     = ds:GetCell(i, "SpriteRUID")
						
						for key, entity in pairs(self.tileEntities) do
							if entity.Name == tileName and ruid ~= "" and isvalid(entity.SpriteRendererComponent) then
								entity.SpriteRendererComponent.SpriteRUID = ruid
							end
						end
					end
				end
				
				return true
	end

	@ExecSpace("ServerOnly")
	method void OnBeginPlay()
				self:BuildTileGraph()
				self:RollAllTileMonsters()
				self:CollectTiles()
	end

	method void BuildTileGraph()
		local ds = _DataService:GetTable("TileEventData")
				if not isvalid(ds) then
					log_warning("[TileManager] TileEventData 테이블 없음")
					return
				end
		
				local stageToMap = {[1]="Map_01", [2]="Map_02", [3]="Map_03"}
				local rowCount = ds:GetRowCount()
		
				-- 1패스: 존재 여부 맵 구성 ("stage_index_branch" → true)
				local exists = {}
				for i = 1, rowCount do
					local stage  = tonumber(ds:GetCell(i, "Stage"))
					local idx    = tonumber(ds:GetCell(i, "TileIndex"))
					local branch = ds:GetCell(i, "Branch")
					if stage and idx then
						exists[stage .. "_" .. idx .. "_" .. branch] = true
					end
				end
		
				local function tileNameOf(idx, branch)
					if branch == "" or branch == "BRANCH" then
						return "Tile_" .. idx
					end
					return "Tile_" .. idx .. "_" .. branch
				end
		
				-- 2패스: 그래프 구성
				local count = 0
				for i = 1, rowCount do
					local stage  = tonumber(ds:GetCell(i, "Stage"))
					local idx    = tonumber(ds:GetCell(i, "TileIndex"))
					local branch = ds:GetCell(i, "Branch")
					local typ    = ds:GetCell(i, "Type")
					local tier   = tonumber(ds:GetCell(i, "Tier"))
					local region = ds:GetCell(i, "Region")
					local branchText = ds:GetCell(i, "BranchText")
					if not stage or not idx then continue end
		
					local mapName = stageToMap[stage]
					if not mapName then continue end
		
					local tName    = tileNameOf(idx, branch)
					local graphKey = mapName .. "_" .. tName
					local nexts    = {}
		
					if typ ~= "End" then
						local ni = idx + 1
						if branch == "BRANCH" then
							-- 다음 인덱스에 A/B 분기 연결
							if exists[stage .. "_" .. ni .. "_A"] then
								table.insert(nexts, tileNameOf(ni, "A"))
							end
							if exists[stage .. "_" .. ni .. "_B"] then
								table.insert(nexts, tileNameOf(ni, "B"))
							end
						elseif branch == "A" or branch == "B" then
							-- 같은 브랜치 계속 → 없으면 합류 지점으로
							if exists[stage .. "_" .. ni .. "_" .. branch] then
								table.insert(nexts, tileNameOf(ni, branch))
							elseif exists[stage .. "_" .. ni .. "_"] or exists[stage .. "_" .. ni .. "_BRANCH"] then
								table.insert(nexts, "Tile_" .. ni)
							end
						else
							-- 일반 타일: 다음이 BRANCH 타일이어도 이름은 "Tile_{ni}"
							if exists[stage .. "_" .. ni .. "_"] or exists[stage .. "_" .. ni .. "_BRANCH"] then
								table.insert(nexts, "Tile_" .. ni)
							end
						end
					end
		
					self.tileGraph[graphKey] = {nexts=nexts, type=typ, branch=branch, stage=stage, tier=tier, region=region, branchText=branchText}
					count += 1
				end
		
				log("[TileManager] 타일 그래프 구성 완료: " .. tostring(count) .. "개")
	end

end