@Logic
script TileManager extends Logic

	@DisplayName("tileGraph")
	@Description("타일들이 어떻게 연결돼있는지를 나타내는 리스트입니다.")
	property table tileGraph = {}

	@DisplayName("tileEntities")
	@Description("실제 타일들의 엔티티입니다.")
	property table tileEntities = {}

	property table tileComponents = {}

	property table variant = {}

	property integer _collectRetries = 0

	property integer _visualRetries = 0

	method void CollectTiles()
		self.tileEntities = {}
				local entities = _EntityService:GetEntitiesByTag("HexaTile")
				local count = 0
				for _, entity in pairs(entities) do
					local key = entity.CurrentMapName .. "_" .. entity.Name
					self.tileEntities[key] = entity
					count += 1
				end
				log("[TileManager] 타일 수집: " .. tostring(count) .. "개")
				
				if self:IsServer() then
					self:BuildVariants()
					
					for key, entity in pairs(self.tileEntities) do
						if self.variant[key] == nil then
							-- 이중 구조가 아닌 key(Map_Tile) 검색용 예외 처리
							local mapName = entity.CurrentMapName
							local tileName = entity.Name
							local data = self.tileGraph[mapName .. "_" .. tileName]
		
							if data ~= nil then
								local compName = self:TypeToComponent(data.type)
								if compName ~= "" and self.tileComponents[key] == nil then
									entity:AddComponent(compName)
									self.tileComponents[key] = entity:GetComponent("script." .. compName)
								end
							end
						end
					end
				end
	end

	method boolean IsVariantTile(string tileName)
		return self.variant[tileName] ~= nil
	end

	@ExecSpace("ServerOnly")
	method void BuildVariants()
		local ds = _DataService:GetTable("TileVariant")
				if not isvalid(ds) then return end
				for i = 1, ds:GetRowCount() do
					local tileName = ds:GetCell(i, "TileName")
					local camp     = ds:GetCell(i, "Camp")
					local typ      = ds:GetCell(i, "Type")
					
					for key, entity in pairs(self.tileEntities) do
						if entity.Name == tileName and typ ~= "" and camp ~= "" then
							local compName = self:TypeToComponent(typ)
							if compName ~= "" then
								local comp = entity:GetComponent("script." .. compName)
								if comp == nil then
									entity:AddComponent(compName)
									comp = entity:GetComponent("script." .. compName)
								end
								if self.variant[key] == nil then self.variant[key] = {} end
								self.variant[key][camp] = comp
							end
						end
					end
				end
	end

	method void EnsureTilesCollected()
		if self:IsServer() then
					self:CollectTiles()
				else
					_TimerService:SetTimerOnce(function()
						log("[TileManager] 클라이언트 타일 수집 지연 실행")
						self:CollectTiles()
					end, 0.5)
				end
	end

	method integer CountTiles()
		local c = 0
				for _, e in pairs(self.tileEntities) do c += 1 end
				return c
	end

	method string TypeToComponent(string tileType)
		if tileType == "Start" then return "StartTile"
				elseif tileType == "Hunt" then return "HuntTile"
				elseif tileType == "HuntPlus" then return "HuntPlusTile"
				elseif tileType == "Tax" then return "TaxTile"
				elseif tileType == "Boss" then return "BossTile"
				elseif tileType == "Village" then return "VillageTile"
				elseif tileType == "Guild" then return "GuildTile"
				elseif tileType == "Union" then return "UnionTile"
				elseif tileType == "End" then return "EndTile"
				end
				return ""
	end

	method table GetNextTiles(string mapName, string tileName)
		local key = mapName .. "_" .. tileName
		    if self.tileGraph[key] then 
		        return self.tileGraph[key].nexts 
		    end
		    return {}
	end

	method Entity GetTileEntity(string mapName, string tileName)
		return self.tileEntities[mapName .. "_" .. tileName]
	end

	method string GetTileBranch(string mapName, string tileName)
		local key = mapName .. "_" .. tileName
		    if self.tileGraph[key] then 
		        return self.tileGraph[key].branch or "" 
		    end
		    return ""
	end

	@ExecSpace("ServerOnly")
	method void RegisterTile(string tileName, BaseTile tile)
		self.tileComponents[tileName] = tile
	end

	method BaseTile GetTileComponent(string tileName)
		return self.tileComponents[tileName]
	end

	@ExecSpace("ServerOnly")
	method void TriggerArrive(string mapName, string tileName, Entity piece)
		local key = mapName .. "_" .. tileName
				if self:IsVariantTile(key) then
					local campKey = ""
					local buff = piece:GetComponent("script.BuffManager")
					if isvalid(buff) then campKey = buff.CampName end
					local comp = self.variant[key][campKey]
					if comp == nil then return end
					comp:OnArrive(piece)
					return
				end
				
				local comp = self.tileComponents[key]
				if comp == nil then return end
				comp:OnArrive(piece)
	end

	@ExecSpace("ClientOnly")
	method void RequestCampVisuals()
		self._visualRetries = 0
				self:TryApplyCampVisuals()
	end

	@ExecSpace("ClientOnly")
	method void TryApplyCampVisuals()
		if self:ApplyCampVisualsLocal() then return end
				self._visualRetries += 1
				if self._visualRetries <= 25 then
					_TimerService:SetTimerOnce(function() self:TryApplyCampVisuals() end, 0.2)
				end
	end

	@ExecSpace("ClientOnly")
	method boolean ApplyCampVisualsLocal()
		if self:CountTiles() == 0 then return false end
				local me = _UserService.LocalPlayer
				if not isvalid(me) then return false end
				local buff = me:GetComponent("script.BuffManager")
				if not isvalid(buff) then return false end
				local myCamp = buff.CampName
				if myCamp == "" then return false end
		
				local ds = _DataService:GetTable("TileVariant")
				if not isvalid(ds) then return true end
				for i = 1, ds:GetRowCount() do
					if ds:GetCell(i, "Camp") == myCamp then
						local tileName = ds:GetCell(i, "TileName")
						local ruid     = ds:GetCell(i, "SpriteRUID")
						
						for key, entity in pairs(self.tileEntities) do
							if entity.Name == tileName and ruid ~= "" and isvalid(entity.SpriteRendererComponent) then
								entity.SpriteRendererComponent.SpriteRUID = ruid
							end
						end
					end
				end
				
				return true
	end

	@ExecSpace("ServerOnly")
	method void OnBeginPlay()
				self:BuildTileGraph()
				self:CollectTiles()
	end

	@ExecSpace("ServerOnly")
	method void BuildTileGraph()
		local ds = _DataService:GetTable("TileEventData")
				if not isvalid(ds) then
					log_warning("[TileManager] TileEventData 테이블 없음")
					return
				end
		
				local stageToMap = {[1]="Map_01", [2]="Map_02", [3]="Map_03"}
				local rowCount = ds:GetRowCount()
		
				-- 1패스: 존재 여부 맵 구성 ("stage_index_branch" → true)
				local exists = {}
				for i = 1, rowCount do
					local stage  = tonumber(ds:GetCell(i, "Stage"))
					local idx    = tonumber(ds:GetCell(i, "TileIndex"))
					local branch = ds:GetCell(i, "Branch")
					if stage and idx then
						exists[stage .. "_" .. idx .. "_" .. branch] = true
					end
				end
		
				local function tileNameOf(idx, branch)
					if branch == "" or branch == "BRANCH" then
						return "Tile_" .. idx
					end
					return "Tile_" .. idx .. "_" .. branch
				end
		
				-- 2패스: 그래프 구성
				local count = 0
				for i = 1, rowCount do
					local stage  = tonumber(ds:GetCell(i, "Stage"))
					local idx    = tonumber(ds:GetCell(i, "TileIndex"))
					local branch = ds:GetCell(i, "Branch")
					local typ    = ds:GetCell(i, "Type")
					if not stage or not idx then continue end
		
					local mapName = stageToMap[stage]
					if not mapName then continue end
		
					local tName    = tileNameOf(idx, branch)
					local graphKey = mapName .. "_" .. tName
					local nexts    = {}
		
					if typ ~= "End" then
						local ni = idx + 1
						if branch == "BRANCH" then
							-- 다음 인덱스에 A/B 분기 연결
							if exists[stage .. "_" .. ni .. "_A"] then
								table.insert(nexts, tileNameOf(ni, "A"))
							end
							if exists[stage .. "_" .. ni .. "_B"] then
								table.insert(nexts, tileNameOf(ni, "B"))
							end
						elseif branch == "A" or branch == "B" then
							-- 같은 브랜치 계속 → 없으면 합류 지점으로
							if exists[stage .. "_" .. ni .. "_" .. branch] then
								table.insert(nexts, tileNameOf(ni, branch))
							elseif exists[stage .. "_" .. ni .. "_"] or exists[stage .. "_" .. ni .. "_BRANCH"] then
								table.insert(nexts, "Tile_" .. ni)
							end
						else
							-- 일반 타일: 다음이 BRANCH 타일이어도 이름은 "Tile_{ni}"
							if exists[stage .. "_" .. ni .. "_"] or exists[stage .. "_" .. ni .. "_BRANCH"] then
								table.insert(nexts, "Tile_" .. ni)
							end
						end
					end
		
					self.tileGraph[graphKey] = {nexts=nexts, type=typ, branch=branch}
					count += 1
				end
		
				log("[TileManager] 타일 그래프 구성 완료: " .. tostring(count) .. "개")
	end

end