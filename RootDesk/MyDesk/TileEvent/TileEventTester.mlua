@Logic
script TileEventTester extends Logic

	@DisplayName("강제 이벤트")
	@Description("None / Hunt / HuntPlus / Village / Boss / Unlucky / Guild / Romance / BlackMage")
	property string ForceEvent = "BlackMage"

	-- ─────────── 강제 이벤트(ForceEvent) 인덱스: 설정 가능한 값 → 부착되는 타일 컴포넌트 ───────────
	--   None(빈 값) → (강제 없음, 정상 동작)
	--   Hunt        → HuntTile      (사냥)
	--   HuntPlus    → HuntPlusTile  (사냥+)
	--   Village     → VillageTile   (마을)
	--   Boss        → BossTile      (보스)
	--   Unlucky     → UnluckyTile   (불행)
	--   Guild       → GuildTile     (길드)
	--   Romance     → RomanceTile   (연애)
	--   BlackMage   → EndTile       (검은 마법사 최종 결전 — 스테이지 무관 강제 발동)
	-- ────────────────────────────────────────────────────────────────────────────

	method string CompNameFor(string key)
		-- 이벤트 키 → 부착할 타일 컴포넌트 이름. 미설정/None이면 "".
		if key == "Hunt" then return "HuntTile"
		elseif key == "HuntPlus" then return "HuntPlusTile"
		elseif key == "Village" then return "VillageTile"
		elseif key == "Boss" then return "BossTile"
		elseif key == "Unlucky" then return "UnluckyTile"
		elseif key == "Guild" then return "GuildTile"
		elseif key == "Romance" then return "RomanceTile"
		elseif key == "BlackMage" then return "EndTile"
		end
		return ""
	end

	@ExecSpace("ServerOnly")
	method any OverrideFor(Entity tileEntity)
		-- ForceEvent가 설정돼 있으면 tileEntity에 해당 타일 컴포넌트를 보장하고 반환한다.
		-- 비활성(None)이거나 엔티티가 없으면 nil → TileManager는 정상 동작으로 진행.
		local compName = self:CompNameFor(self.ForceEvent)
		if compName == "" then return nil end
		if isvalid(tileEntity) == false then return nil end
		local c = tileEntity:GetComponent("script." .. compName)
		if isvalid(c) == false then
			tileEntity:AddComponent(compName)
			c = tileEntity:GetComponent("script." .. compName)
		end
		return c
	end

end