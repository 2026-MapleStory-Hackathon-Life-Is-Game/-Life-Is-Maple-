# ===== MapleStory Worlds (MOD) .gitignore =====

# --- 로컬 설정 / 사용자별 환경 ---
# 에디터가 생성하는 로컬 사용자 설정 (PC마다 다름)
*.user
*.local
LocalSettings/
UserSettings/

# --- 캐시 / 임시 파일 ---
# 에디터가 자동 생성하는 캐시 (재생성되므로 추적 불필요)
Cache/
.cache/
Temp/
tmp/
*.tmp
*.cache

# --- 빌드 / 배포 산출물 ---
# 게시(Publish) 시 생성되는 빌드 결과물
Build/
Builds/
Output/
Dist/
*.modpkg

# --- 로그 ---
Logs/
*.log

# --- 리소스 임포트 캐시 ---
# 원본이 아닌, 임포트 과정에서 생성되는 중간 파일
ImportCache/
Library/
Imported/

# --- OS 생성 파일 ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini

# --- IDE / 에디터 ---
.vscode/
.idea/
*.swp
*.swo
*~

# ===== 추적할 것 (참고) =====
# 아래는 무시하지 말 것 — 실제 게임 콘텐츠/스크립트
# *.codeblock   (스크립트)
# *.model       (모델)
# *.directory   (폴더 구조)
# *.scene / *.map (맵 데이터)