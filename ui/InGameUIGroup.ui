              },
              "Pivot": {
                "x": 0.5,
                "y": 0.5
              },
              "RectSize": {
                "x": 391.0811,
                "y": 406.266968
              },
              "UIMode": 1,
              "UIVersion": 2,
              "anchoredPosition": {
                "x": 272.2378,
                "y": 70.3064
              },
              "Position": {
                "x": 272.2378,
                "y": 70.3064,
                "z": 0.0
              },
              "QuaternionRotation": {
                "x": 0.0,
                "y": 0.0,
                "z": 0.0,
                "w": 1.0
              },
              "Enable": true
            },
            {
              "@type": "MOD.Core.TextGUIRendererComponent",
              "Font": "Maple",
              "HorizontalAlignment": 1,
              "IsRichText": true,
              "OverrideSorting": false,
              "SortingLayer": "MapLayer0",
              "Text": "캐릭터 정보창에서는 내 캐릭터가\n현재 어떤 상태인지 확인할 수 있습니다!\n\n<b><size=35>전투력</size></b>\n전투력은 주스탯(STR/DEX/INT/LUK 중 택 1 ),\n공격력/마력, 대미지, 보스 대미지가\n합쳐져 계산됩니다.\n\n<b><size=35>장비</size></b>\n플레이어는 <b>[보호구/무기/장신구]</b>\n총 세 가지 종류의 장비를 장착할 수 있습니다.\n\n장비를 두 번 클릭하여 장착한 장비를 해제하거나\n마우스 우측 버튼을 눌러\n잠재능력 재설정을 진행할 수 있습니다.",
              "VerticalAlignment": 512,
              "Enable": true
            }
          ],
          "@version": 1
        }
      },
